<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'Invoice · Nirmana Printing' %></title>
  <link rel="icon" type="image/png" href="/images/favicon.png">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      background-color: #f4f6f9;
      color: #000;
      -webkit-font-smoothing: antialiased;
    }

    /* Screen Action Bar (Hidden when printing) */
    .screen-actions-bar {
      background: #1e293b;
      color: #fff;
      padding: 12px 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      box-shadow: 0 2px 8px rgba(0,0,0,0.15);
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .btn-action {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 18px;
      border-radius: 6px;
      font-size: 14px;
      font-weight: 600;
      text-decoration: none;
      cursor: pointer;
      border: none;
      transition: all 0.15s ease;
    }

    .btn-back {
      background: #334155;
      color: #f8fafc;
    }
    .btn-back:hover {
      background: #475569;
      color: #fff;
    }

    .btn-print {
      background: #f7cf17;
      color: #000;
    }
    .btn-print:hover {
      background: #e5bd07;
      color: #000;
    }

    /* Bill Page Container */
    .invoice-wrapper {
      max-width: 840px;
      margin: 30px auto;
      background: #ffffff;
      padding: 45px 50px;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
      border-radius: 4px;
    }

    /* Header Section */
    .invoice-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 25px;
    }

    .header-left {
      flex: 1;
      max-width: 50%;
    }

    .invoice-title {
      font-size: 54px;
      font-weight: 900;
      letter-spacing: -1.5px;
      line-height: 1;
      margin-bottom: 24px;
      color: #000;
    }

    .field-row {
      font-size: 15px;
      margin-bottom: 14px;
      display: flex;
      align-items: flex-end;
    }

    .field-label {
      font-weight: 600;
      color: #111;
      white-space: nowrap;
      margin-right: 8px;
    }

    .field-line {
      flex: 1;
      border-bottom: 1.5px solid #222;
      padding-bottom: 2px;
      font-weight: 600;
      min-height: 22px;
      color: #000;
    }

    .header-right {
      flex: 1;
      max-width: 48%;
      text-align: right;
    }

    .shop-logo-img {
      width: 230px;
      height: auto;
      display: block;
      margin-left: auto;
      margin-bottom: 8px;
    }

    .payment-method-box {
      font-size: 13.5px;
      line-height: 1.45;
      color: #000;
    }

    .payment-method-title {
      font-weight: 800;
      margin-bottom: 3px;
      font-size: 14px;
    }

    .bank-item {
      margin-bottom: 2px;
    }

    .bank-account-name {
      font-weight: 800;
      margin-top: 2px;
    }

    /* Table Section */
    .invoice-table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 20px;
      border: 2px solid #000;
    }

    .invoice-table th {
      background-color: #f7cf17 !important; /* Authentic Yellow Header */
      color: #000;
      font-weight: 800;
      font-size: 15px;
      padding: 10px 12px;
      border-right: 1.5px solid #000;
      border-bottom: 2px solid #000;
    }
    .invoice-table th:last-child {
      border-right: none;
    }

    .invoice-table td {
      border-right: 1.5px solid #000;
      border-bottom: 1.5px solid #000;
      padding: 9px 12px;
      font-size: 14.5px;
      vertical-align: middle;
      color: #000;
    }
    .invoice-table td:last-child {
      border-right: none;
    }

    .invoice-table .col-desc {
      width: 52%;
      text-align: left;
    }
    .invoice-table .col-qty {
      width: 14%;
      text-align: center;
    }
    .invoice-table .col-price {
      width: 16%;
      text-align: right;
    }
    .invoice-table .col-total {
      width: 18%;
      text-align: right;
      font-weight: 700;
    }

    /* Empty Grid Rows to match authentic printed pad look */
    .empty-row td {
      height: 38px;
    }

    /* Total Section */
    .total-wrapper {
      display: flex;
      justify-content: flex-end;
      margin-top: 15px;
    }

    .total-box {
      display: inline-flex;
      border: 2px solid #000;
      background: #fff;
    }

    .total-label {
      background-color: #f7cf17 !important;
      color: #000;
      font-weight: 800;
      font-size: 16px;
      padding: 8px 24px;
      border-right: 2px solid #000;
      display: flex;
      align-items: center;
      text-transform: lowercase;
    }

    .total-amount {
      font-weight: 800;
      font-size: 18px;
      padding: 8px 25px;
      min-width: 160px;
      text-align: right;
      color: #000;
      display: flex;
      align-items: center;
      justify-content: flex-end;
    }

    /* Optional Balance / Advance Strip (For Orders) */
    .order-balance-strip {
      display: flex;
      justify-content: flex-end;
      gap: 20px;
      margin-top: 8px;
      font-size: 13.5px;
      color: #333;
    }
    .order-balance-strip strong {
      color: #000;
    }

    /* Footer Section */
    .invoice-footer {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      margin-top: 55px;
    }

    .footer-left {
      flex: 1;
      max-width: 55%;
    }

    .thank-you-title {
      font-size: 26px;
      font-weight: 900;
      letter-spacing: 0.5px;
      margin-bottom: 18px;
      color: #000;
    }

    .contact-item {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 14px;
      margin-bottom: 6px;
      color: #111;
      font-weight: 500;
    }

    .contact-icon {
      font-size: 15px;
      width: 18px;
      text-align: center;
    }

    .footer-right {
      width: 320px;
    }

    .signature-line {
      border-bottom: 1.5px solid #444;
      height: 28px;
      margin-bottom: 4px;
    }

    /* Print Stylesheet */
    @media print {
      body {
        background-color: #fff !important;
        color: #000 !important;
        margin: 0 !important;
        padding: 0 !important;
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
      }

      .screen-actions-bar {
        display: none !important;
      }

      .invoice-wrapper {
        box-shadow: none !important;
        border-radius: 0 !important;
        padding: 0 !important;
        margin: 0 !important;
        max-width: 100% !important;
        width: 100% !important;
      }

      @page {
        size: A4 portrait;
        margin: 15mm 15mm 15mm 15mm;
      }
    }
  </style>
</head>
<body>

  <!-- Screen Actions Bar (Not Printed) -->
  <div class="screen-actions-bar">
    <div style="display: flex; align-items: center; gap: 12px;">
      <a href="javascript:window.history.back()" class="btn-action btn-back">
        <i class="bi bi-arrow-left"></i> Back
      </a>
      <span style="font-size: 14px; color: #94a3b8;">
        Official Bill / Invoice &bull; Nirmana Printing
      </span>
    </div>

    <div style="display: flex; align-items: center; gap: 10px;">
      <button onclick="window.print()" class="btn-action btn-print">
        <i class="bi bi-printer-fill"></i> Print Bill (A4)
      </button>
    </div>
  </div>

  <!-- Printable Invoice Sheet -->
  <div class="invoice-wrapper">
    <!-- Header -->
    <div class="invoice-header">
      <!-- Left side: Invoice title & customer fields -->
      <div class="header-left">
        <h1 class="invoice-title">Invoice</h1>

        <div class="field-row">
          <span class="field-label">Date:</span>
          <span class="field-line"><%= invoiceData.date %></span>
        </div>

        <div class="field-row">
          <span class="field-label">Invoice number:</span>
          <span class="field-line"><%= invoiceData.invoiceNumber %></span>
        </div>

        <div class="field-row">
          <span class="field-label">Billed to:</span>
          <span class="field-line"><%= invoiceData.billedTo %></span>
        </div>
      </div>

      <!-- Right side: Logo & Payment details -->
      <div class="header-right">
        <img src="/images/nirmana_bill_logo.png" alt="Nirmana Printing" class="shop-logo-img">

        <div class="payment-method-box">
          <div class="payment-method-title">Payment Method:</div>
          <div class="bank-item"><strong>Bank Name :</strong> HNB Bank</div>
          <div class="bank-item"><strong>Account No :</strong> 208020189684</div>
          <div class="bank-item"><strong>Bank Name :</strong> Peoples Bank</div>
          <div class="bank-item"><strong>Account No :</strong> 292200310012597</div>
          <div class="bank-account-name"><strong>Account Name:</strong>BMA Priyamantha</div>
        </div>
      </div>
    </div>

    <!-- Main Items Table -->
    <table class="invoice-table">
      <thead>
        <tr>
          <th class="col-desc">Description</th>
          <th class="col-qty">Qty</th>
          <th class="col-price">Price</th>
          <th class="col-total">Total</th>
        </tr>
      </thead>
      <tbody>
        <!-- Active Items -->
        <% if (invoiceData.items && invoiceData.items.length > 0) { %>
          <% invoiceData.items.forEach(function(item) { %>
            <tr>
              <td class="col-desc">
                <div style="font-weight: 600;"><%= item.description %></div>
                <% if (item.subtext) { %>
                  <div style="font-size: 12.5px; color: #444; margin-top: 2px;"><%= item.subtext %></div>
                <% } %>
              </td>
              <td class="col-qty"><%= item.quantity %></td>
              <td class="col-price"><%= parseFloat(item.unitPrice).toFixed(2) %></td>
              <td class="col-total"><%= parseFloat(item.totalPrice).toFixed(2) %></td>
            </tr>
          <% }); %>
        <% } %>

        <!-- Filler empty grid rows (so invoice looks identical to the official printed pad) -->
        <% 
          var totalRows = 10;
          var filledRows = invoiceData.items ? invoiceData.items.length : 0;
          var emptyRowsCount = Math.max(0, totalRows - filledRows);
          for (var i = 0; i < emptyRowsCount; i++) { 
        %>
          <tr class="empty-row">
            <td class="col-desc"></td>
            <td class="col-qty"></td>
            <td class="col-price"></td>
            <td class="col-total"></td>
          </tr>
        <% } %>
      </tbody>
    </table>

    <!-- Total Row Box -->
    <div class="total-wrapper">
      <div class="total-box">
        <div class="total-label">total :</div>
        <div class="total-amount"><%= invoiceData.currencySymbol %> <%= parseFloat(invoiceData.totalAmount).toFixed(2) %></div>
      </div>
    </div>

    <!-- Optional Order Payment Split (Advance & Balance) -->
    <% if (invoiceData.advancePaid !== undefined && invoiceData.balanceAmount !== undefined && (parseFloat(invoiceData.advancePaid) > 0 || parseFloat(invoiceData.balanceAmount) > 0)) { %>
      <div class="order-balance-strip">
        <div>Advance Paid: <strong><%= invoiceData.currencySymbol %> <%= parseFloat(invoiceData.advancePaid).toFixed(2) %></strong></div>
        <div>Balance Due: <strong style="color: <%= parseFloat(invoiceData.balanceAmount) > 0 ? '#b91c1c' : '#15803d' %>;"><%= invoiceData.currencySymbol %> <%= parseFloat(invoiceData.balanceAmount).toFixed(2) %></strong></div>
      </div>
    <% } %>

    <!-- Footer -->
    <div class="invoice-footer">
      <div class="footer-left">
        <div class="thank-you-title">THANK YOU</div>

        <div class="contact-item">
          <span class="contact-icon"><i class="bi bi-telephone-fill"></i></span>
          <span>075-2301939/070-4833223</span>
        </div>
        <div class="contact-item">
          <span class="contact-icon"><i class="bi bi-envelope-fill"></i></span>
          <span>printingnirmana@gmail.com</span>
        </div>
        <div class="contact-item">
          <span class="contact-icon"><i class="bi bi-geo-alt-fill"></i></span>
          <span>කොටඹේ පාසල අසල</span>
        </div>
      </div>

      <div class="footer-right">
        <div class="signature-line"></div>
        <div class="signature-line"></div>
        <div class="signature-line"></div>
        <div class="signature-line"></div>
      </div>
    </div>
  </div>

  <script>
    // Auto-open print dialog if requested via ?autoprint=1
    if (new URLSearchParams(window.location.search).get('autoprint') === '1') {
      window.onload = function() {
        setTimeout(function() {
          window.print();
        }, 350);
      };
    }
  </script>
</body>
</html>
