  <div class="content-body">
    <div class="serene-card text-center py-5">
      <div class="mb-3 text-muted">
        <i class="bi bi-exclamation-octagon fs-1 text-warning"></i>
      </div>
      <h2 class="mb-2"><%= title || 'Notice' %></h2>
