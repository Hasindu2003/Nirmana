<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<main class="main-wrapper">
  <div class="content-body">
    <!-- Header -->
    <div class="d-flex flex-wrap align-items-center justify-content-between mb-4">
      <div>
        <h2 class="fs-4 fw-bold mb-1">Customers Directory</h2>
        <div class="text-muted small">Registered clients and historical printing job counts</div>
      </div>
      <div class="mt-2 mt-sm-0">
        <button class="btn btn-serene-primary" data-bs-toggle="modal" data-bs-target="#newCustomerModal">
          <i class="bi bi-person-plus"></i> Add Customer
        </button>
      </div>
    </div>

    <!-- Search -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
      <div class="text-muted small">Total: <%= typeof pagination !== 'undefined' ? pagination.totalItems : customers.length %> Customers</div>
      <form action="/customers" method="GET" class="d-flex align-items-center gap-2 flex-grow-1 flex-sm-grow-0" style="min-width: 220px; max-width: 100%;">
        <input type="text" name="search" value="<%= search %>" class="form-control form-control-sm flex-grow-1" placeholder="Search name, phone, code...">
        <button type="submit" class="btn btn-sm btn-serene-secondary">Search</button>
      </form>
    </div>

    <!-- Customers Table Card -->
    <div class="serene-card">
      <div class="table-responsive">
        <table class="serene-table">
          <thead>
            <tr>
              <th>Customer</th>
              <th>Company & Email</th>
              <th>Orders Placed</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (customers && customers.length > 0) { %>
              <% customers.forEach(c => { %>
                <tr>
                  <td>
                    <div>
                      <a href="/customers/<%= c.id %>" class="fw-semibold text-dark text-decoration-none hover-primary"><%= c.name %></a>
                    </div>
                    <div class="d-flex flex-wrap align-items-center gap-2 mt-1">
                      <span class="badge bg-light text-muted border font-monospace" style="font-size: 0.72rem;"><%= c.customerCode %></span>
                      <span class="text-muted small"><i class="bi bi-telephone text-muted me-1"></i><%= c.phone %></span>
                    </div>
                  </td>
                  <td>
                    <div class="fw-medium text-dark"><%= c.companyName || 'Individual' %></div>
                    <% if (c.email) { %>
                      <div class="text-muted small"><%= c.email %></div>
                    <% } %>
                  </td>
                  <td>
                    <span class="badge rounded-pill bg-light text-dark border">
                      <%= c.orders ? c.orders.length : 0 %> Orders
                    </span>
                  </td>
                  <td>
                    <div class="d-flex align-items-center gap-1">
                      <a href="/customers/<%= c.id %>" class="btn btn-sm btn-serene-secondary py-1 px-2" title="View Profile">
                        <i class="bi bi-person"></i> Profile
                      </a>
                      <a href="/orders?customerId=<%= c.id %>" class="btn btn-sm btn-serene-secondary py-1 px-2" title="View Orders">
                        <i class="bi bi-receipt"></i> Orders
                      </a>
                    </div>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="4" class="text-center py-5 text-muted">
                  No customers found. Click "+ Add Customer" or create an order with a new customer.
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
      <%- include('../partials/pagination', { pagination, baseUrl: '/customers', queryParams: { search: search || undefined } }) %>
    </div>
  </div>
</main>

<!-- Modal: Add Customer -->
<div class="modal fade" id="newCustomerModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content" style="border-radius: var(--serene-radius-lg); border: 1px solid var(--serene-border);">
      <div class="modal-header border-bottom" style="background:#fafbfc;">
        <h5 class="modal-title fs-6 fw-semibold">Add Customer</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form onsubmit="handleDirectAddCustomer(event)">
        <div class="modal-body p-4">
          <div class="mb-3">
            <label class="form-label">Full Name *</label>
            <input type="text" name="name" class="form-control" placeholder="Contact Person Name" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Phone Number *</label>
            <input type="tel" name="phone" class="form-control" placeholder="0771234567" pattern="0[0-9]{9}" maxlength="10" minlength="10" oninput="this.value = this.value.replace(/\D/g, '').slice(0, 10)" required>
          </div>
          <div class="row g-2 mb-3">
            <div class="col-6">
              <label class="form-label">Company / Brand (Optional)</label>
              <input type="text" name="companyName" class="form-control" placeholder="Business name">
            </div>
            <div class="col-6">
              <label class="form-label">Email (Optional)</label>
              <input type="email" name="email" class="form-control" placeholder="client@domain.com">
            </div>
          </div>
          <div class="mb-2">
            <label class="form-label">Address (Optional)</label>
            <input type="text" name="address" class="form-control" placeholder="Street, City">
          </div>
        </div>
        <div class="modal-footer border-top bg-light">
          <button type="button" class="btn btn-serene-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-serene-primary">Save Customer</button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>

<script>
async function handleDirectAddCustomer(e) {
  e.preventDefault();
  const form = e.target;
  const formData = new FormData(form);
  const payload = Object.fromEntries(formData.entries());

  const phone = (payload.phone || '').trim();
  if (!phone) {
    toast.warning('Please enter a phone number.');
    return;
  }
  if (!/^0\d{9}$/.test(phone)) {
    toast.warning('Phone number must be exactly 10 digits starting with 0 (e.g. 0771234567).');
    return;
  }

  try {
    const res = await fetch('/api/customers', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });
    const result = await res.json();
    if (result.success) {
      setPendingToast('Customer created: ' + result.data.name, 'success');
      window.location.reload();
    } else {
      toast.error('Error: ' + result.message);
    }
  } catch (err) {
    toast.error('Failed to add customer: ' + err.message);
  }
}
</script>
