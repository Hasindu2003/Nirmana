<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<main class="main-wrapper">
  <div class="content-body">
    <!-- Header -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-4">
      <div>
        <h2 class="fs-4 fw-bold mb-1">Customers & Accounts Directory</h2>
        <div class="text-muted small">Registered client accounts, order transaction histories, given amounts, and outstanding balances yet to give</div>
      </div>
      <div class="d-flex flex-wrap align-items-center gap-2 mt-2 mt-sm-0">
        <a href="/register" class="btn btn-serene-secondary">
          <i class="bi bi-person-badge"></i> Client Registration Link
        </a>
        <button class="btn btn-serene-primary" data-bs-toggle="modal" data-bs-target="#newCustomerModal">
          <i class="bi bi-person-plus"></i> Add Customer
        </button>
      </div>
    </div>

    <!-- Accounts Financial KPI Summary Cards -->
    <% if (typeof accountsSummary !== 'undefined' && accountsSummary) { %>
      <div class="row g-2 g-md-3 mb-4">
        <!-- 1. Total Accounts & Portal Logins -->
        <div class="col-6 col-md-3">
          <div class="kpi-card h-100">
            <div class="kpi-title">Total Client Accounts</div>
            <div class="kpi-value tabular-nums text-dark"><%= accountsSummary.totalAccounts %></div>
            <div class="kpi-sub text-muted text-truncate">
              <span class="badge bg-primary-subtle text-primary border border-primary-subtle fw-semibold">
                <i class="bi bi-shield-lock me-1"></i> <%= accountsSummary.registeredUsersCount %> Logins Active
              </span>
            </div>
          </div>
        </div>

        <!-- 2. Total Billed -->
        <div class="col-6 col-md-3">
          <div class="kpi-card h-100">
            <div class="kpi-title">Total Billed Orders</div>
            <div class="kpi-value tabular-nums text-dark">
              <%= currencySymbol %> <%= parseFloat(accountsSummary.totalBilled).toLocaleString('en-LK', { minimumFractionDigits: 2 }) %>
            </div>
            <div class="kpi-sub text-muted text-truncate">
              <i class="bi bi-receipt"></i> Cumulative client billing
            </div>
          </div>
        </div>

        <!-- 3. Total Given (Paid) -->
        <div class="col-6 col-md-3">
          <div class="kpi-card h-100" style="border-left: 4px solid var(--serene-success, #16a34a);">
            <div class="kpi-title text-success">Total Given (Received)</div>
            <div class="kpi-value tabular-nums text-success">
              <%= currencySymbol %> <%= parseFloat(accountsSummary.totalGiven).toLocaleString('en-LK', { minimumFractionDigits: 2 }) %>
            </div>
            <div class="kpi-sub text-muted text-truncate">
              <i class="bi bi-check-circle text-success"></i> Advance payments collected
            </div>
          </div>
        </div>

        <!-- 4. Total Yet to Give (Unpaid Balance) -->
        <div class="col-6 col-md-3">
          <div class="kpi-card h-100" style="border-left: 4px solid var(--serene-danger, #dc2626);">
            <div class="kpi-title text-danger fw-bold">Total Yet to Give (Due)</div>
            <div class="kpi-value tabular-nums text-danger">
              <%= currencySymbol %> <%= parseFloat(accountsSummary.totalYetToGive).toLocaleString('en-LK', { minimumFractionDigits: 2 }) %>
            </div>
            <div class="kpi-sub text-muted text-truncate">
              <span class="text-danger fw-semibold"><i class="bi bi-exclamation-circle"></i> Outstanding balances</span>
            </div>
          </div>
        </div>
      </div>
    <% } %>

    <!-- Search & Filter Bar -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
      <div class="text-muted small">Showing: <%= typeof pagination !== 'undefined' ? pagination.totalItems : customers.length %> Customers</div>
      <form action="/customers" method="GET" class="d-flex align-items-center gap-2 flex-grow-1 flex-sm-grow-0" style="min-width: 260px; max-width: 100%;">
        <input type="text" name="search" value="<%= search %>" class="form-control form-control-sm flex-grow-1" placeholder="Search name, phone, code, username...">
        <button type="submit" class="btn btn-sm btn-serene-secondary">Search</button>
      </form>
    </div>

    <!-- Customers Table Card -->
    <div class="serene-card">
      <div class="table-responsive">
        <table class="serene-table">
          <thead>
            <tr>
              <th>Customer & Account</th>
              <th>Contact Details</th>
              <th>Orders</th>
              <th>Total Billed</th>
              <th class="text-success">Given (Paid)</th>
              <th class="text-danger">Yet to Give (Due)</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (customers && customers.length > 0) { %>
              <% customers.forEach(c => { %>
                <% const billed = parseFloat(c.dataValues.totalBilled || c.totalBilled || 0); %>
                <% const given = parseFloat(c.dataValues.givenAmount || c.givenAmount || 0); %>
                <% const due = parseFloat(c.dataValues.yetToGive || c.yetToGive || 0); %>
                <tr>
                  <td>
                    <div>
                      <a href="/customers/<%= c.id %>" class="fw-bold text-dark text-decoration-none hover-primary"><%= c.name %></a>
                    </div>
                    <div class="d-flex flex-wrap align-items-center gap-1 mt-1">
                      <span class="badge bg-light text-muted border font-monospace" style="font-size: 0.72rem;"><%= c.customerCode %></span>
                      <% if (c.dataValues.hasLoginAccount || c.userAccount || c.userId) { %>
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle" style="font-size: 0.7rem;">
                          <i class="bi bi-person-check-fill"></i> Portal: <%= c.userAccount ? c.userAccount.username : 'Active' %>
                        </span>
                      <% } else { %>
                        <span class="badge bg-light text-muted border" style="font-size: 0.68rem;">No Portal User</span>
                      <% } %>
                    </div>
                  </td>
                  <td>
                    <div class="fw-medium text-dark"><i class="bi bi-telephone text-primary me-1"></i><%= c.phone %></div>
                    <% if (c.companyName) { %>
                      <div class="text-muted small"><%= c.companyName %></div>
                    <% } %>
                    <% if (c.email) { %>
                      <div class="text-muted small" style="font-size: 0.75rem;"><%= c.email %></div>
                    <% } %>
                  </td>
                  <td>
                    <span class="badge rounded-pill bg-light text-dark border">
                      <%= c.dataValues.ordersCount !== undefined ? c.dataValues.ordersCount : (c.orders ? c.orders.length : 0) %> Orders
                    </span>
                  </td>
                  <td>
                    <div class="tabular-nums fw-bold text-dark">
                      <%= currencySymbol %> <%= billed.toLocaleString('en-LK', { minimumFractionDigits: 2 }) %>
                    </div>
                  </td>
                  <td>
                    <div class="tabular-nums fw-bold text-success">
                      <%= currencySymbol %> <%= given.toLocaleString('en-LK', { minimumFractionDigits: 2 }) %>
                    </div>
                  </td>
                  <td>
                    <% if (due > 0) { %>
                      <div class="badge bg-danger-subtle text-danger border border-danger-subtle fw-bold tabular-nums">
                        <%= currencySymbol %> <%= due.toLocaleString('en-LK', { minimumFractionDigits: 2 }) %>
                      </div>
                    <% } else { %>
                      <span class="badge bg-success-subtle text-success border border-success-subtle fw-semibold">
                        <i class="bi bi-check2"></i> Cleared
                      </span>
                    <% } %>
                  </td>
                  <td>
                    <div class="d-flex align-items-center gap-1">
                      <a href="/customers/<%= c.id %>" class="btn btn-sm btn-serene-secondary py-1 px-2" title="View Profile & Ledger">
                        <i class="bi bi-person"></i> Profile
                      </a>
                      <a href="/orders?customerId=<%= c.id %>" class="btn btn-sm btn-serene-secondary py-1 px-2" title="View Orders">
                        <i class="bi bi-receipt"></i> Orders
                      </a>
                      <a href="/portal?customerId=<%= c.id %>" class="btn btn-sm btn-outline-primary py-1 px-2" title="Preview Client Portal" target="_blank">
                        <i class="bi bi-box-arrow-up-right"></i>
                      </a>
                    </div>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="7" class="text-center py-5 text-muted">
                  No customers found. Click "+ Add Customer" or share the client registration link.
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
      <%- include('../partials/pagination', { pagination, baseUrl: '/customers', queryParams: { search: search || undefined } }) %>
    </div>
  </div>
</main>

<!-- Modal: Add Customer -->
<div class="modal fade" id="newCustomerModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content" style="border-radius: var(--serene-radius-lg); border: 1px solid var(--serene-border);">
      <div class="modal-header border-bottom" style="background:#fafbfc;">
        <h5 class="modal-title fs-6 fw-semibold">Add Customer</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form onsubmit="handleDirectAddCustomer(event)">
        <div class="modal-body p-4">
          <div class="mb-3">
            <label class="form-label">Full Name *</label>
            <input type="text" name="name" class="form-control" placeholder="Contact Person Name" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Phone Number *</label>
            <input type="tel" name="phone" class="form-control" placeholder="0771234567" pattern="0[0-9]{9}" maxlength="10" minlength="10" oninput="this.value = this.value.replace(/\D/g, '').slice(0, 10)" required>
          </div>
          <div class="row g-2 mb-3">
            <div class="col-6">
              <label class="form-label">Company / Brand (Optional)</label>
              <input type="text" name="companyName" class="form-control" placeholder="Business name">
            </div>
            <div class="col-6">
              <label class="form-label">Email (Optional)</label>
              <input type="email" name="email" class="form-control" placeholder="client@domain.com">
            </div>
          </div>
          <div class="mb-2">
            <label class="form-label">Address (Optional)</label>
            <input type="text" name="address" class="form-control" placeholder="Street, City">
          </div>
        </div>
        <div class="modal-footer border-top bg-light">
          <button type="button" class="btn btn-serene-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-serene-primary">Save Customer</button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>

<script>
async function handleDirectAddCustomer(e) {
  e.preventDefault();
  const form = e.target;
  const formData = new FormData(form);
  const payload = Object.fromEntries(formData.entries());

  const phone = (payload.phone || '').trim();
  if (!phone) {
    toast.warning('Please enter a phone number.');
    return;
  }
  if (!/^0\d{9}$/.test(phone)) {
    toast.warning('Phone number must be exactly 10 digits starting with 0 (e.g. 0771234567).');
    return;
  }

  try {
    const res = await fetch('/api/customers', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });
    const result = await res.json();
    if (result.success) {
      setPendingToast('Customer created: ' + result.data.name, 'success');
      window.location.reload();
    } else {
      toast.error('Error: ' + result.message);
    }
  } catch (err) {
    toast.error('Failed to add customer: ' + err.message);
  }
}
</script>
