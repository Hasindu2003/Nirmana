    document.querySelectorAll('.file-color-select').forEach(select => {
      select.addEventListener('change', (e) => {
        const idx = parseInt(e.target.getAttribute('data-index'), 10);
        const file = selectedFiles[idx];
        if (file) {
          file.selectedColorMode = e.target.value;
          file.hasCustomColorMode = true;
        }
      });
    });

    document.querySelectorAll('.file-copies-input').forEach(input => {
      input.addEventListener('change', (e) => {
        const idx = parseInt(e.target.getAttribute('data-index'), 10);
        const file = selectedFiles[idx];
        if (file) {
          const val = parseInt(e.target.value, 10);
          file.selectedCopies = val > 0 ? val : 1;
          e.target.value = file.selectedCopies;
          file.hasCustomCopies = true;
        }
      });
      input.addEventListener('input', (e) => {
        const idx = parseInt(e.target.getAttribute('data-index'), 10);
        const file = selectedFiles[idx];
        if (file) {
          const val = parseInt(e.target.value, 10);
          if (val > 0) {
            file.selectedCopies = val;
            file.hasCustomCopies = true;
          }
        }
      });
    });
  }

  // Real-time phone input validation & error visibility with auto-normalization
  const phoneInput = document.getElementById('customerPhone');
  const phoneHelpText = document.getElementById('phoneHelpText');
  const phoneErrorMsg = document.getElementById('phoneErrorMsg');

  function cleanAndNormalizePhone(raw) {
    if (!raw) return '';
    let str = raw.toString().trim();
    if (str.startsWith('+94')) {
      str = '0' + str.substring(3);
    } else if (str.startsWith('94') && str.replace(/\D/g, '').length === 11) {
      str = '0' + str.replace(/\D/g, '').substring(2);
    }
    let digits = str.replace(/\D/g, '');
    if (digits.length === 9) {
      digits = '0' + digits;
    }
    return digits;
  }

  function validatePhoneNumber(showError = false) {
    const raw = phoneInput.value.trim();
    const normalized = cleanAndNormalizePhone(raw);
    if (normalized.length === 10) {
      phoneInput.value = normalized;
      phoneErrorMsg.classList.add('d-none');
      if (phoneHelpText) phoneHelpText.classList.remove('d-none');
      phoneInput.classList.remove('is-invalid');
      return true;
    } else {
      if (showError) {
        phoneErrorMsg.classList.remove('d-none');
        if (phoneHelpText) phoneHelpText.classList.add('d-none');
        phoneInput.classList.add('is-invalid');
      }
      return false;
    }
  }

  phoneInput.addEventListener('input', (e) => {
    const val = e.target.value;
    const norm = cleanAndNormalizePhone(val);
    if (norm.length === 10) {
      phoneInput.value = norm;
      validatePhoneNumber(false);
    } else if (!phoneErrorMsg.classList.contains('d-none')) {
      validatePhoneNumber(true);
    }
  });

  phoneInput.addEventListener('blur', () => {
    if (phoneInput.value.trim().length > 0) {
      const normalized = cleanAndNormalizePhone(phoneInput.value);
      if (normalized.length === 10) {
        phoneInput.value = normalized;
        validatePhoneNumber(false);
      } else {
        validatePhoneNumber(true);
      }
    }
  });

  // Helper to optimize high-res phone camera photos (e.g. 10MB-20MB JPEGs from phones)
  // Keeps maximum detail for A4 printing (up to 3200px dimension, high-quality 0.92 JPEG)
  async function optimizeImageIfLarge(file) {
    if (!file.type || !file.type.startsWith('image/') || file.type === 'image/svg+xml') {
      return file; // Documents, PDFs, and SVGs are untouched
    }
    // Only compress if image is larger than 3MB
    if (file.size <= 3 * 1024 * 1024) {
      return file;
    }

    return new Promise((resolve) => {
      const img = new Image();
      const reader = new FileReader();

      reader.onload = (e) => {
        img.onload = () => {
          try {
            let width = img.width;
            let height = img.height;
            const maxDim = 3200; // 3200px provides crisp 300+ DPI on A4 prints

            if (width > maxDim || height > maxDim) {
              if (width > height) {
                height = Math.round((height * maxDim) / width);
                width = maxDim;
              } else {
                width = Math.round((width * maxDim) / height);
                height = maxDim;
              }
            }

            const canvas = document.createElement('canvas');
            canvas.width = width;
            canvas.height = height;
            const ctx = canvas.getContext('2d');
            ctx.drawImage(img, 0, 0, width, height);

            canvas.toBlob((blob) => {
              if (blob && blob.size < file.size) {
                const optimizedFile = new File([blob], file.name, {
                  type: 'image/jpeg',
                  lastModified: Date.now(),
                });
                resolve(optimizedFile);
              } else {
                resolve(file);
              }
            }, 'image/jpeg', 0.92);
          } catch (err) {
            resolve(file);
          }
        };
        img.onerror = () => resolve(file);
        img.src = e.target.result;
      };
      reader.onerror = () => resolve(file);
      reader.readAsDataURL(file);
    });
  }

  // Upload a single large file via Google Drive Resumable Session (direct PUT or chunk proxy)
  async function uploadFileToDrive(file, tokenHint, onProgress) {
    // 1. Initialize session with Google Drive via server
    const initRes = await fetch('/api/quick-print/init-direct-upload', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        filename: file.name,
        mimeType: file.type || 'application/octet-stream',
        fileSize: file.size,
        tokenHint,
      }),
    });

    const initData = await initRes.json();
    if (!initData.success || !initData.sessionUrl) {
      throw new Error(initData.message || 'Cloud upload initialization failed.');
    }

    const sessionUrl = initData.sessionUrl;

    // 2. Try direct PUT first (fastest, bypasses Vercel completely)
    try {
      const driveFile = await new Promise((resolve, reject) => {
        const xhr = new XMLHttpRequest();
        xhr.open('PUT', sessionUrl, true);
        xhr.setRequestHeader('Content-Type', file.type || 'application/octet-stream');

        xhr.upload.onprogress = (e) => {
          if (e.lengthComputable && onProgress) {
            onProgress(e.loaded, e.total);
          }
        };

        xhr.onload = function() {
          if (xhr.status === 200 || xhr.status === 201) {
            try {
              const resJson = JSON.parse(xhr.responseText);
              resolve(resJson);
            } catch (e) {
              reject(new Error('Invalid response from Google Drive.'));
            }
          } else {
            reject(new Error(`Drive upload status ${xhr.status}: ${xhr.responseText}`));
          }
        };

        xhr.onerror = function() {
          reject(new Error('Direct upload network/CORS error.'));
        };

        xhr.send(file);
      });

      return {
        driveFileId: driveFile.id,
        originalName: file.name,
        fileSize: file.size,
        mimeType: file.type,
      };
    } catch (directErr) {
      console.warn('Direct PUT failed, falling back to 3MB chunk proxy:', directErr.message);

      // 3. Fallback: Upload in 3MB chunks via /api/quick-print/upload-chunk
      const chunkSize = 3 * 1024 * 1024; // 3MB chunks (well under Vercel's 4.5MB limit)
      const totalSize = file.size;
      let start = 0;
      let completedDriveFile = null;

      while (start < totalSize) {
        const end = Math.min(start + chunkSize, totalSize);
        const chunkBlob = file.slice(start, end);
        const contentRange = `bytes ${start}-${end - 1}/${totalSize}`;

        const chunkRes = await fetch('/api/quick-print/upload-chunk', {
          method: 'PUT',
          headers: {
            'x-session-url': sessionUrl,
            'content-range': contentRange,
            'content-type': file.type || 'application/octet-stream',
          },
          body: chunkBlob,
        });

        const chunkData = await chunkRes.json();
        if (!chunkData.success) {
          throw new Error('Chunk upload failed: ' + (chunkData.message || 'Unknown error'));
        }

        if (chunkData.status === 200 && chunkData.file) {
          completedDriveFile = chunkData.file;
        }

        start = end;
        if (onProgress) {
          onProgress(start, totalSize);
        }
      }

      if (!completedDriveFile || !completedDriveFile.id) {
        throw new Error('File upload completed but Google Drive did not return file ID.');
      }

      return {
        driveFileId: completedDriveFile.id,
        originalName: file.name,
        fileSize: file.size,
        mimeType: file.type,
      };
    }
  }

  // Form submission
  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    if (selectedFiles.length === 0) {
      alert('කරුණාකර Print කරන්න ඕන Photo එකක් හෝ File එකක් Select කරන්න.');
      return;
    }

    const name = document.getElementById('customerName').value.trim();
    if (!name) {
      alert('කරුණාකර ඔයාගේ Name එක ඇතුළත් කරන්න.');
      document.getElementById('customerName').focus();
      return;
    }

    if (!validatePhoneNumber(true)) {
      phoneInput.focus();
      return;
    }

    const phone = cleanAndNormalizePhone(phoneInput.value);
    phoneInput.value = phone;

    submitBtn.disabled = true;
    submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Process කරනවා...';
    uploadProgressContainer.classList.remove('d-none');
    uploadProgressBar.style.width = '0%';
    uploadPercent.textContent = '0%';

    try {
      // 1. Optimize oversized phone photos first
      uploadStatusText.textContent = 'Files පරීක්ෂා කරනවා...';
      const processedFiles = [];
      for (let i = 0; i < selectedFiles.length; i++) {
        const f = selectedFiles[i];
        if (f.type && f.type.startsWith('image/') && f.size > 3 * 1024 * 1024) {
          uploadStatusText.textContent = `Photo ${i + 1} Print Quality එකට Optimize කරනවා...`;
          const optimized = await optimizeImageIfLarge(f);
          optimized.selectedPaperSize = f.selectedPaperSize || 'A4';
          optimized.selectedColorMode = f.selectedColorMode || 'BW';
          optimized.selectedCopies = parseInt(f.selectedCopies, 10) || 1;
          processedFiles.push(optimized);
        } else {
          f.selectedPaperSize = f.selectedPaperSize || 'A4';
          f.selectedColorMode = f.selectedColorMode || 'BW';
          f.selectedCopies = parseInt(f.selectedCopies, 10) || 1;
          processedFiles.push(f);
        }
      }

      const filePaperSizes = processedFiles.map(f => f.selectedPaperSize || 'A4');
      const fileColorModes = processedFiles.map(f => f.selectedColorMode || 'BW');
      const fileCopies = processedFiles.map(f => parseInt(f.selectedCopies, 10) || 1);

      const uniqueSizes = [...new Set(filePaperSizes.filter(Boolean))];
      const selectedPaperSize = uniqueSizes.length > 1 ? `Mixed (${uniqueSizes.join(', ')})` : (uniqueSizes[0] || 'A4');

      const uniqueModes = [...new Set(fileColorModes.filter(Boolean))];
      const colorMode = uniqueModes.length > 1 ? 'MIXED' : (uniqueModes[0] || 'BW');

      const copies = String(fileCopies.reduce((sum, c) => sum + c, 0) || 1);

      // Check if total upload is large (> 3.5 MB, which exceeds Vercel 4.5MB payload limit)
      const totalSize = processedFiles.reduce((acc, f) => acc + f.size, 0);
      const hasLargeFile = processedFiles.some(f => f.size > 3.5 * 1024 * 1024);

      if (totalSize > 3.5 * 1024 * 1024 || hasLargeFile) {
        // USE DIRECT CLOUD RESUMABLE UPLOAD (BYPASSES VERCEL 4.5MB LIMIT COMPLETELY)
        uploadStatusText.textContent = 'Cloud Drive එකට කෙලින්ම Upload වෙනවා...';
        const driveFiles = [];

        for (let i = 0; i < processedFiles.length; i++) {
          const file = processedFiles[i];
          const mbSize = (file.size / (1024 * 1024)).toFixed(1);
          uploadStatusText.textContent = `File ${i + 1}/${processedFiles.length} Upload වෙනවා (${mbSize} MB)...`;
          
          const uploadedMeta = await uploadFileToDrive(file, name.substring(0, 10), (loaded, total) => {
            const filePercent = Math.round((loaded / total) * 100);
            uploadProgressBar.style.width = filePercent + '%';
            uploadPercent.textContent = filePercent + '%';
          });
          driveFiles.push(uploadedMeta);
        }

        uploadStatusText.textContent = 'Order එක Counter එකට Save කරනවා...';
        const completeRes = await fetch('/api/quick-print/complete-direct-upload', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            customerName: name,
            customerPhone: phone,
            customerMessage: document.getElementById('customerMessage').value,
            colorMode,
            copies,
            paperSize: selectedPaperSize,
            orderType: currentOrderType,
            frameType: document.getElementById('frameTypeSelect') ? document.getElementById('frameTypeSelect').value : '',
            frameFinish: document.getElementById('frameFinishSelect') ? document.getElementById('frameFinishSelect').value : '',
            files: driveFiles.map((df, idx) => ({
              ...df,
              paperSize: processedFiles[idx]?.selectedPaperSize || selectedPaperSize || 'A4',
              colorMode: processedFiles[idx]?.selectedColorMode || colorMode || 'BW',
              copies: parseInt(processedFiles[idx]?.selectedCopies, 10) || parseInt(copies, 10) || 1,
            })),
            filePaperSizes,
            fileColorModes,
            fileCopies,
          }),
        });

        const completeData = await completeRes.json();
        submitBtn.disabled = false;
        submitBtn.innerHTML = (currentOrderType === 'PHOTO_FRAME')
          ? '<i class="bi bi-send-fill me-2"></i> Photo Frames Studio එකට Send කරන්න 🚀'
          : '<i class="bi bi-send-fill me-2"></i> Quick Print Counter එකට Send කරන්න 🚀';

        if (completeRes.ok && completeData.success) {
          showSuccessScreen(completeData.data);
        } else {
          alert(completeData.message || 'Upload එක අසාර්ථක විය. කරුණාකර නැවත උත්සාහ කරන්න.');
          uploadProgressContainer.classList.add('d-none');
        }
        return;
      }

      // Standard upload for small files under 3.5 MB
      uploadStatusText.textContent = 'Files Counter එකට Send වෙනවා...';

      const formData = new FormData();
      formData.append('customerName', name);
      formData.append('customerPhone', phone);
      formData.append('customerMessage', document.getElementById('customerMessage').value);
      formData.append('colorMode', colorMode);
      formData.append('copies', copies);
      formData.append('paperSize', selectedPaperSize);
      formData.append('orderType', currentOrderType);
      if (document.getElementById('frameTypeSelect')) {
        formData.append('frameType', document.getElementById('frameTypeSelect').value);
      }
      if (document.getElementById('frameFinishSelect')) {
        formData.append('frameFinish', document.getElementById('frameFinishSelect').value);
      }
      formData.append('filePaperSizes', JSON.stringify(filePaperSizes));
      formData.append('fileColorModes', JSON.stringify(fileColorModes));
      formData.append('fileCopies', JSON.stringify(fileCopies));

      processedFiles.forEach(file => {
        formData.append('files', file);
      });

      const xhr = new XMLHttpRequest();
      xhr.open('POST', '/api/quick-print/upload', true);

      xhr.upload.onprogress = (event) => {
        if (event.lengthComputable) {
          const percentComplete = Math.round((event.loaded / event.total) * 100);
          uploadProgressBar.style.width = percentComplete + '%';
          uploadPercent.textContent = percentComplete + '%';
          if (percentComplete >= 100) {
            uploadStatusText.textContent = 'Counter Server එක Process කරනවා... කරුණාකර රැඳී සිටින්න.';
          }
        }
      };

      xhr.onload = function () {
        submitBtn.disabled = false;
        submitBtn.innerHTML = (currentOrderType === 'PHOTO_FRAME')
          ? '<i class="bi bi-send-fill me-2"></i> Photo Frames Studio එකට Send කරන්න 🚀'
          : '<i class="bi bi-send-fill me-2"></i> Quick Print Counter එකට Send කරන්න 🚀';
        
        try {
          const response = JSON.parse(xhr.responseText);
          if (xhr.status === 201 && response.success) {
            showSuccessScreen(response.data);
          } else {
            alert(response.message || 'Upload එක අසාර්ථක විය. කරුණාකර නැවත උත්සාහ කරන්න.');
            uploadProgressContainer.classList.add('d-none');
          }
        } catch (err) {
          alert('Server response එකේ ගැටලුවක් ඇත. කරුණාකර නැවත උත්සාහ කරන්න.');
          uploadProgressContainer.classList.add('d-none');
        }
      };

      xhr.onerror = function () {
        submitBtn.disabled = false;
        submitBtn.innerHTML = (currentOrderType === 'PHOTO_FRAME')
          ? '<i class="bi bi-send-fill me-2"></i> Photo Frames Studio එකට Send කරන්න 🚀'
          : '<i class="bi bi-send-fill me-2"></i> Quick Print Counter එකට Send කරන්න 🚀';
        uploadProgressContainer.classList.add('d-none');
        alert('Network error එකක් ආවා. කරුණාකර ඔබගේ Connection එක පරීක්ෂා කර නැවත උත්සාහ කරන්න.');
      };

      xhr.send(formData);
    } catch (submitErr) {
      console.error('Submit error:', submitErr);
      submitBtn.disabled = false;
      submitBtn.innerHTML = (currentOrderType === 'PHOTO_FRAME')
        ? '<i class="bi bi-send-fill me-2"></i> Photo Frames Studio එකට Send කරන්න 🚀'
        : '<i class="bi bi-send-fill me-2"></i> Quick Print Counter එකට Send කරන්න 🚀';
      uploadProgressContainer.classList.add('d-none');
      alert('Upload එකේ ගැටලුවක් විය: ' + submitErr.message);
    }
  });

  function showSuccessScreen(data) {
    uploadView.classList.add('d-none');
    successView.classList.remove('d-none');

    currentJobId = data.jobId;
    document.getElementById('ticketTokenNumber').textContent = data.tokenNumber;
    document.getElementById('ticketCustomerName').textContent = data.customerName;
    document.getElementById('ticketFilesCount').textContent = `${data.filesCount} file(s)`;

    const isPhotoOrder = (data.orderType === 'PHOTO_FRAME' || currentOrderType === 'PHOTO_FRAME');
    const badgeEl = document.getElementById('ticketTypeBadge');
    const headingEl = document.getElementById('ticketSuccessHeading');
    const msgEl = document.getElementById('ticketSuccessMsg');

    if (badgeEl) {
      if (isPhotoOrder) {
        badgeEl.className = 'badge bg-warning text-dark border border-warning px-3 py-1 fs-6 rounded-pill';
        badgeEl.innerHTML = '<i class="bi bi-image-fill me-1"></i> 🖼️ Photo Frames Studio Order';
      } else {
        badgeEl.className = 'badge bg-primary text-white border px-3 py-1 fs-6 rounded-pill';
        badgeEl.innerHTML = '<i class="bi bi-printer-fill me-1"></i> 📄 Quick Print Document Order';
      }
    }

    if (headingEl) {
      headingEl.textContent = isPhotoOrder ? 'Photo Frame Order ලැබුණා! 🎉' : 'Files Counter එකට ලැබුණා! 🎉';
    }

    if (msgEl) {
      msgEl.innerHTML = isPhotoOrder
        ? `ඔයාගේ Photo Frame Order එක අපේ <strong>Photo Frames Studio</strong> වෙත ලැබුණා. කරුණාකර මේ <strong>Token Number එක (${data.tokenNumber})</strong> Counter එකට පෙන්වන්න.`
        : `ඔයාගේ Files අපේ Print Counter එකට ලැබුණා. කරුණාකර මේ <strong>Token Number එක (${data.tokenNumber})</strong> Counter එකේ ඉන්න කෙනාට කියලා ලබාගන්න.`;
    }

    if (document.getElementById('ticketSpecs')) {
      let modeLabel = 'B&W';
      if (data.colorMode === 'COLOR') modeLabel = 'Color';
      else if (data.colorMode === 'MIXED') modeLabel = 'Mixed Color/B&W';
      const copiesLabel = (data.copies && data.copies > 1 ? `${data.copies} copies` : '1 copy');
      document.getElementById('ticketSpecs').textContent = `${data.paperSize || 'A4'} • ${modeLabel} • ${copiesLabel}`;
    }
    if (document.getElementById('ticketTime')) {
      document.getElementById('ticketTime').textContent = new Date().toLocaleTimeString('en-LK', {
        timeZone: 'Asia/Colombo',
        hour: '2-digit',
        minute: '2-digit',
        hour12: true,
      });
    }

    try {
      localStorage.setItem('nirmana_customer_name', document.getElementById('customerName').value);
      localStorage.setItem('nirmana_customer_phone', document.getElementById('customerPhone').value);
    } catch(e) {}

    pollJobStatus(currentJobId);
  }

  function updateStatusUI(status) {
    const sReceived = document.getElementById('stepReceived');
    const sCompleted = document.getElementById('stepCompleted');
    const statusText = document.getElementById('ticketCurrentStatus');

    if (status === 'PENDING') {
      sReceived.classList.add('active');
      sReceived.classList.remove('completed');
      sCompleted.classList.remove('active', 'completed');
      statusText.innerHTML = '<span class="text-serene-primary"><i class="bi bi-clock"></i> RECEIVED &bull; Counter එකෙන් තවම Print කරමින් පවතී</span>';
    } else if (status === 'COMPLETED') {
      sReceived.classList.remove('active');
      sReceived.classList.add('completed');
      sCompleted.classList.add('active', 'completed');
      statusText.innerHTML = '<span class="text-success fw-bold"><i class="bi bi-check-circle-fill"></i> PRINT EKA READY! කරුණාකර Counter එකෙන් ලබාගන්න.</span>';
    }
  }

  function pollJobStatus(jobId) {
    if (statusPollInterval) clearInterval(statusPollInterval);

    statusPollInterval = setInterval(async () => {
      try {
        const res = await fetch(`/api/quick-print/status/${jobId}`);
        const data = await res.json();
        if (data.success && data.data) {
          updateStatusUI(data.data.status);
          if (data.data.status === 'COMPLETED') {
            clearInterval(statusPollInterval);
          }
        }
      } catch (err) {
        console.warn('Status poll error:', err);
      }
    }, 3000);
  }

  newUploadBtn.addEventListener('click', () => {
    if (statusPollInterval) clearInterval(statusPollInterval);
    selectedFiles = [];
    renderFileList();
    form.reset();
    uploadProgressContainer.classList.add('d-none');
    successView.classList.add('d-none');
    uploadView.classList.remove('d-none');

    try {
      const savedName = localStorage.getItem('nirmana_customer_name');
      const savedPhone = localStorage.getItem('nirmana_customer_phone');
      if (savedName) document.getElementById('customerName').value = savedName;
      if (savedPhone) document.getElementById('customerPhone').value = savedPhone;
    } catch(e) {}
  });

  window.addEventListener('DOMContentLoaded', () => {
    try {
      const savedName = localStorage.getItem('nirmana_customer_name');
      const savedPhone = localStorage.getItem('nirmana_customer_phone');
      if (savedName) document.getElementById('customerName').value = savedName;
      if (savedPhone) document.getElementById('customerPhone').value = savedPhone;
    } catch(e) {}
  });
</script>

  <!-- Public Track Modal -->
  <div class="modal fade" id="publicTrackModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content shadow-lg border-0 rounded-4">
        <div class="modal-header bg-primary text-white border-0">
          <h5 class="modal-title fs-6 fw-bold"><i class="bi bi-search me-2"></i> Track Your Print Job or Order</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body p-4">
          <p class="text-muted small mb-3">
            Enter your <strong>Tracking Code / Order #</strong> (e.g. <code>ORD-2026-0002</code>), <strong>Token Number</strong> (e.g. <code>QP-1001</code>), or your <strong>WhatsApp Number</strong>.
          </p>
          <div class="input-group mb-3">
            <span class="input-group-text bg-white"><i class="bi bi-upc-scan"></i></span>
            <input type="text" id="trackCodeInput" class="form-control" placeholder="e.g. ORD-2026-0002 or QP-1001 or 077xxxxxxx" onkeydown="if(event.key==='Enter') lookupPublicTrack()">
            <button class="btn btn-primary fw-semibold" type="button" id="btnTrackLookup" onclick="lookupPublicTrack()">Track</button>
          </div>
          
          <div id="trackResultContainer" style="display: none;"></div>
        </div>
      </div>
    </div>
  </div>

  <script>
  async function lookupPublicTrack() {
    const input = document.getElementById('trackCodeInput');
    const container = document.getElementById('trackResultContainer');
    const code = (input.value || '').trim();
    if (!code) {
      alert('Please enter a tracking code, token, or phone number.');
      return;
    }

    const btn = document.getElementById('btnTrackLookup');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';
    container.style.display = 'block';
    container.innerHTML = '<div class="text-center py-3 text-muted small"><span class="spinner-border spinner-border-sm me-1"></span> Looking up order details...</div>';

    try {
      const res = await fetch('/api/orders/track/' + encodeURIComponent(code));
      const json = await res.json();
      btn.disabled = false;
      btn.textContent = 'Track';

      if (!json.success) {
        container.innerHTML = '<div class="alert alert-warning small mb-0"><i class="bi bi-exclamation-triangle me-1"></i> ' + (json.message || 'No matching order found.') + '</div>';
        return;
      }

      const d = json.data;
      if (d.type === 'ORDER') {
        const isPaid = (d.balanceAmount || 0) <= 0;
        let statusBadge = '<span class="badge bg-secondary">RECEIVED</span>';
        if (d.status === 'PRINTING') statusBadge = '<span class="badge bg-primary"><i class="bi bi-printer me-1"></i> PRINTING NOW</span>';
        else if (d.status === 'READY') statusBadge = '<span class="badge bg-success"><i class="bi bi-box-seam me-1"></i> READY FOR PICKUP</span>';
        else if (d.status === 'COMPLETED') statusBadge = '<span class="badge bg-success"><i class="bi bi-check2-all me-1"></i> COMPLETED</span>';

        container.innerHTML = `
          <div class="p-3 rounded-3 border bg-light">
            <div class="d-flex justify-content-between align-items-center mb-2">
              <span class="font-monospace fw-bold text-dark fs-6">${d.orderNumber}</span>
              ${statusBadge}
            </div>
            <h6 class="fw-bold text-dark mb-1">${d.jobTitle}</h6>
            <div class="small text-muted mb-2">Quantity: ${d.quantity} units ${d.paperMaterial ? ' · ' + d.paperMaterial : ''}</div>
            
            <div class="p-2 rounded-2 bg-white border small mb-2">
              <div class="d-flex justify-content-between text-muted mb-1">
                <span>Total Price:</span>
                <strong class="text-dark">Rs. ${parseFloat(d.totalAmount).toLocaleString('en-LK', {minimumFractionDigits: 2})}</strong>
              </div>
              <div class="d-flex justify-content-between text-success mb-1">
                <span>Given (Paid):</span>
                <strong>Rs. ${parseFloat(d.advancePaid).toLocaleString('en-LK', {minimumFractionDigits: 2})}</strong>
              </div>
              <hr class="my-1">
              <div class="d-flex justify-content-between fw-bold ${isPaid ? 'text-success' : 'text-danger'}">
                <span>Balance Yet to Give:</span>
                <span>${isPaid ? 'Paid in Full (Rs. 0.00 Due)' : 'Rs. ' + parseFloat(d.balanceAmount).toLocaleString('en-LK', {minimumFractionDigits: 2})}</span>
              </div>
            </div>
            ${d.status === 'READY' ? '<div class="alert alert-success p-2 small mb-0 text-center fw-bold"><i class="bi bi-bell-fill me-1"></i> Your print job is ready! You can pick it up at the shop counter.</div>' : ''}
          </div>
        `;
      } else if (d.type === 'QUICK_PRINT') {
        let statusBadge = '<span class="badge bg-secondary">IN QUEUE</span>';
        if (d.status === 'PRINTING') statusBadge = '<span class="badge bg-primary">PRINTING NOW</span>';
        else if (d.status === 'COMPLETED') statusBadge = '<span class="badge bg-success">READY / COMPLETED</span>';

        container.innerHTML = `
          <div class="p-3 rounded-3 border bg-light">
            <div class="d-flex justify-content-between align-items-center mb-2">
              <span class="font-monospace fw-bold text-dark fs-5">Token #${d.tokenNumber}</span>
              ${statusBadge}
            </div>
            <div class="small text-dark mb-1">Customer: <strong>${d.customerName}</strong></div>
            <div class="small text-muted mb-2">Files uploaded: ${d.fileCount} file(s)</div>
            <div class="alert alert-info p-2 small mb-0 text-center">Show Token #${d.tokenNumber} at the print shop counter.</div>
          </div>
        `;
      }
    } catch (err) {
      btn.disabled = false;
      btn.textContent = 'Track';
      container.innerHTML = '<div class="alert alert-danger small mb-0">Failed to lookup tracking code: ' + err.message + '</div>';
    }
  }
  </script>
</body>
</html>
