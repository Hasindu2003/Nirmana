                <option value="BW" ${curColor === 'BW' ? 'selected' : ''}>B&W</option>
                <option value="COLOR" ${curColor === 'COLOR' ? 'selected' : ''}>Color</option>
              </select>
            </div>

            <!-- Copies -->
            <div class="d-inline-flex align-items-center gap-1">
              <span class="text-muted" style="font-size: 0.72rem; font-weight: 600;">Copies:</span>
