<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title><%= title || 'Express Print Counter · Nirmana Printing' %></title>

  <!-- Google Fonts: Plus Jakarta Sans, Manrope & Noto Sans Sinhala -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@600;700;800&family=Noto+Sans+Sinhala:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

  <!-- Bootstrap 5.3 & Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

  <!-- Serene Theme & Custom Upload Styles -->
  <link rel="stylesheet" href="/css/serene-theme.css">

  <!-- Favicons: Crisp Modern SVG with PNG Fallback -->
  <link rel="icon" type="image/svg+xml" href="/images/favicon.svg">
  <link rel="alternate icon" type="image/png" href="/images/favicon.png">
  <link rel="apple-touch-icon" href="/images/favicon.png">

  <style>
    body {
      font-family: 'Plus Jakarta Sans', 'Noto Sans Sinhala', -apple-system, BlinkMacSystemFont, sans-serif;
      background: linear-gradient(180deg, #f1f5f9 0%, #e2e8f0 100%);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      padding-bottom: 2rem;
    }
    .mobile-upload-container {
      max-width: 560px;
      margin: 0 auto;
      width: 100%;
      padding: 1rem;
    }
    .kiosk-header {
      text-align: center;
      padding: 1.25rem 0 1rem;
    }
    .kiosk-logo {
      height: 48px;
      width: auto;
      object-fit: contain;
      margin-bottom: 0.75rem;
    }
    .kiosk-card {
      background: #ffffff;
      border-radius: 18px;
      border: 1px solid #e2e8f0;
      box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.08), 0 8px 10px -6px rgba(15, 23, 42, 0.03);
      padding: 1.5rem;
    }
    .dropzone-box {
      border: 2px dashed #94a3b8;
      background: #f8fafc;
      border-radius: 14px;
      padding: 1.5rem 1rem;
      text-align: center;
      cursor: pointer;
      transition: all 0.2s ease-in-out;
    }
    .dropzone-box:hover, .dropzone-box.dragover {
      border-color: #2d6a68;
      background: #e6f0ef;
    }
    .dropzone-icon {
      font-size: 2.2rem;
      color: #2d6a68;
      margin-bottom: 0.35rem;
    }
    .file-preview-item {
      display: flex;
      align-items: flex-start;
      padding: 0.65rem 0.75rem;
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 10px;
      margin-bottom: 0.5rem;
      gap: 0.75rem;
    }
    .file-preview-thumb {
      width: 44px;
      height: 44px;
      border-radius: 6px;
      object-fit: cover;
      background: #e2e8f0;
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.25rem;
      color: #64748b;
    }
    .file-preview-info {
      flex-grow: 1;
      min-width: 0;
    }
    .file-preview-name {
      font-weight: 600;
      font-size: 0.88rem;
      color: #1e293b;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .file-preview-size {
      font-size: 0.75rem;
      color: #64748b;
    }
    .btn-remove-file {
      border: none;
      background: transparent;
      color: #dc2626;
      padding: 4px 8px;
      border-radius: 6px;
      cursor: pointer;
      margin-top: 2px;
    }
    .btn-remove-file:hover {
      background: #fee2e2;
    }
    .pill-radio-group {
      display: flex;
      gap: 0.5rem;
    }
    .pill-radio-group label {
      flex: 1;
      text-align: center;
      padding: 0.5rem 0.75rem;
      border: 1px solid #cbd5e1;
      background: #f8fafc;
      border-radius: 8px;
      font-size: 0.85rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.15s ease;
      margin-bottom: 0;
    }
    .pill-radio-group input[type="radio"]:checked + label {
      border-color: #2d6a68;
      background: #2d6a68;
      color: #ffffff;
      box-shadow: 0 2px 6px rgba(45, 106, 104, 0.25);
    }
    .pill-radio-group input[type="radio"]:checked + label .text-muted {
      color: rgba(255, 255, 255, 0.85) !important;
    }
    .pill-radio-group.grid-sizes {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(65px, 1fr));
      gap: 0.5rem;
    }
    .pill-radio-group input[type="radio"] {
      display: none;
    }
    .token-display-badge {
      display: inline-block;
      font-family: 'Manrope', sans-serif;
      font-size: 2.2rem;
      font-weight: 800;
      color: #2d6a68;
      background: #e6f0ef;
      border: 2px dashed #2d6a68;
      border-radius: 12px;
      padding: 0.4rem 1.5rem;
      letter-spacing: 0.05em;
    }
    .status-stepper {
      display: flex;
      justify-content: space-between;
      position: relative;
      margin: 1.5rem 0;
    }
    .status-stepper::before {
      content: '';
      position: absolute;
      top: 18px;
      left: 20%;
      right: 20%;
      height: 3px;
      background: #e2e8f0;
      z-index: 1;
    }
    .step-node {
      position: relative;
      z-index: 2;
      text-align: center;
      width: 50%;
    }
    .step-circle {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: #e2e8f0;
      color: #64748b;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 0.4rem;
      font-weight: 700;
      font-size: 0.85rem;
      transition: all 0.3s ease;
    }
    .step-node.active .step-circle {
      background: #2d6a68;
      color: #ffffff;
      box-shadow: 0 0 0 4px #e6f0ef;
    }
    .step-node.completed .step-circle {
      background: #16a34a;
      color: #ffffff;
    }
    .step-label {
      font-size: 0.8rem;
      font-weight: 600;
      color: #64748b;
    }
    .step-node.active .step-label {
      color: #2d6a68;
      font-weight: 700;
    }
    .step-node.completed .step-label {
      color: #16a34a;
      font-weight: 700;
    }
  </style>
</head>
<body>

<div class="mobile-upload-container">
  <!-- Brand Header: Natural Singlish (Sinhala + English loanwords) -->
  <header class="kiosk-header">
    <img src="/images/logo.png" alt="Nirmana Printing" class="kiosk-logo">
    <h1 class="fs-4 fw-bold mb-1 text-dark">Nirmana Express Print Counter</h1>
    <p class="text-muted small mb-0">
      WhatsApp වලට දාන්න ඕනෙ නෑ! ඔයාගේ Photos හෝ Documents මෙතනින් කෙලින්ම අපේ Counter Printer එකට Send කරන්න.
    </p>
  </header>
  <div class="d-flex justify-content-center mb-3">
    <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1 shadow-xs fw-semibold" data-bs-toggle="modal" data-bs-target="#publicTrackModal">
      <i class="bi bi-search me-1"></i> Track Order or Token Status
    </button>
  </div>

  <!-- FORM VIEW -->
  <div id="uploadView" class="kiosk-card">
    <form id="printUploadForm" enctype="multipart/form-data">
      
      <!-- 1. Upfront Order Type Division (Photo Frame vs Document/Other Print) -->
      <div class="mb-4">
        <label class="form-label fw-bold small text-muted text-uppercase mb-2">
          1. ඇණවුම් වර්ගය තෝරන්න / Select Order Type <span class="text-danger">*</span>
        </label>

        <input type="hidden" name="orderType" id="orderTypeHiddenInput" value="PHOTO_FRAME">

        <div class="row g-2">
          <!-- Option A: Photo Frame Order -->
          <div class="col-6">
            <div class="card h-100 p-2 order-type-kiosk-btn active" id="btnTypePhoto" onclick="selectCustomerOrderType('PHOTO_FRAME')" style="cursor: pointer; border: 2px solid #d97706; background: #fffbeb; border-radius: 12px; transition: all 0.2s ease;">
              <div class="text-center py-2">
                <div class="p-2 rounded-circle bg-warning text-dark d-inline-flex align-items-center justify-content-center mb-1" style="width: 44px; height: 44px;">
                  <i class="bi bi-image-fill fs-5"></i>
                </div>
                <div class="fw-bold text-dark fs-6 mt-1">🖼️ Photo Frame</div>
                <div class="text-muted small mt-1" style="font-size: 0.73rem; line-height: 1.25;">
                  ඡායාරූප හෝ ෆොටෝ ෆ්‍රේම්
                </div>
                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle mt-2" style="font-size: 0.65rem;">
                  Photo Frames Studio
                </span>
              </div>
            </div>
          </div>

          <!-- Option B: General Document Print -->
          <div class="col-6">
            <div class="card h-100 p-2 order-type-kiosk-btn" id="btnTypeGeneral" onclick="selectCustomerOrderType('GENERAL_PRINT')" style="cursor: pointer; border: 2px solid #cbd5e1; background: #ffffff; border-radius: 12px; transition: all 0.2s ease;">
              <div class="text-center py-2">
                <div class="p-2 rounded-circle bg-light text-primary d-inline-flex align-items-center justify-content-center mb-1" style="width: 44px; height: 44px;">
                  <i class="bi bi-printer-fill fs-5"></i>
                </div>
                <div class="fw-bold text-dark fs-6 mt-1">📄 General Print</div>
                <div class="text-muted small mt-1" style="font-size: 0.73rem; line-height: 1.25;">
                  සාමාන්‍ය මුද්‍රණ / Documents
                </div>
                <span class="badge bg-light text-muted border mt-2" style="font-size: 0.65rem;">
                  Quick Print Counter
                </span>
              </div>
            </div>
          </div>
        </div>

        <!-- Dynamic Notice Banners -->
        <div id="photoOrderBanner" class="alert alert-warning border border-warning-subtle p-2 mt-2 mb-0 rounded-3 d-flex align-items-center gap-2" style="font-size: 0.78rem;">
          <i class="bi bi-image-fill text-warning flex-shrink-0 fs-6"></i>
          <div>
            <strong>Photo Frames Studio ඇණවුමක්:</strong> ඔයාගේ Photos උසස්ම HD Quality එකෙන් Wooden Glass Frames හෝ Canvas ආකාරයට Studio එකෙන් සකස් කෙරේ.
          </div>
        </div>
        <div id="generalOrderBanner" class="alert alert-primary border border-primary-subtle p-2 mt-2 mb-0 rounded-3 d-none align-items-center gap-2" style="font-size: 0.78rem;">
          <i class="bi bi-printer-fill text-primary flex-shrink-0 fs-6"></i>
          <div>
            <strong>සාමාන්‍ය මුද්‍රණ ඇණවුමක්:</strong> Documents, Assignments, Photocopies, සහ Booklets ඉක්මනින් Counter එකෙන් Print කරගත හැක.
          </div>
        </div>
      </div>

      <!-- Customer Name -->
      <div class="mb-3">
        <label for="customerName" class="form-label fw-bold small text-muted text-uppercase mb-1">
          2. ඔයාගේ Name එක <span class="text-danger">*</span>
        </label>
        <div class="input-group">
          <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-person"></i></span>
          <input type="text" class="form-control border-start-0" id="customerName" name="customerName" 
                 placeholder="Name එක මෙතන Type කරන්න (Eg: Kamal Perera)" required autocomplete="name">
        </div>
      </div>

      <!-- Customer Phone -->
      <div class="mb-3">
        <label for="customerPhone" class="form-label fw-bold small text-muted text-uppercase mb-1">
          3. WhatsApp / Phone Number එක <span class="text-danger">*</span>
        </label>
        <div class="input-group">
          <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-whatsapp text-success"></i></span>
          <input type="tel" class="form-control border-start-0" id="customerPhone" name="customerPhone" 
                 placeholder="Eg: 0771234567" maxlength="20" inputmode="tel" required autocomplete="tel">
        </div>
        <div id="phoneHelpText" class="form-text small text-muted" style="font-size: 0.74rem;">
          Print out එක Ready වුණාම කතා කරන්න මේ Number එක අවශ්‍ය වේ (Eg: 0771234567).
        </div>
        <div id="phoneErrorMsg" class="text-danger small mt-1 d-none fw-semibold" style="font-size: 0.78rem;">
          <i class="bi bi-exclamation-circle-fill me-1"></i> Phone number එකට ඉලක්කම් 10ක් (හෝ 9ක්) අවශ්‍ය වේ (Eg: 0771234567).
        </div>
      </div>

      <!-- Framing & Photo Options (Shown for Photo Frame Orders) -->
      <div id="photoFrameOptionsCard" class="p-3 mb-3 rounded-3 border" style="background: #fafaf9; border-color: #fde68a !important;">
        <div class="d-flex align-items-center justify-content-between mb-2 pb-1 border-bottom border-warning-subtle">
          <span class="fw-bold text-dark small"><i class="bi bi-magic text-warning me-1"></i> Framing & Photo Preferences</span>
          <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle" style="font-size: 0.68rem;">Studio Options</span>
        </div>
        <div class="row g-2">
          <div class="col-6">
            <label class="form-label small text-muted mb-1" style="font-size: 0.75rem;">Framing Style / රාමු වර්ගය</label>
            <select class="form-select form-select-sm" id="frameTypeSelect" name="frameType">
              <option value="Wooden Glass Frame" selected>Wooden Glass Frame (ලී වීදුරු)</option>
              <option value="Canvas Mount">Canvas Mount (කැන්වස්)</option>
              <option value="Photo Print Only">Photo Print Only (ප්‍රින්ට් පමණි)</option>
              <option value="Acrylic Floating Frame">Acrylic Floating Frame</option>
            </select>
          </div>
          <div class="col-6">
            <label class="form-label small text-muted mb-1" style="font-size: 0.75rem;">Photo Finish / නිමාව</label>
            <select class="form-select form-select-sm" id="frameFinishSelect" name="frameFinish">
              <option value="Glossy Photo" selected>Glossy HD (දිලිසෙන)</option>
              <option value="Matte Finish">Matte Finish (මැට්)</option>
              <option value="Canvas Texture">Canvas Texture</option>
            </select>
          </div>
        </div>
      </div>

      <!-- File Dropzone -->
      <div class="mb-3">
        <label class="form-label fw-bold small text-muted text-uppercase mb-1" id="uploadLabel">
          4. Files / Photos මෙතනට Upload කරන්න <span class="text-danger">*</span>
        </label>
        
        <div class="dropzone-box" id="dropzoneBox">
          <div class="dropzone-icon">
            <i class="bi bi-cloud-arrow-up"></i>
          </div>
          <div class="fw-bold mb-1 text-dark" id="dropzonePrompt">📸 Framing සඳහා Photos මෙතන Tap කරලා Select කරන්න</div>
          <div class="text-muted small mb-2" id="dropzoneSub">Wedding, Portrait, Family හෝ Memories Photos Select කරන්න</div>
          <button type="button" class="btn btn-sm btn-outline-secondary" id="browseBtn">
            <i class="bi bi-images me-1"></i> Files / Photos Select කරන්න
          </button>
          <input type="file" id="fileInput" name="files" multiple accept="image/*,.pdf,.doc,.docx,.xls,.xlsx,.txt" class="d-none">
        </div>

        <!-- Selected Files List -->
        <div id="fileList" class="mt-2"></div>
      </div>

      <!-- 5. Customer Message / Instructions -->
      <div class="mb-4">
        <label for="customerMessage" class="form-label fw-bold small text-muted text-uppercase mb-1">
          5. Instructions / Notes (විශේෂ උපදෙස් - Optional)
        </label>
        <div class="input-group">
          <textarea class="form-control" id="customerMessage" name="customerMessage" rows="2" 
                    placeholder="Eg: Frame එකේ පාට, Border එකක් අවශ්‍යද, කැන්වස් මවුන්ට් එකක්ද..."></textarea>
        </div>
      </div>

      <!-- Progress Bar -->
      <div id="uploadProgressContainer" class="mb-3 d-none">
        <div class="d-flex justify-content-between small text-muted mb-1">
          <span id="uploadStatusText">Files Counter එකට Upload වෙනවා... කරුණාකර රැඳී සිටින්න.</span>
          <span id="uploadPercent">0%</span>
        </div>
        <div class="progress" style="height: 10px; border-radius: 5px;">
          <div id="uploadProgressBar" class="progress-bar progress-bar-striped progress-bar-animated bg-success" 
               role="progressbar" style="width: 0%"></div>
        </div>
      </div>

      <!-- Submit Button -->
      <div class="d-grid">
        <button type="submit" id="submitBtn" class="btn btn-warning text-dark py-3 fs-6 fw-bold shadow-sm">
          <i class="bi bi-send-fill me-2"></i> Photo Frames Studio එකට Send කරන්න 🚀
        </button>
      </div>
    </form>
  </div>

  <!-- SUCCESS / TRACKING VIEW -->
  <div id="successView" class="kiosk-card d-none text-center">
    <div class="mb-3">
      <div class="token-display-badge" id="ticketTokenNumber">QP-000</div>
    </div>
    <div class="mb-2">
      <span class="badge bg-warning text-dark border border-warning px-3 py-1 fs-6 rounded-pill" id="ticketTypeBadge">
        <i class="bi bi-image-fill me-1"></i> 🖼️ Photo Frames Studio Order
      </span>
    </div>
    <h3 class="fs-5 fw-bold text-dark mb-1" id="ticketSuccessHeading">Files Counter එකට ලැබුණා! 🎉</h3>
    <p class="text-muted small mb-3" id="ticketSuccessMsg">
      ඔයාගේ Files අපේ Print Counter එකට ලැබුණා. කරුණාකර මේ <strong>Token Number එක</strong> Counter එකේ ඉන්න කෙනාට කියලා ඔයාගේ Print out එක ලබාගන්න.
    </p>

    <!-- 2-Step Status Stepper -->
    <div class="status-stepper">
      <div class="step-node active" id="stepReceived">
        <div class="step-circle"><i class="bi bi-clock"></i></div>
        <div class="step-label">1. Received (Counter එකට ආවා)</div>
      </div>
      <div class="step-node" id="stepCompleted">
        <div class="step-circle"><i class="bi bi-check2-all"></i></div>
        <div class="step-label">2. Ready (Print එක Ready!)</div>
      </div>
    </div>

    <!-- Live Status Box -->
    <div class="p-3 rounded-3 bg-light border mb-3 text-start small">
      <div class="d-flex justify-content-between mb-1">
        <span class="text-muted">Name:</span>
        <strong id="ticketCustomerName" class="text-dark">-</strong>
      </div>
      <div class="d-flex justify-content-between mb-1">
        <span class="text-muted">Files ගණන:</span>
        <strong id="ticketFilesCount" class="text-dark">-</strong>
      </div>
      <div class="d-flex justify-content-between mb-1">
        <span class="text-muted">Print Size & Specs:</span>
        <strong id="ticketSpecs" class="text-dark">-</strong>
      </div>
      <div class="d-flex justify-content-between mb-1">
        <span class="text-muted">Time (ශ්‍රී ලංකා වේලාව):</span>
        <strong id="ticketTime" class="text-dark">-</strong>
      </div>
      <div class="d-flex justify-content-between mb-1">
        <span class="text-muted">Status:</span>
