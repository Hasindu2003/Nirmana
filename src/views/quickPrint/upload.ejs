      }
      if (btnPhoto) {
        btnPhoto.classList.remove('active');
        btnPhoto.style.borderColor = '#cbd5e1';
        btnPhoto.style.background = '#ffffff';
      }
      if (generalBanner) {
        generalBanner.classList.remove('d-none');
        generalBanner.classList.add('d-flex');
      }
      if (photoBanner) {
        photoBanner.classList.add('d-none');
