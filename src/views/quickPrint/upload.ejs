    document.querySelectorAll('.file-custom-size-input').forEach(input => {
      input.addEventListener('input', (e) => {
        const idx = parseInt(e.target.getAttribute('data-index'), 10);
        const file = selectedFiles[idx];
        if (file) {
          file.selectedPaperSize = e.target.value.trim() || 'Other';
          file.hasCustomPaperSize = true;
        }
      });
