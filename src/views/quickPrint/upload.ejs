      if (photoFrameCard) photoFrameCard.classList.add('d-none');
      if (dropzonePrompt) dropzonePrompt.textContent = 'Photos හෝ Files මෙතන Tap කරලා Select කරන්න';
      if (dropzoneSub) dropzoneSub.textContent = 'Phone Gallery එකෙන් හෝ Camera එකෙන් Select කරන්න පුළුවන්';
      if (submitBtn) {
        submitBtn.className = 'btn btn-serene-primary py-3 fs-6 fw-bold shadow-sm';
        submitBtn.innerHTML = '<i class="bi bi-send-fill me-2"></i> Quick Print Counter එකට Send කරන්න 🚀';
      }

      selectedFiles.forEach(f => {
        if (!f.hasCustomPaperSize) f.selectedPaperSize = 'A4';
        if (!f.hasCustomColorMode) f.selectedColorMode = 'BW';
      });
