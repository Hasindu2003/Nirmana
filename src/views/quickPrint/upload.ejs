<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script>
  let selectedFiles = [];
  let currentJobId = null;
  let statusPollInterval = null;

  const dropzoneBox = document.getElementById('dropzoneBox');
  const fileInput = document.getElementById('fileInput');
  const browseBtn = document.getElementById('browseBtn');
  const fileList = document.getElementById('fileList');
  const form = document.getElementById('printUploadForm');
  const submitBtn = document.getElementById('submitBtn');
  const uploadProgressContainer = document.getElementById('uploadProgressContainer');
  const uploadProgressBar = document.getElementById('uploadProgressBar');
  const uploadPercent = document.getElementById('uploadPercent');
  const uploadStatusText = document.getElementById('uploadStatusText');

  const uploadView = document.getElementById('uploadView');
  const successView = document.getElementById('successView');
  const newUploadBtn = document.getElementById('newUploadBtn');

  function escapeHtml(str) {
    if (!str) return '';
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  // Dropzone click & drag handlers
  dropzoneBox.addEventListener('click', () => fileInput.click());
  browseBtn.addEventListener('click', (e) => {
    e.stopPropagation();
    fileInput.click();
  });

  ['dragenter', 'dragover'].forEach(eventName => {
    dropzoneBox.addEventListener(eventName, (e) => {
      e.preventDefault();
      dropzoneBox.classList.add('dragover');
    });
  });

  ['dragleave', 'drop'].forEach(eventName => {
    dropzoneBox.addEventListener(eventName, (e) => {
      e.preventDefault();
      dropzoneBox.classList.remove('dragover');
    });
  });

  dropzoneBox.addEventListener('drop', (e) => {
    const files = e.dataTransfer.files;
    handleFilesAdded(files);
  });

  fileInput.addEventListener('change', (e) => {
    handleFilesAdded(e.target.files);
  });

  const serverInitialType = '<%= (typeof initialType !== "undefined" && initialType === "GENERAL_PRINT") ? "GENERAL_PRINT" : "PHOTO_FRAME" %>';
  let currentOrderType = serverInitialType;

  function selectCustomerOrderType(type) {
    currentOrderType = type;
    const hiddenInput = document.getElementById('orderTypeHiddenInput');
    if (hiddenInput) hiddenInput.value = type;

    const btnPhoto = document.getElementById('btnTypePhoto');
    const btnGeneral = document.getElementById('btnTypeGeneral');
    const photoBanner = document.getElementById('photoOrderBanner');
    const generalBanner = document.getElementById('generalOrderBanner');
    const photoFrameCard = document.getElementById('photoFrameOptionsCard');
    const submitBtn = document.getElementById('submitBtn');
    const dropzonePrompt = document.getElementById('dropzonePrompt');
    const dropzoneSub = document.getElementById('dropzoneSub');

    if (type === 'PHOTO_FRAME') {
      if (btnPhoto) {
        btnPhoto.classList.add('active');
        btnPhoto.style.borderColor = '#d97706';
        btnPhoto.style.background = '#fffbeb';
      }
      if (btnGeneral) {
        btnGeneral.classList.remove('active');
        btnGeneral.style.borderColor = '#cbd5e1';
        btnGeneral.style.background = '#ffffff';
      }
      if (photoBanner) {
        photoBanner.classList.remove('d-none');
        photoBanner.classList.add('d-flex');
      }
      if (generalBanner) {
        generalBanner.classList.add('d-none');
        generalBanner.classList.remove('d-flex');
      }
      if (photoFrameCard) photoFrameCard.classList.remove('d-none');
      if (dropzonePrompt) dropzonePrompt.textContent = '📸 Framing සඳහා Photos මෙතන Tap කරලා Select කරන්න';
