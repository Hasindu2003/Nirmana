  // Initialize selector state on page load
  try {
    selectCustomerOrderType(serverInitialType);
  } catch(initErr) {}

  function handleFilesAdded(files) {
    for (let i = 0; i < files.length; i++) {
      const f = files[i];
      if (!selectedFiles.some(existing => existing.name === f.name && existing.size === f.size)) {
        f.selectedPaperSize = (currentOrderType === 'PHOTO_FRAME') ? 'Frame 8x10' : 'A4';
        f.selectedColorMode = (currentOrderType === 'PHOTO_FRAME') ? 'COLOR' : 'BW';
        f.selectedCopies = 1;
        selectedFiles.push(f);
      }
    }
    renderFileList();
  }

  function formatBytes(bytes) {
    if (bytes === 0) return '0 Bytes';
    const k = 1024;
    const sizes = ['Bytes', 'KB', 'MB', 'GB'];
    const i = Math.floor(Math.log(bytes) / Math.log(k));
    return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + ' ' + sizes[i];
  }

  function renderFileList() {
    fileList.innerHTML = '';
    if (selectedFiles.length === 0) {
      return;
    }

    selectedFiles.forEach((file, index) => {
      const item = document.createElement('div');
      item.className = 'file-preview-item';

      const isImg = file.type && file.type.startsWith('image/');
      let thumbHtml = '';
      if (isImg) {
        const objectUrl = URL.createObjectURL(file);
        thumbHtml = `<img src="${objectUrl}" class="file-preview-thumb" alt="Thumbnail">`;
      } else {
        const icon = (file.type && file.type.includes('pdf')) ? 'bi-filetype-pdf text-danger' : 'bi-file-earmark-text text-serene-primary';
        thumbHtml = `<div class="file-preview-thumb"><i class="bi ${icon}"></i></div>`;
      }

      const curSize = file.selectedPaperSize || 'A4';
      const curColor = file.selectedColorMode || 'BW';
      const curCopies = parseInt(file.selectedCopies, 10) || 1;
      const standardSizes = [
        'A4', 'A3', 'Legal', 'A5',
        'Photo 4x6', 'Photo 6x8', 'Frame 8x10', 'Frame 10x12', 'Frame 12x18',
        'Ceramic Mug Print', 'Custom Keytag Print', 'Vinyl Sticker Print', 'Canvas Print'
      ];
      const isCustom = !standardSizes.includes(curSize);

      item.innerHTML = `
        ${thumbHtml}
        <div class="file-preview-info">
          <div class="file-preview-name" title="${escapeHtml(file.name)}">${escapeHtml(file.name)}</div>
          <div class="file-preview-size">${formatBytes(file.size)}</div>
          
          <div class="d-flex align-items-center flex-wrap gap-2 mt-2 pt-1 border-top border-light-subtle">
            <!-- Print Material / Size -->
            <div class="d-inline-flex align-items-center gap-1">
              <span class="text-muted" style="font-size: 0.72rem; font-weight: 600;">Good / Size:</span>
              <select class="form-select form-select-sm py-0 px-1 border-secondary-subtle file-size-select" data-index="${index}" style="font-size: 0.75rem; height: 26px; border-radius: 6px; font-weight: 600; width: auto; max-width: 140px;">
                <optgroup label="Standard Documents">
                  <option value="A4" ${curSize === 'A4' ? 'selected' : ''}>A4 Document</option>
                  <option value="A3" ${curSize === 'A3' ? 'selected' : ''}>A3 Poster</option>
                  <option value="Legal" ${curSize === 'Legal' ? 'selected' : ''}>Legal Document</option>
                  <option value="A5" ${curSize === 'A5' ? 'selected' : ''}>A5 Booklet</option>
                </optgroup>
                <optgroup label="Photo Prints & Frames">
                  <option value="Photo 4x6" ${curSize === 'Photo 4x6' ? 'selected' : ''}>4" x 6" Photo Print</option>
                  <option value="Photo 6x8" ${curSize === 'Photo 6x8' ? 'selected' : ''}>6" x 8" Photo Print</option>
                  <option value="Frame 8x10" ${curSize === 'Frame 8x10' ? 'selected' : ''}>8" x 10" Photo Frame</option>
                  <option value="Frame 10x12" ${curSize === 'Frame 10x12' ? 'selected' : ''}>10" x 12" Photo Frame</option>
                  <option value="Frame 12x18" ${curSize === 'Frame 12x18' ? 'selected' : ''}>12" x 18" Large Frame</option>
                </optgroup>
                <optgroup label="Custom Merchandise & Gifts">
                  <option value="Ceramic Mug Print" ${curSize === 'Ceramic Mug Print' ? 'selected' : ''}>Ceramic Photo Mug</option>
                  <option value="Custom Keytag Print" ${curSize === 'Custom Keytag Print' ? 'selected' : ''}>Custom Keytag</option>
                  <option value="Vinyl Sticker Print" ${curSize === 'Vinyl Sticker Print' ? 'selected' : ''}>Vinyl Sticker / Decal</option>
                  <option value="Canvas Print" ${curSize === 'Canvas Print' ? 'selected' : ''}>Canvas Wrap Print</option>
                </optgroup>
                <optgroup label="Custom">
                  <option value="Other" ${isCustom ? 'selected' : ''}>Other / Custom Good...</option>
                </optgroup>
              </select>
              <input type="text" class="form-control form-control-sm py-0 px-1 file-custom-size-input ${isCustom ? '' : 'd-none'}" 
