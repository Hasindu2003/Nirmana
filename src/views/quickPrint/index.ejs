  // =========================================================================
  // FILE MANAGER STYLE ORDER SELECTION & BATCH DELETION
  // =========================================================================
  var selectedJobIds = new Set();
  var lastCheckedJobId = null;

  function updateSelectionUi() {
    const totalSelected = selectedJobIds.size;
    const countText = document.getElementById('selectionCountText');
    const batchBtn = document.getElementById('batchDeleteBtn');
    const clearBtn = document.getElementById('clearSelectionBtn');
    const badgeCount = document.getElementById('batchDeleteBadgeCount');
    const selectAllCheckbox = document.getElementById('selectAllCheckbox');
    const floatingBar = document.getElementById('floatingSelectionBar');
    const floatingCount = document.getElementById('floatingSelectedCount');
    const selectionToolbar = document.getElementById('queueSelectionToolbar');

    if (countText) {
      countText.textContent = totalSelected === 1 ? '1 selected' : `${totalSelected} selected`;
    }
    if (badgeCount) {
      badgeCount.textContent = totalSelected;
    }
    if (selectionToolbar) {
      selectionToolbar.classList.toggle('has-selection', totalSelected > 0);
    }
    if (batchBtn) {
      if (totalSelected > 0) {
        batchBtn.classList.remove('d-none');
        batchBtn.classList.add('d-inline-flex');
      } else {
        batchBtn.classList.add('d-none');
        batchBtn.classList.remove('d-inline-flex');
      }
    }
    if (clearBtn) {
      if (totalSelected > 0) {
        clearBtn.classList.remove('d-none');
        clearBtn.classList.add('d-inline-flex');
      } else {
        clearBtn.classList.add('d-none');
        clearBtn.classList.remove('d-inline-flex');
      }
    }
    if (floatingBar) {
      if (totalSelected > 0) {
        floatingBar.classList.remove('d-none');
        floatingBar.classList.add('d-flex');
        if (floatingCount) floatingCount.textContent = totalSelected;
      } else {
        floatingBar.classList.add('d-none');
        floatingBar.classList.remove('d-flex');
      }
    }

    // Determine state of Select All checkbox based on currently visible cards
    const visibleCards = Array.from(document.querySelectorAll('.job-card-wrapper')).filter(card => {
      return card.style.display !== 'none' && !card.classList.contains('d-none');
    });

    if (selectAllCheckbox) {
      if (visibleCards.length === 0) {
        selectAllCheckbox.checked = false;
        selectAllCheckbox.indeterminate = false;
      } else {
        const visibleIds = visibleCards.map(c => Number(c.getAttribute('data-id')));
        const selectedVisibleCount = visibleIds.filter(id => selectedJobIds.has(id)).length;

        if (selectedVisibleCount === 0) {
          selectAllCheckbox.checked = false;
          selectAllCheckbox.indeterminate = false;
        } else if (selectedVisibleCount === visibleIds.length) {
          selectAllCheckbox.checked = true;
          selectAllCheckbox.indeterminate = false;
        } else {
          selectAllCheckbox.checked = false;
          selectAllCheckbox.indeterminate = true;
        }
      }
    }
  }

  function handleOrderCheckboxClick(e, jobId) {
    e.stopPropagation();
    const id = Number(jobId);
    const checkbox = e.target;
    const isChecked = checkbox.checked;

    // Shift+Click range selection like a desktop file manager
    if (e.shiftKey && lastCheckedJobId !== null && lastCheckedJobId !== id) {
      const visibleCards = Array.from(document.querySelectorAll('.job-card-wrapper')).filter(card => {
        return card.style.display !== 'none' && !card.classList.contains('d-none');
      });
      const visibleIds = visibleCards.map(c => Number(c.getAttribute('data-id')));
      const fromIdx = visibleIds.indexOf(lastCheckedJobId);
      const toIdx = visibleIds.indexOf(id);

      if (fromIdx !== -1 && toIdx !== -1) {
        const start = Math.min(fromIdx, toIdx);
        const end = Math.max(fromIdx, toIdx);
        for (let i = start; i <= end; i++) {
          const targetId = visibleIds[i];
          if (isChecked) {
            selectedJobIds.add(targetId);
            setCardSelectedVisual(targetId, true);
          } else {
            selectedJobIds.delete(targetId);
            setCardSelectedVisual(targetId, false);
          }
        }
      }
    } else {
      if (isChecked) {
        selectedJobIds.add(id);
        setCardSelectedVisual(id, true);
      } else {
        selectedJobIds.delete(id);
        setCardSelectedVisual(id, false);
      }
    }

    lastCheckedJobId = id;
    updateSelectionUi();
  }
  window.handleOrderCheckboxClick = handleOrderCheckboxClick;

  function setCardSelectedVisual(jobId, isSelected) {
    const card = document.getElementById(`job-card-${jobId}`);
    if (card) {
