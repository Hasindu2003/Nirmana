  // Batch Delete Confirmation & Execution
  function confirmBatchDelete() {
    const count = selectedJobIds.size;
    if (count === 0) return;

    const modalCount = document.getElementById('batchDeleteCountModal');
    if (modalCount) modalCount.textContent = count;

    const modalEl = document.getElementById('batchDeleteModal');
    if (modalEl) {
      const modalInstance = bootstrap.Modal.getOrCreateInstance(modalEl);
      modalInstance.show();
    } else {
      if (confirm(`Are you sure you want to permanently delete ${count} selected order(s) and their files?`)) {
        executeBatchDelete();
      }
    }
  }
  window.confirmBatchDelete = confirmBatchDelete;

  async function executeBatchDelete() {
    const ids = Array.from(selectedJobIds);
    if (ids.length === 0) return;

    const execBtn = document.getElementById('executeBatchDeleteBtn');
    if (execBtn) {
      execBtn.disabled = true;
      execBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status"></span> Deleting...';
    }

    try {
      const res = await fetch('/api/quick-print/jobs/batch-delete', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ ids }),
      });
      const data = await res.json();

      if (data.success) {
        const modalEl = document.getElementById('batchDeleteModal');
        if (modalEl) {
          const modalInstance = bootstrap.Modal.getInstance(modalEl);
          if (modalInstance) modalInstance.hide();
        }

        // Animate & remove deleted cards
        ids.forEach(id => {
          const card = document.getElementById(`job-card-${id}`);
          if (card) {
            card.style.transition = 'all 0.25s ease';
            card.style.opacity = '0';
            card.style.transform = 'scale(0.96)';
            setTimeout(() => card.remove(), 250);
          }
          knownJobIds.delete(id);
        });

        quickPrintJobsData = (quickPrintJobsData || []).filter(j => !selectedJobIds.has(j.id));
        selectedJobIds.clear();

        setTimeout(() => {
          updateQueueCounts();
          updateSelectionUi();
          applyRealtimeSearch();
        }, 300);
      } else {
        alert(data.message || 'Failed to delete selected orders.');
      }
    } catch (err) {
      alert('Network error while deleting selected orders.');
    } finally {
      if (execBtn) {
        execBtn.disabled = false;
        execBtn.innerHTML = '<i class="bi bi-trash-fill me-1"></i> Yes, Delete Orders';
      }
    }
  }
  window.executeBatchDelete = executeBatchDelete;

  // Global Keyboard Shortcuts (File Manager feel)
  document.addEventListener('keydown', function(e) {
    const activeEl = document.activeElement;
    const isTyping = activeEl && (activeEl.tagName === 'INPUT' || activeEl.tagName === 'TEXTAREA' || activeEl.isContentEditable);
    if (isTyping) return;

    if (e.key === 'Delete' || (e.key === 'Backspace' && (e.metaKey || e.ctrlKey))) {
      if (selectedJobIds.size > 0) {
        e.preventDefault();
        confirmBatchDelete();
      }
    } else if (e.key === 'Escape') {
      if (selectedJobIds.size > 0) {
        e.preventDefault();
        clearAllSelections();
      }
    } else if ((e.ctrlKey || e.metaKey) && (e.key === 'a' || e.key === 'A')) {
      e.preventDefault();
      toggleSelectAllOrders(true);
    }
  });

  // Web Audio Synthesizer for arrival chime
  function playChime() {
    if (!soundEnabled) return;
    try {
      const AudioContext = window.AudioContext || window.webkitAudioContext;
      if (!AudioContext) return;
      const ctx = new AudioContext();

      const now = ctx.currentTime;
      const osc1 = ctx.createOscillator();
      const osc2 = ctx.createOscillator();
      const gain = ctx.createGain();

      osc1.type = 'sine';
      osc1.frequency.setValueAtTime(587.33, now); // D5
      osc1.frequency.exponentialRampToValueAtTime(880, now + 0.15); // A5

      osc2.type = 'triangle';
      osc2.frequency.setValueAtTime(880, now + 0.15);
      osc2.frequency.exponentialRampToValueAtTime(1174.66, now + 0.35); // D6

      gain.gain.setValueAtTime(0.01, now);
      gain.gain.linearRampToValueAtTime(0.25, now + 0.05);
      gain.gain.exponentialRampToValueAtTime(0.001, now + 0.6);

      osc1.connect(gain);
      osc2.connect(gain);
      gain.connect(ctx.destination);

      osc1.start(now);
      osc2.start(now + 0.15);
      osc1.stop(now + 0.4);
      osc2.stop(now + 0.6);
    } catch (e) {
      console.warn('Audio chime could not play:', e);
    }
  }

