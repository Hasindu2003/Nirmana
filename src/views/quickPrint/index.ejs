<script id="quickPrintJobsJson" type="application/json">
  <%- JSON.stringify(jobs || []) %>
</script>

<script>
  var currentViewStatus = '<%= currentStatus %>';
  var knownJobIds = new Set([<%= jobs.map(j => j.id).join(',') %>]);
  var soundEnabled = true;
  var currentQrDataUrl = '';

  // Client-side cache of jobs for immediate document preview
  var quickPrintJobsData = [];
  try {
    quickPrintJobsData = JSON.parse(document.getElementById('quickPrintJobsJson').textContent);
  } catch (e) {
    quickPrintJobsData = [];
  }

  var currentPreviewJob = null;
  var currentPreviewActiveFile = null;

  // Open pop-up document preview window
  function openDocumentPreviewModal(jobId) {
    const job = quickPrintJobsData.find(j => j.id == jobId);
    if (!job) {
      alert('Order details not found.');
      return;
    }
    currentPreviewJob = job;

    // Header info
    document.getElementById('previewModalToken').textContent = '#' + job.tokenNumber;
    document.getElementById('previewModalCustomer').innerHTML = '<i class="bi bi-person me-1"></i>' + escapeHtml(job.customerName);
    document.getElementById('previewModalSpecs').innerHTML = 
      `<i class="bi bi-copy me-1"></i>${job.copies} ${job.copies > 1 ? 'copies' : 'copy'} &bull; ` +
      `<i class="bi ${job.colorMode === 'COLOR' ? 'bi-palette-fill text-warning' : (job.colorMode === 'MIXED' ? 'bi-shuffle text-info' : 'bi-circle-half')} me-1"></i>${job.colorMode} &bull; ` +
      `<i class="bi bi-file-earmark me-1"></i>${job.paperSize}`;

    // Customer note
    const noteContainer = document.getElementById('previewCustomerNoteContainer');
    const noteText = document.getElementById('previewCustomerNoteText');
    if (job.customerMessage && job.customerMessage.trim()) {
      const cleanMsg = job.customerMessage.trim();
      noteText.textContent = cleanMsg;
      noteText.title = cleanMsg;
      noteContainer.classList.remove('d-none');
    } else {
      noteContainer.classList.add('d-none');
    }

    // Files navigation
    const navContainer = document.getElementById('previewModalFilesNav');
    const navTabs = document.getElementById('previewFilesNavTabs');
    navTabs.innerHTML = '';

    const files = job.files || [];
    if (files.length === 0) {
      alert('No files attached to this order.');
      return;
    }

    if (files.length > 1) {
      navContainer.classList.remove('d-none');
      files.forEach((file, index) => {
        const li = document.createElement('li');
        li.className = 'nav-item';
        const a = document.createElement('a');
        a.className = 'nav-link btn-sm py-1 px-3 ' + (index === 0 ? 'active' : '');
        a.href = 'javascript:void(0)';
        const fSize = file.paperSize || job.paperSize || 'A4';
        const fColor = file.colorMode || job.colorMode || 'BW';
        const fCopies = file.copies || job.copies || 1;
        const colorIcon = fColor === 'COLOR' ? '<i class="bi bi-palette-fill text-warning"></i>' : '<i class="bi bi-circle-half"></i>';
        a.innerHTML = `<i class="bi bi-file-earmark me-1"></i> File ${index + 1}: <span class="text-truncate d-inline-block align-bottom" style="max-width: 120px;">${escapeHtml(file.originalName)}</span> <span class="badge bg-secondary-subtle text-dark border ms-1" style="font-size: 0.68rem; font-weight: 600;">${escapeHtml(fSize)} &bull; ${colorIcon} ${fColor} &bull; ${fCopies}x</span>`;
        a.onclick = () => {
          navTabs.querySelectorAll('.nav-link').forEach(tab => tab.classList.remove('active'));
          a.classList.add('active');
          switchPreviewFile(file);
        };
        li.appendChild(a);
        navTabs.appendChild(li);
      });
    } else {
      navContainer.classList.add('d-none');
    }

    // Switch to first file
    switchPreviewFile(files[0]);

    // Show modal pop-up window
    const modalEl = document.getElementById('documentPreviewModal');
    const modalInstance = bootstrap.Modal.getOrCreateInstance(modalEl);
    modalInstance.show();
  }

  function switchPreviewFile(file) {
    currentPreviewActiveFile = file;

    const imgEl = document.getElementById('previewImageElement');
    const pdfEl = document.getElementById('previewPdfElement');
    const fallbackEl = document.getElementById('previewFallbackElement');
    const spinner = document.getElementById('previewLoadingSpinner');

    const downloadBtn = document.getElementById('previewDownloadBtn');
    const openTabBtn = document.getElementById('previewOpenTabBtn');
    const infoName = document.getElementById('previewFileInfoName');
    const infoSize = document.getElementById('previewFileInfoSize');

    // Update details
    infoName.textContent = file.originalName;
    const mbSize = (file.fileSize / (1024 * 1024)).toFixed(2);
    const kbSize = (file.fileSize / 1024).toFixed(0);
    infoSize.textContent = mbSize > 0.05 ? `${mbSize} MB` : `${kbSize} KB`;

    if (document.getElementById('previewModalSpecs') && currentPreviewJob) {
      const activeSize = file.paperSize || currentPreviewJob.paperSize || 'A4';
      const activeColor = file.colorMode || currentPreviewJob.colorMode || 'BW';
      const activeCopies = file.copies || currentPreviewJob.copies || 1;
      document.getElementById('previewModalSpecs').innerHTML = 
        `<i class="bi bi-copy me-1"></i><strong>${activeCopies}</strong> ${activeCopies > 1 ? 'copies' : 'copy'} &bull; ` +
        `<i class="bi ${activeColor === 'COLOR' ? 'bi-palette-fill text-warning' : 'bi-circle-half'} me-1"></i><strong>${escapeHtml(activeColor)}</strong> &bull; ` +
        `<i class="bi bi-file-earmark me-1"></i><span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-0">${escapeHtml(activeSize)}</span>`;
    }

    const viewUrl = file.id ? `/api/quick-print/files/${file.id}/view` : file.fileUrl;
    const downloadUrl = file.id ? `/api/quick-print/files/${file.id}/download` : file.fileUrl;

    downloadBtn.href = downloadUrl;
    downloadBtn.download = file.originalName;
    openTabBtn.href = viewUrl;

    // Google Drive button
    const driveBtn = document.getElementById('previewDriveBtn');
    if (driveBtn) {
      if (file.driveViewLink) {
        driveBtn.href = file.driveViewLink;
        driveBtn.classList.remove('d-none');
        driveBtn.classList.add('d-flex');
      } else {
        driveBtn.classList.add('d-none');
        driveBtn.classList.remove('d-flex');
      }
    }

    // Reset views
    imgEl.classList.add('d-none');
    pdfEl.classList.add('d-none');
    fallbackEl.classList.add('d-none');
    spinner.classList.remove('d-none');

    const mime = (file.mimeType || '').toLowerCase();
    if (mime.startsWith('image/')) {
      imgEl.onload = () => {
        spinner.classList.add('d-none');
        imgEl.classList.remove('d-none');
      };
      imgEl.onerror = () => {
        spinner.classList.add('d-none');
        fallbackEl.classList.remove('d-none');
      };
      imgEl.src = viewUrl;
    } else if (mime.includes('pdf')) {
      pdfEl.onload = () => {
        spinner.classList.add('d-none');
      };
      pdfEl.src = viewUrl;
      pdfEl.classList.remove('d-none');
      spinner.classList.add('d-none');
    } else {
      spinner.classList.add('d-none');
      document.getElementById('previewFallbackFilename').textContent = file.originalName;
      document.getElementById('previewFallbackDownloadBtn').href = downloadUrl;
      document.getElementById('previewFallbackDownloadBtn').download = file.originalName;
      fallbackEl.classList.remove('d-none');
    }
  }

  function startPrintActiveDocument() {
    if (!currentPreviewActiveFile) return;
    directPrintFile(currentPreviewActiveFile.fileUrl, currentPreviewActiveFile.mimeType);
  }

  function escapeHtml(text) {
    if (!text) return '';
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
  }

  // Customer Note Modal Handlers
  function openCustomerNoteModal(jobId) {
    const job = (quickPrintJobsData || []).find(j => j.id == jobId);
    if (!job) {
      alert('Order details not found.');
      return;
    }
    const tokenEl = document.getElementById('customerNoteModalToken');
    const custEl = document.getElementById('customerNoteModalCustomer');
    const bodyEl = document.getElementById('customerNoteModalBody');

    if (tokenEl) tokenEl.textContent = '#' + (job.tokenNumber || 'QP-000');
    if (custEl) custEl.innerHTML = '<i class="bi bi-person me-1"></i>' + escapeHtml(job.customerName || 'Customer');
    if (bodyEl) bodyEl.textContent = (job.customerMessage && job.customerMessage.trim()) ? job.customerMessage.trim() : 'No special note provided for this order.';

    const modalEl = document.getElementById('customerNoteModal');
    if (modalEl) {
      const modalInstance = bootstrap.Modal.getOrCreateInstance(modalEl);
      modalInstance.show();
    }
  }
  window.openCustomerNoteModal = openCustomerNoteModal;

  function openCurrentJobNoteModal() {
    if (currentPreviewJob) {
      openCustomerNoteModal(currentPreviewJob.id);
    }
  }
  window.openCurrentJobNoteModal = openCurrentJobNoteModal;

  function copyCustomerNoteToClipboard() {
    const bodyEl = document.getElementById('customerNoteModalBody');
    const copyBtn = document.getElementById('copyCustomerNoteBtn');
    if (!bodyEl) return;
    const text = bodyEl.textContent || '';
    if (!navigator.clipboard) {
      return;
    }
    navigator.clipboard.writeText(text).then(() => {
      if (copyBtn) {
        const orig = copyBtn.innerHTML;
        copyBtn.innerHTML = '<i class="bi bi-check2 text-success"></i> <span>Copied!</span>';
        setTimeout(() => { copyBtn.innerHTML = orig; }, 2000);
      }
    });
  }
