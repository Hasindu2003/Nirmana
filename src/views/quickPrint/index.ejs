<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<style>
  /* Quick Print Page - Serene Slate-Teal Theme */
  .custom-pills {
    display: flex;
    gap: 0.5rem; /* Separates the two filter tabs so they don't touch */
  }
  .custom-pills .nav-item {
    margin: 0;
  }
  .custom-pills .nav-link {
    color: var(--serene-text-muted);
    background-color: #ffffff;
    border: 1px solid var(--serene-border);
    border-radius: var(--serene-radius-md);
    font-size: 0.86rem;
    font-weight: 600;
    padding: 0.45rem 1rem;
    transition: all 0.15s ease;
  }
  .custom-pills .nav-link:hover {
    background-color: var(--serene-surface-muted);
    color: var(--serene-text-main);
  }
  .custom-pills .nav-link.active {
    background-color: var(--serene-primary) !important;
    border-color: var(--serene-primary) !important;
    color: #ffffff !important;
    box-shadow: 0 1px 3px rgba(45, 106, 104, 0.2);
  }
  .custom-pills .nav-link.active .badge {
    background-color: rgba(255, 255, 255, 0.25) !important;
    color: #ffffff !important;
  }


  #previewFilesNavTabs .nav-link {
    color: var(--serene-text-muted);
    background-color: #ffffff;
    border: 1px solid var(--serene-border);
    border-radius: var(--serene-radius-sm);
    font-size: 0.82rem;
    font-weight: 500;
  }
  #previewFilesNavTabs .nav-link.active {
    background-color: var(--serene-primary) !important;
    border-color: var(--serene-primary) !important;
    color: #ffffff !important;
  }

  @keyframes qpArrivalPulse {
    0% {
      background-color: #fee2e2;
      transform: scale(1.015);
      box-shadow: 0 0 0 4px rgba(220, 38, 38, 0.35);
    }
    50% {
      background-color: #fef2f2;
      transform: scale(1.005);
      box-shadow: 0 0 0 2px rgba(220, 38, 38, 0.2);
    }
    100% {
      background-color: #ffffff;
      transform: scale(1);
      box-shadow: none;
    }
  }

  /* File Manager Style Order Selection */
  .job-card-wrapper.selected-order-card .serene-card {
    background-color: #f0fdfa !important;
    border-color: #0d9488 !important;
    box-shadow: 0 0 0 2px rgba(13, 148, 136, 0.28) !important;
  }
  .order-select-checkbox:checked {
    background-color: #0d9488 !important;
    border-color: #0d9488 !important;
  }
  .order-select-checkbox {
    transition: transform 0.15s ease;
  }
  .order-select-checkbox:hover {
    transform: scale(1.18);
  }
  #queueSelectionToolbar {
    background: #ffffff;
    border: 1px solid #e2e8f0;
  }
  #queueSelectionToolbar.has-selection {
    background: #f0fdfa;
    border-color: #99f6e4;
  }
</style>

<main class="main-wrapper">
  <div class="content-body">
    <!-- Header with Actions -->
    <div class="d-flex flex-wrap align-items-center justify-content-between mb-4">
      <div>
        <div class="d-flex align-items-center gap-2 mb-1">
          <h2 class="fs-4 fw-bold mb-0">Walk-in Quick Print Queue</h2>
          <span class="badge rounded-pill bg-danger px-2 py-1 small" id="activeBadge">
            <%= stats.pending %> Pending
          </span>
          <span class="badge rounded-pill bg-success-subtle text-success border border-success-subtle px-2 py-1 small" id="liveIndicator">
            <span class="spinner-grow spinner-grow-sm text-success me-1" style="width: 8px; height: 8px;" role="status"></span> Live
          </span>
        </div>
        <div class="text-muted small">
          Customers scan counter QR &bull; Uploads appear here instantly &bull; Print directly from desk
        </div>
      </div>

      <div class="d-flex flex-wrap align-items-center gap-2 mt-3 mt-sm-0">
        <!-- Audio alert toggle -->
        <button class="btn btn-serene-secondary" id="soundToggleBtn" title="Toggle audio chime on new customer uploads">
          <i class="bi bi-bell-fill text-warning me-1"></i> Sound: <strong id="soundStateText">ON</strong>
        </button>

        <!-- Refresh button -->
        <button class="btn btn-serene-secondary" id="manualRefreshBtn" title="Refresh queue">
          <i class="bi bi-arrow-clockwise"></i> Refresh
        </button>

        <!-- QR Code & Counter Stand Flyer Modal Trigger -->
        <button class="btn btn-serene-primary" data-bs-toggle="modal" data-bs-target="#qrCodeModal">
          <i class="bi bi-qr-code-scan me-1"></i> Counter QR Code & Stand
        </button>
      </div>
    </div>

    <!-- 2 Streamlined Modern Compact KPI Cards: Pending vs Completed Today -->
    <div class="row g-2 g-md-3 mb-4">
      <!-- 1. Pending Queue -->
      <div class="col-6">
        <div class="kpi-card-compact">
          <div class="kpi-compact-content">
            <div class="kpi-compact-label">
              <span>Pending Queue</span>
              <span class="badge bg-danger-subtle text-danger rounded-pill px-2 py-0 ms-1" style="font-size: 0.68rem; font-weight: 600;">
                <i class="bi bi-clock me-1"></i>In Queue
              </span>
            </div>
            <div class="kpi-compact-num text-danger tabular-nums" id="statPending">
              <%= stats.pending %>
            </div>
            <div class="kpi-compact-sub text-muted">
              <span class="status-dot" style="background:#dc2626;"></span> Awaiting print & handover
            </div>
          </div>
          <div class="kpi-icon-chip" style="background: #fee2e2; color: #dc2626;">
            <i class="bi bi-clock-history"></i>
          </div>
        </div>
      </div>

      <!-- 2. Completed Today -->
      <div class="col-6">
        <div class="kpi-card-compact">
          <div class="kpi-compact-content">
            <div class="kpi-compact-label">
              <span>Completed Today</span>
              <span class="badge bg-success-subtle text-success rounded-pill px-2 py-0 ms-1" style="font-size: 0.68rem; font-weight: 600;">
                <i class="bi bi-check2-circle me-1"></i>Done
              </span>
            </div>
            <div class="kpi-compact-num text-success tabular-nums" id="statCompletedToday">
              <%= stats.completedToday %>
            </div>
            <div class="kpi-compact-sub text-muted">
              <span class="status-dot" style="background:#16a34a;"></span> Finished walk-in print jobs
            </div>
          </div>
          <div class="kpi-icon-chip" style="background: #edf7ed; color: #16a34a;">
            <i class="bi bi-check-circle-fill"></i>
          </div>
        </div>
      </div>
    </div>

    <!-- 2 Primary Filter Tabs: Pending vs Completed -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
      <ul class="nav nav-pills custom-pills gap-2" id="quickPrintTabs">
        <li class="nav-item">
          <button type="button" class="nav-link <%= currentStatus === 'PENDING' ? 'active' : '' %>" id="tabPendingBtn" onclick="switchQuickPrintTab('PENDING')">
            <i class="bi bi-hourglass-split me-1"></i> Pending Orders 
            <span class="badge rounded-pill bg-danger ms-1" id="tabPendingBadge"><%= stats.pending %></span>
          </button>
        </li>
        <li class="nav-item">
          <button type="button" class="nav-link <%= currentStatus === 'COMPLETED' ? 'active' : '' %>" id="tabCompletedBtn" onclick="switchQuickPrintTab('COMPLETED')">
            <i class="bi bi-check2-all me-1"></i> Completed Orders 
            <span class="badge rounded-pill bg-secondary ms-1" id="tabCompletedBadge"><%= stats.completedToday %></span>
          </button>
        </li>
      </ul>

      <div class="d-flex gap-2">
        <div class="input-group input-group-sm position-relative" style="width: 290px;">
          <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
          <input type="text" class="form-control border-start-0 ps-0 pe-4" id="queueSearchInput" placeholder="Search token, name, phone, notes..." value="<%= search %>" autocomplete="off">
          <button class="btn btn-sm text-muted bg-white border border-start-0 position-absolute end-0 top-0 bottom-0 d-flex align-items-center justify-content-center px-2" type="button" id="clearSearchBtn" style="display: none; z-index: 5;" title="Clear search">
            <i class="bi bi-x-circle-fill text-secondary"></i>
          </button>
        </div>
      </div>
    </div>

    <!-- File Manager Style Selection Action Bar -->
    <div class="d-flex align-items-center justify-content-between p-2 mb-2 rounded-3 border bg-white shadow-xs" id="queueSelectionToolbar" style="transition: all 0.2s ease;">
      <div class="d-flex align-items-center gap-2">
        <div class="form-check m-0 d-flex align-items-center">
          <input class="form-check-input order-master-checkbox" type="checkbox" id="selectAllCheckbox" style="cursor: pointer; width: 18px; height: 18px;" onchange="toggleSelectAllOrders(this.checked)" title="Select all visible orders">
          <label class="form-check-label ms-2 small fw-semibold text-secondary user-select-none" for="selectAllCheckbox" style="cursor: pointer;">
            Select All
          </label>
        </div>
        <span class="text-muted small border-start ps-2" id="selectionCountText" style="font-size: 0.78rem;">0 selected</span>
      </div>

      <div class="d-flex align-items-center gap-2">
        <button type="button" class="btn btn-sm btn-outline-danger d-none align-items-center gap-1 shadow-xs fw-bold px-3 py-1" id="batchDeleteBtn" onclick="confirmBatchDelete()" style="font-size: 0.78rem;">
          <i class="bi bi-trash-fill"></i>
          <span>Delete Selected (<span id="batchDeleteBadgeCount">0</span>)</span>
        </button>
        <button type="button" class="btn btn-sm btn-link text-secondary text-decoration-none py-0 px-2 d-none" id="clearSelectionBtn" onclick="clearAllSelections()" style="font-size: 0.78rem;">
          <i class="bi bi-x-circle me-1"></i> Deselect
        </button>
      </div>
    </div>

    <!-- FULL-WIDTH REDESIGNED QUEUE LIST -->
    <div id="jobsListContainer">
      <div class="d-flex flex-column gap-2" id="ordersListWrapper">
        <% if (jobs && jobs.length > 0) { %>
          <% jobs.forEach(job => { %>
            <% const isInitiallyActive = (currentStatus === 'PENDING' && job.status !== 'COMPLETED' && job.status !== 'CANCELLED') || (currentStatus === 'COMPLETED' && job.status === 'COMPLETED'); %>
            <div class="job-card-wrapper w-100 transition-all position-relative" 
                 id="job-card-<%= job.id %>" 
                 data-id="<%= job.id %>"
                 data-status="<%= job.status %>"
                 data-token="<%= (job.tokenNumber || '').toLowerCase() %>"
                 data-name="<%= (job.customerName || '').toLowerCase() %>"
                 data-phone="<%= (job.customerPhone || '').toLowerCase() %>"
                 data-message="<%= (job.customerMessage || '').toLowerCase() %>"
                 data-colorspec="<%= (job.colorMode || '').toLowerCase() %>"
                 data-papersize="<%= (job.paperSize || '').toLowerCase() %>"
                 style="<%= isInitiallyActive ? '' : 'display: none !important;' %> overflow: visible !important;">
              <div class="serene-card overflow-visible w-100 border <%= job.status === 'PENDING' ? 'border-start border-start-4 border-start-danger' : 'border-start border-start-4 border-start-success' %> shadow-xs py-2 px-3 position-relative" style="overflow: visible !important; transition: all 0.2s ease;">
                
                <!-- Main Compact Horizontal Row: Token, Customer, Inline Files, Specs, Actions -->
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 gap-lg-3">
                  
                  <!-- 1. Left: Selection Checkbox, Token & Customer Info -->
                  <div class="d-flex align-items-center gap-2" style="min-width: 215px;">
                    <div class="form-check m-0 p-0 d-flex align-items-center me-1">
                      <input class="form-check-input order-select-checkbox m-0" 
                             type="checkbox" 
                             data-job-id="<%= job.id %>" 
                             style="width: 18px; height: 18px; cursor: pointer;" 
                             onclick="handleOrderCheckboxClick(event, <%= job.id %>)" 
                             aria-label="Select order #<%= job.tokenNumber %>">
                    </div>
                    <span class="badge <%= job.status === 'PENDING' ? 'bg-danger' : 'bg-success' %> text-white px-2 py-1 fw-bold fs-6 rounded-2 font-monospace" style="letter-spacing: 0.02em;">
                      #<%= job.tokenNumber %>
                    </span>
                    <div class="lh-sm">
                      <div class="fw-bold text-dark text-truncate" style="max-width: 140px; font-size: 0.9rem;" title="<%= job.customerName %>">
                        <%= job.customerName %>
                      </div>
                      <div class="d-flex align-items-center gap-1 mt-0">
                        <a href="tel:<%= job.customerPhone %>" class="text-muted text-decoration-none" style="font-size: 0.74rem;" title="Call Customer">
                          <i class="bi bi-telephone-fill me-1 text-serene-primary"></i><%= job.customerPhone %>
                        </a>
                        <a href="https://wa.me/<%= job.customerPhone.replace(/[^0-9]/g, '').replace(/^0/, '94') %>" 
                           target="_blank" class="badge bg-success-subtle text-success text-decoration-none border border-success-subtle px-1 py-0 ms-1" style="font-size: 0.65rem;" title="Message on WhatsApp">
                          <i class="bi bi-whatsapp"></i>
                        </a>
                      </div>
                    </div>
                  </div>

                  <!-- 2. Center: View Document & Print Button -->
                  <div class="d-flex align-items-center">
                    <% if (job.files && job.files.length > 0) { %>
                      <button type="button" class="btn btn-serene-outline btn-sm py-1 px-3 fw-semibold d-inline-flex align-items-center gap-2 shadow-xs" 
                              onclick="openDocumentPreviewModal(<%= job.id %>)" 
                              style="height: 32px; border-radius: 6px;"
                              title="View Document Preview & Print">
                        <i class="bi bi-eye-fill"></i>
                        <span>View Document (<%= job.files.length %>)</span>
                      </button>
                    <% } else { %>
                      <span class="text-muted small fst-italic">No document attached</span>
                    <% } %>
                  </div>

                  <!-- 3. Center-Right: Specs Badges -->
                  <div class="d-flex align-items-center gap-1 flex-shrink-0">
                    <span class="badge bg-light text-dark border px-2 py-1" style="font-size: 0.74rem;">
                      <i class="bi bi-copy text-muted me-1"></i><strong><%= job.copies %></strong> <%= job.copies > 1 ? 'copies' : 'copy' %>
                    </span>
                    <span class="badge bg-light text-dark border px-2 py-1" style="font-size: 0.74rem;">
                      <i class="bi <%= job.colorMode === 'COLOR' ? 'bi-palette-fill text-warning' : (job.colorMode === 'MIXED' ? 'bi-shuffle text-info' : 'bi-circle-half text-secondary') %> me-1"></i>
                      <strong><%= job.colorMode %></strong>
                    </span>
                    <span class="badge bg-light text-dark border px-2 py-1" style="font-size: 0.74rem;">
                      <strong><%= job.paperSize %></strong>
                    </span>
                  </div>

                  <!-- 4. Right: Time & Primary Action Button -->
                  <div class="d-flex align-items-center gap-2 ms-auto flex-shrink-0">
                    <div class="text-muted small d-none d-xl-block" style="font-size: 0.75rem;">
                      <i class="bi bi-clock me-1"></i>
                      <%= formatTime(job.createdAt) %>
                    </div>

                    <% if (job.status === 'PENDING') { %>
                      <!-- MARK COMPLETED BUTTON -->
                      <button type="button" class="btn btn-success fw-bold px-3 py-1 shadow-sm d-flex align-items-center gap-1" style="font-size: 0.8rem; height: 32px;"
                              onclick="markJobCompleted(<%= job.id %>, '<%= job.tokenNumber %>')">
                        <i class="bi bi-check2-circle fs-6"></i>
                        <span>Mark Completed</span>
                      </button>
                    <% } else { %>
                      <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1" style="font-size: 0.75rem;">
                        <i class="bi bi-check2-all me-1"></i> Completed
                      </span>
                      <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-2" style="font-size: 0.75rem; height: 28px;"
                              onclick="reopenJob(<%= job.id %>, '<%= job.tokenNumber %>')" title="Move back to Pending">
                        <i class="bi bi-arrow-counterclockwise"></i>
                      </button>
                    <% } %>

                    <!-- Options Dropdown -->
                    <div class="dropdown position-relative">
                      <button class="btn btn-sm btn-serene-ghost p-1 text-muted d-flex align-items-center justify-content-center" 
                              type="button" 
                              data-bs-toggle="dropdown" 
                              data-bs-display="static" 
                              aria-expanded="false" 
                              title="More options" 
                              style="width: 30px; height: 30px; border-radius: 6px;">
                        <i class="bi bi-three-dots-vertical fs-6"></i>
                      </button>
                      <ul class="dropdown-menu dropdown-menu-end shadow-sm" style="min-width: 200px; z-index: 1060;">
                        <li>
                          <a class="dropdown-item py-2 d-flex align-items-center" href="javascript:void(0)" onclick="convertToFormalOrder(<%= job.id %>)">
                            <i class="bi bi-receipt me-2 text-serene-primary"></i> Convert to Formal Order
                          </a>
                        </li>
                        <% const driveFile = job.files && job.files.find(f => f.driveViewLink); %>
                        <% if (driveFile && driveFile.driveViewLink) { %>
                          <li>
                            <a class="dropdown-item py-2 d-flex align-items-center text-primary" href="<%= driveFile.driveViewLink %>" target="_blank" rel="noopener noreferrer">
                              <i class="bi bi-google me-2 text-primary"></i> Open in Google Drive
                            </a>
                          </li>
                        <% } %>
                        <li><hr class="dropdown-divider my-1"></li>
                        <li>
                          <a class="dropdown-item py-2 text-danger d-flex align-items-center" href="javascript:void(0)" onclick="deleteJob(<%= job.id %>)">
                            <i class="bi bi-trash me-2"></i> Delete Order & Files
                          </a>
                        </li>
                      </ul>
                    </div>
                  </div>

                </div>

                <!-- Optional Compact Customer Note with See Full Note Button -->
                <% if (job.customerMessage) { %>
                  <div class="mt-1 pt-1 border-top d-flex align-items-center justify-content-between gap-2" style="font-size: 0.76rem;">
                    <div class="d-flex align-items-center gap-2 text-truncate me-2">
                      <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-1 py-0 flex-shrink-0" style="font-size: 0.65rem; font-weight: 700;">
                        <i class="bi bi-chat-left-text-fill me-1"></i>NOTE
                      </span>
                      <span class="text-dark fw-medium text-truncate" title="<%= job.customerMessage %>">
                        <%= job.customerMessage %>
                      </span>
                    </div>
                    <button type="button" class="btn btn-sm btn-warning text-dark py-0 px-2 fw-bold d-inline-flex align-items-center gap-1 flex-shrink-0 shadow-xs" 
                            onclick="openCustomerNoteModal(<%= job.id %>)" 
                            style="font-size: 0.72rem; height: 22px; border-radius: 4px;" 
                            title="See full customer note">
                      <i class="bi bi-eye-fill"></i>
                      <span>See Full Note</span>
                    </button>
                  </div>
                <% } %>

              </div>
            </div>
          <% }); %>
        <% } %>
      </div>

      <!-- Dynamic No Search Results Feedback -->
      <div id="searchNoResults" class="card border-0 shadow-xs py-5 text-center my-3" style="display: none; border-radius: 12px; background: #fafafa;">
        <div class="text-muted mb-2"><i class="bi bi-search fs-2"></i></div>
        <h6 class="fw-bold text-dark mb-1">No matching orders found</h6>
        <p class="text-muted small mb-3">No orders in this queue match "<span id="searchKeywordDisplay" class="fw-semibold text-dark"></span>"</p>
        <div>
          <button type="button" class="btn btn-sm btn-outline-secondary" onclick="clearSearchFilter()">Clear Search</button>
        </div>
      </div>

      <!-- Dynamic Empty State for Current Filter -->
      <div id="queueEmptyState" class="serene-card text-center py-5" style="<%= (jobs && jobs.length > 0) ? 'display: none;' : '' %>">
        <div class="mb-3">
          <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-light text-muted" style="width: 70px; height: 70px;">
            <i class="bi bi-printer-fill fs-2 text-serene-primary"></i>
          </div>
        </div>
        <h4 class="fs-5 fw-bold mb-1" id="emptyStateTitle">
          <%= currentStatus === 'PENDING' ? 'No Pending Print Orders!' : 'No Completed Orders Found.' %>
        </h4>
        <p class="text-muted small mb-3" id="emptyStateSubtitle">
          <%= currentStatus === 'PENDING' ? 'Walk-in customer uploads will appear here automatically.' : 'Completed print orders will be listed here.' %>
        </p>
        <button type="button" class="btn btn-serene-primary" data-bs-toggle="modal" data-bs-target="#qrCodeModal">
          <i class="bi bi-qr-code-scan me-1"></i> Show Counter QR Code
        </button>
      </div>
    </div>

    <!-- Floating Batch Action Pill (file manager style) -->
    <div id="floatingSelectionBar" class="d-none position-fixed bottom-0 start-50 translate-middle-x mb-4 p-2 px-3 bg-dark text-white rounded-pill shadow-lg align-items-center gap-3" style="z-index: 1040; backdrop-filter: blur(8px); background: rgba(15, 23, 42, 0.94) !important;">
      <div class="d-flex align-items-center gap-2 small">
        <span class="badge bg-danger rounded-pill font-monospace" id="floatingSelectedCount">0</span>
        <span class="fw-semibold">order(s) selected</span>
      </div>
      <button type="button" class="btn btn-danger btn-sm rounded-pill px-3 py-1 fw-bold d-inline-flex align-items-center gap-1 shadow-sm" onclick="confirmBatchDelete()" style="font-size: 0.8rem;">
        <i class="bi bi-trash-fill"></i> Delete Selected
      </button>
      <button type="button" class="btn btn-link text-white-50 text-decoration-none btn-sm p-0 ms-1" onclick="clearAllSelections()" title="Clear selection">
        <i class="bi bi-x-lg"></i>
      </button>
    </div>
  </div>
</main>

<!-- ========================================================================= -->
<!-- DOCUMENT PREVIEW & START PRINT MODAL -->
<!-- ========================================================================= -->
<div class="modal fade" id="documentPreviewModal" tabindex="-1" aria-labelledby="documentPreviewModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content shadow-lg border-0">
      
      <!-- Modal Header -->
      <div class="modal-header py-2 px-3 border-bottom" style="background: #f8fafc;">
        <div class="d-flex align-items-center gap-2 flex-wrap">
          <span class="badge bg-danger text-white fw-bold px-2 py-1 fs-6 font-monospace" id="previewModalToken">#QP-000</span>
          <h5 class="modal-title fw-bold fs-6 mb-0 text-dark" id="previewModalTitle">Document Preview</h5>
          <span class="badge bg-light text-dark border ms-1" id="previewModalCustomer"><i class="bi bi-person me-1"></i>Customer</span>
          <span class="badge bg-light text-dark border" id="previewModalSpecs"><i class="bi bi-printer me-1"></i>Specs</span>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <!-- Modal Body -->
      <div class="modal-body p-3 bg-light">
        
        <!-- Multi-file Tabs (shown only if job has >1 files) -->
        <div id="previewModalFilesNav" class="d-none mb-2">
          <ul class="nav nav-pills gap-1" id="previewFilesNavTabs"></ul>
        </div>

        <!-- Document Preview Canvas Area -->
        <div class="bg-white border rounded-3 p-2 shadow-xs d-flex align-items-center justify-content-center position-relative" 
             style="min-height: 480px; max-height: 65vh; overflow: auto; background-image: radial-gradient(#cbd5e1 1px, transparent 1px); background-size: 16px 16px;">
          
          <!-- Image Preview -->
          <img id="previewImageElement" src="" alt="Document Preview" 
               class="img-fluid rounded shadow-sm d-none" 
               style="max-height: 60vh; max-width: 100%; object-fit: contain;">

          <!-- PDF Preview Iframe -->
