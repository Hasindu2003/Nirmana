      if (btn) {
        const isPending = btn.id === 'tabPendingBtn';
        if (typeof window.switchQuickPrintTab === 'function') {
          window.switchQuickPrintTab(isPending ? 'PENDING' : 'COMPLETED');
        }
      }
    });
  }

  // Handle browser Back / Forward buttons without reloading
  if (!window._qpPopstateAttached) {
    window._qpPopstateAttached = true;
    window.addEventListener('popstate', () => {
      const urlParams = new URLSearchParams(window.location.search);
      const statusFromUrl = urlParams.get('status') || 'PENDING';
      if (typeof window.switchQuickPrintTab === 'function') {
        window.switchQuickPrintTab(statusFromUrl, false);
      }
    });
  }

  function applyRealtimeSearch() {
    const searchInput = document.getElementById('queueSearchInput');
    const clearBtn = document.getElementById('clearSearchBtn');
    const noResultsBox = document.getElementById('searchNoResults');
    const searchKeywordDisplay = document.getElementById('searchKeywordDisplay');
    const emptyBox = document.getElementById('queueEmptyState');
    const emptyTitle = document.getElementById('emptyStateTitle');
    const emptySubtitle = document.getElementById('emptyStateSubtitle');

    const rawVal = searchInput ? searchInput.value : '';
    const term = rawVal.trim().toLowerCase();
    const cards = document.querySelectorAll('.job-card-wrapper');
    let totalInTab = 0;
    let visibleCount = 0;

    if (clearBtn) {
      clearBtn.style.display = term ? 'inline-flex' : 'none';
    }

    cards.forEach(card => {
      const jobStatus = card.getAttribute('data-status') || 'PENDING';
      const isStatusMatch = currentViewStatus === 'PENDING'
        ? (jobStatus === 'PENDING' || jobStatus === 'PRINTING' || jobStatus === 'READY')
        : (jobStatus === 'COMPLETED');

      if (!isStatusMatch) {
        card.style.setProperty('display', 'none', 'important');
        return;
      }

      totalInTab++;

      if (!term) {
        card.style.display = '';
        visibleCount++;
        return;
      }

      const token = card.getAttribute('data-token') || '';
      const name = card.getAttribute('data-name') || '';
      const phone = card.getAttribute('data-phone') || '';
      const message = card.getAttribute('data-message') || '';
      const colorSpec = card.getAttribute('data-colorspec') || '';
      const paperSize = card.getAttribute('data-papersize') || '';

      const cleanToken = token.replace(/[^a-z0-9]/gi, '');
      const cleanTerm = term.replace(/[^a-z0-9]/gi, '');

      const isMatch = token.includes(term) ||
                      (cleanTerm && cleanToken.includes(cleanTerm)) ||
                      name.includes(term) ||
                      phone.includes(term) ||
                      message.includes(term) ||
                      colorSpec.includes(term) ||
                      paperSize.includes(term);

      if (isMatch) {
        card.style.display = '';
        visibleCount++;
      } else {
        card.style.setProperty('display', 'none', 'important');
      }
    });

    if (noResultsBox) {
      if (term && visibleCount === 0 && totalInTab > 0) {
        noResultsBox.style.display = 'block';
        if (searchKeywordDisplay) searchKeywordDisplay.textContent = rawVal.trim();
      } else {
        noResultsBox.style.display = 'none';
      }
    }

    if (emptyBox) {
      if (totalInTab === 0) {
        emptyBox.style.display = 'block';
        if (emptyTitle) {
          emptyTitle.textContent = currentViewStatus === 'PENDING' ? 'No Pending Print Orders!' : 'No Completed Orders Found.';
        }
        if (emptySubtitle) {
          emptySubtitle.textContent = currentViewStatus === 'PENDING' ? 'Walk-in customer uploads will appear here automatically.' : 'Completed print orders will be listed here.';
        }
      } else {
        emptyBox.style.display = 'none';
      }
    }
    updateSelectionUi();
  }

  function clearSearchFilter() {
    const input = document.getElementById('queueSearchInput');
    if (input) {
      input.value = '';
      applyRealtimeSearch();
      input.focus();
    }
  }

  const liveSearchInput = document.getElementById('queueSearchInput');
  if (liveSearchInput && !liveSearchInput.dataset.qpBound) {
    liveSearchInput.dataset.qpBound = 'true';
    liveSearchInput.addEventListener('input', applyRealtimeSearch);
  }

  const liveClearBtn = document.getElementById('clearSearchBtn');
  if (liveClearBtn && !liveClearBtn.dataset.qpBound) {
    liveClearBtn.dataset.qpBound = 'true';
    liveClearBtn.addEventListener('click', clearSearchFilter);
  }

  // Trigger search / initial tab layout on page load
  applyRealtimeSearch();

  // Helper to format order creation time to Sri Lanka time
  function formatClientJobTime(dateVal) {
    if (!dateVal) return '';
    try {
      const d = new Date(dateVal);
      return new Intl.DateTimeFormat('en-LK', {
        timeZone: 'Asia/Colombo',
        hour: '2-digit',
        minute: '2-digit',
        hour12: true,
      }).format(d);
    } catch (e) {
      return '';
    }
  }

  // Generate identical markup for a job card dynamically
  function renderJobCardHtml(job) {
    const isInitiallyActive = (currentViewStatus === 'PENDING' && job.status !== 'COMPLETED' && job.status !== 'CANCELLED') || (currentViewStatus === 'COMPLETED' && job.status === 'COMPLETED');
    const isPending = job.status === 'PENDING';
    const borderClass = isPending ? 'border-start border-start-4 border-start-danger' : 'border-start border-start-4 border-start-success';
    const badgeBg = isPending ? 'bg-danger' : 'bg-success';
    const waNumber = (job.customerPhone || '').replace(/[^0-9]/g, '').replace(/^0/, '94');

    const filesCount = (job.files && Array.isArray(job.files)) ? job.files.length : 0;
    const documentBtnHtml = filesCount > 0
      ? `<button type="button" class="btn btn-serene-outline btn-sm py-1 px-3 fw-semibold d-inline-flex align-items-center gap-2 shadow-xs" 
                 onclick="openDocumentPreviewModal(${job.id})" 
                 style="height: 32px; border-radius: 6px;"
                 title="View Document Preview & Print">
           <i class="bi bi-eye-fill"></i>
           <span>View Document (${filesCount})</span>
         </button>`
      : `<span class="text-muted small fst-italic">No document attached</span>`;

    let colorIcon = 'bi-circle-half text-secondary';
    if (job.colorMode === 'COLOR') colorIcon = 'bi-palette-fill text-warning';
    else if (job.colorMode === 'MIXED') colorIcon = 'bi-shuffle text-info';

    const copiesText = (job.copies > 1 ? `${job.copies} copies` : '1 copy');

    const actionBtnHtml = isPending
      ? `<button type="button" class="btn btn-success fw-bold px-3 py-1 shadow-sm d-flex align-items-center gap-1" style="font-size: 0.8rem; height: 32px;"
                 onclick="markJobCompleted(${job.id}, '${escapeHtml(job.tokenNumber)}')">
           <i class="bi bi-check2-circle fs-6"></i>
           <span>Mark Completed</span>
         </button>`
      : `<span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1" style="font-size: 0.75rem;">
           <i class="bi bi-check2-all me-1"></i> Completed
         </span>
         <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-2" style="font-size: 0.75rem; height: 28px;"
                 onclick="reopenJob(${job.id}, '${escapeHtml(job.tokenNumber)}')" title="Move back to Pending">
           <i class="bi bi-arrow-counterclockwise"></i>
         </button>`;

    const driveFile = (job.files && Array.isArray(job.files) && job.files.find(f => f.driveViewLink));
    const driveLinkHtml = (driveFile && driveFile.driveViewLink)
      ? `<li>
           <a class="dropdown-item py-2 d-flex align-items-center text-primary" href="${escapeHtml(driveFile.driveViewLink)}" target="_blank" rel="noopener noreferrer">
             <i class="bi bi-google me-2 text-primary"></i> Open in Google Drive
           </a>
         </li>`
      : '';

    const noteHtml = (job.customerMessage && job.customerMessage.trim())
      ? `<div class="mt-1 pt-1 border-top d-flex align-items-center justify-content-between gap-2" style="font-size: 0.76rem;">
           <div class="d-flex align-items-center gap-2 text-truncate me-2">
             <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-1 py-0 flex-shrink-0" style="font-size: 0.65rem; font-weight: 700;">
               <i class="bi bi-chat-left-text-fill me-1"></i>NOTE
             </span>
             <span class="text-dark fw-medium text-truncate" title="${escapeHtml(job.customerMessage)}">
               ${escapeHtml(job.customerMessage)}
             </span>
           </div>
           <button type="button" class="btn btn-sm btn-warning text-dark py-0 px-2 fw-bold d-inline-flex align-items-center gap-1 flex-shrink-0 shadow-xs" 
                   onclick="openCustomerNoteModal(${job.id})" 
                   style="font-size: 0.72rem; height: 22px; border-radius: 4px;" 
                   title="See full customer note">
             <i class="bi bi-eye-fill"></i>
             <span>See Full Note</span>
           </button>
         </div>`
      : '';

    const isSelected = selectedJobIds.has(Number(job.id));
    const selectedClass = isSelected ? 'selected-order-card' : '';

    return `
      <div class="job-card-wrapper w-100 transition-all position-relative ${selectedClass}" 
           id="job-card-${job.id}" 
           data-id="${job.id}"
           data-status="${escapeHtml(job.status || 'PENDING')}"
           data-token="${escapeHtml((job.tokenNumber || '').toLowerCase())}"
           data-name="${escapeHtml((job.customerName || '').toLowerCase())}"
           data-phone="${escapeHtml((job.customerPhone || '').toLowerCase())}"
           data-message="${escapeHtml((job.customerMessage || '').toLowerCase())}"
           data-colorspec="${escapeHtml((job.colorMode || '').toLowerCase())}"
           data-papersize="${escapeHtml((job.paperSize || '').toLowerCase())}"
           style="${isInitiallyActive ? '' : 'display: none !important;'} overflow: visible !important;">
        <div class="serene-card overflow-visible w-100 border ${borderClass} shadow-xs py-2 px-3 position-relative" style="overflow: visible !important; transition: all 0.2s ease;">
          <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 gap-lg-3">
            
            <!-- 1. Left: Selection Checkbox, Token & Customer Info -->
            <div class="d-flex align-items-center gap-2" style="min-width: 215px;">
              <div class="form-check m-0 p-0 d-flex align-items-center me-1">
                <input class="form-check-input order-select-checkbox m-0" 
                       type="checkbox" 
                       data-job-id="${job.id}" 
                       style="width: 18px; height: 18px; cursor: pointer;" 
                       ${isSelected ? 'checked' : ''} 
                       onclick="handleOrderCheckboxClick(event, ${job.id})" 
                       aria-label="Select order #${escapeHtml(job.tokenNumber)}">
              </div>
              <span class="badge ${badgeBg} text-white px-2 py-1 fw-bold fs-6 rounded-2 font-monospace" style="letter-spacing: 0.02em;">
                #${escapeHtml(job.tokenNumber)}
              </span>
              <div class="lh-sm">
                <div class="fw-bold text-dark text-truncate" style="max-width: 140px; font-size: 0.9rem;" title="${escapeHtml(job.customerName)}">
                  ${escapeHtml(job.customerName)}
                </div>
                <div class="d-flex align-items-center gap-1 mt-0">
                  <a href="tel:${escapeHtml(job.customerPhone)}" class="text-muted text-decoration-none" style="font-size: 0.74rem;" title="Call Customer">
                    <i class="bi bi-telephone-fill me-1 text-serene-primary"></i>${escapeHtml(job.customerPhone)}
                  </a>
                  <a href="https://wa.me/${escapeHtml(waNumber)}" 
                     target="_blank" class="badge bg-success-subtle text-success text-decoration-none border border-success-subtle px-1 py-0 ms-1" style="font-size: 0.65rem;" title="Message on WhatsApp">
                    <i class="bi bi-whatsapp"></i>
                  </a>
                </div>
              </div>
            </div>

            <!-- 2. Center: View Document & Print Button -->
            <div class="d-flex align-items-center">
              ${documentBtnHtml}
            </div>

            <!-- 3. Center-Right: Specs Badges -->
            <div class="d-flex align-items-center gap-1 flex-shrink-0">
              <span class="badge bg-light text-dark border px-2 py-1" style="font-size: 0.74rem;">
                <i class="bi bi-copy text-muted me-1"></i><strong>${job.copies || 1}</strong> ${copiesText}
              </span>
              <span class="badge bg-light text-dark border px-2 py-1" style="font-size: 0.74rem;">
                <i class="bi ${colorIcon} me-1"></i>
                <strong>${escapeHtml(job.colorMode || 'BW')}</strong>
              </span>
              <span class="badge bg-light text-dark border px-2 py-1" style="font-size: 0.74rem;">
                <strong>${escapeHtml(job.paperSize || 'A4')}</strong>
              </span>
            </div>

            <!-- 4. Right: Time & Primary Action Button -->
            <div class="d-flex align-items-center gap-2 ms-auto flex-shrink-0">
              <div class="text-muted small d-none d-xl-block" style="font-size: 0.75rem;">
                <i class="bi bi-clock me-1"></i>
                ${escapeHtml(formatClientJobTime(job.createdAt))}
              </div>

              ${actionBtnHtml}

              <!-- Options Dropdown -->
              <div class="dropdown position-relative">
                <button class="btn btn-sm btn-serene-ghost p-1 text-muted d-flex align-items-center justify-content-center" 
                        type="button" 
                        data-bs-toggle="dropdown" 
                        data-bs-display="static" 
                        aria-expanded="false" 
                        title="More options" 
                        style="width: 30px; height: 30px; border-radius: 6px;">
                  <i class="bi bi-three-dots-vertical fs-6"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow-sm" style="min-width: 200px; z-index: 1060;">
                  <li>
                    <a class="dropdown-item py-2 d-flex align-items-center" href="javascript:void(0)" onclick="convertToFormalOrder(${job.id})">
                      <i class="bi bi-receipt me-2 text-serene-primary"></i> Convert to Formal Order
                    </a>
                  </li>
                  ${driveLinkHtml}
                  <li><hr class="dropdown-divider my-1"></li>
                  <li>
                    <a class="dropdown-item py-2 text-danger d-flex align-items-center" href="javascript:void(0)" onclick="deleteJob(${job.id})">
                      <i class="bi bi-trash me-2"></i> Delete Order & Files
                    </a>
                  </li>
                </ul>
              </div>
            </div>

          </div>

          ${noteHtml}

        </div>
      </div>
    `;
  }

  // Live polling for queue updates every 4s
  async function pollQueue() {
    try {
      const res = await fetch('/api/quick-print/jobs?status=ALL');
      const result = await res.json();

      if (result.success && Array.isArray(result.data)) {
        if (result.stats) {
          updateQueueCounts(result.stats);
        } else {
          updateQueueCounts();
        }

        // Cache updated jobs list for modals
        quickPrintJobsData = result.data;

        let wrapper = document.getElementById('ordersListWrapper');
        if (!wrapper) {
          const container = document.getElementById('jobsListContainer');
          if (container) {
            wrapper = document.createElement('div');
            wrapper.className = 'd-flex flex-column gap-2';
            wrapper.id = 'ordersListWrapper';
            container.prepend(wrapper);
          }
        }

        let hasNewPending = false;
        const newlyAddedCardIds = [];

        // Identify new jobs vs existing jobs
        const newPendingJobs = [];
        const otherNewJobs = [];

        result.data.forEach(job => {
          const card = document.getElementById(`job-card-${job.id}`);
          if (!card) {
            if (!knownJobIds.has(job.id) && job.status === 'PENDING') {
              hasNewPending = true;
              newlyAddedCardIds.push(job.id);
              newPendingJobs.push(job);
            } else {
              otherNewJobs.push(job);
            }
            knownJobIds.add(job.id);
          } else {
            knownJobIds.add(job.id);
            const currentCardStatus = card.getAttribute('data-status');
            if (currentCardStatus !== job.status) {
              card.setAttribute('data-status', job.status);
              const temp = document.createElement('div');
              temp.innerHTML = renderJobCardHtml(job).trim();
              const updatedCard = temp.firstElementChild;
              if (updatedCard) {
                card.replaceWith(updatedCard);
              }
            }
          }
        });

        // Remove cards that were deleted remotely
        const remoteIds = new Set(result.data.map(j => j.id));
        document.querySelectorAll('.job-card-wrapper').forEach(card => {
          const cid = parseInt(card.getAttribute('data-id'), 10);
          if (cid && !remoteIds.has(cid)) {
            card.remove();
            knownJobIds.delete(cid);
            selectedJobIds.delete(cid);
          }
        });

        if (wrapper) {
          // Prepend new pending jobs in chronological order so newest is at the very top
          newPendingJobs.reverse().forEach(job => {
            const temp = document.createElement('div');
            temp.innerHTML = renderJobCardHtml(job).trim();
            const newCard = temp.firstElementChild;
            if (newCard) {
              wrapper.prepend(newCard);
            }
          });

          // Append any other new non-pending jobs
          otherNewJobs.forEach(job => {
            const temp = document.createElement('div');
            temp.innerHTML = renderJobCardHtml(job).trim();
            const newCard = temp.firstElementChild;
            if (newCard) {
              wrapper.appendChild(newCard);
            }
          });
        }

        // If newly arrived pending orders detected, play chime and highlight card
        if (hasNewPending) {
          playChime();
          newlyAddedCardIds.forEach(id => {
            const el = document.getElementById(`job-card-${id}`);
            if (el) {
              const inner = el.querySelector('.serene-card');
              if (inner) {
                inner.style.animation = 'qpArrivalPulse 2.5s ease';
              }
            }
          });
        }

        // Re-apply real-time search & tab filter visibility seamlessly (0ms)
        applyRealtimeSearch();
      }
    } catch (err) {
      console.warn('Queue poll failed:', err);
    }
  }

  setInterval(pollQueue, 4000);

  // Ensure dropdown menu in queue cards floats cleanly above all other cards
  document.addEventListener('show.bs.dropdown', function (e) {
    const card = e.target.closest('.serene-card');
    if (card) {
      card.style.zIndex = '1050';
    }
  });
  document.addEventListener('hidden.bs.dropdown', function (e) {
    const card = e.target.closest('.serene-card');
    if (card) {
      card.style.zIndex = '';
    }
  });

  // =========================================================================
  // DYNAMIC QR CODE GENERATOR & FLYER HANDLERS
  // =========================================================================
  const qrUrlInput = document.getElementById('customQrUrlInput');
  const qrContainer = document.getElementById('qrCanvasContainer');
  const copyUrlBtn = document.getElementById('copyUrlBtn');
  const downloadQrBtn = document.getElementById('downloadQrBtn');
  const printFlyerBtn = document.getElementById('printFlyerBtn');
  const flyerQrImage = document.getElementById('flyerQrImage');

  const flyerUrlText = document.getElementById('flyerUrlText');
  const resetToOriginBtn = document.getElementById('resetToOriginBtn');

  // Smart Initial URL:
  // Uses dedicated customer portal (https://nirmana-upload.vercel.app)
  function getCleanUploadUrl() {
    const serverUrl = `<%= defaultUploadUrl %>`;
    if (serverUrl && serverUrl.trim() && serverUrl.trim().startsWith('http')) {
      return serverUrl.trim();
    }
    return 'https://nirmana-upload.vercel.app';
  }

  const initialUrl = getCleanUploadUrl();
  qrUrlInput.value = initialUrl;
  const previewUploadLink = document.getElementById('previewCustomerUploadLink');
  if (previewUploadLink) previewUploadLink.href = initialUrl;

  async function loadQrCode(targetUrl) {
    const cleanUrl = (targetUrl || '').trim();
    try {
      qrContainer.innerHTML = '<div class="spinner-border text-serene-primary" role="status"></div>';
      const res = await fetch(`/api/quick-print/qr?url=${encodeURIComponent(cleanUrl)}`);
      const data = await res.json();
      if (data.success && data.qrDataUrl) {
        currentQrDataUrl = data.qrDataUrl;
        qrContainer.innerHTML = `<img src="${data.qrDataUrl}" alt="Counter QR Code" style="width: 240px; height: 240px; border-radius: 8px;">`;
        if (flyerQrImage) flyerQrImage.src = data.qrDataUrl;
        if (flyerUrlText) flyerUrlText.textContent = cleanUrl;
      }
    } catch (e) {
      qrContainer.innerHTML = '<span class="text-danger">Failed to generate QR</span>';
    }
  }

  // Initial QR load
  loadQrCode(qrUrlInput.value);

  // Dynamic QR update on input change
  qrUrlInput.addEventListener('input', () => {
    loadQrCode(qrUrlInput.value.trim());
  });

  // Reset to Dedicated Customer Portal URL
  if (resetToOriginBtn) {
    resetToOriginBtn.addEventListener('click', () => {
      const resetUrl = getCleanUploadUrl();
      qrUrlInput.value = resetUrl;
      loadQrCode(resetUrl);
      if (previewUploadLink) previewUploadLink.href = resetUrl;
    });
  }

  // Copy URL button
  copyUrlBtn.addEventListener('click', () => {
    navigator.clipboard.writeText(qrUrlInput.value.trim()).then(() => {
      copyUrlBtn.innerHTML = '<i class="bi bi-check-lg text-success"></i> Copied!';
      setTimeout(() => {
        copyUrlBtn.innerHTML = '<i class="bi bi-clipboard me-1"></i> Copy';
      }, 2000);
    });
  });

  // Download high-resolution PNG
  downloadQrBtn.addEventListener('click', () => {
    const targetUrl = qrUrlInput.value.trim();
    window.location.href = `/api/quick-print/qr?download=true&url=${encodeURIComponent(targetUrl)}`;
  });

  // Print Tabletop Stand Placard
  printFlyerBtn.addEventListener('click', () => {
    const flyerContent = document.getElementById('printableCounterFlyer').innerHTML;
    const printWindow = window.open('', '_blank');
    printWindow.document.write(`
      <!DOCTYPE html>
      <html>
      <head>
        <title>Nirmana Printing - Self Service Counter Stand</title>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">
        <style>
          @page { size: A4 portrait; margin: 15mm; }
          body { font-family: 'Plus Jakarta Sans', sans-serif; margin: 0; padding: 0; background: #fff; }
          @media print {
            body { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
          }
        </style>
      </head>
      <body>
        ${flyerContent}
        <script>
          window.onload = function() {
            setTimeout(function() {
              window.print();
            }, 300);
          };
        <\/script>
      </body>
      </html>
    `);
    printWindow.document.close();
  });
</script>

