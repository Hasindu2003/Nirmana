  // Update counts asynchronously
  async function updateQueueCounts(providedStats) {
    try {
      let stats = providedStats;
      if (!stats) {
        const res = await fetch('/api/quick-print/stats');
        const data = await res.json();
        if (data.success && data.data) {
          stats = data.data;
        }
      }
      if (stats) {
        const statPending = document.getElementById('statPending');
        const statCompletedToday = document.getElementById('statCompletedToday');
        const tabPendingBadge = document.getElementById('tabPendingBadge');
        const tabCompletedBadge = document.getElementById('tabCompletedBadge');
        const activeBadge = document.getElementById('activeBadge');
        const sidebarBadge = document.getElementById('sidebarQuickBadge');

        if (statPending) statPending.textContent = stats.pending;
        if (statCompletedToday) statCompletedToday.textContent = stats.completedToday;
        if (tabPendingBadge) tabPendingBadge.textContent = stats.pending;
        if (tabCompletedBadge) tabCompletedBadge.textContent = stats.completedToday;
        if (activeBadge) activeBadge.textContent = `${stats.pending} Pending`;
        
        if (sidebarBadge) {
          if (stats.pending > 0) {
            sidebarBadge.textContent = stats.pending;
            sidebarBadge.style.display = 'inline-block';
          } else {
            sidebarBadge.style.display = 'none';
          }
        }
      }
    } catch (e) {}
  }

  // -------------------------------------------------------------
  // Instant In-Memory Tab Switching & Real-Time Search (0ms)
  // -------------------------------------------------------------
  window.switchQuickPrintTab = function(newStatus, updateUrl = true) {
    currentViewStatus = newStatus;

    // 1. Toggle Tab Button classes instantly (0ms)
    const tabPendingBtn = document.getElementById('tabPendingBtn');
    const tabCompletedBtn = document.getElementById('tabCompletedBtn');
    if (tabPendingBtn) tabPendingBtn.classList.toggle('active', newStatus === 'PENDING');
    if (tabCompletedBtn) tabCompletedBtn.classList.toggle('active', newStatus === 'COMPLETED');

    // 2. Update URL silently in browser history (0ms, no reload)
    if (updateUrl) {
      const url = new URL(window.location.href);
      url.searchParams.set('status', newStatus);
      window.history.pushState({ status: newStatus }, '', url.toString());
    }

    // 3. Filter the in-memory cards instantly (0ms)
    applyRealtimeSearch();
  };

  // Delegated tab click listener across Turbo navigation
  if (!window._qpTabDelegationAttached) {
    window._qpTabDelegationAttached = true;
    document.addEventListener('click', function(e) {
