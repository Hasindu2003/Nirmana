<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/serene-theme.css">
  <style>
    body {
      background: #f8fafc;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
    }
    .login-container {
      width: 100%;
      max-width: 440px;
    }
    .login-card {
      background: #ffffff;
      border: 1px solid var(--serene-border);
      border-radius: var(--serene-radius-xl);
      box-shadow: var(--serene-shadow-card);
      padding: 2.5rem 2rem;
    }
    .quick-role-btn {
      font-size: 0.75rem;
      padding: 0.35rem 0.6rem;
      border-radius: 6px;
      border: 1px solid var(--serene-border);
      background: #fff;
      color: var(--serene-text-muted);
      cursor: pointer;
      transition: all 0.15s;
    }
    .quick-role-btn:hover {
      background: var(--serene-primary-light);
      border-color: var(--serene-primary);
      color: var(--serene-primary);
    }
  </style>
</head>
<body>

<div class="login-container">
  <div class="text-center mb-4">
    <div class="d-inline-flex align-items-center justify-content-center p-3 rounded-3 mb-2" style="background: var(--serene-primary); color:#fff;">
      <i class="bi bi-printer fs-2"></i>
    </div>
    <h2 class="fs-4 fw-bold mb-1">Nirmana Printing</h2>
    <p class="text-muted small">Internal Stock & Order Management System</p>
  </div>

  <div class="login-card">
    <% if (error) { %>
      <div class="alert alert-danger py-2 px-3 small rounded-3 mb-3 d-flex align-items-center gap-2">
        <i class="bi bi-exclamation-circle-fill"></i>
        <span><%= error %></span>
      </div>
    <% } %>

    <form action="/login" method="POST">
      <div class="mb-3">
        <label class="form-label">Username or Email</label>
        <div class="input-group">
          <span class="input-group-text bg-light border-end-0"><i class="bi bi-person text-muted"></i></span>
          <input type="text" name="username" id="usernameInput" class="form-control border-start-0" placeholder="admin@nirmana.lk" value="<%= username || 'admin' %>" required autofocus>
        </div>
      </div>

      <div class="mb-3">
        <div class="d-flex justify-content-between align-items-center mb-1">
          <label class="form-label mb-0">Password</label>
        </div>
        <div class="input-group">
          <span class="input-group-text bg-light border-end-0"><i class="bi bi-lock text-muted"></i></span>
          <input type="password" name="password" id="passwordInput" class="form-control border-start-0" placeholder="••••••••••••" value="Password123!" required>
        </div>
      </div>

      <div class="mb-4 d-flex justify-content-between align-items-center">
        <div class="form-check">
          <input type="checkbox" class="form-check-input" id="rememberMe" checked>
          <label class="form-check-label small text-muted" for="rememberMe">Remember me</label>
        </div>
        <span class="small text-muted">Phase 1 MVP</span>
      </div>

      <button type="submit" class="btn btn-serene-primary w-100 justify-content-center py-2 mb-4">
        <span>Sign In to Workspace</span>
        <i class="bi bi-arrow-right"></i>
      </button>
    </form>

    <!-- Role Switching Helper for Testing -->
    <div class="border-top pt-3">
      <div class="small text-muted mb-2 text-center" style="font-size:0.75rem;">QUICK ROLE LOGIN (TEST CREDENTIALS)</div>
      <div class="d-flex flex-wrap gap-1 justify-content-center">
        <button type="button" class="quick-role-btn" onclick="fillCreds('admin')">👑 Owner/Admin</button>
        <button type="button" class="quick-role-btn" onclick="fillCreds('sales')">💼 Sales</button>
        <button type="button" class="quick-role-btn" onclick="fillCreds('production')">🖨️ Production</button>
        <button type="button" class="quick-role-btn" onclick="fillCreds('inventory')">📦 Inventory</button>
        <button type="button" class="quick-role-btn" onclick="fillCreds('accountant')">📊 Accountant</button>
      </div>
    </div>
  </div>

  <div class="text-center mt-3 text-muted small">
    &copy; <%= new Date().getFullYear() %> Nirmana Printing (Pvt) Ltd. All rights reserved.
  </div>
</div>

<script>
function fillCreds(role) {
  document.getElementById('usernameInput').value = role;
  document.getElementById('passwordInput').value = 'Password123!';
}
</script>
</body>
</html>
