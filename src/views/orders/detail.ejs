<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<main class="main-wrapper">
  <div class="content-body">
    <!-- Header -->
    <div class="d-flex flex-wrap align-items-center justify-content-between mb-4">
      <div>
        <nav aria-label="breadcrumb">
          <ol class="breadcrumb mb-1 small text-muted">
            <li class="breadcrumb-item"><a href="/orders" class="text-decoration-none text-muted">Orders</a></li>
            <li class="breadcrumb-item active"><%= order.orderNumber %></li>
          </ol>
        </nav>
        <div class="d-flex align-items-center gap-3">
          <h2 class="fs-4 fw-bold mb-0">Order: <%= order.orderNumber %></h2>
          <span class="status-badge status-<%= order.status.toLowerCase() %>">
            <span class="status-dot"></span> <%= order.status.replace('_', ' ') %>
          </span>
        </div>
      </div>

      <!-- Quick Status Actions -->
      <div class="d-flex flex-wrap align-items-center gap-2 mt-3 mt-sm-0">
        <a href="/orders/<%= order.id %>/invoice" target="_blank" class="btn btn-warning text-dark fw-bold shadow-xs">
          <i class="bi bi-printer-fill me-1"></i> Print Bill (Invoice)
        </a>

        <% if (order.status === 'RECEIVED') { %>
          <button class="btn btn-serene-primary" onclick="setOrderStatus(<%= order.id %>, 'PRINTING')">
            <i class="bi bi-printer"></i> Send to Printing
          </button>
        <% } else if (order.status === 'PRINTING') { %>
          <button class="btn btn-serene-primary" onclick="setOrderStatus(<%= order.id %>, 'READY')">
            <i class="bi bi-box-seam"></i> Mark Ready
          </button>
        <% } else if (order.status === 'READY') { %>
          <button class="btn btn-serene-primary" onclick="openCompleteOrderModal(<%= order.id %>, '<%= order.orderNumber %>', <%= order.balanceAmount %>, <%= order.totalAmount %>, <%= order.advancePaid %>)">
            <i class="bi bi-check-circle"></i> Complete & Deliver
          </button>
        <% } %>

        <% if (order.status !== 'CANCELLED') { %>
          <button type="button" class="btn btn-outline-warning text-dark d-inline-flex align-items-center gap-1 shadow-xs" onclick="openOrderWastageModal()">
            <i class="bi bi-trash2"></i> Record Misprint / Wastage
          </button>
        <% } %>

        <% if (order.status !== 'CANCELLED' && order.status !== 'COMPLETED') { %>
          <button class="btn btn-outline-danger d-inline-flex align-items-center gap-1 shadow-xs" onclick="openOrderCancelModal(<%= order.id %>, '<%= order.orderNumber %>', '<%= escape(order.jobTitle) %>')">
            <i class="bi bi-x-circle"></i> Remove from Queue
          </button>
        <% } else if (order.status === 'CANCELLED') { %>
          <button class="btn btn-danger d-inline-flex align-items-center gap-1 shadow-xs" onclick="openOrderDeleteModal(<%= order.id %>, '<%= order.orderNumber %>', '<%= escape(order.jobTitle) %>')">
            <i class="bi bi-trash-fill"></i> Permanently Delete Record
          </button>
        <% } %>
      </div>
    </div>

    <% if (order.status === 'CANCELLED') { %>
      <div class="alert alert-danger d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4 p-3 border-danger-subtle shadow-xs rounded-3">
        <div class="d-flex align-items-center gap-3">
          <div class="p-2 rounded-circle bg-danger text-white d-flex align-items-center justify-content-center" style="width: 42px; height: 42px;">
            <i class="bi bi-x-octagon-fill fs-4"></i>
          </div>
          <div>
            <div class="fw-bold text-danger fs-6">Order Cancelled</div>
            <div class="small text-muted">This order was cancelled and removed from active production queues. You can permanently delete this record if needed.</div>
          </div>
        </div>
        <div>
          <button class="btn btn-sm btn-danger d-inline-flex align-items-center gap-1 shadow-xs" onclick="openOrderDeleteModal(<%= order.id %>, '<%= order.orderNumber %>', '<%= escape(order.jobTitle) %>')">
            <i class="bi bi-trash-fill"></i> Permanently Delete Record
          </button>
        </div>
      </div>
    <% } %>

    <% if (order.status === 'COMPLETED') { %>
      <div class="alert alert-success d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4 p-3 border-success-subtle shadow-xs rounded-3">
        <div class="d-flex align-items-center gap-3">
          <div class="p-2 rounded-circle bg-success text-white d-flex align-items-center justify-content-center" style="width: 42px; height: 42px;">
            <i class="bi bi-check-lg fs-4"></i>
          </div>
          <div>
            <div class="fw-bold text-success fs-6">Order Completed & Delivered</div>
            <div class="small text-muted">This order has been completed and handed over to the client.</div>
          </div>
        </div>
        <div class="d-flex align-items-center gap-2">
          <% if (parseFloat(order.balanceAmount) <= 0) { %>
            <span class="badge bg-success text-white px-3 py-2 fs-6">
              <i class="bi bi-shield-check me-1"></i> Paid in Full (<%= currencySymbol %> <%= parseFloat(order.totalAmount).toLocaleString('en-LK', { minimumFractionDigits: 2 }) %>)
            </span>
          <% } else { %>
            <span class="badge bg-warning text-dark px-3 py-2 fs-6">
              <i class="bi bi-exclamation-circle me-1"></i> Delivered on Credit (Due: <%= currencySymbol %> <%= parseFloat(order.balanceAmount).toLocaleString('en-LK', { minimumFractionDigits: 2 }) %>)
            </span>
            <button class="btn btn-sm btn-serene-primary" onclick="openPaymentModal(<%= order.id %>, <%= order.balanceAmount %>)">
              <i class="bi bi-cash me-1"></i> Settle Remaining Balance
            </button>
          <% } %>
        </div>
      </div>
    <% } %>

    <div class="row g-4">
      <!-- Left: Job Details & Specifications (7 cols) -->
      <div class="col-lg-7">
        <div class="serene-card mb-4">
          <div class="serene-card-header">
            <h3 class="serene-card-title"><i class="bi bi-file-earmark-text me-2 text-muted"></i> Job Specifications</h3>
          </div>
          <div class="serene-card-body">
            <h4 class="fs-5 fw-bold mb-2"><%= order.jobTitle %></h4>
            <div class="d-flex flex-wrap gap-2 mb-3">
              <span class="spec-chip"><i class="bi bi-boxes me-1"></i> Quantity: <strong><%= order.quantity %></strong></span>
              <% if (order.paperMaterial) { %>
                <span class="spec-chip" style="background: #f0fdf4; border-color: #bbf7d0;"><i class="bi bi-box-seam text-success me-1"></i> Material: <strong class="text-success"><%= order.paperMaterial %></strong></span>
              <% } %>
              <% if (order.stockDeducted) { %>
                <span class="spec-chip" style="background: #eff6ff; border-color: #bfdbfe; color: #1e40af;"><i class="bi bi-box-arrow-down me-1"></i> Office Use: <strong><%= parseFloat(order.stockDeductedQty) %> units deducted</strong></span>
              <% } %>
              <% if (parseFloat(order.wastageQty) > 0) { %>
                <span class="spec-chip" style="background: #fdf2f8; border-color: #fbcfe8; color: #9d174d;"><i class="bi bi-trash2 me-1"></i> Misprints / Wastage: <strong><%= parseFloat(order.wastageQty) %> units removed</strong></span>
              <% } %>
            </div>

            <% if (order.specifications) { %>
              <div class="mb-3">
                <span class="fw-semibold small text-muted d-block mb-1">Customer Customization & Specific Instructions:</span>
                <div class="p-3 rounded-2 bg-light border text-dark small" style="white-space: pre-line;"><%= order.specifications %></div>
              </div>
            <% } %>

            <div class="row g-3 small text-muted">
              <div class="col-6">
                <span>Order Placed:</span> <strong class="text-dark"><%= order.orderDate %></strong>
              </div>
              <div class="col-6">
                <span>Target Due Date:</span> <strong class="text-dark"><%= order.dueDate || 'Standard Turnaround' %></strong>
              </div>
            </div>

            <% if (order.notes) { %>
              <div class="mt-3 pt-3 border-top small">
                <span class="fw-semibold text-muted d-block">Internal Production Notes:</span>
                <div class="text-dark" style="white-space: pre-line;"><%= order.notes %></div>
              </div>
            <% } %>
          </div>
        </div>

        <!-- Material Usage & Inventory Tracking Card -->
        <div class="serene-card">
          <div class="serene-card-header d-flex flex-wrap align-items-center justify-content-between gap-2">
            <h3 class="serene-card-title"><i class="bi bi-layers-half text-primary me-2"></i> Printing Materials & Inventory Tracking</h3>
            <button class="btn btn-sm btn-outline-warning text-dark py-1 px-2 d-inline-flex align-items-center gap-1 shadow-xs" onclick="openOrderWastageModal()">
              <i class="bi bi-trash2"></i> Record Misprint / Wastage
            </button>
          </div>
          <div class="serene-card-body p-3">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 p-2 rounded-2 mb-2" style="background: #f8fafc; border: 1px solid #e2e8f0;">
              <div>
                <span class="text-muted small d-block">Printing Paper / Substrate:</span>
                <strong class="text-dark"><%= order.paperMaterial || 'Standard / Unspecified' %></strong>
                <% if (order.stockItem) { %>
                  <span class="badge bg-light text-muted border ms-1 small">Stock: <%= order.stockItem.currentStock %> <%= order.stockItem.unit %></span>
                <% } %>
              </div>
              <div class="text-end">
                <span class="text-muted small d-block">Automatic Office Use Deduction:</span>
                <% if (order.stockDeducted) { %>
                  <span class="badge bg-success-subtle text-success border border-success-subtle"><i class="bi bi-check2-circle me-1"></i> <%= parseFloat(order.stockDeductedQty) %> <%= (order.stockItem ? order.stockItem.unit : 'Sheets') %> Deducted</span>
                <% } else { %>
                  <span class="badge bg-light text-muted border">No auto-deduction</span>
                <% } %>
              </div>
            </div>

            <% if (parseFloat(order.wastageQty) > 0) { %>
              <div class="d-flex align-items-center justify-content-between p-2 rounded-2 mb-2" style="background: #fff1f2; border: 1px solid #fecdd3;">
                <div class="small text-danger">
                  <i class="bi bi-exclamation-triangle-fill me-1"></i> <strong><%= parseFloat(order.wastageQty) %> sheets</strong> recorded as misprints / damaged paper and removed from stock.
                </div>
              </div>
            <% } %>

            <div class="d-flex align-items-center justify-content-between text-muted small mt-2">
              <span>If any sheets were not printed well or damaged during printing:</span>
              <button class="btn btn-sm btn-link text-warning-emphasis p-0 text-decoration-none fw-semibold" onclick="openOrderWastageModal()">
                + Manually Remove Spoiled Materials &rarr;
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Right: Financial Summary & Customer Info (5 cols) -->
      <div class="col-lg-5">
        <!-- Financial Card -->
        <div class="serene-card mb-4">
          <div class="serene-card-header d-flex flex-wrap align-items-center justify-content-between gap-2">
            <h3 class="serene-card-title mb-0">Financials, Payments & Discounts</h3>
            <div class="d-flex align-items-center gap-1">
              <button class="btn btn-sm btn-outline-secondary py-1 px-2" onclick="openOrderDiscountModal(<%= order.id %>, <%= order.discount || 0 %>)">
                <i class="bi bi-percent"></i> Manual Discount
              </button>
              <% if (parseFloat(order.balanceAmount) > 0) { %>
                <button class="btn btn-serene-primary py-1 px-2 small" onclick="openPaymentModal(<%= order.id %>, <%= order.balanceAmount %>)">
                  + Record Payment
                </button>
              <% } %>
            </div>
          </div>
          <div class="serene-card-body">
            <% const oSubtotal = parseFloat(order.subtotal) || parseFloat(order.totalAmount) || 0; %>
            <% const oDiscount = parseFloat(order.discount) || 0; %>
            <div class="d-flex justify-content-between py-1 text-muted small">
              <span>Subtotal Amount:</span>
              <span class="fw-semibold text-dark tabular-nums">
                <%= currencySymbol %> <%= oSubtotal.toLocaleString('en-LK', { minimumFractionDigits: 2 }) %>
              </span>
            </div>
            <% if (oDiscount > 0) { %>
              <div class="d-flex justify-content-between py-1 text-primary small">
                <span>Manual Discount:</span>
                <span class="fw-semibold tabular-nums">
                  -<%= currencySymbol %> <%= oDiscount.toLocaleString('en-LK', { minimumFractionDigits: 2 }) %>
                </span>
              </div>
            <% } %>
            <div class="d-flex justify-content-between py-1 text-muted small">
              <span>Net Total Job Price:</span>
              <span class="fs-6 fw-bold text-dark tabular-nums">
                <%= currencySymbol %> <%= parseFloat(order.totalAmount).toLocaleString('en-LK', { minimumFractionDigits: 2 }) %>
              </span>
            </div>
            <div class="d-flex justify-content-between py-1 text-success small">
              <span>Given Amount (Paid):</span>
              <span class="fw-bold tabular-nums">
                <%= currencySymbol %> <%= parseFloat(order.advancePaid).toLocaleString('en-LK', { minimumFractionDigits: 2 }) %>
              </span>
            </div>
            <hr class="my-2">
            <div class="d-flex justify-content-between py-1">
              <span class="fw-bold <%= parseFloat(order.balanceAmount) > 0 ? 'text-danger' : 'text-success' %>">Yet to Give (Balance Due):</span>
              <span class="fs-5 fw-bold tabular-nums <%= parseFloat(order.balanceAmount) > 0 ? 'text-danger' : 'text-success' %>">
                <%= currencySymbol %> <%= parseFloat(order.balanceAmount).toLocaleString('en-LK', { minimumFractionDigits: 2 }) %>
              </span>
            </div>
          </div>
        </div>

        <!-- Bank Payment Slip Review & Verification Card -->
        <div class="serene-card mb-4" id="bankSlipCard">
          <div class="serene-card-header d-flex flex-wrap align-items-center justify-content-between gap-2">
            <h3 class="serene-card-title mb-0">
              <i class="bi bi-bank me-2 text-primary"></i> Online Bank Transfer Slip
            </h3>
            <% if (order.paymentSlipStatus === 'PENDING_VERIFICATION') { %>
              <span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split me-1"></i> Awaiting Verification</span>
            <% } else if (order.paymentSlipStatus === 'VERIFIED') { %>
              <span class="badge bg-success"><i class="bi bi-patch-check-fill me-1"></i> Verified & Credited</span>
            <% } else if (order.paymentSlipStatus === 'REJECTED') { %>
              <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i> Rejected</span>
            <% } else { %>
              <span class="badge bg-light text-muted border">No Slip Uploaded</span>
            <% } %>
          </div>

          <div class="serene-card-body">
            <% if (order.paymentSlipUrl) { %>
              <div class="row g-3 align-items-center mb-3">
                <div class="col-sm-4 text-center">
                  <% const isPdf = (order.paymentSlipUrl || '').toLowerCase().endsWith('.pdf'); %>
                  <% if (isPdf) { %>
                    <div class="p-3 border rounded-3 bg-light text-center">
                      <i class="bi bi-file-earmark-pdf-fill text-danger fs-1 d-block mb-1"></i>
                      <span class="small text-muted d-block mb-2">PDF Document</span>
                      <a href="<%= order.paymentSlipUrl %>" target="_blank" class="btn btn-sm btn-outline-danger">
                        <i class="bi bi-box-arrow-up-right me-1"></i> Open PDF
                      </a>
                    </div>
                  <% } else { %>
                    <a href="<%= order.paymentSlipUrl %>" target="_blank" title="Click to view full image">
                      <img src="<%= order.paymentSlipUrl %>" alt="Payment Slip" class="img-thumbnail rounded-3 shadow-xs" style="max-height: 140px; object-fit: contain;">
                    </a>
                  <% } %>
                </div>

                <div class="col-sm-8 small">
                  <div class="d-flex justify-content-between py-1 border-bottom">
                    <span class="text-muted">Claimed Amount:</span>
                    <strong class="fs-6 text-success tabular-nums"><%= currencySymbol %> <%= parseFloat(order.paymentSlipAmount || 0).toLocaleString('en-LK', { minimumFractionDigits: 2 }) %></strong>
                  </div>
                  <div class="d-flex justify-content-between py-1 border-bottom">
                    <span class="text-muted">Bank Reference #:</span>
                    <span class="font-monospace fw-bold text-dark"><%= order.paymentSlipRef || 'N/A' %></span>
                  </div>
                  <div class="d-flex justify-content-between py-1 border-bottom">
                    <span class="text-muted">Uploaded At:</span>
                    <span class="text-dark"><%= typeof formatSriLankaDateTime !== 'undefined' ? formatSriLankaDateTime(order.paymentSlipUploadedAt) : (order.paymentSlipUploadedAt ? new Date(order.paymentSlipUploadedAt).toLocaleString('en-LK') : 'N/A') %></span>
                  </div>
                  <% if (order.paymentSlipNotes) { %>
                    <div class="py-1">
                      <span class="text-muted d-block">Customer Note:</span>
                      <div class="text-dark p-2 bg-light rounded mt-1"><%= order.paymentSlipNotes %></div>
                    </div>
                  <% } %>
                </div>
              </div>

              <!-- Action Controls for Staff -->
              <% if (order.paymentSlipStatus === 'PENDING_VERIFICATION' || !order.paymentSlipStatus) { %>
                <div class="p-3 rounded-3 bg-warning-subtle border border-warning-subtle d-flex flex-wrap align-items-center justify-content-between gap-2">
                  <div class="small text-dark">
                    <strong>Check bank account:</strong> Verify the transaction against your bank app / SMS before crediting.
                  </div>
                  <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="openRejectSlipModal(<%= order.id %>)">
                      <i class="bi bi-x-circle me-1"></i> Reject Slip
                    </button>
                    <button type="button" class="btn btn-sm btn-success" onclick="openVerifySlipModal(<%= order.id %>, '<%= order.orderNumber %>', <%= order.paymentSlipAmount || order.balanceAmount %>)">
                      <i class="bi bi-check-circle-fill me-1"></i> Verify & Credit Payment
                    </button>
                  </div>
                </div>
              <% } else if (order.paymentSlipStatus === 'VERIFIED') { %>
                <div class="p-2 px-3 rounded-2 bg-success-subtle border border-success-subtle text-success small d-flex align-items-center gap-2">
                  <i class="bi bi-check-circle-fill fs-5"></i>
                  <div>Payment slip verified and successfully credited as Bank Transfer to order ledger.</div>
                </div>
              <% } else if (order.paymentSlipStatus === 'REJECTED') { %>
                <div class="p-2 px-3 rounded-2 bg-danger-subtle border border-danger-subtle text-danger small d-flex align-items-center gap-2">
                  <i class="bi bi-exclamation-octagon-fill fs-5"></i>
                  <div>This slip was rejected. The customer can re-upload a valid slip from their portal.</div>
                </div>
              <% } %>
            <% } else { %>
              <div class="text-center py-3 text-muted small">
                <i class="bi bi-receipt fs-3 d-block mb-1 text-muted"></i>
                No online bank transfer slip uploaded yet.
                <div class="text-muted mt-1" style="font-size: 0.73rem;">If the customer transfers funds online, their receipt screenshot will appear here for one-click verification.</div>
              </div>
            <% } %>
          </div>
        </div>

        <!-- Customer Card -->
        <div class="serene-card">
          <div class="serene-card-header">
            <h3 class="serene-card-title">Customer Information</h3>
            <span class="badge bg-light text-muted border font-monospace"><%= order.customer ? order.customer.customerCode : '' %></span>
          </div>
          <div class="serene-card-body small">
            <% if (order.customer) { %>
              <div class="mb-2">
                <span class="text-muted d-block">Client Name</span>
                <strong class="fs-6 text-dark"><%= order.customer.name %></strong>
              </div>
              <div class="mb-2">
                <span class="text-muted d-block">Phone Contact</span>
                <span class="text-dark"><i class="bi bi-telephone me-1"></i> <%= order.customer.phone %></span>
              </div>
              <% if (order.customer.companyName) { %>
                <div class="mb-2">
                  <span class="text-muted d-block">Company</span>
                  <span class="text-dark"><%= order.customer.companyName %></span>
                </div>
              <% } %>
              <% if (order.customer.email) { %>
                <div class="mb-2">
                  <span class="text-muted d-block">Email</span>
                  <span class="text-dark"><%= order.customer.email %></span>
                </div>
              <% } %>
              <% if (order.customer.address) { %>
                <div class="mb-2">
                  <span class="text-muted d-block">Address</span>
                  <span class="text-dark"><%= order.customer.address %></span>
                </div>
              <% } %>
            <% } else { %>
              <div class="text-muted">No customer details recorded.</div>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Complete & Deliver Modal -->
  <div class="modal fade" id="completeOrderModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content shadow-lg border-0 rounded-4">
        <div class="modal-header bg-success text-white">
          <h5 class="modal-title fw-bold">
            <i class="bi bi-check-circle-fill me-2"></i> Complete & Deliver Order
          </h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <form id="completeOrderForm" onsubmit="submitCompleteOrder(event)">
          <div class="modal-body p-4">
            <input type="hidden" id="completeOrderId">
            
            <div class="p-3 rounded-3 bg-light border mb-3">
              <div class="d-flex justify-content-between small text-muted mb-1">
                <span>Order Reference:</span>
                <strong class="font-monospace text-dark" id="modalOrderNumber"></strong>
              </div>
              <div class="d-flex justify-content-between small text-muted mb-1">
                <span>Net Total Job Price:</span>
                <strong class="text-dark tabular-nums" id="modalOrderTotal"></strong>
              </div>
              <div class="d-flex justify-content-between small text-success mb-1">
                <span>Given Amount (Paid Advance):</span>
                <strong class="tabular-nums" id="modalOrderAdvance"></strong>
              </div>
              <hr class="my-2">
              <div class="d-flex justify-content-between fw-bold">
                <span id="modalBalanceLabel">Outstanding Balance Due:</span>
                <span class="fs-5 tabular-nums text-danger" id="modalOrderBalance"></span>
              </div>
            </div>

            <!-- Payment Options (Only shown if balance > 0) -->
            <div id="paymentOptionsSection">
              <label class="form-label fw-bold text-dark mb-2">Customer Payment Settlement on Delivery:</label>
              
              <div class="form-check p-3 rounded-3 border mb-2" style="background: #f0fdf4; border-color: #bbf7d0 !important;">
                <input class="form-check-input" type="radio" name="paymentOption" id="optFullBalance" value="FULL" checked onchange="togglePaymentInputs()">
                <label class="form-check-label fw-semibold text-success ms-1" for="optFullBalance">
                  Collect Full Balance Now (<span id="optFullBalanceText"></span>) - <span class="badge bg-success text-white">Paid in Full</span>
                </label>
                <div class="small text-muted ms-4">The customer pays the remaining amount at the counter on collection.</div>
              </div>

              <div class="form-check p-3 rounded-3 border mb-2">
                <input class="form-check-input" type="radio" name="paymentOption" id="optPartial" value="PARTIAL" onchange="togglePaymentInputs()">
                <label class="form-check-label fw-semibold text-dark ms-1" for="optPartial">
                  Collect Partial Payment
                </label>
                <div id="partialInputContainer" class="mt-2 ms-4" style="display: none;">
                  <div class="input-group input-group-sm">
                    <span class="input-group-text"><%= currencySymbol %></span>
                    <input type="number" id="partialPaymentAmount" class="form-control" placeholder="Amount collected" min="0.01" step="any">
                  </div>
                  <small class="text-muted">Remaining amount will remain as balance due.</small>
                </div>
              </div>

              <div class="form-check p-3 rounded-3 border mb-3" style="background: #fffbeb; border-color: #fde68a !important;">
                <input class="form-check-input" type="radio" name="paymentOption" id="optCredit" value="CREDIT" onchange="togglePaymentInputs()">
                <label class="form-check-label fw-semibold text-warning-emphasis ms-1" for="optCredit">
                  Deliver on Credit (No payment collected now)
                </label>
                <div class="small text-muted ms-4">Order is completed, but balance remains on customer ledger.</div>
              </div>

              <div id="paymentMethodGroup" class="mb-3">
                <label class="form-label small fw-semibold text-muted">Payment Method:</label>
                <select id="completePaymentMethod" class="form-select form-select-sm">
                  <option value="CASH">Cash at Counter</option>
                  <option value="CARD">Credit/Debit Card (POS)</option>
                  <option value="BANK_TRANSFER">Bank Transfer / QR Pay</option>
                </select>
              </div>

              <!-- Money Got / Add to POS Switch -->
              <div class="form-check form-switch p-3 bg-light rounded-3 border mb-3">
                <input class="form-check-input ms-0 me-2" type="checkbox" id="completeAddToPos" checked style="cursor: pointer; transform: scale(1.15);">
                <label class="form-check-label fw-bold text-dark" for="completeAddToPos" style="cursor: pointer;">
                  💰 Money Received - Record in POS System Register
                </label>
                <div class="text-muted small ps-4 mt-1">
                  Automatically syncs this collected amount into Point of Sale (POS) daily cash/register receipts.
                </div>
              </div>
            </div>

            <div class="mb-3">
              <label class="form-label small fw-semibold text-muted">Handover Notes (Optional):</label>
              <input type="text" id="completeOrderNotes" class="form-control form-control-sm" placeholder="e.g. Handed over to client directly, package checked">
            </div>
          </div>
          <div class="modal-footer bg-light border-0">
            <button type="button" class="btn btn-serene-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-success fw-bold px-4" id="btnConfirmComplete">
              <i class="bi bi-check2-circle me-1"></i> Confirm & Complete
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Remove / Cancel Order Modal -->
  <div class="modal fade" id="orderCancelModal" tabindex="-1" aria-labelledby="orderCancelModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content shadow-lg border-0" style="border-radius: var(--serene-radius-lg);">
        <div class="modal-header py-3 px-4 border-bottom bg-light">
          <div class="d-flex align-items-center gap-2">
            <div class="p-2 rounded-2 bg-danger-subtle text-danger d-flex align-items-center justify-content-center">
              <i class="bi bi-x-octagon-fill fs-5"></i>
            </div>
            <div>
              <h5 class="modal-title fw-bold fs-6 mb-0 text-dark" id="orderCancelModalLabel">Remove Order from Queue</h5>
              <div class="text-muted small">Cancel production and remove order from active queue</div>
            </div>
          </div>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>

        <div class="modal-body p-4">
          <div class="alert alert-warning py-2 px-3 mb-3 border-warning-subtle small d-flex align-items-start gap-2">
            <i class="bi bi-exclamation-triangle-fill text-warning flex-shrink-0 mt-1"></i>
            <div>
              You are about to cancel order <strong id="orderCancelOrderNum" class="font-monospace text-dark"></strong> (<span id="orderCancelJobTitle"></span>). This will mark it as <strong>CANCELLED</strong> and remove it from active production queues.
            </div>
          </div>

          <input type="hidden" id="orderCancelModalId" value="">

          <div class="mb-3">
            <label class="form-label fw-semibold small text-dark mb-1">Reason for Removal / Cancellation <span class="text-danger">*</span></label>
            <select class="form-select form-select-sm" id="orderCancelReasonSelect" onchange="window.handleOrderCancelReasonChange(this.value)">
              <option value="Customer requested cancellation / changed mind" selected>Customer requested cancellation / changed mind</option>
              <% if (order.orderType === 'PHOTO_FRAME') { %>
                <option value="Frame size / moulding material currently out of stock">Frame size / moulding material currently out of stock</option>
              <% } else { %>
                <option value="Paper substrate / printing material currently out of stock">Paper substrate / printing material currently out of stock</option>
              <% } %>
              <option value="Customer walked out / did not confirm specifications">Customer walked out / did not confirm specifications</option>
              <option value="Wrong dimensions or artwork resolution entered">Wrong dimensions or artwork resolution entered</option>
              <option value="Duplicate order entry created by mistake">Duplicate order entry created by mistake</option>
              <option value="OTHER">Other Reason (Specify below)...</option>
            </select>
          </div>

          <div class="mb-3 d-none" id="orderCancelCustomReasonGroup">
            <label class="form-label fw-semibold small text-dark mb-1">Specific Cancellation Details</label>
            <textarea class="form-control form-control-sm" id="orderCancelCustomReason" rows="2" placeholder="Explain reason for cancellation..."></textarea>
          </div>
        </div>

        <div class="modal-footer py-2 px-4 border-top bg-light">
          <button type="button" class="btn btn-sm btn-secondary px-3" data-bs-dismiss="modal">Keep in Queue</button>
          <button type="button" class="btn btn-sm btn-danger px-3 d-inline-flex align-items-center gap-1 fw-bold shadow-xs" id="confirmOrderCancelBtn" onclick="window.submitOrderCancel()">
            <i class="bi bi-trash"></i> Confirm & Remove from Queue
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal: Record Misprinted / Damaged Material (Manual Removal) -->
  <div class="modal fade" id="orderWastageModal" tabindex="-1" aria-labelledby="orderWastageModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content shadow-lg border-0" style="border-radius: var(--serene-radius-lg);">
        <div class="modal-header py-3 px-4 border-bottom bg-light">
          <div class="d-flex align-items-center gap-2">
            <div class="p-2 rounded-2 bg-warning-subtle text-warning-emphasis d-flex align-items-center justify-content-center">
              <i class="bi bi-trash2-fill fs-5"></i>
            </div>
            <div>
              <h5 class="modal-title fw-bold fs-6 mb-0 text-dark" id="orderWastageModalLabel">Record Misprinted / Damaged Material</h5>
              <div class="text-muted small">Manually remove spoiled sheets from inventory for Order #<%= order.orderNumber %></div>
            </div>
          </div>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>

        <div class="modal-body p-4">
          <div class="alert alert-warning py-2 px-3 mb-3 border-warning-subtle small d-flex align-items-start gap-2">
            <i class="bi bi-info-circle-fill text-warning flex-shrink-0 mt-1"></i>
            <div>
              If paper sheets were not printed well, ink-smeared, or damaged during printing, enter the spoiled quantity here to manually remove them from inventory as wastage.
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold small text-dark mb-1">Select Material to Deduct <span class="text-danger">*</span></label>
            <select class="form-select form-select-sm" id="wastageStockItemSelect">
              <% if (typeof stockItems !== 'undefined' && stockItems.length > 0) { %>
                <% stockItems.forEach(item => { %>
                  <option value="<%= item.id %>" <%= (order.stockItemId === item.id || (order.paperMaterial && item.name.toLowerCase().includes(order.paperMaterial.toLowerCase()))) ? 'selected' : '' %>>
                    <%= item.name %> (<%= item.currentStock %> <%= item.unit %> available)
                  </option>
                <% }) %>
              <% } else { %>
                <option value="<%= order.stockItemId || '' %>"><%= order.paperMaterial || 'Order Material' %></option>
              <% } %>
            </select>
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold small text-dark mb-1">Misprinted / Damaged Quantity <span class="text-danger">*</span></label>
            <div class="input-group input-group-sm">
              <input type="number" class="form-control" id="wastageQuantityInput" placeholder="e.g. 10" min="1" step="any" value="10">
              <span class="input-group-text">Sheets / Units</span>
            </div>
            <div class="text-muted" style="font-size: 0.72rem;">Example: 10 sheets were not printed well and need to be removed.</div>
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold small text-dark mb-1">Reason for Removal <span class="text-danger">*</span></label>
            <select class="form-select form-select-sm" id="wastageReasonSelect">
              <option value="WASTAGE" selected>Misprint / Scrap (Not printed well / Ink smear)</option>
              <option value="DAMAGED">Damaged Paper / Paper Jam</option>
              <option value="OFFICE_USE">Internal Shop / Test Calibration</option>
              <option value="OTHER">Other Manual Removal</option>
            </select>
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold small text-dark mb-1">Notes / Explanation</label>
            <input type="text" class="form-control form-control-sm" id="wastageNotesInput" placeholder="e.g. 10 sheets not printed well during print run" value="10 sheets not printed well during print run">
          </div>
        </div>

        <div class="modal-footer py-2 px-4 border-top bg-light">
          <button type="button" class="btn btn-sm btn-secondary px-3" data-bs-dismiss="modal">Cancel</button>
          <button type="button" class="btn btn-sm btn-warning text-dark px-3 d-inline-flex align-items-center gap-1 fw-bold shadow-xs" id="confirmWastageBtn" onclick="submitOrderWastage()">
            <i class="bi bi-box-arrow-down"></i> Deduct & Remove from Stock
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Permanent Delete Order Modal -->
  <div class="modal fade" id="orderDeleteModal" tabindex="-1" aria-labelledby="orderDeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content shadow-lg border-0" style="border-radius: var(--serene-radius-lg);">
        <div class="modal-header py-3 px-4 border-bottom bg-danger text-white">
          <div class="d-flex align-items-center gap-2">
            <i class="bi bi-trash3-fill fs-5"></i>
            <h5 class="modal-title fw-bold fs-6 mb-0" id="orderDeleteModalLabel">Permanently Delete Order</h5>
          </div>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>

        <div class="modal-body p-4 text-center">
          <div class="mb-3">
            <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-danger-subtle text-danger" style="width: 60px; height: 60px;">
              <i class="bi bi-exclamation-triangle-fill fs-3"></i>
            </span>
          </div>
          <h5 class="fw-bold mb-2">Delete <span id="orderDeleteOrderNum" class="font-monospace text-danger"></span>?</h5>
          <p class="text-muted small mb-0" style="line-height: 1.6;">
            You are about to permanently delete <strong id="orderDeleteJobTitle"></strong>. All order data, payments, and slips will be removed from the database permanently. <strong>This action cannot be undone.</strong>
          </p>
          <input type="hidden" id="orderDeleteModalId" value="">
        </div>

        <div class="modal-footer py-2 px-4 border-top bg-light d-flex justify-content-between">
          <button type="button" class="btn btn-sm btn-secondary px-3" data-bs-dismiss="modal">Cancel</button>
          <button type="button" class="btn btn-sm btn-danger px-3 d-inline-flex align-items-center gap-1 fw-bold shadow-xs" id="confirmOrderDeleteBtn" onclick="submitOrderDelete()">
            <i class="bi bi-trash-fill"></i> Yes, Permanently Delete
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Verify Bank Payment Slip Modal -->
  <div class="modal fade" id="verifySlipModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content shadow-lg border-0 rounded-4">
        <div class="modal-header bg-success text-white">
          <h5 class="modal-title fw-bold">
            <i class="bi bi-patch-check-fill me-2"></i> Verify & Credit Bank Payment
          </h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <form id="verifySlipForm" onsubmit="submitVerifySlip(event)">
          <div class="modal-body p-4">
            <input type="hidden" id="verifySlipOrderId">

            <div class="alert alert-success border-success-subtle small mb-3">
              <i class="bi bi-shield-check me-1"></i> Confirming will credit this amount as a <strong>Bank Transfer payment</strong> to the order ledger and deduct the remaining balance.
            </div>

            <div class="mb-3">
              <label class="form-label small fw-semibold text-muted">Order Reference:</label>
              <input type="text" class="form-control font-monospace bg-light" id="verifySlipOrderNum" readonly>
            </div>

            <div class="mb-3">
              <label class="form-label small fw-semibold text-muted" for="verifySlipAmountInput">
                Verified Amount Received (<%= currencySymbol %>) *
              </label>
              <input type="number" step="0.01" min="1" class="form-control tabular-nums fw-bold fs-5 text-success" id="verifySlipAmountInput" required>
            </div>

            <div class="mb-3">
              <label class="form-label small fw-semibold text-muted" for="verifySlipNotes">
                Internal Verification Notes (Optional):
              </label>
              <input type="text" class="form-control" id="verifySlipNotes" placeholder="e.g. Funds verified in Commercial Bank online banking">
            </div>
          </div>
          <div class="modal-footer bg-light p-3">
            <button type="button" class="btn btn-serene-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-success fw-bold px-3" id="btnConfirmVerifySlip">
              <i class="bi bi-check-circle-fill me-1"></i> Verify & Credit Now
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Reject Bank Payment Slip Modal -->
  <div class="modal fade" id="rejectSlipModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content shadow-lg border-0 rounded-4">
        <div class="modal-header bg-danger text-white">
          <h5 class="modal-title fw-bold">
            <i class="bi bi-x-octagon-fill me-2"></i> Reject Payment Slip
          </h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <form id="rejectSlipForm" onsubmit="submitRejectSlip(event)">
          <div class="modal-body p-4">
            <input type="hidden" id="rejectSlipOrderId">

            <p class="text-muted small mb-3">
              Please enter the reason for rejection. The customer will be informed on their portal to submit a clear, valid bank receipt screenshot.
            </p>

            <div class="mb-3">
              <label class="form-label small fw-semibold text-muted" for="rejectSlipNotes">
                Reason for Rejection *
              </label>
              <textarea class="form-control" id="rejectSlipNotes" rows="3" required placeholder="e.g. Transaction amount does not match, image is illegible, or transfer not received in shop account..."></textarea>
            </div>
          </div>
          <div class="modal-footer bg-light p-3">
            <button type="button" class="btn btn-serene-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-danger fw-bold px-3" id="btnConfirmRejectSlip">
              <i class="bi bi-x-circle me-1"></i> Reject Slip
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>

<script>
let activeModalBalance = 0;

function openCompleteOrderModal(orderId, orderNumber, balance, total, advance) {
  activeModalBalance = parseFloat(balance) || 0;
  document.getElementById('completeOrderId').value = orderId;
  document.getElementById('modalOrderNumber').textContent = orderNumber;
  document.getElementById('modalOrderTotal').textContent = '<%= currencySymbol %> ' + parseFloat(total || 0).toLocaleString('en-LK', { minimumFractionDigits: 2 });
  document.getElementById('modalOrderAdvance').textContent = '<%= currencySymbol %> ' + parseFloat(advance || 0).toLocaleString('en-LK', { minimumFractionDigits: 2 });
  document.getElementById('modalOrderBalance').textContent = '<%= currencySymbol %> ' + activeModalBalance.toLocaleString('en-LK', { minimumFractionDigits: 2 });
  
  const paymentSection = document.getElementById('paymentOptionsSection');
  const fullText = document.getElementById('optFullBalanceText');

  if (activeModalBalance > 0) {
    paymentSection.style.display = 'block';
    fullText.textContent = '<%= currencySymbol %> ' + activeModalBalance.toLocaleString('en-LK', { minimumFractionDigits: 2 });
    document.getElementById('optFullBalance').checked = true;
    document.getElementById('partialPaymentAmount').value = '';
    document.getElementById('partialPaymentAmount').max = activeModalBalance;
    togglePaymentInputs();
  } else {
    paymentSection.style.display = 'none';
    document.getElementById('modalBalanceLabel').textContent = 'Order Payment Status:';
    document.getElementById('modalOrderBalance').className = 'fs-5 tabular-nums text-success';
    document.getElementById('modalOrderBalance').textContent = 'Paid in Full (Rs. 0.00 Due)';
  }

  const modal = new bootstrap.Modal(document.getElementById('completeOrderModal'));
  modal.show();
}

function togglePaymentInputs() {
  const isPartial = document.getElementById('optPartial').checked;
  const isCredit = document.getElementById('optCredit').checked;
  const partialContainer = document.getElementById('partialInputContainer');
  const methodGroup = document.getElementById('paymentMethodGroup');

  partialContainer.style.display = isPartial ? 'block' : 'none';
  methodGroup.style.display = isCredit ? 'none' : 'block';
}

async function submitCompleteOrder(e) {
  e.preventDefault();
  const orderId = document.getElementById('completeOrderId').value;
  const notes = document.getElementById('completeOrderNotes').value.trim();
  const paymentMethod = document.getElementById('completePaymentMethod').value;
  
  let collectFullBalance = false;
  let paymentAmount = 0;

  if (activeModalBalance > 0) {
    const selectedOption = document.querySelector('input[name="paymentOption"]:checked').value;
    if (selectedOption === 'FULL') {
      collectFullBalance = true;
      paymentAmount = activeModalBalance;
    } else if (selectedOption === 'PARTIAL') {
      const pAmt = parseFloat(document.getElementById('partialPaymentAmount').value);
      if (isNaN(pAmt) || pAmt <= 0) {
        toast.error('Please enter a valid partial payment amount.');
        return;
      }
      if (pAmt > activeModalBalance) {
        toast.error('Partial payment cannot exceed the remaining balance.');
        return;
      }
      paymentAmount = pAmt;
    }
  }

  const submitBtn = document.getElementById('btnConfirmComplete');
  submitBtn.disabled = true;
  submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Processing...';

  try {
    const res = await fetch(`/api/orders/${orderId}/status`, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        status: 'COMPLETED',
        collectFullBalance,
        paymentAmount,
        paymentMethod,
        addToPos: document.getElementById('completeAddToPos') ? document.getElementById('completeAddToPos').checked : true,
        notes,
      }),
    });
    const result = await res.json();
    if (result.success) {
      setPendingToast(result.message || 'Order completed and prices updated!', 'success');
      window.location.reload();
    } else {
      toast.error('Failed to complete order: ' + result.message);
      submitBtn.disabled = false;
      submitBtn.innerHTML = '<i class="bi bi-check2-circle me-1"></i> Confirm & Complete';
    }
  } catch (err) {
    toast.error('Request failed: ' + err.message);
    submitBtn.disabled = false;
    submitBtn.innerHTML = '<i class="bi bi-check2-circle me-1"></i> Confirm & Complete';
  }
}

async function setOrderStatus(orderId, newStatus) {
  const confirmed = await window.sereneConfirm({
    title: 'Update Order Status',
    message: `Are you sure you want to transition this order to status: <strong>${newStatus}</strong>?`,
    confirmText: `Move to ${newStatus}`,
    cancelText: 'Cancel',
  });
  if (!confirmed) return;

  try {
    const res = await fetch(`/api/orders/${orderId}/status`, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ status: newStatus }),
    });
    const result = await res.json();
    if (result.success) {
      setPendingToast(result.message || `Order transitioned to ${newStatus}`, 'success');
      window.location.reload();
    } else {
      toast.error('Error: ' + result.message);
    }
  } catch (err) {
    toast.error('Request failed: ' + err.message);
  }
}

async function openPaymentModal(orderId, balance) {
  const amount = await window.serenePrompt({
    title: 'Record Payment (Update Given & Balance)',
    message: `Enter the payment amount collected for this order.<br><span class="text-danger fw-bold small">Current Yet to Give (Due): Rs. ${parseFloat(balance).toLocaleString('en-LK', { minimumFractionDigits: 2 })}</span>`,
    label: 'Payment Amount Collected (Rs.) *',
    defaultValue: balance,
    placeholder: 'Enter amount',
    type: 'number',
    min: 0.01,
    max: balance,
    step: 'any',
    confirmText: 'Record Payment',
    cancelText: 'Cancel',
  });
  if (!amount) return;

  try {
    const res = await fetch(`/api/orders/${orderId}/payment`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ amount: parseFloat(amount), addToPos: true }),
    });
    const result = await res.json();
    if (result.success) {
      setPendingToast(result.message, 'success');
      window.location.reload();
    } else {
      toast.error('Payment failed: ' + result.message);
    }
  } catch (err) {
    toast.error('Request failed: ' + err.message);
  }
}

async function openOrderDiscountModal(orderId, currentDiscount) {
  const discount = await window.serenePrompt({
    title: 'Update Manual Discount',
    message: 'Enter manual discount in rupees. The net total job price and yet to give balance will recalculate automatically.',
    label: 'Manual Discount Amount (Rs.) *',
    defaultValue: currentDiscount || 0,
    placeholder: '0.00',
    type: 'number',
    min: 0,
    step: 'any',
    confirmText: 'Apply Discount',
    cancelText: 'Cancel',
  });
  if (discount === null || discount === undefined || discount === '') return;

  try {
    const res = await fetch(`/api/orders/${orderId}/discount`, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ discount: parseFloat(discount) || 0 }),
    });
    const result = await res.json();
    if (result.success) {
      setPendingToast(result.message, 'success');
      window.location.reload();
    } else {
      toast.error('Failed to update discount: ' + result.message);
    }
  } catch (err) {
    toast.error('Request failed: ' + err.message);
  }
}

// Online Bank Transfer Slip Verification Handlers
function openVerifySlipModal(orderId, orderNum, amount) {
  document.getElementById('verifySlipOrderId').value = orderId;
  document.getElementById('verifySlipOrderNum').value = orderNum;
  document.getElementById('verifySlipAmountInput').value = parseFloat(amount || 0).toFixed(2);
  document.getElementById('verifySlipNotes').value = '';
  const modal = new bootstrap.Modal(document.getElementById('verifySlipModal'));
  modal.show();
}

async function submitVerifySlip(e) {
  e.preventDefault();
  const orderId = document.getElementById('verifySlipOrderId').value;
  const verifiedAmount = document.getElementById('verifySlipAmountInput').value;
  const notes = document.getElementById('verifySlipNotes').value;
  const btn = document.getElementById('btnConfirmVerifySlip');

  btn.disabled = true;
  btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Processing...';

  try {
    const res = await fetch(`/api/orders/${orderId}/verify-slip`, {
      method: 'PUT',
      headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/json'
      },
      body: JSON.stringify({
        action: 'VERIFY',
        verifiedAmount: parseFloat(verifiedAmount),
        notes
      })
    });
    const result = await res.json();
    if (result.success) {
      setPendingToast(result.message, 'success');
      window.location.reload();
    } else {
      toast.error('Verification failed: ' + result.message);
    }
  } catch (err) {
    toast.error('Request failed: ' + err.message);
  } finally {
    btn.disabled = false;
    btn.innerHTML = '<i class="bi bi-check-circle-fill me-1"></i> Verify & Credit Now';
  }
}

function openRejectSlipModal(orderId) {
  document.getElementById('rejectSlipOrderId').value = orderId;
  document.getElementById('rejectSlipNotes').value = '';
  const modal = new bootstrap.Modal(document.getElementById('rejectSlipModal'));
  modal.show();
}

async function submitRejectSlip(e) {
  e.preventDefault();
  const orderId = document.getElementById('rejectSlipOrderId').value;
  const notes = document.getElementById('rejectSlipNotes').value;
  const btn = document.getElementById('btnConfirmRejectSlip');

  btn.disabled = true;
  btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Rejecting...';

  try {
    const res = await fetch(`/api/orders/${orderId}/verify-slip`, {
      method: 'PUT',
      headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/json'
      },
      body: JSON.stringify({
        action: 'REJECT',
        notes
      })
    });
    const result = await res.json();
    if (result.success) {
      setPendingToast(result.message, 'warning');
      window.location.reload();
    } else {
      toast.error('Rejection failed: ' + result.message);
    }
  } catch (err) {
    toast.error('Request failed: ' + err.message);
  } finally {
    btn.disabled = false;
    btn.innerHTML = '<i class="bi bi-x-circle me-1"></i> Reject Slip';
  }
}

// Cancel / Remove Order from Queue
let orderCancelModalInstance = null;

function openOrderCancelModal(orderId, orderNumber, rawJobTitle) {
  const modalEl = document.getElementById('orderCancelModal');
  if (!modalEl) return;
  if (!orderCancelModalInstance) {
    orderCancelModalInstance = new bootstrap.Modal(modalEl);
  }
  document.getElementById('orderCancelModalId').value = orderId;
  document.getElementById('orderCancelOrderNum').textContent = '#' + orderNumber;
  try {
    document.getElementById('orderCancelJobTitle').textContent = decodeURIComponent(rawJobTitle);
  } catch (e) {
    try {
      document.getElementById('orderCancelJobTitle').textContent = unescape(rawJobTitle);
    } catch (e2) {
      document.getElementById('orderCancelJobTitle').textContent = rawJobTitle;
    }
  }
  document.getElementById('orderCancelReasonSelect').value = 'Customer requested cancellation / changed mind';
  document.getElementById('orderCancelCustomReason').value = '';
  document.getElementById('orderCancelCustomReasonGroup').classList.add('d-none');
  orderCancelModalInstance.show();
}

function handleOrderCancelReasonChange(val) {
  const group = document.getElementById('orderCancelCustomReasonGroup');
  if (val === 'OTHER') {
    group.classList.remove('d-none');
    document.getElementById('orderCancelCustomReason').focus();
  } else {
    group.classList.add('d-none');
  }
}

async function submitOrderCancel() {
  const orderId = document.getElementById('orderCancelModalId').value;
  const selectVal = document.getElementById('orderCancelReasonSelect').value;
  const customVal = document.getElementById('orderCancelCustomReason').value.trim();
  const btn = document.getElementById('confirmOrderCancelBtn');

  if (!orderId) return;

  let finalReason = selectVal;
  if (selectVal === 'OTHER') {
    if (!customVal) {
      alert('Please specify the cancellation reason.');
      document.getElementById('orderCancelCustomReason').focus();
      return;
    }
    finalReason = customVal;
  }

  btn.disabled = true;
  btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Removing...';

  try {
    const res = await fetch(`/api/orders/${orderId}/status`, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        status: 'CANCELLED',
        notes: `[CANCELLED from Order Detail]: ${finalReason}`
      })
    });
    const data = await res.json();
    if (data.success) {
      if (orderCancelModalInstance) orderCancelModalInstance.hide();
      window.location.reload();
    } else {
      alert(data.message || 'Failed to remove order.');
      btn.disabled = false;
      btn.innerHTML = '<i class="bi bi-trash"></i> Confirm & Remove from Queue';
    }
  } catch (err) {
    alert('Error updating order: ' + err.message);
    btn.disabled = false;
    btn.innerHTML = '<i class="bi bi-trash"></i> Confirm & Remove from Queue';
  }
}

// Permanent Delete Order from Detail Page
let orderDeleteModalInstance = null;
function openOrderDeleteModal(orderId, orderNumber, rawJobTitle) {
  const modalEl = document.getElementById('orderDeleteModal');
  if (!modalEl) return;
  if (!orderDeleteModalInstance) {
    orderDeleteModalInstance = new bootstrap.Modal(modalEl);
  }
  document.getElementById('orderDeleteModalId').value = orderId;
  document.getElementById('orderDeleteOrderNum').textContent = '#' + orderNumber;
  try {
    document.getElementById('orderDeleteJobTitle').textContent = decodeURIComponent(rawJobTitle);
  } catch (e) {
    try {
      document.getElementById('orderDeleteJobTitle').textContent = unescape(rawJobTitle);
    } catch (e2) {
      document.getElementById('orderDeleteJobTitle').textContent = rawJobTitle;
    }
  }
  orderDeleteModalInstance.show();
}

async function submitOrderDelete() {
  const orderId = document.getElementById('orderDeleteModalId').value;
  const btn = document.getElementById('confirmOrderDeleteBtn');
  if (!orderId) return;

  btn.disabled = true;
  btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Deleting...';

  try {
    const res = await fetch(`/api/orders/${orderId}`, {
      method: 'DELETE',
      headers: { 'Content-Type': 'application/json' }
    });
    const data = await res.json();
    if (data.success) {
      if (orderDeleteModalInstance) orderDeleteModalInstance.hide();
      const isFrame = '<%= order.orderType %>' === 'PHOTO_FRAME' || /frame|රාමු/i.test('<%= escape(order.jobTitle) %>');
      window.location.href = isFrame ? '/orders?type=frame' : '/orders';
    } else {
      alert(data.message || 'Failed to delete order.');
      btn.disabled = false;
      btn.innerHTML = '<i class="bi bi-trash-fill"></i> Yes, Permanently Delete';
    }
  } catch (err) {
    alert('Error deleting order: ' + err.message);
    btn.disabled = false;
    btn.innerHTML = '<i class="bi bi-trash-fill"></i> Yes, Permanently Delete';
  }
}

// Manual Material Wastage / Misprint Removal Modal
let wastageModalInstance = null;
function openOrderWastageModal() {
  const modalEl = document.getElementById('orderWastageModal');
  if (!modalEl) return;
  if (!wastageModalInstance) {
    wastageModalInstance = new bootstrap.Modal(modalEl);
  }
  wastageModalInstance.show();
}

async function submitOrderWastage() {
  const stockItemId = document.getElementById('wastageStockItemSelect').value;
  const quantity = parseFloat(document.getElementById('wastageQuantityInput').value);
  const reason = document.getElementById('wastageReasonSelect').value;
  const notes = document.getElementById('wastageNotesInput').value.trim();
  const btn = document.getElementById('confirmWastageBtn');

  if (!stockItemId) {
    alert('Please select a stock material to deduct.');
    return;
  }
  if (isNaN(quantity) || quantity <= 0) {
    alert('Quantity must be greater than zero.');
    document.getElementById('wastageQuantityInput').focus();
    return;
  }

  btn.disabled = true;
  btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Deducting...';

  try {
    const res = await fetch('/api/orders/<%= order.id %>/remove-material', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ stockItemId, quantity, reason, notes }),
    });
    const data = await res.json();
    if (data.success) {
      if (wastageModalInstance) wastageModalInstance.hide();
      alert(data.message || 'Material successfully removed from inventory.');
      window.location.reload();
    } else {
      alert(data.message || 'Failed to remove material.');
      btn.disabled = false;
      btn.innerHTML = '<i class="bi bi-box-arrow-down"></i> Deduct & Remove from Stock';
    }
  } catch (err) {
    alert('Network error: ' + err.message);
    btn.disabled = false;
    btn.innerHTML = '<i class="bi bi-box-arrow-down"></i> Deduct & Remove from Stock';
  }
}
</script>
