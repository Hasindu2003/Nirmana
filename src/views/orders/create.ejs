<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<main class="main-wrapper">
  <div class="content-body">
    <!-- Header -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-4">
      <div>
        <nav aria-label="breadcrumb">
          <ol class="breadcrumb mb-1 small text-muted">
            <li class="breadcrumb-item"><a href="/orders" class="text-decoration-none text-muted">Orders</a></li>
            <li class="breadcrumb-item active">New Order</li>
          </ol>
        </nav>
        <h2 class="fs-4 fw-bold mb-0">Record New Printing Order</h2>
      </div>
      <div>
        <a href="/orders" class="btn btn-serene-secondary">
          <i class="bi bi-arrow-left"></i> Back to Orders
        </a>
      </div>
    </div>

    <form id="newOrderForm" onsubmit="handleOrderSubmit(event)">
      <div class="row g-4">
        <!-- Left: Customer Intake & Job Specifications (7 cols) -->
        <div class="col-lg-7">
          <!-- Customer Selection Card -->
          <div class="serene-card mb-4">
            <div class="serene-card-header d-flex align-items-center justify-content-between">
              <h3 class="serene-card-title"><i class="bi bi-person me-2 text-muted"></i> Customer Information</h3>
              <span class="small text-muted">Who placed this order?</span>
            </div>

            <div class="serene-card-body">
              <!-- Redesigned Customer Selection Buttons / Cards -->
              <div class="customer-mode-selector mb-3">
                <button type="button" 
                        class="customer-mode-card <%= customers.length === 0 ? 'disabled' : 'active' %>" 
                        id="btnModeExisting" 
                        onclick="toggleCustomerMode('existing')" 
                        <%= customers.length === 0 ? 'disabled' : '' %>>
                  <div class="d-flex align-items-center gap-2">
                    <div class="mode-icon-box">
                      <i class="bi bi-person-check-fill"></i>
                    </div>
                    <div>
                      <div class="mode-title">Existing Customer</div>
                      <div class="mode-sub">From directory (<%= customers.length %>)</div>
                    </div>
                  </div>
                  <div class="mode-radio-dot"></div>
                </button>

                <button type="button" 
                        class="customer-mode-card <%= customers.length === 0 ? 'active' : '' %>" 
                        id="btnModeNew" 
                        onclick="toggleCustomerMode('new')">
                  <div class="d-flex align-items-center gap-2">
                    <div class="mode-icon-box mode-icon-new">
                      <i class="bi bi-person-plus-fill"></i>
                    </div>
                    <div>
                      <div class="mode-title">+ New Customer</div>
                      <div class="mode-sub">Auto-creates account</div>
                    </div>
                  </div>
                  <div class="mode-radio-dot"></div>
                </button>

                <button type="button" 
                        class="customer-mode-card" 
                        id="btnModeWalkin" 
                        onclick="toggleCustomerMode('walkin')">
                  <div class="d-flex align-items-center gap-2">
                    <div class="mode-icon-box" style="background:#f1f5f9; color:#475569;">
                      <i class="bi bi-person-dash"></i>
                    </div>
                    <div>
                      <div class="mode-title">Walk-in Order</div>
                      <div class="mode-sub">No profile required</div>
                    </div>
                  </div>
                  <div class="mode-radio-dot"></div>
                </button>
              </div>

              <!-- Mode 0: Walk-in Customer Info Banner -->
              <div id="walkinCustomerSection" class="d-none">
                <div class="alert alert-light border small text-muted mb-0 d-flex align-items-center gap-2 p-3 rounded-3" style="background:#f8fafc;">
                  <i class="bi bi-check-circle-fill text-success fs-5"></i>
                  <div>
                    <strong class="text-dark d-block">Direct Walk-in Order</strong>
                    <span>Order will be recorded directly without linking or requiring a customer profile.</span>
                  </div>
                </div>
              </div>
              <!-- Mode 1: Existing Customer Dropdown -->
              <div id="existingCustomerSection" class="<%= customers.length === 0 ? 'd-none' : '' %>">
                <label class="form-label">Select Registered Customer *</label>
                <select name="customerId" id="existingCustomerSelect" class="form-select" onchange="onExistingCustomerSelect(this)" <%= customers.length === 0 ? '' : 'required' %>>
                  <option value="">-- Choose Customer from Directory --</option>
                  <% customers.forEach(c => { %>
                    <option value="<%= c.id %>" data-phone="<%= c.phone %>" data-company="<%= c.companyName || '' %>">
                      <%= c.name %> &bull; <%= c.phone %> <%= c.companyName ? `(${c.companyName})` : '' %> (<%= c.customerCode %>)
                    </option>
                  <% }) %>
                </select>
                <div class="form-text small text-muted mt-2">
                  Can't find the customer? Click <strong>"+ New Customer"</strong> above to enter their details right now.
                </div>
              </div>

              <!-- Mode 2: New Customer Form (Auto-created) -->
              <div id="newCustomerSection" class="<%= customers.length === 0 ? '' : 'd-none' %>">
                <div class="alert alert-light border small text-muted mb-3 py-2 px-3 rounded-2">
                  <i class="bi bi-info-circle text-primary me-1"></i> A new customer account will be created automatically with these details.
                </div>

                <div class="row g-3 mb-3">
                  <div class="col-md-6">
                    <label class="form-label">Customer Name *</label>
                    <input type="text" name="newCustomerName" id="newCustomerName" class="form-control" placeholder="Full Name / Contact Person">
                  </div>
                  <div class="col-md-6">
                    <label class="form-label">Phone Number *</label>
                    <input type="tel" name="newCustomerPhone" id="newCustomerPhone" class="form-control" placeholder="0771234567" pattern="0[0-9]{9}" maxlength="10" minlength="10" oninput="this.value = this.value.replace(/\D/g, '').slice(0, 10)">
                  </div>
                </div>

                <div class="row g-3 mb-3">
                  <div class="col-md-6">
                    <label class="form-label">Company / Business Name (Optional)</label>
                    <input type="text" name="newCustomerCompany" class="form-control" placeholder="Company or brand name">
                  </div>
                  <div class="col-md-6">
                    <label class="form-label">Email Address (Optional)</label>
                    <input type="email" name="newCustomerEmail" class="form-control" placeholder="client@domain.com">
                  </div>
                </div>

                <div>
                  <label class="form-label">Address / Location (Optional)</label>
                  <input type="text" name="newCustomerAddress" class="form-control" placeholder="Street, City">
                </div>
              </div>
            </div>
          </div>

          <!-- Job Specifications Card -->
          <div class="serene-card">
            <div class="serene-card-header">
              <h3 class="serene-card-title"><i class="bi bi-sliders me-2 text-muted"></i> Job & Print Specifications</h3>
            </div>
            <div class="serene-card-body">
              <div class="mb-3">
                <label class="form-label">Job Title / Item Description *</label>
                <input type="text" name="jobTitle" id="jobTitleInput" class="form-control" placeholder="e.g. 500x Business Cards, 8x10 Photo Frame with Print" required>
              </div>

              <!-- Material / Photo Frame Size Selector -->
              <div class="mb-3 p-3 rounded-2" style="background:#fafbfc; border: 1px solid var(--serene-border-subtle);">
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <label class="form-label fw-semibold mb-0 small text-dark">
                    <i class="bi bi-aspect-ratio me-1 text-primary"></i> Stock Material / Photo Frame Size
                  </label>
                  <span class="badge bg-light text-muted border small" style="font-size: 0.7rem;">Sizes & Live Prices</span>
                </div>

                <select id="stockItemSelector" class="form-select form-select-sm mb-2" onchange="onStockItemSelect(this)">
                  <option value="">-- Choose Stock Material or Photo Frame Size --</option>
                  
                  <!-- Sized Items & Photo Frames -->
                  <optgroup label="Photo Frames (Sized Dimensions)">
                    <% stockItems.filter(i => i.category === 'Photo Frames' || i.width || i.sizeLabel).forEach(item => { %>
                      <option value="<%= item.id %>" 
                        data-name="<%= item.name %>"
                        data-category="<%= item.category %>"
                        data-width="<%= item.width || '' %>"
                        data-length="<%= item.length || '' %>"
                        data-unit="<%= item.dimensionUnit || 'inches' %>"
                        data-sizelabel="<%= item.sizeLabel || '' %>"
                        data-price="<%= item.sellingPrice || item.unitCost || 0 %>"
                        data-stock="<%= item.currentStock %>">
                        <%= item.name %> &bull; Size: <%= item.sizeLabel || (item.width && item.length ? `${item.width}" x ${item.length}"` : 'Standard') %> &bull; Rs. <%= parseFloat(item.sellingPrice || item.unitCost || 0).toFixed(2) %> (<%= item.currentStock %> in stock)
                      </option>
                    <% }) %>
                  </optgroup>

                  <!-- Other Paper Substrates & Materials -->
                  <optgroup label="Paper / Substrates & Other Materials">
                    <% stockItems.filter(i => i.category !== 'Photo Frames' && !i.width && !i.sizeLabel).forEach(item => { %>
                      <option value="<%= item.id %>"
                        data-name="<%= item.name %>"
                        data-category="<%= item.category %>"
                        data-price="<%= item.sellingPrice || item.unitCost || 0 %>"
                        data-stock="<%= item.currentStock %>">
                        <%= item.name %> &bull; Rs. <%= parseFloat(item.sellingPrice || item.unitCost || 0).toFixed(2) %> (<%= item.currentStock %> <%= item.unit %>)
                      </option>
                    <% }) %>
                  </optgroup>
                  <option value="CUSTOM_FRAME">+ Custom Frame Size (Enter Width x Length)...</option>
                </select>

                <!-- Custom Photo Frame Dimensions (conditionally shown or inline) -->
                <div id="customFrameDimsRow" class="row g-2 mt-1 mb-2 d-none">
                  <div class="col-4">
                    <label class="form-label small text-muted">Width (in)</label>
                    <input type="number" id="customFrameWidth" class="form-control form-control-sm" placeholder="e.g. 12" step="any" min="1" oninput="onCustomDimensionsChange()">
                  </div>
                  <div class="col-4">
                    <label class="form-label small text-muted">Length (in)</label>
                    <input type="number" id="customFrameLength" class="form-control form-control-sm" placeholder="e.g. 18" step="any" min="1" oninput="onCustomDimensionsChange()">
                  </div>
                  <div class="col-4">
                    <label class="form-label small text-muted">Frame Price / Unit</label>
                    <input type="number" id="customFramePrice" class="form-control form-control-sm" placeholder="Rs. 0.00" step="any" min="0" oninput="onCustomDimensionsChange()">
                  </div>
                </div>

                <div class="row g-2">
                  <div class="col-md-7">
                    <label class="form-label small text-muted">Paper Substrate / Material Name</label>
                    <input type="text" name="paperMaterial" id="paperMaterialField" list="stockPaperList" class="form-control form-control-sm" placeholder="e.g. 8x10 Black Photo Frame with Gloss Print">
                    <datalist id="stockPaperList">
                      <% stockItems.forEach(item => { %>
                        <option value="<%= item.name %> <%= item.sizeLabel ? `(${item.sizeLabel})` : '' %>">
                      <% }) %>
                    </datalist>
                  </div>
                  <div class="col-md-5">
                    <label class="form-label small text-muted">Print / Frame Quantity *</label>
                    <input type="number" name="quantity" id="orderQuantity" class="form-control form-control-sm" value="1" min="1" oninput="onQuantityChange()" required>
                  </div>
                </div>
              </div>

              <div class="mb-3">
                <label class="form-label">Specifications (Sides, Colors, Frame Finish)</label>
                <textarea name="specifications" id="specificationsField" class="form-control" rows="3" style="resize: none;" placeholder="e.g. 8x10 inch Wooden Photo Frame with Glass & Matte Photo Print"></textarea>
              </div>

              <div class="row g-3">
                <div class="col-md-6">
                  <label class="form-label">Order Date</label>
                  <input type="date" name="orderDate" class="form-control" value="<%= todayDate() %>">
                </div>
                <div class="col-md-6">
                  <label class="form-label">Due Date for Collection</label>
                  <input type="date" name="dueDate" id="dueDateField" class="form-control">
                </div>
              </div>

              <div class="mt-3">
                <label class="form-label">Internal Production Notes (Optional)</label>
                <input type="text" name="notes" class="form-control" placeholder="Special client instructions, artwork file location">
              </div>
            </div>
          </div>
        </div>

        <!-- Right: Pricing & Confirmation (5 cols) -->
        <div class="col-lg-5">
          <div class="serene-card sticky-lg-top" style="top: 80px;">
            <div class="serene-card-header">
              <h3 class="serene-card-title">Billing, Discount & Balance</h3>
            </div>
            <div class="serene-card-body">
              <!-- Subtotal -->
              <div class="mb-3">
                <label class="form-label fw-semibold">Subtotal Amount (<%= currencySymbol %>) *</label>
                <input type="number" name="subtotal" id="subtotalInput" class="form-control fs-5 fw-bold" placeholder="0.00" step="any" min="0" onfocus="clearIfZero(this)" onclick="clearIfZero(this)" oninput="updateBalanceCalc()" required>
              </div>

              <!-- Manual Discount Input -->
              <div class="mb-3">
                <div class="d-flex justify-content-between align-items-center mb-1">
                  <label class="form-label fw-semibold mb-0 text-primary">
                    <i class="bi bi-tag-fill me-1"></i> Manual Discount (<%= currencySymbol %>)
                  </label>
                  <span class="badge bg-light text-muted border small" style="font-size: 0.7rem;">Input Manual</span>
                </div>
                <input type="number" name="discount" id="discountInput" class="form-control" placeholder="0.00" step="any" min="0" value="0.00" onfocus="clearIfZero(this)" onclick="clearIfZero(this)" oninput="updateBalanceCalc()">
                <div class="form-text small text-muted" style="font-size: 0.72rem;">Type manual discount to subtract from subtotal.</div>
              </div>

              <!-- Total Net Amount -->
              <div class="mb-3">
                <label class="form-label fw-semibold">Net Total Job Price (<%= currencySymbol %>) *</label>
                <input type="number" name="totalAmount" id="totalAmountInput" class="form-control fs-5 fw-bold bg-light" placeholder="0.00" step="any" min="0" readonly required>
              </div>

              <!-- Given Amount / Advance Paid -->
              <div class="mb-3">
                <label class="form-label fw-semibold text-success">
                  <i class="bi bi-cash-stack me-1"></i> Given Amount / Advance Paid (<%= currencySymbol %>)
                </label>
                <input type="number" name="advancePaid" id="advancePaidInput" class="form-control text-success fw-bold fs-6" placeholder="0.00" step="any" min="0" onfocus="clearIfZero(this)" onclick="clearIfZero(this)" oninput="updateBalanceCalc()">
              </div>

              <!-- Live Balance Slip Card -->
              <div class="p-3 mb-4 rounded-2" style="background:#fafbfc; border:1px solid var(--serene-border-subtle);">
                <div class="d-flex justify-content-between align-items-center mb-1">
                  <span class="text-muted small">Subtotal:</span>
                  <span class="fw-semibold tabular-nums text-dark" id="calcSubtotal">Rs. 0.00</span>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-1 text-primary">
                  <span class="small">Manual Discount:</span>
                  <span class="fw-semibold tabular-nums" id="calcDiscount">-Rs. 0.00</span>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-1">
                  <span class="text-muted small">Net Total:</span>
                  <span class="fw-bold tabular-nums text-dark" id="calcTotal">Rs. 0.00</span>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <span class="text-success small">Given Amount:</span>
                  <span class="fw-semibold tabular-nums text-success" id="calcAdvance">Rs. 0.00</span>
                </div>
                <hr class="my-2">
                <div class="d-flex justify-content-between align-items-center">
                  <span class="fw-bold text-danger">Yet to Give (Balance Due):</span>
                  <span class="fs-5 fw-bold tabular-nums text-danger" id="calcBalance">Rs. 0.00</span>
                </div>
              </div>

              <div class="mb-4">
                <label class="form-label">Initial Status</label>
                <select name="status" class="form-select">
                  <option value="RECEIVED" selected>Received (Pending Design / Pre-press)</option>
                  <option value="PRINTING">Printing (Direct to Press)</option>
                  <option value="READY">Ready for Collection</option>
                </select>
              </div>

              <button type="submit" class="btn btn-serene-primary w-100 py-2 justify-content-center shadow-xs">
                <i class="bi bi-check2-circle"></i> Save & Record Order
              </button>
            </div>
          </div>
        </div>
      </div>
    </form>
  </div>
</main>

<%- include('../partials/footer') %>

<script>
var currentMode = '<%= customers.length === 0 ? "new" : "existing" %>';

function clearIfZero(input) {
  if (input.value === '0' || input.value === '0.00' || parseFloat(input.value) === 0) {
    input.value = '';
  }
}

function toggleCustomerMode(mode) {
  currentMode = mode;
  const existingSec = document.getElementById('existingCustomerSection');
  const newSec = document.getElementById('newCustomerSection');
  const walkinSec = document.getElementById('walkinCustomerSection');
  const existingSelect = document.getElementById('existingCustomerSelect');
  const newName = document.getElementById('newCustomerName');
  const newPhone = document.getElementById('newCustomerPhone');
  const btnExisting = document.getElementById('btnModeExisting');
  const btnNew = document.getElementById('btnModeNew');
  const btnWalkin = document.getElementById('btnModeWalkin');

  if (mode === 'walkin') {
    if (btnExisting) btnExisting.classList.remove('active');
    if (btnNew) btnNew.classList.remove('active');
    if (btnWalkin) btnWalkin.classList.add('active');
    existingSec.classList.add('d-none');
    newSec.classList.add('d-none');
    walkinSec.classList.remove('d-none');
    existingSelect.removeAttribute('required');
    newName.removeAttribute('required');
    newPhone.removeAttribute('required');
  } else if (mode === 'new') {
    if (btnExisting) btnExisting.classList.remove('active');
    if (btnWalkin) btnWalkin.classList.remove('active');
    if (btnNew) btnNew.classList.add('active');
    existingSec.classList.add('d-none');
    walkinSec.classList.add('d-none');
    newSec.classList.remove('d-none');
    existingSelect.removeAttribute('required');
    newName.setAttribute('required', 'required');
    newPhone.setAttribute('required', 'required');
    newName.focus();
  } else {
    if (btnNew) btnNew.classList.remove('active');
    if (btnWalkin) btnWalkin.classList.remove('active');
    if (btnExisting) btnExisting.classList.add('active');
    newSec.classList.add('d-none');
    walkinSec.classList.add('d-none');
    existingSec.classList.remove('d-none');
    existingSelect.setAttribute('required', 'required');
    newName.removeAttribute('required');
    newPhone.removeAttribute('required');
    existingSelect.focus();
  }
}

window.selectedStockUnitPrice = 0;

function onStockItemSelect(selectEl) {
  const customRow = document.getElementById('customFrameDimsRow');
  const selectedOpt = selectEl.options[selectEl.selectedIndex];
  if (!selectedOpt || !selectEl.value) {
    if (customRow) customRow.classList.add('d-none');
    return;
  }

  if (selectEl.value === 'CUSTOM_FRAME') {
    if (customRow) customRow.classList.remove('d-none');
    document.getElementById('customFrameWidth').focus();
    return;
  }

  if (customRow) customRow.classList.add('d-none');

  const name = selectedOpt.dataset.name || '';
  const price = parseFloat(selectedOpt.dataset.price) || 0;
  const width = selectedOpt.dataset.width || '';
  const length = selectedOpt.dataset.length || '';
  const unit = selectedOpt.dataset.unit || 'inches';
  const sizeLabel = selectedOpt.dataset.sizelabel || (width && length ? `${width}" x ${length}"` : '');

  const paperField = document.getElementById('paperMaterialField');
  if (paperField) {
    paperField.value = name + (sizeLabel ? ` (${sizeLabel})` : '');
  }

  const jobInput = document.getElementById('jobTitleInput');
  if (jobInput && (!jobInput.value || jobInput.value.includes('Photo Frame') || jobInput.value.includes('Business Cards'))) {
    jobInput.value = name + (sizeLabel ? ` - ${sizeLabel}` : '');
  }

  const specField = document.getElementById('specificationsField');
  if (specField && sizeLabel) {
    specField.value = `Size: ${sizeLabel} (${width ? width + 'x' + length + ' ' + unit : ''})\nFrame Selling Price: Rs. ${price.toFixed(2)}`;
  }

  window.selectedStockUnitPrice = price;
  const qty = parseInt(document.getElementById('orderQuantity').value, 10) || 1;
  if (price > 0) {
    const sub = price * qty;
    document.getElementById('subtotalInput').value = sub.toFixed(2);
  }
  updateBalanceCalc();
}

function onCustomDimensionsChange() {
  const w = document.getElementById('customFrameWidth').value;
  const l = document.getElementById('customFrameLength').value;
  const p = parseFloat(document.getElementById('customFramePrice').value) || 0;
  window.selectedStockUnitPrice = p;

  if (w && l) {
    const dimText = `${w}" x ${l}"`;
    document.getElementById('paperMaterialField').value = `Custom Photo Frame (${dimText})`;
    const jobInput = document.getElementById('jobTitleInput');
    if (jobInput) jobInput.value = `Custom Photo Frame - ${dimText}`;
    document.getElementById('specificationsField').value = `Custom Photo Frame: Width ${w} in x Length ${l} in\nRate: Rs. ${p.toFixed(2)}`;
  }

  const qty = parseInt(document.getElementById('orderQuantity').value, 10) || 1;
  if (p > 0) {
    document.getElementById('subtotalInput').value = (p * qty).toFixed(2);
  }
  updateBalanceCalc();
}

function onQuantityChange() {
  if (window.selectedStockUnitPrice > 0) {
    const qty = parseInt(document.getElementById('orderQuantity').value, 10) || 1;
    document.getElementById('subtotalInput').value = (window.selectedStockUnitPrice * qty).toFixed(2);
  }
  updateBalanceCalc();
}

function updateBalanceCalc() {
  const subtotalVal = document.getElementById('subtotalInput').value;
  const discountVal = document.getElementById('discountInput').value;
  const advanceVal = document.getElementById('advancePaidInput').value;

  const subtotal = subtotalVal !== '' ? (parseFloat(subtotalVal) || 0) : 0;
  const discount = discountVal !== '' ? Math.max(0, parseFloat(discountVal) || 0) : 0;
  const total = Math.max(0, subtotal - discount);
  const advance = advanceVal !== '' ? (parseFloat(advanceVal) || 0) : 0;
  const balance = Math.max(0, total - advance);

  document.getElementById('totalAmountInput').value = total.toFixed(2);
  document.getElementById('calcSubtotal').innerText = formatCurrency(subtotal);
  document.getElementById('calcDiscount').innerText = (discount > 0 ? '-' : '') + formatCurrency(discount);
  document.getElementById('calcTotal').innerText = formatCurrency(total);
  document.getElementById('calcAdvance').innerText = formatCurrency(advance);
  document.getElementById('calcBalance').innerText = formatCurrency(balance);
}

document.addEventListener('DOMContentLoaded', () => {
  // Set default due date to 2 days from today in Sri Lanka
  const d = new Date();
  d.setDate(d.getDate() + 2);
  const dueStr = new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Colombo', year: 'numeric', month: '2-digit', day: '2-digit' }).format(d);
  document.getElementById('dueDateField').value = dueStr;
  updateBalanceCalc();

  <% if (customers.length === 0) { %>
  toggleCustomerMode('new');
  <% } %>
});

async function handleOrderSubmit(e) {
  e.preventDefault();
  const form = e.target;
  const formData = new FormData(form);
  const payload = Object.fromEntries(formData.entries());

  if (currentMode === 'walkin') {
    delete payload.customerId;
    delete payload.newCustomerName;
    delete payload.newCustomerPhone;
    delete payload.newCustomerEmail;
    delete payload.newCustomerCompany;
    delete payload.newCustomerAddress;
    payload.isWalkIn = true;
  } else if (currentMode === 'existing') {
    if (!payload.customerId) {
      toast.warning('Please select an existing customer or switch to "+ New Customer" or "Walk-in".');
      return;
    }
  } else if (currentMode === 'new') {
    delete payload.customerId; // Ensure customerId is empty so backend creates new customer
    const phone = (payload.newCustomerPhone || '').trim();
    if (!phone) {
      toast.warning('Please enter a phone number for the new customer.');
      return;
    }
    if (!/^0\d{9}$/.test(phone)) {
      toast.warning('Customer phone number must be exactly 10 digits starting with 0 (e.g. 0771234567).');
      return;
    }
  }

  try {
    const res = await fetch('/api/orders', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });
    const result = await res.json();
    if (result.success) {
      setPendingToast(result.message, 'success');
      window.location.href = `/orders/${result.data.id}`;
    } else {
      toast.error('Failed to create order: ' + result.message);
    }
  } catch (err) {
    toast.error('Network error: ' + err.message);
  }
}
</script>
