<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<main class="main-wrapper">
  <div class="content-body">
    <!-- Header -->
    <div class="d-flex flex-wrap align-items-center justify-content-between mb-4">
      <div>
        <h2 class="fs-4 fw-bold mb-1">Printing Orders</h2>
        <div class="text-muted small">Track print job queue, customer specs, and fulfillment</div>
      </div>
      <div class="mt-2 mt-sm-0">
        <a href="/orders/new" class="btn btn-serene-primary">
          <i class="bi bi-plus-lg"></i> New Order
        </a>
      </div>
    </div>

    <!-- Status Filters & Search -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
      <div class="d-flex flex-wrap gap-1" id="orderStatusTabs">
        <a href="/orders" class="btn btn-sm <%= currentStatus === 'ALL' ? 'btn-serene-primary' : 'btn-serene-secondary' %>" data-status-filter="ALL">
          All (<%= orders.length %>)
        </a>
        <a href="/orders?status=RECEIVED" class="btn btn-sm <%= currentStatus === 'RECEIVED' ? 'btn-serene-primary' : 'btn-serene-secondary' %>" data-status-filter="RECEIVED">Received</a>
        <a href="/orders?status=PRINTING" class="btn btn-sm <%= currentStatus === 'PRINTING' ? 'btn-serene-primary' : 'btn-serene-secondary' %>" data-status-filter="PRINTING">Printing</a>
        <a href="/orders?status=READY" class="btn btn-sm <%= currentStatus === 'READY' ? 'btn-serene-primary' : 'btn-serene-secondary' %>" data-status-filter="READY">Ready for Pickup</a>
        <a href="/orders?status=COMPLETED" class="btn btn-sm <%= currentStatus === 'COMPLETED' ? 'btn-serene-primary' : 'btn-serene-secondary' %>" data-status-filter="COMPLETED">Completed</a>
      </div>

      <div class="d-flex align-items-center gap-2 flex-grow-1 flex-sm-grow-0 position-relative" style="min-width: 250px; max-width: 100%;">
        <div class="input-group input-group-sm position-relative w-100">
          <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
          <input type="text" id="orderSearchInput" value="<%= search %>" class="form-control border-start-0 ps-0 pe-4" placeholder="Search order #, job, client..." autocomplete="off">
          <button class="btn btn-sm text-muted bg-white border border-start-0 position-absolute end-0 top-0 bottom-0 d-flex align-items-center justify-content-center px-2" type="button" id="clearOrderSearchBtn" style="display: none; z-index: 5;" title="Clear search">
            <i class="bi bi-x-circle-fill text-secondary"></i>
          </button>
        </div>
      </div>
    </div>

    <!-- Orders Table Card -->
    <div class="serene-card">
      <div class="table-responsive">
        <table class="serene-table" id="ordersTable">
          <thead>
            <tr>
              <th>Order #</th>
              <th>Customer</th>
              <th>Job Description</th>
              <th>Amount & Balance</th>
              <th>Status</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% if (orders && orders.length > 0) { %>
              <% orders.forEach(o => { %>
                <tr class="order-row"
                    data-status="<%= o.status %>"
                    data-order="<%= (o.orderNumber || '').toLowerCase() %>"
                    data-customer="<%= (o.customer ? o.customer.name : '').toLowerCase() %>"
                    data-phone="<%= (o.customer && o.customer.phone ? o.customer.phone : '').toLowerCase() %>"
                    data-job="<%= (o.jobTitle || '').toLowerCase() %>">
                  <td>
                    <a href="/orders/<%= o.id %>" class="fw-semibold text-decoration-none text-dark font-monospace">
                      <%= o.orderNumber %>
                    </a>
                  </td>
                  <td>
                    <div class="fw-semibold text-dark"><%= o.customer ? o.customer.name : 'Unknown' %></div>
                    <% if (o.customer && o.customer.phone) { %>
                      <div class="text-muted small"><%= o.customer.phone %></div>
                    <% } %>
                  </td>
                  <td>
                    <div class="fw-medium text-dark"><%= o.jobTitle %></div>
                    <span class="badge bg-light text-muted border small mt-1"><%= o.quantity %> units</span>
                  </td>
                  <td>
                    <div class="tabular-nums fw-semibold text-dark">
                      <%= currencySymbol %> <%= parseFloat(o.totalAmount).toLocaleString('en-LK', { minimumFractionDigits: 2 }) %>
                    </div>
                    <% if (parseFloat(o.balanceAmount) <= 0) { %>
                      <span class="badge mt-1" style="background:#edf7ed; color:#1e4620;">Paid in Full</span>
                    <% } else { %>
                      <div class="text-danger small fw-semibold mt-1">
                        Due: <%= currencySymbol %> <%= parseFloat(o.balanceAmount).toLocaleString('en-LK', { minimumFractionDigits: 2 }) %>
                      </div>
                    <% } %>
                  </td>
                  <td>
                    <span class="status-badge status-<%= o.status.toLowerCase() %>">
                      <span class="status-dot"></span> <%= o.status.replace('_', ' ') %>
                    </span>
                  </td>
                  <td>
                    <a href="/orders/<%= o.id %>" class="btn btn-sm btn-serene-secondary py-1 px-2" title="View Details">
                      <i class="bi bi-eye"></i> View
                    </a>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="6" class="text-center py-5 text-muted">
                  No orders match this filter. Click "+ New Order" to record an order.
                </td>
              </tr>
            <% } %>
            <tr id="orderNoResultsRow" style="display: none;">
              <td colspan="6" class="text-center py-5 text-muted">
                <i class="bi bi-search fs-3 d-block mb-2 text-muted opacity-50"></i>
                No orders match your filter criteria.
              </td>
            </tr>
          </tbody>
        </table>
      </div>
      <%- include('../partials/pagination', { pagination, baseUrl: '/orders', queryParams: { status: currentStatus !== 'ALL' ? currentStatus : undefined, search: search || undefined, customerId: typeof customerId !== 'undefined' && customerId ? customerId : undefined } }) %>
    </div>
  </div>
</main>

<script>
function initOrdersPage() {
  const searchInput = document.getElementById('orderSearchInput');
  const clearBtn = document.getElementById('clearOrderSearchBtn');
  const rows = document.querySelectorAll('.order-row');
  const emptyRow = document.getElementById('orderNoResultsRow');
  let activeStatus = '<%= currentStatus %>' || 'ALL';

  function filterOrders() {
    const rawVal = searchInput ? searchInput.value : '';
    const term = rawVal.trim().toLowerCase();
    let visibleCount = 0;

    if (clearBtn) {
      clearBtn.style.display = term ? 'inline-flex' : 'none';
    }

    rows.forEach(row => {
      const rowStatus = row.getAttribute('data-status') || '';
      const statusMatches = (activeStatus === 'ALL') || (rowStatus === activeStatus);

      if (!statusMatches) {
        row.style.display = 'none';
        return;
      }

      if (!term) {
        row.style.display = '';
        visibleCount++;
        return;
      }

      const order = row.getAttribute('data-order') || '';
      const customer = row.getAttribute('data-customer') || '';
      const phone = row.getAttribute('data-phone') || '';
      const job = row.getAttribute('data-job') || '';

      const isMatch = order.includes(term) || customer.includes(term) || phone.includes(term) || job.includes(term);

      if (isMatch) {
        row.style.display = '';
        visibleCount++;
      } else {
        row.style.display = 'none';
      }
    });

    if (emptyRow) {
      emptyRow.style.display = (visibleCount === 0 && rows.length > 0) ? '' : 'none';
    }
  }

  if (searchInput && !searchInput.dataset.bound) {
    searchInput.dataset.bound = 'true';
    searchInput.addEventListener('input', filterOrders);
  }

  if (clearBtn && !clearBtn.dataset.bound) {
    clearBtn.dataset.bound = 'true';
    clearBtn.addEventListener('click', () => {
      searchInput.value = '';
      filterOrders();
      searchInput.focus();
    });
  }

  document.querySelectorAll('#orderStatusTabs a').forEach(tab => {
    if (!tab.dataset.bound) {
      tab.dataset.bound = 'true';
      tab.addEventListener('click', (e) => {
        e.preventDefault();
        const target = tab.getAttribute('data-status-filter') || 'ALL';
        activeStatus = target;

        document.querySelectorAll('#orderStatusTabs a').forEach(t => {
          t.classList.remove('btn-serene-primary');
          t.classList.add('btn-serene-secondary');
        });
        tab.classList.remove('btn-serene-secondary');
        tab.classList.add('btn-serene-primary');

        filterOrders();

        // Silently update address bar without reload
        const newUrl = new URL(window.location.href);
        if (target === 'ALL') {
          newUrl.searchParams.delete('status');
        } else {
          newUrl.searchParams.set('status', target);
        }
        history.replaceState(null, '', newUrl.toString());
      });
    }
  });

  filterOrders();
}

document.addEventListener('DOMContentLoaded', initOrdersPage);
document.addEventListener('turbo:load', initOrdersPage);
</script>

<%- include('../partials/footer') %>
