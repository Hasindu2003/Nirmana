<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<main class="main-wrapper">
  <div class="content-body">
    <!-- Header -->
    <div class="d-flex flex-wrap align-items-center justify-content-between mb-4">
      <div>
        <h2 class="fs-4 fw-bold mb-1">Printing Orders</h2>
        <div class="text-muted small">Track print job queue, customer specs, and fulfillment</div>
      </div>
      <div class="mt-2 mt-sm-0">
        <a href="/orders/new" class="btn btn-serene-primary">
          <i class="bi bi-plus-lg"></i> New Order
        </a>
      </div>
    </div>

    <!-- Financial & Order Value Ribbon -->
    <% if (locals.ordersSummary) { %>
      <div class="row g-2 g-md-3 mb-4">
        <!-- 1. Total Orders -->
        <div class="col-6 col-lg-3">
          <div class="kpi-card-compact">
            <div class="kpi-compact-content">
              <div class="kpi-compact-label">
                <span>Total Orders</span>
              </div>
              <div class="kpi-compact-num text-dark tabular-nums">
                <%= ordersSummary.totalOrders %>
              </div>
              <div class="kpi-compact-sub">
                <span class="status-dot" style="background:#16a34a;"></span> <%= ordersSummary.completedCount %> completed
              </div>
            </div>
            <div class="kpi-icon-chip" style="background: #f1f5f9; color: #334155;">
              <i class="bi bi-receipt"></i>
            </div>
          </div>
        </div>

        <!-- 2. Total Billed Value -->
        <div class="col-6 col-lg-3">
          <div class="kpi-card-compact">
            <div class="kpi-compact-content">
              <div class="kpi-compact-label">
                <span>Total Billed Value</span>
              </div>
              <div class="kpi-compact-num text-dark tabular-nums" style="font-size: 1.35rem;">
                <%= currencySymbol %> <%= ordersSummary.totalBilled.toLocaleString('en-LK', { minimumFractionDigits: 2 }) %>
              </div>
              <div class="kpi-compact-sub text-muted">
                <i class="bi bi-file-earmark-check"></i> Gross order sales
              </div>
            </div>
            <div class="kpi-icon-chip" style="background: #e6f0ef; color: #2d6a68;">
              <i class="bi bi-tag-fill"></i>
            </div>
          </div>
        </div>

        <!-- 3. Total Given (Collected) -->
        <div class="col-6 col-lg-3">
          <div class="kpi-card-compact">
            <div class="kpi-compact-content">
              <div class="kpi-compact-label">
                <span>Total Collected</span>
              </div>
              <div class="kpi-compact-num text-success tabular-nums" style="font-size: 1.35rem;">
                <%= currencySymbol %> <%= ordersSummary.totalGiven.toLocaleString('en-LK', { minimumFractionDigits: 2 }) %>
              </div>
              <div class="kpi-compact-sub text-success">
                <i class="bi bi-cash-stack"></i> Advances & settled payments
              </div>
            </div>
            <div class="kpi-icon-chip" style="background: #edf7ed; color: #16a34a;">
              <i class="bi bi-wallet2"></i>
            </div>
          </div>
        </div>

        <!-- 4. Outstanding Balance Due -->
        <div class="col-6 col-lg-3">
          <div class="kpi-card-compact <%= ordersSummary.totalDue > 0 ? 'border-danger-subtle' : '' %>">
            <div class="kpi-compact-content">
              <div class="kpi-compact-label">
                <span>Yet to Give (Due)</span>
              </div>
              <div class="kpi-compact-num <%= ordersSummary.totalDue > 0 ? 'text-danger' : 'text-success' %> tabular-nums" style="font-size: 1.35rem;">
                <%= currencySymbol %> <%= ordersSummary.totalDue.toLocaleString('en-LK', { minimumFractionDigits: 2 }) %>
              </div>
              <div class="kpi-compact-sub <%= ordersSummary.totalDue > 0 ? 'text-danger fw-semibold' : 'text-muted' %>">
                <% if (ordersSummary.totalDue > 0) { %>
                  <i class="bi bi-exclamation-circle text-danger"></i> Uncollected balance
                <% } else { %>
                  <i class="bi bi-check2-circle text-success"></i> All settled
                <% } %>
              </div>
            </div>
            <div class="kpi-icon-chip <%= ordersSummary.totalDue > 0 ? 'bg-danger-subtle text-danger' : 'bg-light text-muted' %>">
              <i class="bi <%= ordersSummary.totalDue > 0 ? 'bi-hourglass-top' : 'bi-shield-check' %>"></i>
            </div>
          </div>
        </div>
      </div>
    <% } %>
    <!-- Status Filters & Search -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
      <div class="d-flex flex-wrap gap-1" id="orderStatusTabs">
        <button type="button" class="btn btn-sm order-tab-btn <%= currentStatus === 'ALL' ? 'btn-serene-primary' : 'btn-serene-secondary' %>" data-status="ALL" onclick="switchOrderStatusTab('ALL')">
          All (<span id="allOrdersCount"><%= orders.length %></span>)
        </button>
        <button type="button" class="btn btn-sm order-tab-btn <%= currentStatus === 'RECEIVED' ? 'btn-serene-primary' : 'btn-serene-secondary' %>" data-status="RECEIVED" onclick="switchOrderStatusTab('RECEIVED')">
          Received
        </button>
        <button type="button" class="btn btn-sm order-tab-btn <%= currentStatus === 'PRINTING' ? 'btn-serene-primary' : 'btn-serene-secondary' %>" data-status="PRINTING" onclick="switchOrderStatusTab('PRINTING')">
          Printing
        </button>
        <button type="button" class="btn btn-sm order-tab-btn <%= currentStatus === 'READY' ? 'btn-serene-primary' : 'btn-serene-secondary' %>" data-status="READY" onclick="switchOrderStatusTab('READY')">
          Ready
        </button>
        <button type="button" class="btn btn-sm order-tab-btn <%= currentStatus === 'COMPLETED' ? 'btn-serene-primary' : 'btn-serene-secondary' %>" data-status="COMPLETED" onclick="switchOrderStatusTab('COMPLETED')">
          Completed
        </button>
        <button type="button" class="btn btn-sm order-tab-btn <%= currentStatus === 'CANCELLED' ? 'btn-serene-primary' : 'btn-serene-secondary' %>" data-status="CANCELLED" onclick="switchOrderStatusTab('CANCELLED')">
          Cancelled (<span id="cancelledOrdersCount"><%= orders.filter(o => o.status === 'CANCELLED').length %></span>)
        </button>
        <% const frameCount = orders.filter(o => /frame|රාමු|fream|framing/i.test([o.jobTitle||'', o.paperMaterial||'', o.specifications||'', o.notes||''].join(' '))).length; %>
        <button type="button" class="btn btn-sm order-tab-btn <%= (typeof typeFilter !== 'undefined' && typeFilter === 'frame') ? 'btn-warning text-dark fw-bold' : 'btn-outline-warning text-dark' %>" data-status="FRAME" onclick="switchOrderStatusTab('FRAME')">
          <i class="bi bi-image"></i> Photo Frames (<span id="framesCount"><%= frameCount %></span>)
        </button>
      </div>

      <div class="d-flex align-items-center gap-2 flex-grow-1 flex-sm-grow-0" style="min-width: 260px; max-width: 100%;">
        <div class="input-group input-group-sm position-relative w-100">
          <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
          <input type="text" id="orderSearchInput" value="<%= search %>" class="form-control form-control-sm border-start-0 ps-0 pe-4" placeholder="Search order #, job, client..." autocomplete="off">
          <button class="btn btn-sm text-muted bg-white border border-start-0 position-absolute end-0 top-0 bottom-0 d-flex align-items-center justify-content-center px-2" type="button" id="clearOrderSearchBtn" style="display: none; z-index: 5;" title="Clear search">
            <i class="bi bi-x-circle-fill text-secondary"></i>
          </button>
        </div>
      </div>
    </div>

    <!-- Orders Table Card -->
    <div class="serene-card">
      <div class="table-responsive">
        <table class="serene-table">
          <thead>
            <tr>
              <th>Order #</th>
              <th>Customer</th>
              <th>Job Description</th>
              <th>Amount & Balance</th>
              <th>Status</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% if (orders && orders.length > 0) { %>
              <% orders.forEach(o => { %>
                <% 
                  const isFrame = /frame|රාමු|fream|framing/i.test([o.jobTitle||'', o.paperMaterial||'', o.specifications||'', o.notes||''].join(' ')); 
                  const isInitiallyActive = (currentStatus === 'FRAME' ? isFrame : (currentStatus === 'ALL' || o.status === currentStatus));
                %>
                <tr class="order-table-row" 
                    data-status="<%= o.status %>"
                    data-is-frame="<%= isFrame ? 'true' : 'false' %>"
                    data-search="<%= [o.orderNumber, o.customer ? o.customer.name : '', o.customer ? o.customer.phone : '', o.jobTitle, o.paperMaterial || ''].join(' ').toLowerCase() %>"
                    style="<%= isInitiallyActive ? '' : 'display: none !important;' %>">
                  <td>
                    <a href="/orders/<%= o.id %>" class="fw-semibold text-decoration-none text-dark font-monospace">
                      <%= o.orderNumber %>
                    </a>
                  </td>
                  <td>
                    <div class="fw-semibold text-dark"><%= o.customer ? o.customer.name : 'Unknown' %></div>
                    <% if (o.customer && o.customer.phone) { %>
                      <div class="text-muted small"><%= o.customer.phone %></div>
                    <% } %>
                  </td>
                  <td>
                    <div class="fw-semibold text-dark">
                      <% if (isFrame) { %>
                        <i class="bi bi-aspect-ratio text-warning me-1"></i>
                      <% } %>
                      <%= o.jobTitle %>
                    </div>
                    <div class="d-flex align-items-center flex-wrap gap-1 mt-1">
                      <span class="badge bg-light text-muted border small"><%= o.quantity %> units</span>
                      <% if (o.paperMaterial) { %>
                        <span class="badge <%= isFrame ? 'bg-warning-subtle text-warning-emphasis border border-warning-subtle' : 'bg-primary-subtle text-primary border border-primary-subtle' %> small fw-semibold">
                          <i class="bi <%= isFrame ? 'bi-image' : 'bi-box-seam' %> me-1"></i><%= o.paperMaterial %>
                        </span>
                      <% } %>
                    </div>
                    <% if (o.specifications) { %>
                      <div class="text-muted small text-truncate mt-1" style="max-width: 280px; font-size: 0.73rem;" title="<%= o.specifications %>">
                        <i class="bi bi-palette text-secondary me-1"></i><%= o.specifications %>
                      </div>
                    <% } %>
                  </td>
                  <td>
                    <div class="tabular-nums fw-semibold text-dark">
                      <%= currencySymbol %> <%= parseFloat(o.totalAmount).toLocaleString('en-LK', { minimumFractionDigits: 2 }) %>
                    </div>
                    <% if (parseFloat(o.balanceAmount) <= 0) { %>
                      <span class="badge mt-1" style="background:#edf7ed; color:#1e4620;">Paid in Full</span>
                    <% } else { %>
                      <div class="text-danger small fw-semibold mt-1">
                        Due: <%= currencySymbol %> <%= parseFloat(o.balanceAmount).toLocaleString('en-LK', { minimumFractionDigits: 2 }) %>
                      </div>
                    <% } %>
                  </td>
                  <td>
                    <span class="status-badge status-<%= o.status.toLowerCase() %>">
                      <span class="status-dot"></span> <%= o.status.replace('_', ' ') %>
                    </span>
                    <% if (o.paymentSlipStatus === 'PENDING_VERIFICATION') { %>
                      <div class="mt-1">
                        <span class="badge bg-warning text-dark border border-warning small" style="font-size: 0.68rem;" title="Bank transfer slip uploaded awaiting review">
                          <i class="bi bi-receipt me-1"></i> Slip Pending
                        </span>
                      </div>
                    <% } %>
                  </td>
                  <td>
                    <div class="d-inline-flex align-items-center gap-1">
                      <a href="/orders/<%= o.id %>" class="btn btn-sm btn-serene-secondary py-1 px-2 d-inline-flex align-items-center gap-1 shadow-xs" title="View Details">
                        <i class="bi bi-eye"></i> View
                      </a>
                      <% if (o.status !== 'COMPLETED' && o.status !== 'CANCELLED') { %>
                        <button type="button" class="btn btn-sm btn-outline-danger py-1 px-2 d-inline-flex align-items-center gap-1 shadow-xs" 
                                onclick="openOrderCancelModal(<%= o.id %>, '<%= o.orderNumber %>', '<%= escape(o.jobTitle) %>')" 
                                title="Cancel and remove this order from queue">
                          <i class="bi bi-x-circle"></i> Remove
                        </button>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }) %>
            <% } %>
            <tr id="noOrdersRow" style="display: none;">
              <td colspan="6" class="text-center py-5 text-muted">
                No orders match this filter. Click "+ New Order" to record an order.
              </td>
            </tr>
          </tbody>
        </table>
      </div>
      <% if (pagination && pagination.totalPages > 1) { %>
        <%- include('../partials/pagination', { pagination, baseUrl: '/orders', queryParams: { status: currentStatus !== 'ALL' ? currentStatus : undefined, search: search || undefined, customerId: typeof customerId !== 'undefined' && customerId ? customerId : undefined } }) %>
      <% } %>
    </div>
  </div>
</main>

<!-- ========================================================================= -->
<!-- MODAL: REMOVE ORDER FROM ORDERS QUEUE -->
<!-- ========================================================================= -->
<div class="modal fade" id="orderCancelModal" tabindex="-1" aria-labelledby="orderCancelModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content shadow-lg border-0" style="border-radius: var(--serene-radius-lg);">
      <div class="modal-header py-3 px-4 border-bottom bg-light">
        <div class="d-flex align-items-center gap-2">
          <div class="p-2 rounded-2 bg-danger-subtle text-danger d-flex align-items-center justify-content-center">
            <i class="bi bi-x-octagon-fill fs-5"></i>
          </div>
          <div>
            <h5 class="modal-title fw-bold fs-6 mb-0 text-dark" id="orderCancelModalLabel">Remove Order from Queue</h5>
            <div class="text-muted small">Cancel production and remove order from active queue</div>
          </div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <div class="modal-body p-4">
        <div class="alert alert-warning py-2 px-3 mb-3 border-warning-subtle small d-flex align-items-start gap-2">
          <i class="bi bi-exclamation-triangle-fill text-warning flex-shrink-0 mt-1"></i>
          <div>
            You are about to cancel order <strong id="orderCancelOrderNum" class="font-monospace text-dark"></strong> (<span id="orderCancelJobTitle"></span>). This will mark it as <strong>CANCELLED</strong> and remove it from active production queues.
          </div>
        </div>

        <input type="hidden" id="orderCancelModalId" value="">

        <div class="mb-3">
          <label class="form-label fw-semibold small text-dark mb-1">Reason for Removal / Cancellation <span class="text-danger">*</span></label>
          <select class="form-select form-select-sm" id="orderCancelReasonSelect" onchange="window.handleOrderCancelReasonChange(this.value)">
            <option value="Customer requested cancellation / changed mind" selected>Customer requested cancellation / changed mind</option>
            <option value="Frame size / substrate material currently out of stock">Frame size / substrate material currently out of stock</option>
            <option value="Customer walked out / did not confirm specifications">Customer walked out / did not confirm specifications</option>
            <option value="Wrong dimensions or artwork resolution entered">Wrong dimensions or artwork resolution entered</option>
            <option value="Duplicate order entry created by mistake">Duplicate order entry created by mistake</option>
            <option value="OTHER">Other Reason (Specify below)...</option>
          </select>
        </div>

        <div class="mb-3 d-none" id="orderCancelCustomReasonGroup">
          <label class="form-label fw-semibold small text-dark mb-1">Specific Cancellation Details</label>
          <textarea class="form-control form-control-sm" id="orderCancelCustomReason" rows="2" placeholder="Explain reason for cancellation..."></textarea>
        </div>
      </div>

      <div class="modal-footer py-2 px-4 border-top bg-light">
        <button type="button" class="btn btn-sm btn-secondary px-3" data-bs-dismiss="modal">Keep in Queue</button>
        <button type="button" class="btn btn-sm btn-danger px-3 d-inline-flex align-items-center gap-1 fw-bold shadow-xs" id="confirmOrderCancelBtn" onclick="window.submitOrderCancel()">
          <i class="bi bi-trash"></i> Confirm & Remove from Queue
        </button>
      </div>
    </div>
  </div>
</div>

<script>
(function() {
  window.currentOrderStatus = '<%= currentStatus %>' || 'ALL';

  window.filterOrdersTable = function() {
    const orderSearchInput = document.getElementById('orderSearchInput');
    const clearOrderSearchBtn = document.getElementById('clearOrderSearchBtn');
    const orderRows = document.querySelectorAll('.order-table-row');
    const noOrdersRow = document.getElementById('noOrdersRow');

    const term = orderSearchInput ? orderSearchInput.value.trim().toLowerCase() : '';
    let visibleCount = 0;

    if (clearOrderSearchBtn) {
      clearOrderSearchBtn.style.display = term ? 'inline-flex' : 'none';
    }

    orderRows.forEach(row => {
      const status = row.getAttribute('data-status') || '';
      const isFrame = row.getAttribute('data-is-frame') === 'true';
      const searchData = row.getAttribute('data-search') || '';

      let matchesStatus = false;
      if (window.currentOrderStatus === 'ALL') {
        matchesStatus = true;
      } else if (window.currentOrderStatus === 'FRAME') {
        matchesStatus = isFrame;
      } else {
        matchesStatus = (status === window.currentOrderStatus);
      }

      const matchesSearch = !term || searchData.includes(term);

      if (matchesStatus && matchesSearch) {
        row.style.display = '';
        visibleCount++;
      } else {
        row.style.setProperty('display', 'none', 'important');
      }
    });

    if (noOrdersRow) {
      noOrdersRow.style.display = visibleCount === 0 ? '' : 'none';
    }
  };

  window.switchOrderStatusTab = function(status, updateUrl = true) {
    window.currentOrderStatus = status;
    const tabButtons = document.querySelectorAll('.order-tab-btn');

    tabButtons.forEach(btn => {
      const isTarget = btn.getAttribute('data-status') === status;
      if (status === 'FRAME') {
        btn.classList.toggle('btn-warning', isTarget);
        btn.classList.toggle('text-dark', isTarget);
        btn.classList.toggle('fw-bold', isTarget);
        if (!isTarget) {
          btn.classList.remove('btn-serene-primary');
          btn.classList.add('btn-serene-secondary');
        }
      } else {
        btn.classList.toggle('btn-serene-primary', isTarget);
        btn.classList.toggle('btn-serene-secondary', !isTarget);
      }
    });

    if (updateUrl) {
      const url = new URL(window.location.href);
      if (status === 'ALL') {
        url.searchParams.delete('status');
        url.searchParams.delete('type');
      } else if (status === 'FRAME') {
        url.searchParams.set('type', 'frame');
        url.searchParams.delete('status');
      } else {
        url.searchParams.set('status', status);
        url.searchParams.delete('type');
      }
      window.history.pushState({ status }, '', url.toString());
    }

    window.filterOrdersTable();
  };

  // Cancel / Remove Order from Queue
  let orderCancelModalInstance = null;

  window.openOrderCancelModal = function(orderId, orderNumber, rawJobTitle) {
    const modalEl = document.getElementById('orderCancelModal');
    if (!modalEl) return;
    if (!orderCancelModalInstance) {
      orderCancelModalInstance = new bootstrap.Modal(modalEl);
    }
    document.getElementById('orderCancelModalId').value = orderId;
    document.getElementById('orderCancelOrderNum').textContent = '#' + orderNumber;
    try {
      document.getElementById('orderCancelJobTitle').textContent = decodeURIComponent(rawJobTitle);
    } catch (e) {
      try {
        document.getElementById('orderCancelJobTitle').textContent = unescape(rawJobTitle);
      } catch (e2) {
        document.getElementById('orderCancelJobTitle').textContent = rawJobTitle;
      }
    }
    document.getElementById('orderCancelReasonSelect').value = 'Customer requested cancellation / changed mind';
    document.getElementById('orderCancelCustomReason').value = '';
    document.getElementById('orderCancelCustomReasonGroup').classList.add('d-none');
    orderCancelModalInstance.show();
  };

  window.handleOrderCancelReasonChange = function(val) {
    const group = document.getElementById('orderCancelCustomReasonGroup');
    if (val === 'OTHER') {
      group.classList.remove('d-none');
      document.getElementById('orderCancelCustomReason').focus();
    } else {
      group.classList.add('d-none');
    }
  };

  window.submitOrderCancel = async function() {
    const orderId = document.getElementById('orderCancelModalId').value;
    const selectVal = document.getElementById('orderCancelReasonSelect').value;
    const customVal = document.getElementById('orderCancelCustomReason').value.trim();
    const btn = document.getElementById('confirmOrderCancelBtn');

    if (!orderId) return;

    let finalReason = selectVal;
    if (selectVal === 'OTHER') {
      if (!customVal) {
        alert('Please specify the cancellation reason.');
        document.getElementById('orderCancelCustomReason').focus();
        return;
      }
      finalReason = customVal;
    }

    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Removing...';

    try {
      const res = await fetch(`/api/orders/${orderId}/status`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          status: 'CANCELLED',
          notes: `[CANCELLED from Orders Queue]: ${finalReason}`
        })
      });
      const data = await res.json();
      if (data.success) {
        if (orderCancelModalInstance) orderCancelModalInstance.hide();
        window.location.reload();
      } else {
        alert(data.message || 'Failed to remove order.');
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-trash"></i> Confirm & Remove from Queue';
      }
    } catch (err) {
      alert('Error updating order: ' + err.message);
      btn.disabled = false;
      btn.innerHTML = '<i class="bi bi-trash"></i> Confirm & Remove from Queue';
    }
  };

  function initOrdersPage() {
    const orderSearchInput = document.getElementById('orderSearchInput');
    const clearOrderSearchBtn = document.getElementById('clearOrderSearchBtn');
    if (!orderSearchInput && !document.getElementById('orderStatusTabs')) return;

    const urlParams = new URLSearchParams(window.location.search);
    const statusFromUrl = urlParams.get('status') || '<%= currentStatus %>' || 'ALL';
    window.switchOrderStatusTab(statusFromUrl, false);

    if (orderSearchInput && !orderSearchInput.dataset.ordersBound) {
      orderSearchInput.dataset.ordersBound = 'true';
      orderSearchInput.addEventListener('input', window.filterOrdersTable);
    }

    if (clearOrderSearchBtn && !clearOrderSearchBtn.dataset.ordersBound) {
      clearOrderSearchBtn.dataset.ordersBound = 'true';
      clearOrderSearchBtn.addEventListener('click', () => {
        orderSearchInput.value = '';
        window.filterOrdersTable();
        orderSearchInput.focus();
      });
    }
  }

  // Delegated click listener so tab button clicks ALWAYS trigger even across Turbo transitions
  if (!window._ordersTabDelegationAttached) {
    window._ordersTabDelegationAttached = true;
    document.addEventListener('click', function(e) {
      const btn = e.target.closest('.order-tab-btn');
      if (btn) {
        const status = btn.getAttribute('data-status');
        if (status && typeof window.switchOrderStatusTab === 'function') {
          window.switchOrderStatusTab(status);
        }
      }
    });
  }

  if (!window._ordersPopstateAttached) {
    window._ordersPopstateAttached = true;
    window.addEventListener('popstate', () => {
      const urlParams = new URLSearchParams(window.location.search);
      const status = urlParams.get('status') || 'ALL';
      if (typeof window.switchOrderStatusTab === 'function') {
        window.switchOrderStatusTab(status, false);
      }
    });
  }

  initOrdersPage();
  document.addEventListener('turbo:load', initOrdersPage);
  document.addEventListener('DOMContentLoaded', initOrdersPage);
})();
</script>

<%- include('../partials/footer') %>
