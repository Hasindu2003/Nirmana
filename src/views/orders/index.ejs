<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<main class="main-wrapper">
  <div class="content-body">
    <!-- Header -->
    <div class="d-flex flex-wrap align-items-center justify-content-between mb-4">
      <div>
        <h2 class="fs-4 fw-bold mb-1">Printing Orders</h2>
        <div class="text-muted small">Track print job queue, customer specs, and fulfillment</div>
      </div>
      <div class="mt-2 mt-sm-0">
        <a href="/orders/new" class="btn btn-serene-primary">
          <i class="bi bi-plus-lg"></i> New Order
        </a>
      </div>
    </div>

    <!-- Status Filters & Search -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
      <div class="d-flex flex-wrap gap-1">
        <a href="/orders" class="btn btn-sm <%= currentStatus === 'ALL' ? 'btn-serene-primary' : 'btn-serene-secondary' %>">
          All (<%= orders.length %>)
        </a>
        <a href="/orders?status=RECEIVED" class="btn btn-sm <%= currentStatus === 'RECEIVED' ? 'btn-serene-primary' : 'btn-serene-secondary' %>">Received</a>
        <a href="/orders?status=PRINTING" class="btn btn-sm <%= currentStatus === 'PRINTING' ? 'btn-serene-primary' : 'btn-serene-secondary' %>">Printing</a>
        <a href="/orders?status=READY" class="btn btn-sm <%= currentStatus === 'READY' ? 'btn-serene-primary' : 'btn-serene-secondary' %>">Ready for Pickup</a>
        <a href="/orders?status=COMPLETED" class="btn btn-sm <%= currentStatus === 'COMPLETED' ? 'btn-serene-primary' : 'btn-serene-secondary' %>">Completed</a>
      </div>

      <form action="/orders" method="GET" class="d-flex align-items-center gap-2 flex-grow-1 flex-sm-grow-0" style="min-width: 220px; max-width: 100%;">
        <input type="text" name="search" value="<%= search %>" class="form-control form-control-sm flex-grow-1" placeholder="Search order #, job, client...">
        <button type="submit" class="btn btn-sm btn-serene-secondary">Search</button>
      </form>
    </div>

    <!-- Orders Table Card -->
    <div class="serene-card">
      <div class="table-responsive">
        <table class="serene-table">
          <thead>
            <tr>
              <th>Order #</th>
              <th>Customer</th>
              <th>Job Description</th>
              <th>Amount & Balance</th>
              <th>Status</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% if (orders && orders.length > 0) { %>
              <% orders.forEach(o => { %>
                <tr>
                  <td>
                    <a href="/orders/<%= o.id %>" class="fw-semibold text-decoration-none text-dark font-monospace">
                      <%= o.orderNumber %>
                    </a>
                  </td>
                  <td>
                    <div class="fw-semibold text-dark"><%= o.customer ? o.customer.name : 'Unknown' %></div>
                    <% if (o.customer && o.customer.phone) { %>
                      <div class="text-muted small"><%= o.customer.phone %></div>
                    <% } %>
                  </td>
                  <td>
                    <div class="fw-medium text-dark"><%= o.jobTitle %></div>
                    <span class="badge bg-light text-muted border small mt-1"><%= o.quantity %> units</span>
                  </td>
                  <td>
                    <div class="tabular-nums fw-semibold text-dark">
                      <%= currencySymbol %> <%= parseFloat(o.totalAmount).toLocaleString('en-LK', { minimumFractionDigits: 2 }) %>
                    </div>
                    <% if (parseFloat(o.balanceAmount) <= 0) { %>
                      <span class="badge mt-1" style="background:#edf7ed; color:#1e4620;">Paid in Full</span>
                    <% } else { %>
                      <div class="text-danger small fw-semibold mt-1">
                        Due: <%= currencySymbol %> <%= parseFloat(o.balanceAmount).toLocaleString('en-LK', { minimumFractionDigits: 2 }) %>
                      </div>
                    <% } %>
                  </td>
                  <td>
                    <span class="status-badge status-<%= o.status.toLowerCase() %>">
                      <span class="status-dot"></span> <%= o.status.replace('_', ' ') %>
                    </span>
                  </td>
                  <td>
                    <a href="/orders/<%= o.id %>" class="btn btn-sm btn-serene-secondary py-1 px-2" title="View Details">
                      <i class="bi bi-eye"></i> View
                    </a>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="6" class="text-center py-5 text-muted">
                  No orders match this filter. Click "+ New Order" to record an order.
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
      <%- include('../partials/pagination', { pagination, baseUrl: '/orders', queryParams: { status: currentStatus !== 'ALL' ? currentStatus : undefined, search: search || undefined, customerId: typeof customerId !== 'undefined' && customerId ? customerId : undefined } }) %>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
