<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<main class="main-wrapper">
  <div class="content-body">
    <!-- Header with View Tabs -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
      <div>
        <h2 class="fs-4 fw-bold mb-1 d-flex align-items-center gap-2">
          <i class="bi bi-cart3 text-primary"></i>
          <span>Point of Sale (POS)</span>
        </h2>
        <div class="text-muted small">Simple counter billing & sales records</div>
      </div>
      <div class="d-flex align-items-center gap-2">
        <ul class="nav nav-pills pos-nav-pills p-1 bg-white border rounded-3 shadow-sm" id="posViewTabs" role="tablist">
          <li class="nav-item" role="presentation">
            <button class="nav-link active px-3 py-1-5 fw-semibold small d-flex align-items-center gap-2" id="terminal-tab" data-bs-toggle="pill" data-bs-target="#terminalView" type="button" role="tab">
              <i class="bi bi-calculator"></i>
              <span>POS Billing</span>
            </button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link px-3 py-1-5 fw-semibold small d-flex align-items-center gap-2" id="records-tab" data-bs-toggle="pill" data-bs-target="#recordsView" type="button" role="tab">
              <i class="bi bi-journal-text"></i>
              <span>Sales Records</span>
              <span class="badge bg-secondary rounded-pill" id="tabSalesCountBadge"><%= todayStats.todaySalesCount %></span>
            </button>
          </li>
        </ul>
      </div>
    </div>

    <!-- Alert Banner Container -->
    <div id="posAlertContainer"></div>

    <!-- Tab Content -->
    <div class="tab-content" id="posViewContent">
      <!-- =================================================================== -->
      <!-- 1. SIMPLE POS BILLING TERMINAL -->
      <!-- =================================================================== -->
      <div class="tab-pane fade show active" id="terminalView" role="tabpanel">
        <!-- 1. ITEM ENTRY BAR (Select or Enter Item Code) -->
        <div class="card border-0 shadow-sm rounded-3 mb-3">
          <div class="card-header bg-white border-bottom py-2 px-3 d-flex align-items-center justify-content-between">
            <span class="fw-bold small text-uppercase text-secondary d-flex align-items-center gap-2">
              <i class="bi bi-plus-circle text-primary"></i> Add Item to Bill
            </span>
            <span class="text-muted small" style="font-size: 0.75rem;">
              Select from list or type item code
            </span>
          </div>
          <div class="card-body p-3">
            <form id="itemEntryForm" onsubmit="handleAddItemSubmit(event)" class="row g-2 align-items-end">
              <!-- Item Code Input -->
              <div class="col-12 col-sm-6 col-md-2">
                <label class="form-label small text-muted mb-1 fw-semibold">Item Code</label>
                <div class="input-group input-group-sm">
                  <span class="input-group-text bg-light"><i class="bi bi-upc-scan"></i></span>
                  <input type="text" id="itemCodeInput" class="form-control form-control-sm font-monospace" placeholder="e.g. STK-0001" autocomplete="off" oninput="onItemCodeInput(this.value)">
                </div>
              </div>

              <!-- Select Item Dropdown -->
              <div class="col-12 col-sm-6 col-md-3">
                <label class="form-label small text-muted mb-1 fw-semibold">Select Item from List</label>
                <select id="itemSelectDropdown" class="form-select form-select-sm" onchange="onItemDropdownSelect(this.value)">
                  <option value="">-- Choose item from inventory --</option>
                  <% if (stockItems && stockItems.length > 0) { %>
                    <% stockItems.forEach(item => { %>
                      <option value="<%= item.id %>" 
                              data-code="<%= item.code %>"
                              data-name="<%= item.name %>"
                              data-price="<%= item.sellingPrice || 0 %>"
                              data-stock="<%= item.currentStock %>"
                              data-unit="<%= item.unit %>">
                        <%= item.code %> · <%= item.name %> (<%= currencySymbol %> <%= parseFloat(item.sellingPrice || 0).toFixed(2) %>) [<%= item.currentStock %> in stock]
                      </option>
                    <% }); %>
                  <% } %>
                  <option value="CUSTOM">+ Custom / Printing Service</option>
                </select>
              </div>

              <!-- Item Description -->
              <div class="col-12 col-sm-6 col-md-3">
                <label class="form-label small text-muted mb-1 fw-semibold">Item / Service Description</label>
                <input type="text" id="itemNameInput" class="form-control form-control-sm" placeholder="Item name or custom service..." required autocomplete="off">
              </div>

              <!-- Unit Price -->
              <div class="col-6 col-sm-3 col-md-2">
                <label class="form-label small text-muted mb-1 fw-semibold">Unit Price (<%= currencySymbol %>)</label>
                <input type="number" id="itemPriceInput" class="form-control form-control-sm tabular-nums text-end" min="0" step="any" placeholder="0.00" required>
              </div>

              <!-- Quantity -->
              <div class="col-6 col-sm-3 col-md-1">
                <label class="form-label small text-muted mb-1 fw-semibold">Quantity</label>
                <input type="number" id="itemQtyInput" class="form-control form-control-sm tabular-nums text-center" value="1" min="0.01" step="any" required>
              </div>

              <!-- Add Button -->
              <div class="col-12 col-md-1">
                <button type="submit" class="btn btn-sm btn-serene-primary w-100 d-flex align-items-center justify-content-center gap-1 py-1-5" id="addItemBtn" title="Add item (Enter)">
                  <i class="bi bi-plus-lg"></i>
                  <span>Add</span>
                </button>
              </div>
            </form>
          </div>
        </div>

        <!-- 2. CURRENT BILL ITEMS TABLE -->
        <div class="card border-0 shadow-sm rounded-3 mb-3">
          <div class="card-header bg-white border-bottom py-2-5 px-3 d-flex align-items-center justify-content-between">
            <div class="fw-bold small text-uppercase text-secondary d-flex align-items-center gap-2">
              <i class="bi bi-receipt"></i> Items on Bill (<span id="cartItemsCountText">0</span>)
            </div>
            <button type="button" class="btn btn-sm btn-link text-danger text-decoration-none p-0 small" onclick="clearCart()" title="Empty current bill">
              <i class="bi bi-trash3"></i> Clear Bill
            </button>
          </div>

          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.875rem;">
              <thead class="table-light text-muted small text-uppercase">
                <tr>
                  <th style="width: 45px;" class="ps-3 text-center">#</th>
                  <th style="width: 130px;">Item Code</th>
                  <th>Item / Service Description</th>
                  <th style="width: 140px;" class="text-end">Price (<%= currencySymbol %>)</th>
                  <th style="width: 140px;" class="text-center">Quantity</th>
                  <th style="width: 140px;" class="text-end">Total (<%= currencySymbol %>)</th>
                  <th style="width: 60px;" class="text-center pe-3">Remove</th>
                </tr>
              </thead>
              <tbody id="cartTableBody">
                <tr id="cartEmptyRow">
                  <td colspan="7" class="text-center text-muted py-5">
                    <i class="bi bi-cart-x fs-1 opacity-25 d-block mb-1"></i>
                    <span>No items added yet. Select an item or enter code above.</span>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- 3. BILL SUMMARY & CHECKOUT (PRINT OR SAVE) -->
        <div class="card border-0 shadow-sm rounded-3">
          <div class="card-body p-3 p-md-4">
            <div class="row g-4">
              <!-- Left Side: Customer & Payment Details -->
              <div class="col-12 col-lg-6 border-end-lg">
                <h6 class="fw-bold small text-uppercase text-secondary mb-3 d-flex align-items-center gap-2">
                  <i class="bi bi-person-check"></i> Customer & Payment Details
                </h6>

                <div class="row g-2 mb-3">
                  <div class="col-12 col-sm-7">
                    <label class="form-label small text-muted mb-1">Customer Name</label>
                    <input type="text" id="saleCustomerName" class="form-control form-control-sm" placeholder="Walk-in Customer" value="Walk-in Customer">
                  </div>
                  <div class="col-12 col-sm-5">
                    <label class="form-label small text-muted mb-1">Phone Number (Optional)</label>
                    <input type="text" id="saleCustomerPhone" class="form-control form-control-sm" placeholder="e.g. 0771234567">
                  </div>
                </div>

                <div class="row g-2 mb-3">
                  <div class="col-12 col-sm-6">
                    <label class="form-label small text-muted mb-1">Payment Method</label>
                    <select id="salePaymentMethod" class="form-select form-select-sm" onchange="onPaymentMethodChange()">
                      <option value="CASH" selected>Cash</option>
                      <option value="CARD">Credit / Debit Card</option>
                      <option value="BANK_TRANSFER">Bank Transfer</option>
                      <option value="OTHER">Other / QR</option>
                    </select>
                  </div>

                  <div class="col-12 col-sm-6" id="cashTenderedGroup">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                      <label class="form-label small text-muted mb-0">Amount Received</label>
                      <button type="button" class="btn btn-xs btn-link p-0 text-decoration-none small" onclick="setExactCash()">Exact</button>
                    </div>
                    <div class="input-group input-group-sm">
                      <span class="input-group-text bg-light"><%= currencySymbol %></span>
                      <input type="number" id="amountTenderedInput" class="form-control form-control-sm tabular-nums text-end fw-bold" placeholder="0.00" oninput="calculateChange()">
                    </div>
                  </div>
                </div>

                <!-- Change Due Box (Visible for Cash) -->
                <div id="changeDueBox" class="p-2-5 rounded-2 d-flex justify-content-between align-items-center" style="background: #f8fafc; border: 1px dashed #cbd5e1;">
                  <span class="small text-muted fw-semibold">Change Due:</span>
                  <span class="fs-6 fw-bold tabular-nums text-success" id="changeDueText"><%= currencySymbol %> 0.00</span>
                </div>
              </div>

              <!-- Right Side: Total Amount & Action Buttons (Print or Save) -->
              <div class="col-12 col-lg-6 d-flex flex-column justify-content-between">
                <div>
                  <h6 class="fw-bold small text-uppercase text-secondary mb-3 d-flex align-items-center gap-2">
                    <i class="bi bi-calculator"></i> Total Amount
                  </h6>

                  <div class="d-flex justify-content-between align-items-center small mb-2">
                    <span class="text-muted">Subtotal:</span>
                    <span class="fw-semibold tabular-nums fs-6" id="billSubtotal"><%= currencySymbol %> 0.00</span>
                  </div>

                  <div class="d-flex justify-content-between align-items-center gap-2 mb-3">
                    <div class="d-flex align-items-center gap-1">
                      <span class="small text-muted">Discount:</span>
                      <div class="btn-group btn-group-xs" role="group">
                        <input type="radio" class="btn-check" name="discountType" id="discountFixed" value="FIXED" checked onchange="calculateTotals()">
                        <label class="btn btn-outline-secondary py-0 px-1 text-xs" for="discountFixed"><%= currencySymbol %></label>
                        <input type="radio" class="btn-check" name="discountType" id="discountPercent" value="PERCENTAGE" onchange="calculateTotals()">
                        <label class="btn btn-outline-secondary py-0 px-1 text-xs" for="discountPercent">%</label>
                      </div>
                    </div>
                    <div style="width: 120px;">
                      <input type="number" id="billDiscountInput" class="form-control form-control-sm text-end tabular-nums" value="0" min="0" step="any" oninput="calculateTotals()">
                    </div>
                  </div>

                  <!-- Prominent Total Amount Display -->
                  <div class="p-3 rounded-3 mb-4 d-flex justify-content-between align-items-center" style="background: var(--serene-primary-light); border: 1px solid rgba(45, 106, 104, 0.2);">
                    <div>
                      <span class="fw-bold d-block" style="color: var(--serene-primary); font-size: 1.1rem;">TOTAL AMOUNT</span>
                      <small class="text-muted" style="font-size: 0.75rem;">Includes all discounts</small>
                    </div>
                    <span class="fs-2 fw-bold tabular-nums" id="billGrandTotal" style="color: var(--serene-primary);">
                      <%= currencySymbol %> 0.00
                    </span>
                  </div>
                </div>

                <!-- Action Buttons: Print or Save -->
                <div class="d-flex flex-wrap gap-2 pt-2 border-top">
                  <!-- Save Only Button -->
                  <button type="button" class="btn btn-outline-primary flex-grow-1 py-2-5 fw-bold d-flex align-items-center justify-content-center gap-2 shadow-sm" id="saveSaleOnlyBtn" onclick="processSale(false)">
                    <i class="bi bi-check2-circle fs-5"></i>
                    <span>Save Sale</span>
                  </button>

                  <!-- Save & Print Button -->
                  <button type="button" class="btn btn-serene-primary flex-grow-1 py-2-5 fw-bold d-flex align-items-center justify-content-center gap-2 shadow" id="saveAndPrintBtn" onclick="processSale(true)">
                    <i class="bi bi-printer-fill fs-5"></i>
                    <span>Print Receipt</span>
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- =================================================================== -->
      <!-- 2. SALES RECORDS & HISTORY VIEW -->
      <!-- =================================================================== -->
      <div class="tab-pane fade" id="recordsView" role="tabpanel">
        <!-- Daily KPI Summary Cards -->
        <div class="row g-3 mb-4">
          <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white">
              <div class="text-muted small mb-1 fw-semibold">Today's Sales Revenue</div>
              <div class="fs-4 fw-bold text-primary tabular-nums" id="kpiTodayRevenue">
                <%= currencySymbol %> <%= parseFloat(todayStats.todayRevenue || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
              </div>
              <div class="text-muted small" style="font-size: 0.72rem;">Total revenue settled today</div>
            </div>
          </div>
          <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white">
              <div class="text-muted small mb-1 fw-semibold">Transactions Count</div>
              <div class="fs-4 fw-bold text-dark tabular-nums" id="kpiTodayCount">
                <%= todayStats.todaySalesCount || 0 %>
              </div>
              <div class="text-muted small" style="font-size: 0.72rem;">Total bills generated today</div>
            </div>
          </div>
          <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white">
              <div class="text-muted small mb-1 fw-semibold">Cash Collected</div>
              <div class="fs-4 fw-bold text-success tabular-nums" id="kpiCashRevenue">
                <%= currencySymbol %> <%= parseFloat(todayStats.cashRevenue || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
              </div>
              <div class="text-muted small" style="font-size: 0.72rem;">Cash drawer intake</div>
            </div>
          </div>
          <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white">
              <div class="text-muted small mb-1 fw-semibold">Card & Bank Transfers</div>
              <div class="fs-4 fw-bold text-info tabular-nums" id="kpiCardRevenue">
                <%= currencySymbol %> <%= parseFloat((todayStats.cardRevenue || 0) + (todayStats.bankRevenue || 0)).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
              </div>
              <div class="text-muted small" style="font-size: 0.72rem;">Digital & bank settlements</div>
            </div>
          </div>
        </div>

        <!-- Filter & Search Toolbar -->
        <div class="card border-0 shadow-sm rounded-3 mb-3">
          <div class="card-body p-3">
            <form action="/pos" method="GET" class="row g-2 align-items-center">
              <input type="hidden" name="tab" value="records">
              <div class="col-12 col-md-4">
                <div class="input-group input-group-sm">
                  <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                  <input type="text" name="search" class="form-control form-control-sm" placeholder="Search receipt #, customer..." value="<%= search %>">
                </div>
              </div>
              <div class="col-6 col-md-2">
                <input type="date" name="dateFrom" class="form-control form-control-sm" title="From Date" value="<%= dateFrom %>">
              </div>
              <div class="col-6 col-md-2">
                <input type="date" name="dateTo" class="form-control form-control-sm" title="To Date" value="<%= dateTo %>">
              </div>
              <div class="col-6 col-md-2">
                <select name="paymentMethod" class="form-select form-select-sm">
                  <option value="ALL" <%= paymentMethod === 'ALL' ? 'selected' : '' %>>All Payments</option>
                  <option value="CASH" <%= paymentMethod === 'CASH' ? 'selected' : '' %>>Cash</option>
                  <option value="CARD" <%= paymentMethod === 'CARD' ? 'selected' : '' %>>Card</option>
                  <option value="BANK_TRANSFER" <%= paymentMethod === 'BANK_TRANSFER' ? 'selected' : '' %>>Bank Transfer</option>
                </select>
              </div>
              <div class="col-6 col-md-2 d-flex gap-1">
                <button type="submit" class="btn btn-sm btn-serene-primary flex-grow-1">Filter</button>
                <a href="/pos?tab=records" class="btn btn-sm btn-serene-secondary" title="Reset Filters"><i class="bi bi-arrow-counterclockwise"></i></a>
              </div>
            </form>
          </div>
        </div>

        <!-- Sales Records Ledger Table -->
        <div class="card border-0 shadow-sm rounded-3">
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.875rem;">
              <thead class="table-light text-muted small text-uppercase">
                <tr>
                  <th class="ps-3">Receipt #</th>
                  <th>Date & Time</th>
                  <th>Customer</th>
                  <th>Items</th>
                  <th>Payment</th>
                  <th class="text-end">Total Amount</th>
                  <th class="text-center">Status</th>
                  <th class="text-end pe-3">Actions</th>
                </tr>
              </thead>
              <tbody id="salesRecordsTableBody">
                <% if (sales && sales.length > 0) { %>
                  <% sales.forEach(sale => { %>
                    <tr id="saleRow-<%= sale.id %>">
                      <td class="ps-3 fw-bold font-monospace text-primary">
                        <%= sale.receiptNumber %>
                      </td>
                      <td>
                        <div><%= formatDate(sale.createdAt) %></div>
                        <small class="text-muted" style="font-size: 0.72rem;"><%= formatTime(sale.createdAt) %></small>
                      </td>
                      <td>
                        <div class="fw-semibold"><%= sale.customerName %></div>
                        <% if (sale.customerPhone) { %>
                          <small class="text-muted"><%= sale.customerPhone %></small>
                        <% } %>
                      </td>
                      <td>
                        <span class="badge bg-light text-dark border">
                          <%= sale.items ? sale.items.length : 0 %> items
                        </span>
                        <div class="text-muted small text-truncate" style="max-width: 180px; font-size: 0.75rem;">
                          <%= sale.items ? sale.items.map(i => i.itemName).join(', ') : '' %>
                        </div>
                      </td>
                      <td>
                        <% if (sale.paymentMethod === 'CASH') { %>
                          <span class="badge bg-success-subtle text-success border border-success-subtle"><i class="bi bi-cash"></i> Cash</span>
                        <% } else if (sale.paymentMethod === 'CARD') { %>
                          <span class="badge bg-primary-subtle text-primary border border-primary-subtle"><i class="bi bi-credit-card"></i> Card</span>
                        <% } else if (sale.paymentMethod === 'BANK_TRANSFER') { %>
                          <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle"><i class="bi bi-bank"></i> Bank</span>
                        <% } else { %>
                          <span class="badge bg-light text-secondary border"><%= sale.paymentMethod %></span>
                        <% } %>
                      </td>
                      <td class="text-end fw-bold tabular-nums">
                        <%= currencySymbol %> <%= parseFloat(sale.totalAmount).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                      </td>
                      <td class="text-center">
                        <% if (sale.status === 'COMPLETED') { %>
                          <span class="badge bg-success-subtle text-success">Completed</span>
                        <% } else { %>
                          <span class="badge bg-secondary-subtle text-muted text-decoration-line-through">Voided</span>
                        <% } %>
                      </td>
                      <td class="text-end pe-3">
                        <div class="btn-group btn-group-sm">
                          <button type="button" class="btn btn-outline-secondary" onclick="viewReceipt(<%= sale.id %>)" title="View & Print Receipt">
                            <i class="bi bi-receipt"></i>
                          </button>
                          <% if (sale.status === 'COMPLETED') { %>
                            <button type="button" class="btn btn-outline-danger" onclick="confirmVoidSale(<%= sale.id %>, '<%= sale.receiptNumber %>')" title="Void Sale">
                              <i class="bi bi-x-circle"></i>
                            </button>
                          <% } %>
                        </div>
                      </td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr>
                    <td colspan="8" class="text-center text-muted py-5">
                      <i class="bi bi-journal-x fs-1 opacity-25 d-block mb-1"></i>
                      <span>No sales recorded yet.</span>
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>

          <!-- Pagination -->
          <% if (pagination && pagination.totalPages > 1) { %>
            <div class="card-footer bg-white border-top p-3">
              <%- include('../partials/pagination', {
                pagination,
                baseUrl: '/pos',
                queryParams: { search, dateFrom, dateTo, paymentMethod, tab: 'records' }
              }) %>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</main>

<!-- =================================================================== -->
<!-- THERMAL 80mm & STANDARD PRINTABLE RECEIPT MODAL -->
<!-- =================================================================== -->
<div class="modal fade" id="receiptModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
  <div class="modal-dialog modal-dialog-centered" style="max-width: 420px;">
    <div class="modal-content border-0 shadow-lg rounded-3">
      <div class="modal-header border-bottom py-2-5 px-3 bg-light">
        <h6 class="modal-title fw-bold mb-0 d-flex align-items-center gap-2">
          <i class="bi bi-receipt text-primary"></i>
          <span>Sales Receipt</span>
        </h6>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <div class="modal-body p-3" id="receiptPrintableArea">
        <div class="receipt-paper p-3 bg-white border rounded-2" style="font-family: 'Courier New', Courier, monospace; font-size: 13px; line-height: 1.35;">
          <!-- Shop Header -->
          <div class="text-center mb-3">
            <h5 class="fw-bold mb-0" style="letter-spacing: 1px;">NIRMANA PRINTING</h5>
            <div style="font-size: 11px;" class="text-muted">WHEN QUALITY REALLY MATTERS</div>
            <div style="font-size: 11px;">Printing · Photocopy · Graphic Design</div>
            <div style="font-size: 11px;">Tel: 070 177 5826 / 077 123 4567</div>
          </div>

          <div style="border-top: 1px dashed #000; margin: 8px 0;"></div>

          <!-- Receipt Metadata -->
          <div class="d-flex justify-content-between" style="font-size: 12px;">
            <span>Receipt #:</span>
            <span class="fw-bold" id="rcptNumber">POS-0000</span>
          </div>
          <div class="d-flex justify-content-between" style="font-size: 12px;">
            <span>Date/Time:</span>
            <span id="rcptDate">-</span>
          </div>
          <div class="d-flex justify-content-between" style="font-size: 12px;">
            <span>Cashier:</span>
            <span id="rcptCashier"><%= currentUser ? (currentUser.fullName || currentUser.username) : 'Staff' %></span>
          </div>
          <div class="d-flex justify-content-between" style="font-size: 12px;">
            <span>Customer:</span>
            <span id="rcptCustomer">Walk-in</span>
          </div>

          <div style="border-top: 1px dashed #000; margin: 8px 0;"></div>

          <!-- Items Table -->
          <table style="width: 100%; font-size: 12px;">
            <thead>
              <tr style="border-bottom: 1px solid #ccc;">
                <th style="text-align: left; padding-bottom: 4px;">Item</th>
                <th style="text-align: center; padding-bottom: 4px; width: 45px;">Qty</th>
                <th style="text-align: right; padding-bottom: 4px; width: 60px;">Price</th>
                <th style="text-align: right; padding-bottom: 4px; width: 70px;">Total</th>
              </tr>
            </thead>
            <tbody id="rcptItemsBody">
              <!-- Dynamically rendered -->
            </tbody>
          </table>

          <div style="border-top: 1px dashed #000; margin: 8px 0;"></div>

          <!-- Totals -->
          <div class="d-flex justify-content-between" style="font-size: 12px;">
            <span>Subtotal:</span>
            <span id="rcptSubtotal"><%= currencySymbol %> 0.00</span>
          </div>
          <div class="d-flex justify-content-between text-muted" id="rcptDiscountRow" style="font-size: 12px;">
            <span>Discount:</span>
            <span id="rcptDiscount"><%= currencySymbol %> 0.00</span>
          </div>
          <div class="d-flex justify-content-between fw-bold my-1" style="font-size: 15px; border-top: 1px solid #000; border-bottom: 1px solid #000; padding: 4px 0;">
            <span>NET TOTAL:</span>
            <span id="rcptTotal"><%= currencySymbol %> 0.00</span>
          </div>

          <!-- Payment & Change -->
          <div class="d-flex justify-content-between" style="font-size: 12px;">
            <span>Payment Method:</span>
            <span id="rcptPaymentMethod">CASH</span>
          </div>
          <div class="d-flex justify-content-between" style="font-size: 12px;">
            <span>Amount Tendered:</span>
            <span id="rcptTendered"><%= currencySymbol %> 0.00</span>
          </div>
          <div class="d-flex justify-content-between fw-bold" style="font-size: 13px;">
            <span>Change Due:</span>
            <span id="rcptChange"><%= currencySymbol %> 0.00</span>
          </div>

          <div style="border-top: 1px dashed #000; margin: 12px 0 8px 0;"></div>

          <!-- Footer -->
          <div class="text-center" style="font-size: 11px;">
            <div>*** THANK YOU FOR YOUR BUSINESS! ***</div>
            <div class="text-muted">Software by Nirmana Systems</div>
          </div>
        </div>
      </div>

      <div class="modal-footer border-top py-2 px-3 bg-light d-flex justify-content-between">
        <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Close</button>
        <button type="button" class="btn btn-sm btn-serene-primary px-3 fw-bold d-flex align-items-center gap-1" onclick="printReceiptFromModal()">
          <i class="bi bi-printer-fill"></i> Print Thermal Receipt
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Stock Items JSON Cache -->
<script id="rawStockItemsJson" type="application/json">
  <%- JSON.stringify(stockItems || []) %>
</script>

<style>
  .pos-nav-pills .nav-link {
    color: var(--serene-text-muted);
    border-radius: 6px;
    transition: all 0.15s ease-in-out;
  }
  .pos-nav-pills .nav-link.active {
    background-color: var(--serene-primary);
    color: #ffffff;
  }
  .btn-xs {
    padding: 0.15rem 0.45rem;
    font-size: 0.75rem;
    border-radius: 4px;
  }
  .text-xs {
    font-size: 0.75rem;
  }
  @media (min-width: 992px) {
    .border-end-lg {
      border-right: 1px solid var(--serene-border) !important;
      padding-right: 1.5rem;
    }
  }
</style>

<script>
  // In-memory stock catalog & active bill state
  const rawStockItems = JSON.parse(document.getElementById('rawStockItemsJson').textContent || '[]');
  let cart = []; // Array of { id, stockItemId, itemCode, name, unitPrice, quantity, lineTotal, unit }
  let lastCompletedSale = null;

  document.addEventListener('DOMContentLoaded', () => {
    // Check if URL has tab=records
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('tab') === 'records') {
      const recordsTabTrigger = document.getElementById('records-tab');
      if (recordsTabTrigger) {
        bootstrap.Tab.getOrCreateInstance(recordsTabTrigger).show();
      }
    }

    // Default focus to item code input for fast cashier entry
    const codeInput = document.getElementById('itemCodeInput');
    if (codeInput) codeInput.focus();
  });

  // When staff types an Item Code
  function onItemCodeInput(val) {
    const code = val.trim().toUpperCase();
    if (!code) return;

    const matched = rawStockItems.find(i => (i.code || '').toUpperCase() === code);
    if (matched) {
      document.getElementById('itemSelectDropdown').value = matched.id;
      document.getElementById('itemNameInput').value = matched.name;
      document.getElementById('itemPriceInput').value = parseFloat(matched.sellingPrice || 0);
      document.getElementById('itemQtyInput').focus();
    }
  }

  // When staff selects an Item from the dropdown
  function onItemDropdownSelect(val) {
    if (!val) {
      document.getElementById('itemCodeInput').value = '';
      document.getElementById('itemNameInput').value = '';
      document.getElementById('itemPriceInput').value = '';
      return;
    }

    if (val === 'CUSTOM') {
      document.getElementById('itemCodeInput').value = 'CUSTOM';
      document.getElementById('itemNameInput').value = '';
      document.getElementById('itemPriceInput').value = '';
      document.getElementById('itemNameInput').focus();
      return;
    }

    const matched = rawStockItems.find(i => i.id == val);
    if (matched) {
      document.getElementById('itemCodeInput').value = matched.code || '';
      document.getElementById('itemNameInput').value = matched.name || '';
      document.getElementById('itemPriceInput').value = parseFloat(matched.sellingPrice || 0);
      document.getElementById('itemQtyInput').focus();
    }
  }

  // Handle "+ Add Item"
  function handleAddItemSubmit(e) {
    e.preventDefault();

    const code = document.getElementById('itemCodeInput').value.trim();
    const name = document.getElementById('itemNameInput').value.trim();
    const price = parseFloat(document.getElementById('itemPriceInput').value) || 0;
    const qty = Math.max(0.01, parseFloat(document.getElementById('itemQtyInput').value) || 1);
    const dropdownVal = document.getElementById('itemSelectDropdown').value;

    if (!name) {
      alert('Please enter an item name or description.');
      return;
    }

    let stockItemId = null;
    let unit = 'Pcs';

    if (dropdownVal && dropdownVal !== 'CUSTOM') {
      const matched = rawStockItems.find(i => i.id == dropdownVal);
      if (matched) {
        stockItemId = matched.id;
        unit = matched.unit || 'Pcs';
      }
    } else if (code) {
      const matched = rawStockItems.find(i => (i.code || '').toUpperCase() === code.toUpperCase());
      if (matched) {
        stockItemId = matched.id;
        unit = matched.unit || 'Pcs';
      }
    }

    // Check if this item is already in the cart table
    const existingIndex = cart.findIndex(c => (stockItemId && c.stockItemId === stockItemId) || (c.itemCode && c.itemCode === code && c.name === name));

    if (existingIndex >= 0) {
      cart[existingIndex].quantity += qty;
      cart[existingIndex].unitPrice = price;
      cart[existingIndex].lineTotal = cart[existingIndex].quantity * price;
    } else {
      cart.push({
        id: 'cart_' + Date.now(),
        stockItemId,
        itemCode: code || (stockItemId ? '' : 'CUSTOM'),
        name,
        unitPrice: price,
        quantity: qty,
        lineTotal: price * qty,
        unit,
      });
    }

    // Reset entry inputs for next scan
    document.getElementById('itemCodeInput').value = '';
    document.getElementById('itemSelectDropdown').value = '';
    document.getElementById('itemNameInput').value = '';
    document.getElementById('itemPriceInput').value = '';
    document.getElementById('itemQtyInput').value = '1';
    document.getElementById('itemCodeInput').focus();

    renderCartTable();
  }

  // Render the Cart Table
  function renderCartTable() {
    const tbody = document.getElementById('cartTableBody');
    const emptyRow = document.getElementById('cartEmptyRow');
    const countBadge = document.getElementById('cartItemsCountText');

    countBadge.textContent = cart.length;

    if (cart.length === 0) {
      tbody.innerHTML = `
        <tr id="cartEmptyRow">
          <td colspan="7" class="text-center text-muted py-5">
            <i class="bi bi-cart-x fs-1 opacity-25 d-block mb-1"></i>
            <span>No items added yet. Select an item or enter code above.</span>
          </td>
        </tr>
      `;
      calculateTotals();
      return;
    }

    let html = '';
    cart.forEach((item, index) => {
      html += `
        <tr>
          <td class="text-center text-muted small ps-3">${index + 1}</td>
          <td class="font-monospace small fw-semibold text-primary">
            ${escapeHtml(item.itemCode || '-')}
          </td>
          <td>
            <div class="fw-semibold text-dark">${escapeHtml(item.name)}</div>
            <small class="text-muted" style="font-size: 0.72rem;">Unit: ${escapeHtml(item.unit || 'Pcs')}</small>
          </td>
          <td class="text-end">
            <input type="number" class="form-control form-control-sm text-end tabular-nums ms-auto py-0 px-1" style="width: 85px; height: 26px;" value="${item.unitPrice}" min="0" step="any" onchange="updateCartItemPrice('${item.id}', this.value)">
          </td>
          <td class="text-center">
            <div class="d-inline-flex align-items-center gap-1">
              <button type="button" class="btn btn-xs btn-light border py-0 px-1" onclick="updateCartItemQty('${item.id}', -1)">-</button>
              <input type="number" class="form-control form-control-sm text-center p-0 tabular-nums fw-bold text-xs" style="width: 50px; height: 26px;" value="${item.quantity}" min="0.01" step="any" onchange="setCartItemQty('${item.id}', this.value)">
              <button type="button" class="btn btn-xs btn-light border py-0 px-1" onclick="updateCartItemQty('${item.id}', 1)">+</button>
            </div>
          </td>
          <td class="text-end fw-bold tabular-nums">
            <%= currencySymbol %> ${item.lineTotal.toFixed(2)}
          </td>
          <td class="text-center pe-3">
            <button type="button" class="btn btn-link text-danger p-0 text-decoration-none" onclick="removeCartItem('${item.id}')" title="Delete row">
              <i class="bi bi-trash3"></i>
            </button>
          </td>
        </tr>
      `;
    });

    tbody.innerHTML = html;
    calculateTotals();
  }

  // Update item price directly in table
  function updateCartItemPrice(id, val) {
    const item = cart.find(c => c.id === id);
    if (!item) return;
    item.unitPrice = Math.max(0, parseFloat(val) || 0);
    item.lineTotal = item.quantity * item.unitPrice;
    renderCartTable();
  }

  // Step quantity
  function updateCartItemQty(id, delta) {
    const item = cart.find(c => c.id === id);
    if (!item) return;
    item.quantity = Math.max(0.01, item.quantity + delta);
    item.lineTotal = item.quantity * item.unitPrice;
    renderCartTable();
  }

  // Set quantity directly
  function setCartItemQty(id, val) {
    const item = cart.find(c => c.id === id);
    if (!item) return;
    item.quantity = Math.max(0.01, parseFloat(val) || 1);
    item.lineTotal = item.quantity * item.unitPrice;
    renderCartTable();
  }

  // Remove item
  function removeCartItem(id) {
    cart = cart.filter(c => c.id !== id);
    renderCartTable();
  }

  // Clear bill
  function clearCart() {
    if (cart.length > 0 && !confirm('Clear current bill items?')) return;
    cart = [];
    document.getElementById('billDiscountInput').value = '0';
    document.getElementById('amountTenderedInput').value = '';
    renderCartTable();
  }

  // Calculate Subtotal, Discounts, Net Total
  function calculateTotals() {
    const subtotal = cart.reduce((sum, item) => sum + item.lineTotal, 0);
    const discountVal = Math.max(0, parseFloat(document.getElementById('billDiscountInput').value) || 0);
    const isPercent = document.getElementById('discountPercent').checked;

    let discountAmount = 0;
    if (isPercent) {
      discountAmount = (subtotal * discountVal) / 100;
    } else {
      discountAmount = discountVal;
    }

    if (discountAmount > subtotal) discountAmount = subtotal;

    const netTotal = Math.max(0, subtotal - discountAmount);

    document.getElementById('billSubtotal').textContent = '<%= currencySymbol %> ' + subtotal.toFixed(2);
    document.getElementById('billGrandTotal').textContent = '<%= currencySymbol %> ' + netTotal.toFixed(2);

    calculateChange();
  }

  // Payment Method Switching
  function onPaymentMethodChange() {
    const method = document.getElementById('salePaymentMethod').value;
    const cashGroup = document.getElementById('cashTenderedGroup');
    const changeBox = document.getElementById('changeDueBox');

    if (method === 'CASH') {
      cashGroup.style.display = 'block';
      changeBox.style.display = 'flex';
    } else {
      cashGroup.style.display = 'none';
      changeBox.style.display = 'none';
    }
    calculateChange();
  }

  function setExactCash() {
    const netTotal = getNetTotalNumber();
    document.getElementById('amountTenderedInput').value = netTotal.toFixed(2);
    calculateChange();
  }

  function getNetTotalNumber() {
    const totalText = document.getElementById('billGrandTotal').textContent || '0';
    return parseFloat(totalText.replace(/[^0-9.]/g, '')) || 0;
  }

  function calculateChange() {
    const method = document.getElementById('salePaymentMethod').value;
    if (method !== 'CASH') return;

    const netTotal = getNetTotalNumber();
    const tenderedVal = document.getElementById('amountTenderedInput').value;
    const changeText = document.getElementById('changeDueText');

    const tendered = parseFloat(tenderedVal) || 0;
    const change = tendered - netTotal;

    if (tenderedVal === '' || tendered === 0) {
      changeText.textContent = '<%= currencySymbol %> 0.00';
      changeText.className = 'fs-6 fw-bold tabular-nums text-muted';
    } else if (change >= 0) {
      changeText.textContent = '<%= currencySymbol %> ' + change.toFixed(2);
      changeText.className = 'fs-6 fw-bold tabular-nums text-success';
    } else {
      changeText.textContent = 'Due: <%= currencySymbol %> ' + Math.abs(change).toFixed(2);
      changeText.className = 'fs-6 fw-bold tabular-nums text-danger';
    }
  }

  // Core Submit Function: Print or Save
  async function processSale(shouldPrint = false) {
    if (cart.length === 0) {
      alert('Please add at least one item to the bill before saving.');
      document.getElementById('itemCodeInput').focus();
      return;
    }

    const netTotal = getNetTotalNumber();
    const method = document.getElementById('salePaymentMethod').value;
    const tendered = parseFloat(document.getElementById('amountTenderedInput').value) || netTotal;

    if (method === 'CASH' && tendered < netTotal && tendered > 0) {
      if (!confirm(`Amount received (Rs. ${tendered.toFixed(2)}) is less than Net Total (Rs. ${netTotal.toFixed(2)}). Proceed?`)) {
        return;
      }
    }

    const saveBtn = document.getElementById('saveSaleOnlyBtn');
    const printBtn = document.getElementById('saveAndPrintBtn');

    saveBtn.disabled = true;
    printBtn.disabled = true;

    if (shouldPrint) {
      printBtn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Printing...';
    } else {
      saveBtn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Saving...';
    }

    const payload = {
      customerName: document.getElementById('saleCustomerName').value.trim() || 'Walk-in Customer',
      customerPhone: document.getElementById('saleCustomerPhone').value.trim() || null,
      paymentMethod: method,
      discount: parseFloat(document.getElementById('billDiscountInput').value) || 0,
      discountType: document.querySelector('input[name="discountType"]:checked').value,
      amountTendered: method === 'CASH' ? tendered : netTotal,
      items: cart.map(i => ({
        stockItemId: i.stockItemId,
        name: i.name,
        quantity: i.quantity,
        unitPrice: i.unitPrice,
        unit: i.unit,
      })),
    };

    try {
      const res = await fetch('/api/pos/sales', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      const data = await res.json();
      if (!data.success) {
        throw new Error(data.message || 'Failed to record sale');
      }

      lastCompletedSale = data.data;

      // Reset Bill Form
      cart = [];
      document.getElementById('billDiscountInput').value = '0';
      document.getElementById('amountTenderedInput').value = '';
      document.getElementById('saleCustomerName').value = 'Walk-in Customer';
      document.getElementById('saleCustomerPhone').value = '';
      renderCartTable();

      // Show Success Toast / Alert
      showPosAlert(`✓ Sale <strong>#${lastCompletedSale.receiptNumber}</strong> saved successfully for Rs. ${parseFloat(lastCompletedSale.totalAmount).toFixed(2)}.`);

      // Update KPI numbers
      refreshDailyStats();

      // If user chose "Print Receipt"
      if (shouldPrint) {
        populateReceiptModal(lastCompletedSale);
        printReceiptFromModal();
      }

      document.getElementById('itemCodeInput').focus();

    } catch (err) {
      alert('Error recording sale: ' + err.message);
    } finally {
      saveBtn.disabled = false;
      printBtn.disabled = false;
      saveBtn.innerHTML = '<i class="bi bi-check2-circle fs-5"></i> <span>Save Sale</span>';
      printBtn.innerHTML = '<i class="bi bi-printer-fill fs-5"></i> <span>Print Receipt</span>';
    }
  }

  function showPosAlert(htmlMsg) {
    const c = document.getElementById('posAlertContainer');
    c.innerHTML = `
      <div class="alert alert-success alert-dismissible fade show d-flex align-items-center justify-content-between py-2 px-3 mb-3 shadow-sm rounded-3">
        <div><i class="bi bi-check-circle-fill me-2"></i> ${htmlMsg}</div>
        <button type="button" class="btn-close py-2" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    `;
    setTimeout(() => {
      const alertEl = c.querySelector('.alert');
      if (alertEl) {
        const bsAlert = bootstrap.Alert.getOrCreateInstance(alertEl);
        bsAlert.close();
      }
    }, 5000);
  }

  // Populate Receipt Modal
  function populateReceiptModal(sale) {
    document.getElementById('rcptNumber').textContent = sale.receiptNumber;
    document.getElementById('rcptDate').textContent = new Date(sale.createdAt || sale.saleDate).toLocaleString('en-LK', {
      timeZone: 'Asia/Colombo',
      year: 'numeric', month: 'short', day: 'numeric',
      hour: '2-digit', minute: '2-digit'
    });
    document.getElementById('rcptCashier').textContent = sale.cashier ? (sale.cashier.fullName || sale.cashier.username) : 'Staff';
    document.getElementById('rcptCustomer').textContent = sale.customerName + (sale.customerPhone ? ` (${sale.customerPhone})` : '');

    const itemsTbody = document.getElementById('rcptItemsBody');
    let rowsHtml = '';
    (sale.items || []).forEach(item => {
      rowsHtml += `
        <tr>
          <td style="padding: 3px 0;">${escapeHtml(item.itemName)}</td>
          <td style="text-align: center;">${parseFloat(item.quantity)}</td>
          <td style="text-align: right;">${parseFloat(item.unitPrice).toFixed(2)}</td>
          <td style="text-align: right; font-weight: bold;">${parseFloat(item.totalPrice).toFixed(2)}</td>
        </tr>
      `;
    });
    itemsTbody.innerHTML = rowsHtml;

    document.getElementById('rcptSubtotal').textContent = '<%= currencySymbol %> ' + parseFloat(sale.subtotal).toFixed(2);

    const discountRow = document.getElementById('rcptDiscountRow');
    if (parseFloat(sale.discount) > 0) {
      discountRow.style.display = 'flex';
      document.getElementById('rcptDiscount').textContent = '- <%= currencySymbol %> ' + parseFloat(sale.discount).toFixed(2);
    } else {
      discountRow.style.display = 'none';
    }

    document.getElementById('rcptTotal').textContent = '<%= currencySymbol %> ' + parseFloat(sale.totalAmount).toFixed(2);
    document.getElementById('rcptPaymentMethod').textContent = sale.paymentMethod;
    document.getElementById('rcptTendered').textContent = '<%= currencySymbol %> ' + parseFloat(sale.amountTendered || sale.totalAmount).toFixed(2);
    document.getElementById('rcptChange').textContent = '<%= currencySymbol %> ' + parseFloat(sale.changeAmount || 0).toFixed(2);
  }

  // View Receipt from Records Table
  async function viewReceipt(saleId) {
    try {
      const res = await fetch(`/api/pos/sales/${saleId}`);
      const data = await res.json();
      if (!data.success) throw new Error(data.message);

      populateReceiptModal(data.data);
      const modal = new bootstrap.Modal(document.getElementById('receiptModal'));
      modal.show();
    } catch (e) {
      alert('Could not load receipt: ' + e.message);
    }
  }

  // Print Receipt directly from modal / print window
  function printReceiptFromModal() {
    const content = document.getElementById('receiptPrintableArea').innerHTML;
    const printWindow = window.open('', '_blank', 'width=450,height=600');
    if (!printWindow) {
      window.print();
      return;
    }

    printWindow.document.write(`
      <!DOCTYPE html>
      <html>
      <head>
        <title>Receipt · Nirmana Printing</title>
        <style>
          @page {
            size: 80mm auto;
            margin: 3mm;
          }
          body {
            font-family: 'Courier New', Courier, monospace;
            font-size: 12px;
            color: #000;
            background: #fff;
            margin: 0;
            padding: 5px;
          }
          .receipt-paper {
            border: none !important;
            padding: 0 !important;
          }
          @media print {
            body { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
          }
        </style>
      </head>
      <body>
        ${content}
        <script>
          window.onload = function() {
            setTimeout(function() {
              window.print();
              window.close();
            }, 250);
          };
        <\/script>
      </body>
      </html>
    `);
    printWindow.document.close();
  }

  // Void Sale
  async function confirmVoidSale(saleId, receiptNumber) {
    if (!confirm(`Are you sure you want to VOID sale #${receiptNumber}?\n\nAny deducted inventory will be automatically restored to stock.`)) {
      return;
    }

    try {
      const res = await fetch(`/api/pos/sales/${saleId}/void`, { method: 'POST' });
      const data = await res.json();
      if (!data.success) throw new Error(data.message);

      alert(data.message);
      window.location.href = '/pos?tab=records';
    } catch (e) {
      alert('Error voiding sale: ' + e.message);
    }
  }

  // Refresh Stats
  async function refreshDailyStats() {
    try {
      const res = await fetch('/api/pos/stats');
      const data = await res.json();
      if (!data.success) return;

      const s = data.data;
      document.getElementById('kpiTodayRevenue').textContent = '<%= currencySymbol %> ' + parseFloat(s.todayRevenue).toLocaleString('en-US', { minimumFractionDigits: 2 });
      document.getElementById('kpiTodayCount').textContent = s.todaySalesCount;
      document.getElementById('kpiCashRevenue').textContent = '<%= currencySymbol %> ' + parseFloat(s.cashRevenue).toLocaleString('en-US', { minimumFractionDigits: 2 });
      document.getElementById('kpiCardRevenue').textContent = '<%= currencySymbol %> ' + parseFloat((s.cardRevenue || 0) + (s.bankRevenue || 0)).toLocaleString('en-US', { minimumFractionDigits: 2 });
      document.getElementById('tabSalesCountBadge').textContent = s.todaySalesCount;
    } catch (e) {}
  }

  function escapeHtml(str) {
    if (!str) return '';
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }
</script>

<%- include('../partials/footer') %>
