<!-- Mobile-only top header bar -->
<header class="mobile-topbar d-lg-none">
  <button class="btn btn-serene-ghost mobile-menu-btn" id="sidebarToggle" type="button" aria-label="Open Navigation Menu">
    <i class="bi bi-list fs-4"></i>
  </button>
  <a href="<%= (currentUser && currentUser.role === 'CUSTOMER') ? '/portal' : '/dashboard' %>" class="mobile-topbar-brand">
    <img src="/images/logo.png" alt="Nirmana Printing" class="mobile-topbar-logo">
  </a>
  <% if (currentUser && currentUser.role === 'CUSTOMER') { %>
    <a href="/upload" class="btn btn-sm btn-serene-primary mobile-topbar-action" title="Upload Print Files">
      <i class="bi bi-cloud-arrow-up"></i>
    </a>
  <% } else { %>
    <a href="/orders/new" class="btn btn-sm btn-serene-primary mobile-topbar-action" title="Create New Order">
      <i class="bi bi-plus-lg"></i>
    </a>
  <% } %>
  <div class="d-flex align-items-center gap-1">
    <button type="button" class="theme-toggle-btn text-muted" onclick="toggleDarkMode()" title="Toggle Dark / Light Mode" aria-label="Toggle Dark / Light Mode">
      <i class="bi bi-moon-stars-fill fs-5"></i>
    </button>
    <% if (currentUser && currentUser.role === 'CUSTOMER') { %>
      <a href="/upload" class="btn btn-sm btn-serene-primary mobile-topbar-action" title="Upload Print Files">
        <i class="bi bi-cloud-arrow-up"></i>
      </a>
    <% } else { %>
      <a href="/orders/new" class="btn btn-sm btn-serene-primary mobile-topbar-action" title="Create New Order">
        <i class="bi bi-plus-lg"></i>
      </a>
    <% } %>
  </div>
</header>

<!-- Mobile drawer backdrop overlay -->
<div class="sidebar-backdrop" id="sidebarBackdrop" aria-hidden="true"></div>

<aside class="sidebar" id="appSidebar">
  <div class="sidebar-brand-wrapper d-flex align-items-center justify-content-between">
    <a href="<%= (currentUser && currentUser.role === 'CUSTOMER') ? '/portal' : '/dashboard' %>" class="sidebar-brand flex-grow-1" title="Nirmana Printing — When quality really matters">
      <img src="/images/logo.png" alt="Nirmana Printing — When quality really matters" class="sidebar-brand-img">
    </a>
    <button type="button" class="btn btn-sm btn-serene-ghost d-lg-none me-2" id="sidebarClose" aria-label="Close Navigation" style="width: 36px; height: 36px; display: flex; align-items: center; justify-content: center;">
      <i class="bi bi-x-lg fs-6"></i>
    </button>
  </div>

  <div class="sidebar-nav">
    <% if (currentUser && currentUser.role === 'CUSTOMER') { %>
      <div class="nav-section-title">Customer Dashboard</div>
      <a href="/portal" class="nav-item-link <%= activePage === 'portal' ? 'active' : '' %>">
        <i class="bi bi-speedometer2"></i>
        <span>My Dashboard</span>
      </a>

      <a href="/portal#ordersSection" class="nav-item-link">
        <i class="bi bi-receipt-cutoff"></i>
        <span>My Orders & Slips</span>
      </a>

      <a href="/products" class="nav-item-link <%= activePage === 'products' ? 'active' : '' %>">
        <i class="bi bi-tags"></i>
        <span>Products & Rates</span>
      </a>

      <a href="/upload" class="nav-item-link <%= activePage === 'guest-upload' ? 'active' : '' %>">
        <i class="bi bi-cloud-arrow-up"></i>
        <span>Upload Print Files</span>
      </a>
    <% } else { %>
      <!-- SECTION 1: CORE WORKSPACES -->
      <div class="nav-section-title">Core Workspaces</div>
      <a href="/dashboard" class="nav-item-link <%= activePage === 'dashboard' ? 'active' : '' %>" data-turbo="false">
        <i class="bi bi-grid-1x2 text-primary"></i>
        <span>Dashboard</span>
      </a>

      <a href="/quick-sell" class="nav-item-link <%= (typeof activePage !== 'undefined' && activePage === 'quick-sell') ? 'active' : '' %>" data-turbo="false">
        <i class="bi bi-lightning-charge-fill text-warning"></i>
        <span class="d-flex align-items-center justify-content-between flex-grow-1">
          <span class="fw-semibold">Quick Sell</span>
          <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-0" style="font-size: 0.65rem; font-weight: 700;">COUNTER</span>
        </span>
      </a>

      <!-- SECTION 2: PRINT PRODUCTION -->
      <div class="nav-section-divider"></div>
      <div class="nav-section-title">Print Production</div>
      <a href="/orders" class="nav-item-link <%= activePage === 'orders' ? 'active' : '' %>">
        <i class="bi bi-clipboard2-check text-info"></i>
        <span>Printing Orders</span>
      </a>

      <a href="/orders?type=frame" class="nav-item-link <%= (typeof activePage !== 'undefined' && activePage === 'frames') ? 'active' : '' %>">
        <i class="bi bi-aspect-ratio text-warning"></i>
        <span>Photo Frames Studio</span>
      </a>

      <a href="/quick-print" class="nav-item-link <%= activePage === 'quick-print' ? 'active' : '' %>">
        <i class="bi bi-qr-code-scan text-success"></i>
        <span class="d-flex align-items-center justify-content-between flex-grow-1">
          <span>Quick Print (QR)</span>
          <span class="badge bg-danger rounded-pill px-1 py-0 small" id="sidebarQuickBadge" style="display: none; font-size: 0.65rem;">NEW</span>
        </span>
      </a>

      <!-- SECTION 3: SALES & INVENTORY -->
      <div class="nav-section-divider"></div>
      <div class="nav-section-title">Sales & Inventory</div>
      <a href="/pos" class="nav-item-link <%= activePage === 'pos' ? 'active' : '' %>">
        <i class="bi bi-cart3 text-success"></i>
        <span>Point of Sale (POS)</span>
      </a>

      <a href="/stock" class="nav-item-link <%= activePage === 'stock' ? 'active' : '' %>">
        <i class="bi bi-box-seam text-secondary"></i>
        <span>Stock Management</span>
      </a>

      <a href="/products" class="nav-item-link <%= activePage === 'products' ? 'active' : '' %>">
        <i class="bi bi-tags text-info"></i>
        <span>Products & Catalog</span>
      </a>

      <a href="/customers" class="nav-item-link <%= activePage === 'customers' ? 'active' : '' %>">
        <i class="bi bi-people text-danger"></i>
        <span>Customers & Accounts</span>
      </a>

      <!-- SECTION 4: SYSTEM SETTINGS -->
      <% if (currentUser && (currentUser.role === 'ADMIN' || currentUser.role === 'OWNER')) { %>
        <div class="nav-section-divider"></div>
        <div class="nav-section-title">System Administration</div>
        <a href="/users" class="nav-item-link <%= activePage === 'users' ? 'active' : '' %>">
          <i class="bi bi-shield-lock text-primary"></i>
          <span>User Administration</span>
        </a>
      <% } %>
    <% } %>
  </div>

  <div class="sidebar-footer">
    <div class="d-flex align-items-center justify-content-between w-100">
      <div class="d-flex align-items-center gap-2 text-truncate">
        <div class="user-avatar">
          <i class="bi bi-person-fill"></i>
        </div>
        <div class="flex-grow-1 text-truncate">
          <div class="small fw-semibold text-truncate"><%= currentUser ? (currentUser.fullName || currentUser.username) : 'Nirmana Staff' %></div>
          <div class="text-muted" style="font-size: 0.72rem;"><%= currentUser ? (currentUser.role === 'ADMIN' || currentUser.role === 'OWNER' ? 'Owner / Admin' : (currentUser.role === 'CUSTOMER' ? 'Regular Customer' : 'Store Worker')) : 'Operations Desk' %></div>
        </div>
      </div>
      <div class="d-flex align-items-center gap-1 ms-1">
        <button type="button" class="theme-toggle-btn text-muted p-1" onclick="toggleDarkMode()" title="Toggle Dark / Light Mode" aria-label="Toggle Dark / Light Mode">
          <i class="bi bi-moon-stars-fill fs-6"></i>
        </button>
        <a href="/logout" class="btn btn-sm btn-serene-ghost text-muted p-1" title="Sign Out" style="width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; border-radius: 6px;">
          <i class="bi bi-box-arrow-right fs-6"></i>
        </a>
      </div>
    </div>
  </div>
</aside>
