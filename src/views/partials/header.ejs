<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Nirmana Printing Management System' %></title>

  <!-- Preconnect & DNS-Prefetch for Fast CDN Asset Loading -->
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
  <link rel="dns-prefetch" href="https://cdn.jsdelivr.net">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

  <!-- Bootstrap 5.3 & Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

  <!-- Serene Workshop Studio Design System -->
  <link rel="stylesheet" href="/css/serene-theme.css?v=<%= Date.now() %>">

  <!-- Favicons: Crisp Modern SVG with PNG Fallback -->
  <link rel="icon" type="image/svg+xml" href="/images/favicon.svg">
  <link rel="alternate icon" type="image/png" href="/images/favicon.png">
  <!-- Hotwire Turbo Drive (Seamless Fast SPA Navigation) -->
  <meta name="turbo-cache-control" content="no-preview">
  <script defer src="/js/turbo.min.js"></script>

  <!-- Immediate Theme Engine: Prevents flash of white/dark theme -->
  <script>
    (function() {
      try {
        var saved = localStorage.getItem('nirmana_theme') || (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.setAttribute('data-bs-theme', saved);
        document.documentElement.setAttribute('data-theme', saved);
      } catch(e) {}
    })();
  </script>

  <!-- Inlined Guaranteed Dark Mode Contrast Protections -->
  <style>
    /* Immediate Dark Mode Table & Card Protection (Bypasses external cache) */
    html[data-bs-theme="dark"] .serene-card,
    html[data-theme="dark"] .serene-card,
    [data-bs-theme="dark"] .serene-card {
      background-color: #131c31 !important;
      border-color: #243049 !important;
    }

    html[data-bs-theme="dark"] .serene-table,
    html[data-theme="dark"] .serene-table,
    [data-bs-theme="dark"] .serene-table,
    html[data-bs-theme="dark"] .table,
    html[data-theme="dark"] .table,
    [data-bs-theme="dark"] .table {
      background-color: #131c31 !important;
      color: #f8fafc !important;
      border-color: #243049 !important;
    }

    html[data-bs-theme="dark"] .serene-table th,
    html[data-theme="dark"] .serene-table th,
    [data-bs-theme="dark"] .serene-table th,
    html[data-bs-theme="dark"] .table thead th,
    html[data-theme="dark"] .table thead th,
    [data-bs-theme="dark"] .table thead th,
    html[data-bs-theme="dark"] .table-light,
    html[data-theme="dark"] .table-light,
    [data-bs-theme="dark"] .table-light,
    html[data-bs-theme="dark"] .table-light th,
    html[data-theme="dark"] .table-light td {
      background-color: #162036 !important;
      color: #94a3b8 !important;
      border-color: #243049 !important;
    }

    html[data-bs-theme="dark"] .serene-table tr,
    html[data-theme="dark"] .serene-table tr,
    [data-bs-theme="dark"] .serene-table tr,
    html[data-bs-theme="dark"] .serene-table td,
    html[data-theme="dark"] .serene-table td,
    [data-bs-theme="dark"] .serene-table td,
    html[data-bs-theme="dark"] .table tr,
    html[data-theme="dark"] .table tr,
    [data-bs-theme="dark"] .table tr,
    html[data-bs-theme="dark"] .table td,
    html[data-theme="dark"] .table td,
    [data-bs-theme="dark"] .table td {
      background-color: #131c31 !important;
      color: #f8fafc !important;
      border-color: #1a253c !important;
    }

    html[data-bs-theme="dark"] .serene-table tbody tr:hover td,
    html[data-theme="dark"] .serene-table tbody tr:hover td,
    [data-bs-theme="dark"] .serene-table tbody tr:hover td,
    html[data-bs-theme="dark"] .table-hover tbody tr:hover td,
    html[data-theme="dark"] .table-hover tbody tr:hover td,
    [data-bs-theme="dark"] .table-hover tbody tr:hover td {
      background-color: #1e293b !important;
      color: #ffffff !important;
    }

    html[data-bs-theme="dark"] .serene-table td a,
    html[data-theme="dark"] .serene-table td a,
    html[data-bs-theme="dark"] .serene-table td div,
    html[data-theme="dark"] .serene-table td div,
    html[data-bs-theme="dark"] .serene-table td .text-dark,
    html[data-theme="dark"] .serene-table td .text-dark,
    html[data-bs-theme="dark"] .table td a,
    html[data-theme="dark"] .table td a,
    html[data-bs-theme="dark"] .table td div,
    html[data-theme="dark"] .table td div,
    html[data-bs-theme="dark"] .table td .text-dark,
    html[data-theme="dark"] .table td .text-dark {
      color: #f8fafc !important;
    }

    html[data-bs-theme="dark"] .serene-table td .text-muted,
    html[data-theme="dark"] .serene-table td .text-muted,
    html[data-bs-theme="dark"] .table td .text-muted,
    html[data-theme="dark"] .table td .text-muted,
    html[data-bs-theme="dark"] #noOrdersRow td,
    html[data-theme="dark"] #noOrdersRow td {
      color: #94a3b8 !important;
      background-color: #131c31 !important;
    }
  </style>
</head>
<body>
<div class="app-container">
