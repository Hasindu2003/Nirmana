<!-- Bootstrap Bundle & Scripts -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/app.js"></script>
<script>
// Populate Stock Dropdowns for modals (Lazy-loaded or pre-loaded)
let globalStockItems = null;

async function loadStockDropdowns(preselectInId = null, preselectOutId = null, preselectOfficeId = null) {
  const inSelect = document.getElementById('stockInSelect');
  const outSelect = document.getElementById('stockOutSelect');
  const officeSelect = document.getElementById('officeUseSelect');
  if (!inSelect && !outSelect && !officeSelect) return [];

  // Use preloaded items if available on the page
  if (!globalStockItems && window._preloadedStockItems && Array.isArray(window._preloadedStockItems) && window._preloadedStockItems.length > 0) {
    globalStockItems = window._preloadedStockItems;
  }

  if (globalStockItems && globalStockItems.length > 0) {
    populateStockDropdowns(globalStockItems, preselectInId, preselectOutId, preselectOfficeId);
    return globalStockItems;
  }

  try {
    const res = await fetch('/api/stock');
    const data = await res.json();
    if (data.success && Array.isArray(data.data)) {
      globalStockItems = data.data;
      populateStockDropdowns(globalStockItems, preselectInId, preselectOutId, preselectOfficeId);
      return globalStockItems;
    }
  } catch (err) {
    console.error('Error loading stock options:', err);
  }
  return [];
}

function populateStockDropdowns(items, preselectInId = null, preselectOutId = null, preselectOfficeId = null) {
  const inSelect = document.getElementById('stockInSelect');
  const outSelect = document.getElementById('stockOutSelect');
  const officeSelect = document.getElementById('officeUseSelect');
  if (!inSelect && !outSelect && !officeSelect) return;

  const targetInVal = (preselectInId !== null && preselectInId !== undefined && String(preselectInId) !== '')
    ? String(preselectInId)
    : (inSelect && inSelect.dataset.pendingSelectedId ? inSelect.dataset.pendingSelectedId : (inSelect ? inSelect.value : ''));

  const targetOutVal = (preselectOutId !== null && preselectOutId !== undefined && String(preselectOutId) !== '')
    ? String(preselectOutId)
    : (outSelect && outSelect.dataset.pendingSelectedId ? outSelect.dataset.pendingSelectedId : (outSelect ? outSelect.value : ''));

  const targetOfficeVal = (preselectOfficeId !== null && preselectOfficeId !== undefined && String(preselectOfficeId) !== '')
    ? String(preselectOfficeId)
    : (officeSelect && officeSelect.dataset.pendingSelectedId ? officeSelect.dataset.pendingSelectedId : (officeSelect ? officeSelect.value : ''));

  if (items.length === 0) {
    if (inSelect) inSelect.innerHTML = '<option value="">-- No materials registered yet --</option>';
    if (outSelect) outSelect.innerHTML = '<option value="">-- No materials in stock yet --</option>';
    if (officeSelect) officeSelect.innerHTML = '<option value="">-- No materials in stock yet --</option>';
  } else {
    if (inSelect) {
      inSelect.innerHTML = '<option value="">-- Choose Stock Item --</option>' +
        items.map(i => `<option value="${i.id}" data-name="${encodeURIComponent(i.name)}" data-code="${i.code || ''}" data-category="${i.category || ''}" data-current="${i.currentStock}" data-unitcost="${i.unitCost || 0}" data-sellingprice="${i.sellingPrice || ''}" data-unit="${i.unit}">${i.name} (${i.currentStock} ${i.unit} in stock)</option>`).join('');

      if (targetInVal) {
        inSelect.value = String(targetInVal);
        delete inSelect.dataset.pendingSelectedId;
        onStockInItemChange(inSelect);
      }
    }
    if (outSelect) {
      outSelect.innerHTML = '<option value="">-- Choose Stock Item --</option>' +
        items.map(i => `<option value="${i.id}" data-current="${i.currentStock}" data-unit="${i.unit}">${i.name} (${i.currentStock} ${i.unit} available)</option>`).join('');

      if (targetOutVal) {
        outSelect.value = String(targetOutVal);
        delete outSelect.dataset.pendingSelectedId;
        if (typeof showCurrentAvailableStock === 'function') {
          showCurrentAvailableStock(outSelect);
        }
      }
    }
    if (officeSelect) {
      officeSelect.innerHTML = '<option value="">-- Choose Stock Item --</option>' +
        items.map(i => `<option value="${i.id}" data-name="${encodeURIComponent(i.name)}" data-code="${i.code || ''}" data-category="${i.category || ''}" data-current="${i.currentStock}" data-unitcost="${i.unitCost || 0}" data-unit="${i.unit}">${i.name} (${i.currentStock} ${i.unit} in stock · Buying: Rs. ${parseFloat(i.unitCost || 0).toFixed(2)})</option>`).join('');

      if (targetOfficeVal) {
        officeSelect.value = String(targetOfficeVal);
        delete officeSelect.dataset.pendingSelectedId;
        onOfficeUseItemChange(officeSelect);
      }
    }
  }
}

// Global quickStockIn function available on all pages
window.quickStockIn = async function(itemId, suggestedQty = null, itemName = null) {
  const modalEl = document.getElementById('stockInModal');
  if (!modalEl) return;

  const inSelect = document.getElementById('stockInSelect');
  const headerBanner = document.getElementById('stockInItemHeader');
  const headerName = document.getElementById('stockInItemHeaderName');
  const headerMeta = document.getElementById('stockInItemHeaderMeta');
  const headerStock = document.getElementById('stockInItemHeaderStock');

  if (inSelect && itemId) {
    inSelect.dataset.pendingSelectedId = String(itemId);
  }

  // If item name/info is already known from table, immediately render header banner!
  if (headerBanner && itemId) {
    const knownItem = (window._preloadedStockItems || []).find(i => String(i.id) === String(itemId));
    const displayName = itemName || (knownItem ? knownItem.name : null);
    if (displayName) {
      headerName.textContent = displayName;
      headerMeta.textContent = (knownItem && knownItem.code ? knownItem.code + ' · ' : '') + ((knownItem && knownItem.category) || 'Raw Material');
      headerStock.textContent = knownItem ? `${knownItem.currentStock} ${knownItem.unit}` : 'Low Stock';
      headerBanner.style.display = 'block';
    }
  }

  // Pre-load stock items and set selection
  await loadStockDropdowns(itemId, null, null);

  if (inSelect && itemId) {
    inSelect.value = String(itemId);
    delete inSelect.dataset.pendingSelectedId;
    onStockInItemChange(inSelect);
  }

  if (suggestedQty) {
    const qtyInput = document.getElementById('stockInQuantity');
    if (qtyInput) {
      qtyInput.value = suggestedQty;
      calculateStockInProfit('qty');
    }
  }

  const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
  modal.show();

  setTimeout(() => {
    const qtyInput = document.getElementById('stockInQuantity');
    if (qtyInput) {
      qtyInput.focus();
      if (qtyInput.value) qtyInput.select();
    }
  }, 350);
};

// Global quickStockOut function available on all pages
window.quickStockOut = async function(itemId) {
  const modalEl = document.getElementById('stockOutModal');
  if (!modalEl) return;

  const outSelect = document.getElementById('stockOutSelect');
  if (outSelect && itemId) {
    outSelect.dataset.pendingSelectedId = String(itemId);
  }

  await loadStockDropdowns(null, itemId, null);

  if (outSelect && itemId) {
    outSelect.value = String(itemId);
    delete outSelect.dataset.pendingSelectedId;
    if (typeof showCurrentAvailableStock === 'function') {
      showCurrentAvailableStock(outSelect);
    }
  }

  const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
  modal.show();

  setTimeout(() => {
    const qtyInput = modalEl.querySelector('input[name="quantity"]');
    if (qtyInput) {
      qtyInput.focus();
      if (qtyInput.value) qtyInput.select();
    }
  }, 350);
};

// Global quickOfficeUse function available on all pages
window.quickOfficeUse = async function(itemId, suggestedQty = null, itemName = null) {
  const modalEl = document.getElementById('officeUseModal');
  if (!modalEl) return;

  const officeSelect = document.getElementById('officeUseSelect');
  const headerBanner = document.getElementById('officeUseItemHeader');
  const headerName = document.getElementById('officeUseItemHeaderName');
  const headerMeta = document.getElementById('officeUseItemHeaderMeta');
  const headerStock = document.getElementById('officeUseItemHeaderStock');

  if (officeSelect && itemId) {
    officeSelect.dataset.pendingSelectedId = String(itemId);
  }

  if (headerBanner && itemId) {
    const knownItem = (window._preloadedStockItems || []).find(i => String(i.id) === String(itemId));
    const displayName = itemName || (knownItem ? knownItem.name : null);
    if (displayName) {
      headerName.textContent = displayName;
      headerMeta.textContent = (knownItem && knownItem.code ? knownItem.code + ' · ' : '') + ((knownItem && knownItem.category) || 'Office Consumable');
      headerStock.textContent = knownItem ? `${knownItem.currentStock} ${knownItem.unit}` : '-';
      headerBanner.style.display = 'block';
    }
  }

  await loadStockDropdowns(null, null, itemId);

  if (officeSelect && itemId) {
    officeSelect.value = String(itemId);
    delete officeSelect.dataset.pendingSelectedId;
    onOfficeUseItemChange(officeSelect);
  }

  if (suggestedQty) {
    const qtyInput = document.getElementById('officeUseQuantity');
    if (qtyInput) {
      qtyInput.value = suggestedQty;
      calculateOfficeUseExpense();
    }
  }

  const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
  modal.show();

  setTimeout(() => {
    const qtyInput = document.getElementById('officeUseQuantity');
    if (qtyInput) {
      qtyInput.focus();
      if (qtyInput.value) qtyInput.select();
    }
  }, 350);
};

// Lazy load when user opens Stock modals from toolbar without preselection
document.addEventListener('show.bs.modal', function (e) {
  if (e.target && (e.target.id === 'stockInModal' || e.target.id === 'stockOutModal' || e.target.id === 'officeUseModal')) {
    const inSelect = document.getElementById('stockInSelect');
    const outSelect = document.getElementById('stockOutSelect');
    const officeSelect = document.getElementById('officeUseSelect');
    const pendingIn = inSelect ? inSelect.dataset.pendingSelectedId : null;
    const pendingOut = outSelect ? outSelect.dataset.pendingSelectedId : null;
    const pendingOffice = officeSelect ? officeSelect.dataset.pendingSelectedId : null;
    loadStockDropdowns(pendingIn, pendingOut, pendingOffice);
  }
});

function onStockInItemChange(selectEl) {
  const opt = selectEl.options[selectEl.selectedIndex];
  const headerBanner = document.getElementById('stockInItemHeader');
  const headerName = document.getElementById('stockInItemHeaderName');
  const headerMeta = document.getElementById('stockInItemHeaderMeta');
  const headerStock = document.getElementById('stockInItemHeaderStock');

  if (opt && opt.value) {
    const rawName = opt.dataset.name ? decodeURIComponent(opt.dataset.name) : opt.text.split('(')[0].trim();
    if (headerBanner) {
      headerName.textContent = rawName;
      headerMeta.textContent = (opt.dataset.code ? opt.dataset.code + ' · ' : '') + (opt.dataset.category || 'Printing Substrate');
      headerStock.textContent = `${opt.dataset.current || '0'} ${opt.dataset.unit || 'Units'}`;
      headerBanner.style.display = 'block';
    }

    const cost = parseFloat(opt.dataset.unitcost) || 0;
    const sell = opt.dataset.sellingprice ? parseFloat(opt.dataset.sellingprice) : '';
    document.getElementById('stockInUnitCost').value = cost > 0 ? cost : '';
    document.getElementById('stockInSellingPrice').value = sell !== '' ? sell : '';
    calculateStockInProfit('item');
  } else {
    if (headerBanner) headerBanner.style.display = 'none';
  }
}

function onOfficeUseItemChange(selectEl) {
  const opt = selectEl.options[selectEl.selectedIndex];
  const headerBanner = document.getElementById('officeUseItemHeader');
  const headerName = document.getElementById('officeUseItemHeaderName');
  const headerMeta = document.getElementById('officeUseItemHeaderMeta');
  const headerStock = document.getElementById('officeUseItemHeaderStock');
  const hint = document.getElementById('officeUseAvailableHint');

  if (opt && opt.value) {
    const rawName = opt.dataset.name ? decodeURIComponent(opt.dataset.name) : opt.text.split('(')[0].trim();
    const cur = parseFloat(opt.dataset.current) || 0;
    const unit = opt.dataset.unit || 'Units';
    const cost = parseFloat(opt.dataset.unitcost) || 0;

    if (headerBanner) {
      headerName.textContent = rawName;
      headerMeta.textContent = (opt.dataset.code ? opt.dataset.code + ' · ' : '') + (opt.dataset.category || 'Office Material');
      headerStock.textContent = `${cur} ${unit}`;
      headerBanner.style.display = 'block';
    }

    if (hint) {
      hint.innerHTML = `<span class="fw-semibold text-dark">Remaining Stock: ${cur} ${unit}</span> &bull; <span class="text-muted">Buying Price: Rs. ${cost.toFixed(2)} / ${unit}</span>`;
    }

    calculateOfficeUseExpense();
  } else {
    if (headerBanner) headerBanner.style.display = 'none';
    if (hint) hint.innerHTML = '';
    calculateOfficeUseExpense();
  }
}

function calculateOfficeUseExpense() {
  const officeSelect = document.getElementById('officeUseSelect');
  const qtyInput = document.getElementById('officeUseQuantity');
  const unitCostLabel = document.getElementById('officeUseUnitCostLabel');
  const totalExpenseLabel = document.getElementById('officeUseTotalExpenseLabel');
  const balanceLabel = document.getElementById('officeUseRemainingBalanceLabel');

  if (!officeSelect || !qtyInput) return;

  const opt = officeSelect.options[officeSelect.selectedIndex];
  const qty = parseFloat(qtyInput.value) || 0;

  if (opt && opt.value) {
    const unitCost = parseFloat(opt.dataset.unitcost) || 0;
    const curStock = parseFloat(opt.dataset.current) || 0;
    const unit = opt.dataset.unit || 'Units';

    const totalExpense = qty * unitCost;
    const remBalance = curStock - qty;

    if (unitCostLabel) unitCostLabel.textContent = `Rs. ${unitCost.toFixed(2)}`;
    if (totalExpenseLabel) totalExpenseLabel.textContent = `Rs. ${totalExpense.toFixed(2)}`;

    if (balanceLabel) {
      if (remBalance < 0) {
        balanceLabel.innerHTML = `<span class="text-danger fw-bold">${remBalance.toFixed(1)} ${unit} (Exceeds stock!)</span>`;
      } else {
        balanceLabel.innerHTML = `<span class="text-primary fw-bold">${remBalance.toFixed(1)} ${unit}</span>`;
      }
    }
  } else {
    if (unitCostLabel) unitCostLabel.textContent = 'Rs. 0.00';
    if (totalExpenseLabel) totalExpenseLabel.textContent = 'Rs. 0.00';
    if (balanceLabel) balanceLabel.textContent = '-';
  }
}

async function handleOfficeUseSubmit(e) {
  e.preventDefault();
  const form = e.target;
  const formData = new FormData(form);
  const payload = Object.fromEntries(formData.entries());

  try {
    const res = await fetch('/api/stock/office-use', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });
    const result = await res.json();
    if (result.success) {
      setPendingToast(result.message, 'success');
      window.location.reload();
    } else {
      toast.error(result.message);
    }
  } catch (err) {
    toast.error('Failed to record office use: ' + err.message);
  }
}

function calculateStockInProfit(trigger) {
  const qty = parseFloat(document.getElementById('stockInQuantity').value) || 0;
  const unitCostInput = document.getElementById('stockInUnitCost');
  const batchCostInput = document.getElementById('stockInBatchCost');
  const sellPriceInput = document.getElementById('stockInSellingPrice');

  let unitCost = parseFloat(unitCostInput.value) || 0;
  let batchCost = parseFloat(batchCostInput.value) || 0;
  const sellPrice = parseFloat(sellPriceInput.value) || 0;

  if (trigger === 'unit' && qty > 0) {
    batchCost = parseFloat((unitCost * qty).toFixed(2));
    batchCostInput.value = batchCost > 0 ? batchCost : '';
  } else if (trigger === 'batch' && qty > 0) {
    unitCost = parseFloat((batchCost / qty).toFixed(2));
    unitCostInput.value = unitCost > 0 ? unitCost : '';
  } else if (trigger === 'qty' && qty > 0) {
    if (unitCost > 0) {
      batchCost = parseFloat((unitCost * qty).toFixed(2));
      batchCostInput.value = batchCost > 0 ? batchCost : '';
    } else if (batchCost > 0) {
      unitCost = parseFloat((batchCost / qty).toFixed(2));
      unitCostInput.value = unitCost > 0 ? unitCost : '';
    }
  } else if (trigger === 'item' && qty > 0 && unitCost > 0) {
    batchCost = parseFloat((unitCost * qty).toFixed(2));
    batchCostInput.value = batchCost > 0 ? batchCost : '';
  }

  const profitBox = document.getElementById('stockInProfitBox');
  const profitHint = document.getElementById('stockInProfitHint');

  if (sellPrice > 0 && (unitCost > 0 || batchCost > 0)) {
    const unitProfit = sellPrice - unitCost;
    const totalProfit = unitProfit * (qty > 0 ? qty : 1);
    const margin = ((unitProfit / sellPrice) * 100);
    const isProfit = unitProfit >= 0;

    profitBox.style.display = 'block';
    profitHint.style.display = 'none';

    const unitEl = document.getElementById('stockInUnitProfit');
    const batchEl = document.getElementById('stockInBatchProfit');
    const marginEl = document.getElementById('stockInMarginBadge');

    unitEl.innerText = `${isProfit ? '+' : ''}${formatCurrency(unitProfit)}`;
    unitEl.className = `fw-bold tabular-nums ${isProfit ? 'text-success' : 'text-danger'}`;

    batchEl.innerText = `${isProfit ? '+' : ''}${formatCurrency(totalProfit)}`;
    batchEl.className = `fw-bold tabular-nums ${isProfit ? 'text-success' : 'text-danger'}`;

    marginEl.innerText = `${margin.toFixed(1)}% margin`;
    marginEl.className = `badge ${isProfit ? 'bg-success-subtle text-success' : 'bg-danger-subtle text-danger'}`;
  } else {
    profitBox.style.display = 'none';
    profitHint.style.display = 'block';
  }
}

function showCurrentAvailableStock(selectEl) {
  const opt = selectEl.options[selectEl.selectedIndex];
  const hint = document.getElementById('stockAvailableHint');
  if (opt.value && opt.dataset.current !== undefined) {
    hint.innerHTML = `<span class="fw-semibold text-dark">Current Available: ${opt.dataset.current} ${opt.dataset.unit}</span>`;
  } else {
    hint.innerHTML = '';
  }
}

