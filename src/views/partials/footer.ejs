</div><!-- /.app-container -->

<!-- Modal: Record Stock In (Arrival) -->
<div class="modal fade" id="stockInModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content" style="border-radius: var(--serene-radius-lg); border: 1px solid var(--serene-border);">
      <div class="modal-header border-bottom" style="background:#fafbfc;">
        <h5 class="modal-title fs-6 fw-semibold"><i class="bi bi-box-arrow-in-down text-success me-2"></i> Record Stock Arrival (Stock In)</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form id="stockInForm" onsubmit="handleStockInSubmit(event)">
        <div class="modal-body p-4">
          <div class="mb-3">
            <label class="form-label">Stock Item *</label>
            <select name="stockItemId" id="stockInSelect" class="form-select" onchange="onStockInItemChange(this)" required>
              <option value="">-- Choose Stock Item --</option>
            </select>
          </div>
          <div class="row g-2 mb-3">
            <div class="col-6">
              <label class="form-label">Quantity Arrived *</label>
              <input type="number" name="quantity" id="stockInQuantity" class="form-control" placeholder="0" min="1" step="any" oninput="calculateStockInProfit('qty')" required>
            </div>
            <div class="col-6">
              <label class="form-label">Arrival Date</label>
              <input type="date" name="date" class="form-control" value="<%= new Date().toISOString().split('T')[0] %>">
            </div>
          </div>

          <!-- Pricing & Estimated Profit Section -->
          <div class="p-3 mb-3 rounded-2" style="background:#fafbfc; border: 1px solid var(--serene-border-subtle);">
            <div class="d-flex align-items-center justify-content-between mb-2">
              <label class="form-label fw-semibold mb-0 text-dark small"><i class="bi bi-tag me-1"></i> Cost & Estimated Profit</label>
              <span class="badge bg-light text-muted border" style="font-size: 0.7rem;">Auto-Calculated</span>
            </div>

            <div class="row g-2 mb-2">
              <div class="col-6">
                <label class="form-label small text-muted">Buying Price / Unit (<%= currencySymbol %>)</label>
                <input type="number" name="unitCost" id="stockInUnitCost" class="form-control form-control-sm" placeholder="0.00" step="any" min="0" oninput="calculateStockInProfit('unit')">
              </div>
              <div class="col-6">
                <label class="form-label small text-muted">Total Batch Price (<%= currencySymbol %>)</label>
                <input type="number" name="batchCost" id="stockInBatchCost" class="form-control form-control-sm" placeholder="0.00" step="any" min="0" oninput="calculateStockInProfit('batch')">
              </div>
            </div>

            <div class="mb-2">
              <div class="d-flex justify-content-between align-items-center">
                <label class="form-label small text-muted mb-1">Selling Price / Unit (<%= currencySymbol %>)</label>
                <span class="text-muted" style="font-size: 0.72rem;">Optional</span>
              </div>
              <input type="number" name="sellingPrice" id="stockInSellingPrice" class="form-control form-control-sm" placeholder="0.00" step="any" min="0" oninput="calculateStockInProfit('sell')">
            </div>

            <!-- Live Estimated Profit Box -->
            <div id="stockInProfitBox" class="p-2 rounded-2 mt-2" style="background: #ffffff; border: 1px dashed var(--serene-border); display: none;">
              <div class="d-flex justify-content-between align-items-center small mb-1">
                <span class="text-muted">Est. Profit / Unit:</span>
                <span class="fw-bold tabular-nums" id="stockInUnitProfit">Rs. 0.00</span>
              </div>
              <div class="d-flex justify-content-between align-items-center small mb-1">
                <span class="text-muted">Total Batch Profit:</span>
                <span class="fw-bold tabular-nums" id="stockInBatchProfit">Rs. 0.00</span>
              </div>
              <div class="d-flex justify-content-between align-items-center small">
                <span class="text-muted">Profit Margin:</span>
                <span class="badge" id="stockInMarginBadge">0.0%</span>
              </div>
            </div>
            <div id="stockInProfitHint" class="text-muted small mt-1" style="font-size: 0.75rem;">
              Enter selling price per unit to calculate estimated profit and margin.
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label">Supplier / Invoice Ref</label>
            <input type="text" name="reference" class="form-control" placeholder="e.g. Inv #8492 / PO #102">
          </div>
          <div class="mb-2">
            <label class="form-label">Notes (Optional)</label>
            <input type="text" name="notes" class="form-control" placeholder="e.g. New delivery batch from supplier">
          </div>
        </div>
        <div class="modal-footer border-top bg-light">
          <button type="button" class="btn btn-serene-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-serene-primary">Add to Stock</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Modal: Record Stock Out (Usage) -->
<div class="modal fade" id="stockOutModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content" style="border-radius: var(--serene-radius-lg); border: 1px solid var(--serene-border);">
      <div class="modal-header border-bottom" style="background:#fafbfc;">
        <h5 class="modal-title fs-6 fw-semibold"><i class="bi bi-box-arrow-up text-danger me-2"></i> Record Stock Usage (Stock Out)</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form id="stockOutForm" onsubmit="handleStockOutSubmit(event)">
        <div class="modal-body p-4">
          <div class="mb-3">
            <label class="form-label">Stock Item to Deduct *</label>
            <select name="stockItemId" id="stockOutSelect" class="form-select" onchange="showCurrentAvailableStock(this)" required>
              <option value="">-- Choose Stock Item --</option>
            </select>
            <div id="stockAvailableHint" class="form-text small text-muted"></div>
          </div>
          <div class="row g-2 mb-3">
            <div class="col-6">
              <label class="form-label">Quantity Used *</label>
              <input type="number" name="quantity" class="form-control" placeholder="0" min="1" step="any" required>
            </div>
            <div class="col-6">
              <label class="form-label">Usage Date</label>
              <input type="date" name="date" class="form-control" value="<%= new Date().toISOString().split('T')[0] %>">
            </div>
          </div>
          <div class="mb-3">
            <label class="form-label">Job / Order Reference</label>
            <input type="text" name="reference" class="form-control" placeholder="e.g. For Order #ORD-2024-0001">
          </div>
          <div class="mb-2">
            <label class="form-label">Reason / Production Notes</label>
            <input type="text" name="notes" class="form-control" placeholder="e.g. Used for 1000 business card printing">
          </div>
        </div>
        <div class="modal-footer border-top bg-light">
          <button type="button" class="btn btn-serene-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-danger">Deduct from Stock</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Serene Dynamic Dialog Modal (Prompt & Confirm) -->
<div class="modal fade" id="sereneDialogModal" tabindex="-1" aria-hidden="true" style="z-index: 10600;">
  <div class="modal-dialog modal-dialog-centered" style="max-width: 440px;">
    <div class="modal-content" style="border-radius: var(--serene-radius-lg); border: 1px solid var(--serene-border); box-shadow: var(--serene-shadow-popover);">
      <div class="modal-header border-bottom py-3 px-4" style="background:#fafbfc;">
        <h5 class="modal-title fs-6 fw-semibold" id="sereneDialogTitle">Confirm Action</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-4">
        <div id="sereneDialogMessage" class="text-secondary small mb-3"></div>
        <div id="sereneDialogInputContainer" style="display: none;">
          <label id="sereneDialogInputLabel" class="form-label small fw-medium mb-1 text-dark"></label>
          <input type="text" id="sereneDialogInput" class="form-control" autocomplete="off">
          <div id="sereneDialogInputError" class="invalid-feedback small"></div>
        </div>
      </div>
      <div class="modal-footer border-top bg-light py-2 px-4 d-flex justify-content-end gap-2">
        <button type="button" class="btn btn-serene-secondary btn-sm" id="sereneDialogCancelBtn" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-serene-primary btn-sm" id="sereneDialogConfirmBtn">Confirm</button>
      </div>
    </div>
  </div>
</div>

<!-- Global Serene Toast Container -->
<div id="sereneToastContainer" class="serene-toast-container" aria-live="polite"></div>

<!-- Bootstrap Bundle & Scripts -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/app.js"></script>
<script>
// Populate Stock Dropdowns for modals (Lazy-loaded on modal show)
let globalStockItems = null;

async function loadStockDropdowns() {
  const inSelect = document.getElementById('stockInSelect');
  const outSelect = document.getElementById('stockOutSelect');
  if (!inSelect && !outSelect) return;

  if (globalStockItems && globalStockItems.length > 0) {
    populateStockDropdowns(globalStockItems);
    return;
  }

  try {
    const res = await fetch('/api/stock');
    const data = await res.json();
    if (data.success) {
      globalStockItems = data.data;
      populateStockDropdowns(globalStockItems);
    }
  } catch (err) {
    console.error('Error loading stock options:', err);
  }
}

function populateStockDropdowns(items) {
  const inSelect = document.getElementById('stockInSelect');
  const outSelect = document.getElementById('stockOutSelect');
  if (!inSelect && !outSelect) return;

  if (items.length === 0) {
    if (inSelect) inSelect.innerHTML = '<option value="">-- No materials in stock yet. Add item first --</option>';
    if (outSelect) outSelect.innerHTML = '<option value="">-- No materials in stock yet. Add item first --</option>';
  } else {
    if (inSelect) {
      inSelect.innerHTML = '<option value="">-- Choose Stock Item --</option>' +
        items.map(i => `<option value="${i.id}" data-unitcost="${i.unitCost || 0}" data-sellingprice="${i.sellingPrice || ''}" data-unit="${i.unit}">${i.name} (${i.currentStock} ${i.unit} in stock)</option>`).join('');
    }
    if (outSelect) {
      outSelect.innerHTML = '<option value="">-- Choose Stock Item --</option>' +
        items.map(i => `<option value="${i.id}" data-current="${i.currentStock}" data-unit="${i.unit}">${i.name} (${i.currentStock} ${i.unit} available)</option>`).join('');
    }
  }
}

// Lazy load when user opens Stock In or Stock Out modal
document.addEventListener('show.bs.modal', function (e) {
  if (e.target && (e.target.id === 'stockInModal' || e.target.id === 'stockOutModal')) {
    loadStockDropdowns();
  }
});

function onStockInItemChange(selectEl) {
  const opt = selectEl.options[selectEl.selectedIndex];
  if (opt && opt.value) {
    const cost = parseFloat(opt.dataset.unitcost) || 0;
    const sell = opt.dataset.sellingprice ? parseFloat(opt.dataset.sellingprice) : '';
    document.getElementById('stockInUnitCost').value = cost > 0 ? cost : '';
    document.getElementById('stockInSellingPrice').value = sell !== '' ? sell : '';
    calculateStockInProfit('item');
  }
}

function calculateStockInProfit(trigger) {
  const qty = parseFloat(document.getElementById('stockInQuantity').value) || 0;
  const unitCostInput = document.getElementById('stockInUnitCost');
  const batchCostInput = document.getElementById('stockInBatchCost');
  const sellPriceInput = document.getElementById('stockInSellingPrice');

  let unitCost = parseFloat(unitCostInput.value) || 0;
  let batchCost = parseFloat(batchCostInput.value) || 0;
  const sellPrice = parseFloat(sellPriceInput.value) || 0;

  if (trigger === 'unit' && qty > 0) {
    batchCost = parseFloat((unitCost * qty).toFixed(2));
    batchCostInput.value = batchCost > 0 ? batchCost : '';
  } else if (trigger === 'batch' && qty > 0) {
    unitCost = parseFloat((batchCost / qty).toFixed(2));
    unitCostInput.value = unitCost > 0 ? unitCost : '';
  } else if (trigger === 'qty' && qty > 0) {
    if (unitCost > 0) {
      batchCost = parseFloat((unitCost * qty).toFixed(2));
      batchCostInput.value = batchCost > 0 ? batchCost : '';
    } else if (batchCost > 0) {
      unitCost = parseFloat((batchCost / qty).toFixed(2));
      unitCostInput.value = unitCost > 0 ? unitCost : '';
    }
  } else if (trigger === 'item' && qty > 0 && unitCost > 0) {
    batchCost = parseFloat((unitCost * qty).toFixed(2));
    batchCostInput.value = batchCost > 0 ? batchCost : '';
  }

  const profitBox = document.getElementById('stockInProfitBox');
  const profitHint = document.getElementById('stockInProfitHint');

  if (sellPrice > 0 && (unitCost > 0 || batchCost > 0)) {
    const unitProfit = sellPrice - unitCost;
    const totalProfit = unitProfit * (qty > 0 ? qty : 1);
    const margin = ((unitProfit / sellPrice) * 100);
    const isProfit = unitProfit >= 0;

    profitBox.style.display = 'block';
    profitHint.style.display = 'none';

    const unitEl = document.getElementById('stockInUnitProfit');
    const batchEl = document.getElementById('stockInBatchProfit');
    const marginEl = document.getElementById('stockInMarginBadge');

    unitEl.innerText = `${isProfit ? '+' : ''}${formatCurrency(unitProfit)}`;
    unitEl.className = `fw-bold tabular-nums ${isProfit ? 'text-success' : 'text-danger'}`;

    batchEl.innerText = `${isProfit ? '+' : ''}${formatCurrency(totalProfit)}`;
    batchEl.className = `fw-bold tabular-nums ${isProfit ? 'text-success' : 'text-danger'}`;

    marginEl.innerText = `${margin.toFixed(1)}% margin`;
    marginEl.className = `badge ${isProfit ? 'bg-success-subtle text-success' : 'bg-danger-subtle text-danger'}`;
  } else {
    profitBox.style.display = 'none';
    profitHint.style.display = 'block';
  }
}

function showCurrentAvailableStock(selectEl) {
  const opt = selectEl.options[selectEl.selectedIndex];
  const hint = document.getElementById('stockAvailableHint');
  if (opt.value && opt.dataset.current !== undefined) {
    hint.innerHTML = `<span class="fw-semibold text-dark">Current Available: ${opt.dataset.current} ${opt.dataset.unit}</span>`;
  } else {
    hint.innerHTML = '';
  }
}

async function handleStockInSubmit(e) {
  e.preventDefault();
  const form = e.target;
  const formData = new FormData(form);
  const payload = Object.fromEntries(formData.entries());

  try {
    const res = await fetch('/api/stock/in', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });
    const result = await res.json();
    if (result.success) {
      setPendingToast(result.message, 'success');
      window.location.reload();
    } else {
      toast.error(result.message);
    }
  } catch (err) {
    toast.error('Failed to record stock arrival: ' + err.message);
  }
}

async function handleStockOutSubmit(e) {
  e.preventDefault();
  const form = e.target;
  const formData = new FormData(form);
  const payload = Object.fromEntries(formData.entries());

  try {
    const res = await fetch('/api/stock/out', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });
    const result = await res.json();
    if (result.success) {
      setPendingToast(result.message, 'success');
      window.location.reload();
    } else {
      toast.error(result.message);
    }
  } catch (err) {
    toast.error('Failed to deduct stock: ' + err.message);
  }
}

function initFooterScripts() {
  // Update Quick Print pending badge in sidebar after initial page render
  async function updateSidebarQuickPrintBadge() {
    try {
      const res = await fetch('/api/quick-print/stats');
      const data = await res.json();
      if (data.success && data.data) {
        const badge = document.getElementById('sidebarQuickBadge');
        if (badge) {
          if (data.data.pending > 0) {
            badge.textContent = data.data.pending;
            badge.style.display = 'inline-block';
          } else {
            badge.style.display = 'none';
          }
        }
      }
    } catch (e) {
      // Ignore background badge fetch errors
    }
  }

  // Run initial badge check 1s after render so main page loads instantly
  setTimeout(updateSidebarQuickPrintBadge, 1000);
  if (window._quickPrintBadgeInterval) {
    clearInterval(window._quickPrintBadgeInterval);
  }
  window._quickPrintBadgeInterval = setInterval(updateSidebarQuickPrintBadge, 20000);
}

// Instant hover prefetching for internal links to eliminate transition latency
(function setupInstantHoverPrefetch() {
  if (window._instantPrefetchInit) return;
  window._instantPrefetchInit = true;

  function prefetchUrl(url) {
    if (!url || url.includes('/logout') || url.includes('/auth') || url.includes('#')) return;
    try {
      const parsed = new URL(url, window.location.origin);
      if (parsed.origin !== window.location.origin) return;
      if (document.querySelector(`link[rel="prefetch"][href="${parsed.pathname}"]`)) return;

      const link = document.createElement('link');
      link.rel = 'prefetch';
      link.href = parsed.pathname;
      link.as = 'document';
      document.head.appendChild(link);
    } catch (e) {}
  }

  document.addEventListener('pointerenter', function(e) {
    const a = e.target.closest('a[href^="/"]');
    if (a && a.href) prefetchUrl(a.href);
  }, { passive: true, capture: true });

  document.addEventListener('touchstart', function(e) {
    const a = e.target.closest('a[href^="/"]');
    if (a && a.href) prefetchUrl(a.href);
  }, { passive: true, capture: true });
})();

document.addEventListener('DOMContentLoaded', initFooterScripts);
document.addEventListener('turbo:load', initFooterScripts);
</script>
</body>
</html>
