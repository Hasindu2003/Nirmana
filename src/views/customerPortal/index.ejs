<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<%
  const ordersList = customer.orders || [];
  const quickList = typeof quickPrintJobs !== 'undefined' ? quickPrintJobs : [];
  const billedSum = typeof customer.totalBilled !== 'undefined' ? customer.totalBilled : ordersList.reduce((acc, o) => acc + (parseFloat(o.totalAmount) || 0), 0);
  const givenSum = typeof customer.totalGiven !== 'undefined' ? customer.totalGiven : ordersList.reduce((acc, o) => acc + (parseFloat(o.advancePaid) || 0), 0);
  const yetToGiveSum = typeof customer.totalYetToGive !== 'undefined' ? customer.totalYetToGive : ordersList.reduce((acc, o) => acc + (parseFloat(o.balanceAmount) || 0), 0);
%>

<main class="main-wrapper">
  <div class="content-body">
    <!-- Welcome Header -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
      <div>
        <div class="d-flex align-items-center gap-2 mb-1">
          <span class="badge bg-primary-subtle text-primary border border-primary-subtle fw-semibold px-2 py-1">
            <i class="bi bi-speedometer2 me-1"></i> Customer Dashboard
          </span>
          <span class="badge bg-light text-muted border font-monospace"><%= customer.customerCode %></span>
        </div>
        <h2 class="fs-4 fw-bold mb-1">My Dashboard — <%= customer.name %></h2>
        <div class="text-muted small">
          Track individual print orders, edit requests before printing, upload bank slips, and monitor queue tokens.
        </div>
      </div>

      <div class="d-flex flex-wrap align-items-center gap-2">
        <a href="/products" class="btn btn-serene-secondary shadow-xs">
          <i class="bi bi-grid me-1"></i> Order Goods & Merchandise
        </a>
        <a href="/upload" class="btn btn-serene-primary shadow-xs">
          <i class="bi bi-cloud-arrow-up"></i> Upload New Print Files
        </a>
        <a href="/logout" class="btn btn-serene-secondary">
          <i class="bi bi-box-arrow-right"></i> Sign Out
        </a>
      </div>
    </div>

    <!-- Financial KPI Summary Cards -->
    <div class="row g-2 g-md-3 mb-4">
      <!-- 1. Total Orders -->
      <div class="col-6 col-md-3">
        <div class="kpi-card h-100">
          <div class="kpi-title">Total Orders</div>
          <div class="kpi-value tabular-nums text-dark"><%= ordersList.length %></div>
          <div class="kpi-sub text-muted text-truncate">
            <i class="bi bi-receipt"></i> Print orders placed
          </div>
        </div>
      </div>

      <!-- 2. Total Billed Value -->
      <div class="col-6 col-md-3">
        <div class="kpi-card h-100">
          <div class="kpi-title">Total Billed</div>
          <div class="kpi-value tabular-nums text-dark">
            <%= currencySymbol %> <%= parseFloat(billedSum).toLocaleString('en-LK', { minimumFractionDigits: 2 }) %>
          </div>
          <div class="kpi-sub text-muted text-truncate">
            <i class="bi bi-wallet2"></i> Lifetime jobs total
          </div>
        </div>
      </div>

      <!-- 3. Given Amount (Paid) -->
      <div class="col-6 col-md-3">
        <div class="kpi-card h-100" style="border-left: 4px solid var(--serene-success, #16a34a);">
          <div class="kpi-title text-success">Given Amount (Paid)</div>
          <div class="kpi-value tabular-nums text-success">
            <%= currencySymbol %> <%= parseFloat(givenSum).toLocaleString('en-LK', { minimumFractionDigits: 2 }) %>
          </div>
          <div class="kpi-sub text-muted text-truncate">
            <i class="bi bi-check-circle text-success"></i> Advance & payments received
          </div>
        </div>
      </div>

      <!-- 4. Yet to Give (Unpaid Balance) -->
      <div class="col-6 col-md-3">
        <div class="kpi-card h-100" style="border-left: 4px solid <%= yetToGiveSum > 0 ? 'var(--serene-danger, #dc2626)' : 'var(--serene-success, #16a34a)' %>;">
          <div class="kpi-title <%= yetToGiveSum > 0 ? 'text-danger fw-bold' : 'text-success' %>">Yet to Give (To Pay)</div>
          <div class="kpi-value tabular-nums <%= yetToGiveSum > 0 ? 'text-danger' : 'text-success' %>">
            <%= currencySymbol %> <%= parseFloat(yetToGiveSum).toLocaleString('en-LK', { minimumFractionDigits: 2 }) %>
          </div>
          <div class="kpi-sub text-muted text-truncate">
            <% if (yetToGiveSum > 0) { %>
              <span class="text-danger fw-medium"><i class="bi bi-clock-history"></i> Balance due upon delivery</span>
            <% } else { %>
              <span class="text-success fw-medium"><i class="bi bi-check2-all"></i> All orders fully paid!</span>
            <% } %>
          </div>
        </div>
      </div>
    </div>

    <!-- Active Balance Notice Banner (if any) -->
    <% if (yetToGiveSum > 0) { %>
      <div class="alert alert-warning border-warning-subtle shadow-xs mb-4 p-3 rounded-3 d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div class="d-flex align-items-center gap-3">
          <div class="rounded-circle bg-warning text-dark p-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
            <i class="bi bi-exclamation-triangle-fill fs-5"></i>
          </div>
          <div>
            <div class="fw-bold text-dark mb-0">Pending Payment Due: <%= currencySymbol %> <%= parseFloat(yetToGiveSum).toLocaleString('en-LK', { minimumFractionDigits: 2 }) %></div>
            <div class="text-muted small">You can settle this balance at our store counter or via direct bank transfer when collecting your order.</div>
          </div>
        </div>
        <div class="small text-muted font-monospace">
          Contact: 077 568 5543 / 034 226 2355
        </div>
      </div>
    <% } %>

    <!-- Visual Showcase of Popular Custom Products with Example Photos -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden bg-white border">
      <div class="card-header bg-white border-bottom py-3 px-4 d-flex align-items-center justify-content-between">
        <div>
          <h5 class="fw-bold fs-6 mb-0 text-dark d-flex align-items-center gap-2">
            <i class="bi bi-stars text-warning"></i>
            <span>Order Custom Printing & Merchandise</span>
          </h5>
          <div class="text-muted small" style="font-size: 0.75rem;">Browse real example photos of our custom work and place your order online</div>
        </div>
        <a href="/products" class="btn btn-sm btn-outline-primary fw-semibold">
          View All Items <i class="bi bi-arrow-right ms-1"></i>
        </a>
      </div>
      <div class="card-body p-3 p-md-4">
        <div class="row g-3">
          <div class="col-6 col-md-3">
            <a href="/products?category=Merchandise" class="text-decoration-none">
              <div class="card h-100 border rounded-3 overflow-hidden shadow-xs hover-shadow transition-all text-center">
                <div style="height: 120px; overflow: hidden; background: #f8fafc;">
                  <img src="https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?w=600&auto=format&fit=crop&q=80" alt="Custom Mug" class="w-100 h-100" style="object-fit: cover;">
                </div>
                <div class="p-2">
                  <strong class="d-block text-dark small text-truncate">Custom Photo Mugs</strong>
                  <span class="badge bg-primary-subtle text-primary border small" style="font-size: 0.68rem;">From <%= currencySymbol %> 850</span>
                </div>
              </div>
            </a>
          </div>
          <div class="col-6 col-md-3">
            <a href="/products?category=Photo%20Frames" class="text-decoration-none">
              <div class="card h-100 border rounded-3 overflow-hidden shadow-xs hover-shadow transition-all text-center">
                <div style="height: 120px; overflow: hidden; background: #f8fafc;">
                  <img src="https://images.unsplash.com/photo-1513519245088-0e12902e5a38?w=600&auto=format&fit=crop&q=80" alt="Photo Frame" class="w-100 h-100" style="object-fit: cover;">
                </div>
                <div class="p-2">
                  <strong class="d-block text-dark small text-truncate">Photo Frames & Print</strong>
                  <span class="badge bg-primary-subtle text-primary border small" style="font-size: 0.68rem;">Various Sizes</span>
                </div>
              </div>
            </a>
          </div>
          <div class="col-6 col-md-3">
            <a href="/products?category=Printing%20Services" class="text-decoration-none">
              <div class="card h-100 border rounded-3 overflow-hidden shadow-xs hover-shadow transition-all text-center">
                <div style="height: 120px; overflow: hidden; background: #f8fafc;">
                  <img src="https://images.unsplash.com/photo-1589829085413-56de8ae18c73?w=600&auto=format&fit=crop&q=80" alt="Business Cards" class="w-100 h-100" style="object-fit: cover;">
                </div>
                <div class="p-2">
                  <strong class="d-block text-dark small text-truncate">Executive Cards</strong>
                  <span class="badge bg-primary-subtle text-primary border small" style="font-size: 0.68rem;">From <%= currencySymbol %> 1,500</span>
                </div>
              </div>
            </a>
          </div>
          <div class="col-6 col-md-3">
            <a href="/products?category=Stationery%20%26%20Retail" class="text-decoration-none">
              <div class="card h-100 border rounded-3 overflow-hidden shadow-xs hover-shadow transition-all text-center">
                <div style="height: 120px; overflow: hidden; background: #f8fafc;">
                  <img src="https://images.unsplash.com/photo-1614728894747-a83421e2b9c9?w=600&auto=format&fit=crop&q=80" alt="Keytags & Stationery" class="w-100 h-100" style="object-fit: cover;">
                </div>
                <div class="p-2">
                  <strong class="d-block text-dark small text-truncate">Keytags & Retail</strong>
                  <span class="badge bg-primary-subtle text-primary border small" style="font-size: 0.68rem;">Store Stock</span>
                </div>
              </div>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Orders & Transactions List -->
    <div class="serene-card mb-4" id="ordersSection">
      <div class="serene-card-header d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div>
          <h3 class="serene-card-title mb-0 d-flex align-items-center gap-2">
            <i class="bi bi-receipt-cutoff text-primary"></i>
            <span>My Printing Orders</span>
          </h3>
          <div class="text-muted small" style="font-size: 0.78rem;">Each order is shown separately below with exact time, custom request, and payment status</div>
        </div>
        <div class="d-flex align-items-center gap-2">
          <span class="badge bg-light text-muted border"><%= ordersList.length %> Total Jobs</span>
          <div class="btn-group btn-group-sm" role="group">
            <button type="button" class="btn btn-outline-secondary active" id="btnViewCards" onclick="toggleOrderView('cards')">
              <i class="bi bi-grid-fill me-1"></i> Separate Cards
            </button>
            <button type="button" class="btn btn-outline-secondary" id="btnViewTable" onclick="toggleOrderView('table')">
              <i class="bi bi-table me-1"></i> Table View
            </button>
          </div>
        </div>
      </div>

      <!-- VIEW 1: SEPARATE ORDER CARDS (Clear distinction for 2+ simultaneous orders) -->
      <div id="ordersCardsContainer" class="p-3 p-md-4">
        <% if (ordersList.length > 0) { %>
          <div class="d-flex flex-column gap-3">
            <% ordersList.forEach((o, idx) => { %>
              <% const orderDue = parseFloat(o.balanceAmount) || 0; %>
              <% const orderPaid = parseFloat(o.advancePaid) || 0; %>
              <% const orderTotal = parseFloat(o.totalAmount) || 0; %>
              <% const isEditable = o.status === 'RECEIVED'; %>
              <div class="card border rounded-3 shadow-xs overflow-hidden bg-white order-card-item" id="order-card-<%= o.id %>">
                <!-- Order Card Header: Unique Order #, Exact Timestamp with seconds, and Badges -->
                <div class="card-header bg-light py-2 px-3 border-bottom d-flex flex-wrap align-items-center justify-content-between gap-2">
                  <div class="d-flex align-items-center flex-wrap gap-2">
                    <span class="badge bg-dark font-monospace fs-6 px-2 py-1"><%= o.orderNumber %></span>
                    <span class="text-muted small">
                      <i class="bi bi-clock me-1"></i>
                      <strong><%= typeof formatSriLankaDateTime !== 'undefined' ? formatSriLankaDateTime(o.createdAt) : (o.createdAt ? new Date(o.createdAt).toLocaleString('en-LK') : o.orderDate) %></strong>
                    </span>
                    <% if (idx === 0) { %>
                      <span class="badge bg-info-subtle text-info border border-info-subtle small" style="font-size: 0.7rem;">Latest Order</span>
                    <% } %>
                  </div>

                  <div class="d-flex align-items-center flex-wrap gap-2">
                    <!-- Status Badge -->
                    <span class="status-badge status-<%= o.status.toLowerCase() %>">
                      <span class="status-dot"></span> <%= o.status.replace('_', ' ') %>
                    </span>

                    <!-- Online Bank Slip Status Badge -->
                    <% if (o.paymentSlipStatus === 'PENDING_VERIFICATION') { %>
                      <span class="badge bg-warning-subtle text-warning border border-warning-subtle fw-semibold">
                        <i class="bi bi-hourglass-split me-1"></i> Slip Verification Pending
                      </span>
                    <% } else if (o.paymentSlipStatus === 'VERIFIED') { %>
                      <span class="badge bg-success-subtle text-success border border-success-subtle fw-semibold">
                        <i class="bi bi-check-circle-fill me-1"></i> Bank Slip Confirmed
                      </span>
                    <% } else if (o.paymentSlipStatus === 'REJECTED') { %>
                      <span class="badge bg-danger-subtle text-danger border border-danger-subtle fw-semibold">
                        <i class="bi bi-exclamation-octagon me-1"></i> Slip Rejected (Re-upload needed)
                      </span>
                    <% } %>
                  </div>
                </div>

                <!-- Order Card Body: Job Title, Good/Material, Qty, Specifications & Instructions -->
                <div class="card-body p-3">
                  <div class="row g-3 align-items-center">
                    <div class="col-lg-7">
                      <h5 class="fw-bold fs-6 text-dark mb-1 d-flex align-items-center gap-2">
                        <span><%= o.jobTitle %></span>
                      </h5>

                      <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                        <span class="badge bg-secondary-subtle text-secondary border small">
                          <i class="bi bi-boxes me-1"></i> <%= o.quantity %> units
                        </span>
                        <% if (o.paperMaterial) { %>
                          <span class="badge bg-primary-subtle text-primary border border-primary-subtle small fw-semibold">
                            <i class="bi bi-box-seam me-1"></i> <%= o.paperMaterial %>
                          </span>
                        <% } %>
                      </div>

                      <!-- Customer Custom Specifications Box -->
                      <div class="p-2 px-3 rounded-2 bg-light border small text-dark">
                        <span class="text-muted fw-semibold d-block mb-1" style="font-size: 0.72rem;">
                          <i class="bi bi-chat-left-text me-1 text-primary"></i> Customer Customization Request:
                        </span>
                        <% if (o.specifications && o.specifications.trim()) { %>
                          <div style="white-space: pre-line;" id="order-specs-text-<%= o.id %>"><%= o.specifications %></div>
                        <% } else { %>
                          <span class="text-muted fst-italic">Standard printing request (no custom instructions entered)</span>
                        <% } %>
                      </div>
                    </div>

                    <!-- Financial Summary Ribbon -->
                    <div class="col-lg-5">
                      <div class="p-3 rounded-3 border bg-light">
                        <div class="d-flex justify-content-between small text-muted mb-1">
                          <span>Job Total Price:</span>
                          <strong class="text-dark tabular-nums"><%= currencySymbol %> <%= orderTotal.toLocaleString('en-LK', { minimumFractionDigits: 2 }) %></strong>
                        </div>
                        <div class="d-flex justify-content-between small text-success mb-1">
                          <span>Given Amount (Paid):</span>
                          <strong class="tabular-nums"><%= currencySymbol %> <%= orderPaid.toLocaleString('en-LK', { minimumFractionDigits: 2 }) %></strong>
                        </div>
                        <hr class="my-1">
                        <div class="d-flex justify-content-between align-items-center">
                          <span class="small fw-bold <%= orderDue > 0 ? 'text-danger' : 'text-success' %>">
                            Yet to Give (Balance):
                          </span>
                          <span class="fs-6 fw-bold tabular-nums <%= orderDue > 0 ? 'text-danger' : 'text-success' %>">
                            <%= currencySymbol %> <%= orderDue.toLocaleString('en-LK', { minimumFractionDigits: 2 }) %>
                          </span>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Order Card Footer: Action Controls -->
                <div class="card-footer bg-white border-top py-2 px-3 d-flex flex-wrap align-items-center justify-content-between gap-2">
                  <div class="d-flex align-items-center gap-2">
                    <!-- Edit Request Button (Available ONLY before printing starts: RECEIVED) -->
                    <% if (isEditable) { %>
                      <button type="button" class="btn btn-sm btn-outline-primary"
                              onclick="openCustomerEditModal(<%= o.id %>, '<%= o.orderNumber %>', <%= o.quantity %>, `<%= (o.specifications || '').replace(/`/g, '\\`').replace(/\\/g, '\\\\') %>`)">
                        <i class="bi bi-pencil-square me-1"></i> Edit Request
                      </button>
                    <% } else { %>
                      <button type="button" class="btn btn-sm btn-light border text-muted" disabled
                              title="Production has started (<%= o.status %>). Requests can no longer be edited online.">
                        <i class="bi bi-lock-fill me-1"></i> In Print / Production (Locked)
                      </button>
                    <% } %>

                    <!-- Cancellation Help Link (Customers cannot delete; must contact store) -->
                    <button type="button" class="btn btn-sm btn-link text-secondary text-decoration-none"
                            onclick="openCustomerCancelModal('<%= o.orderNumber %>')">
                      <i class="bi bi-telephone-outbound text-danger me-1"></i> Need to cancel?
                    </button>
                  </div>

                  <!-- Bank Slip Upload / Preview Buttons -->
                  <div class="d-flex align-items-center gap-2">
                    <% if (o.paymentSlipUrl) { %>
                      <a href="<%= o.paymentSlipUrl %>" target="_blank" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-file-earmark-image me-1"></i> View Bank Slip
                      </a>
                    <% } %>

                    <% if (orderDue > 0 || o.paymentSlipStatus === 'REJECTED') { %>
                      <button type="button" class="btn btn-sm btn-serene-primary"
                              onclick="openUploadSlipModal(<%= o.id %>, '<%= o.orderNumber %>', <%= orderDue %>)">
                        <i class="bi bi-cloud-arrow-up me-1"></i>
                        <%= o.paymentSlipUrl ? 'Re-upload Bank Slip' : 'Upload Bank Slip' %>
                      </button>
                    <% } %>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <div class="text-center py-5 text-muted">
            <div class="mb-2"><i class="bi bi-printer fs-2 text-muted"></i></div>
            <div class="fw-semibold text-dark">No orders found yet</div>
            <div class="small text-muted mt-1">When you place print jobs at Nirmana, they will be listed here separately.</div>
            <a href="/upload" class="btn btn-sm btn-serene-primary mt-3">Upload Print Artwork</a>
          </div>
        <% } %>
      </div>

      <!-- VIEW 2: COMPACT TABLE VIEW (Optional Toggle) -->
      <div id="ordersTableContainer" class="table-responsive" style="display: none;">
        <table class="serene-table">
          <thead>
            <tr>
              <th>Order #</th>
              <th>Placed Time</th>
              <th>Job Description</th>
              <th>Quantity</th>
              <th>Total Amount</th>
              <th>Given Amount</th>
              <th>Yet to Give</th>
              <th>Job Status</th>
              <th>Slip Status</th>
            </tr>
          </thead>
          <tbody>
            <% if (ordersList.length > 0) { %>
              <% ordersList.forEach(o => { %>
                <% const orderDue = parseFloat(o.balanceAmount) || 0; %>
                <% const orderPaid = parseFloat(o.advancePaid) || 0; %>
                <% const orderTotal = parseFloat(o.totalAmount) || 0; %>
                <tr>
                  <td>
                    <span class="font-monospace fw-bold text-dark"><%= o.orderNumber %></span>
                  </td>
                  <td>
                    <span class="text-muted small">
                      <%= typeof formatSriLankaDateTime !== 'undefined' ? formatSriLankaDateTime(o.createdAt) : (o.orderDate || formatDate(o.createdAt)) %>
                    </span>
                  </td>
                  <td>
                    <div class="fw-semibold text-dark"><%= o.jobTitle %></div>
                    <% if (o.paperMaterial) { %>
                      <div class="mt-1">
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle small" style="font-size: 0.73rem;">
                          <i class="bi bi-box-seam me-1"></i><%= o.paperMaterial %>
                        </span>
                      </div>
                    <% } %>
                    <% if (o.specifications) { %>
                      <div class="text-muted small mt-1" style="font-size: 0.73rem;">
                        <i class="bi bi-chat-left-dots text-secondary me-1"></i><%= o.specifications %>
                      </div>
                    <% } %>
                  </td>
                  <td>
                    <span class="badge bg-light text-dark border"><%= o.quantity %> units</span>
                  </td>
                  <td>
                    <div class="tabular-nums fw-bold text-dark">
                      <%= currencySymbol %> <%= orderTotal.toLocaleString('en-LK', { minimumFractionDigits: 2 }) %>
                    </div>
                  </td>
                  <td>
                    <span class="tabular-nums fw-semibold text-success">
                      <%= currencySymbol %> <%= orderPaid.toLocaleString('en-LK', { minimumFractionDigits: 2 }) %>
                    </span>
                  </td>
                  <td>
                    <% if (orderDue > 0) { %>
                      <span class="badge bg-danger-subtle text-danger border border-danger-subtle fw-bold tabular-nums">
                        <%= currencySymbol %> <%= orderDue.toLocaleString('en-LK', { minimumFractionDigits: 2 }) %>
                      </span>
                    <% } else { %>
                      <span class="badge bg-success-subtle text-success border border-success-subtle fw-semibold">
                        <i class="bi bi-check2"></i> Settled
                      </span>
                    <% } %>
                  </td>
                  <td>
                    <span class="status-badge status-<%= o.status.toLowerCase() %>">
                      <span class="status-dot"></span> <%= o.status.replace('_', ' ') %>
                    </span>
                  </td>
                  <td>
                    <% if (o.paymentSlipStatus === 'PENDING_VERIFICATION') { %>
                      <span class="badge bg-warning-subtle text-warning border border-warning-subtle">Pending Check</span>
                    <% } else if (o.paymentSlipStatus === 'VERIFIED') { %>
                      <span class="badge bg-success-subtle text-success border border-success-subtle">Verified</span>
                    <% } else if (o.paymentSlipStatus === 'REJECTED') { %>
                      <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Rejected</span>
                    <% } else { %>
                      <span class="text-muted small">—</span>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="9" class="text-center py-5 text-muted">
                  No orders found.
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Quick Print Counter & Online Submissions -->
    <div class="serene-card mb-4">
      <div class="serene-card-header d-flex flex-wrap align-items-center justify-content-between gap-2">
        <h3 class="serene-card-title mb-0">
          <i class="bi bi-qr-code-scan me-2 text-primary"></i> My Quick Print Counter & Online Submissions
        </h3>
        <span class="badge bg-light text-muted border"><%= quickList.length %> Total Submissions</span>
      </div>

      <div class="table-responsive">
        <table class="serene-table">
          <thead>
            <tr>
              <th>Token #</th>
              <th>Date & Time</th>
              <th>Options</th>
              <th>Copies</th>
              <th>Files Uploaded</th>
              <th>Special Message</th>
              <th>Queue Status</th>
            </tr>
          </thead>
          <tbody>
            <% if (quickList.length > 0) { %>
              <% quickList.forEach(job => { %>
                <tr>
                  <td>
                    <span class="font-monospace fw-bold text-primary"><%= job.tokenNumber %></span>
                  </td>
                  <td>
                    <span class="text-muted small"><%= typeof formatDateTime !== 'undefined' ? formatDateTime(job.createdAt) : (job.createdAt ? new Date(job.createdAt).toLocaleString('en-LK') : '') %></span>
                  </td>
                  <td>
                    <span class="badge bg-light text-dark border me-1"><%= job.paperSize %></span>
                    <% if (job.colorMode === 'COLOR') { %>
                      <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Color</span>
                    <% } else { %>
                      <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">B&W</span>
                    <% } %>
                  </td>
                  <td>
                    <span class="fw-semibold text-dark"><%= job.copies %> copies</span>
                  </td>
                  <td>
                    <% const files = job.files || []; %>
                    <div class="d-flex align-items-center gap-1">
                      <i class="bi bi-file-earmark-text text-muted"></i>
                      <span class="fw-semibold text-dark small"><%= files.length %> file<%= files.length === 1 ? '' : 's' %></span>
                    </div>
                    <% if (files.length > 0) { %>
                      <div class="text-muted small text-truncate" style="max-width: 180px; font-size: 0.73rem;">
                        <%= files.map(f => f.originalName).join(', ') %>
                      </div>
                    <% } %>
                  </td>
                  <td>
                    <span class="text-muted small"><%= job.customerMessage || '—' %></span>
                  </td>
                  <td>
                    <% if (job.status === 'READY') { %>
                      <span class="badge bg-success-subtle text-success border border-success-subtle fw-bold">
                        <i class="bi bi-check-circle-fill me-1"></i> Ready for Pickup
                      </span>
                    <% } else if (job.status === 'PRINTING') { %>
                      <span class="badge bg-info-subtle text-info border border-info-subtle fw-bold">
                        <i class="bi bi-printer me-1"></i> Printing Now
                      </span>
                    <% } else if (job.status === 'COMPLETED') { %>
                      <span class="badge bg-light text-muted border fw-semibold">
                        <i class="bi bi-check2-all me-1"></i> Completed
                      </span>
                    <% } else { %>
                      <span class="badge bg-warning-subtle text-warning border border-warning-subtle fw-semibold">
                        <i class="bi bi-hourglass-split me-1"></i> In Queue (Pending)
                      </span>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="7" class="text-center py-4 text-muted">
                  <div class="mb-1"><i class="bi bi-cloud-arrow-up fs-3 text-muted"></i></div>
                  <div class="small fw-semibold text-dark">No counter quick print submissions yet</div>
                  <div class="small text-muted mt-1">Upload documents to print instantly at our store counter anytime.</div>
                  <a href="/upload" class="btn btn-sm btn-serene-primary mt-2">
                    <i class="bi bi-upload me-1"></i> Upload Print Files Now
                  </a>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Account Details & Bank Transfer Info Card -->
    <div class="row g-4">
      <div class="col-lg-6">
        <div class="serene-card h-100">
          <div class="serene-card-header">
            <h3 class="serene-card-title"><i class="bi bi-person-circle me-2 text-muted"></i> My Account Details</h3>
          </div>
          <div class="serene-card-body small">
            <div class="d-flex justify-content-between py-2 border-bottom">
              <span class="text-muted">Account Name:</span>
              <span class="fw-bold text-dark"><%= customer.name %></span>
            </div>
            <div class="d-flex justify-content-between py-2 border-bottom">
              <span class="text-muted">Registered Phone:</span>
              <span class="fw-semibold text-dark"><%= customer.phone %></span>
            </div>
            <div class="d-flex justify-content-between py-2 border-bottom">
              <span class="text-muted">Company / Brand:</span>
              <span class="text-dark"><%= customer.companyName || 'Individual' %></span>
            </div>
            <div class="d-flex justify-content-between py-2 border-bottom">
              <span class="text-muted">Email Address:</span>
              <span class="text-dark"><%= customer.email || 'Not provided' %></span>
            </div>
            <div class="d-flex justify-content-between py-2">
              <span class="text-muted">Customer Code:</span>
              <span class="font-monospace text-primary fw-bold"><%= customer.customerCode %></span>
            </div>
          </div>
        </div>
      </div>

      <div class="col-lg-6">
        <div class="serene-card h-100">
          <div class="serene-card-header">
            <h3 class="serene-card-title"><i class="bi bi-bank me-2 text-muted"></i> Payment & Bank Details</h3>
          </div>
          <div class="serene-card-body small">
            <p class="text-muted mb-3">To settle any remaining balances due via direct bank transfer, please use the following bank details:</p>
            <div class="p-3 rounded-2 bg-light border mb-3">
              <div class="fw-bold text-dark mb-1">Nirmana Printing (Pvt) Ltd</div>
              <div class="text-muted mb-1">Bank: <strong>Commercial Bank of Ceylon</strong></div>
              <div class="text-muted mb-1">Account No: <strong>8000 1234 5678</strong></div>
              <div class="text-muted">Branch: <strong>Horana Branch</strong></div>
            </div>
            <div class="text-muted">
              <i class="bi bi-info-circle text-primary me-1"></i> Please mention your <strong>Customer Code (<%= customer.customerCode %>)</strong> or <strong>Order #</strong> as the transaction remark and share receipt via WhatsApp (077 568 5543).
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- 1. Modal: Customer Edit Order Request -->
  <div class="modal fade" id="customerEditModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content shadow-lg border-0 rounded-4">
        <div class="modal-header bg-primary text-white">
          <h5 class="modal-title fw-bold">
            <i class="bi bi-pencil-square me-2"></i> Edit Order Request
          </h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <form id="customerEditForm" onsubmit="submitCustomerEdit(event)">
          <div class="modal-body p-4">
            <input type="hidden" id="editModalOrderId">

            <div class="alert alert-info border-info-subtle small mb-3">
              <i class="bi bi-info-circle me-1"></i> You can edit your specifications and quantity before printing commences. If quantity is changed, the bill total will be automatically recalculated.
            </div>

            <div class="mb-3">
              <label class="form-label fw-semibold small text-muted">Order Reference</label>
              <input type="text" class="form-control font-monospace bg-light" id="editModalOrderNum" readonly>
            </div>

            <div class="mb-3">
              <label class="form-label fw-semibold small text-muted" for="editModalQuantity">Order Quantity</label>
              <input type="number" class="form-control" id="editModalQuantity" min="1" max="10000" required>
            </div>

            <div class="mb-3">
              <label class="form-label fw-semibold small text-muted" for="editModalSpecs">Custom Specifications & Instructions</label>
              <textarea class="form-control" id="editModalSpecs" rows="4" placeholder="Enter your custom request details, photo placement, paper preference, or special notes..."></textarea>
            </div>
          </div>
          <div class="modal-footer bg-light p-3">
            <button type="button" class="btn btn-serene-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-serene-primary" id="btnSaveCustomerEdit">
              <i class="bi bi-check-lg me-1"></i> Save Changes
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- 2. Modal: Order Cancellation Request / Direct Store Contact -->
  <div class="modal fade" id="customerCancelModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content shadow-lg border-0 rounded-4">
        <div class="modal-header bg-danger text-white">
          <h5 class="modal-title fw-bold">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> Order Cancellation Request
          </h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body p-4">
          <div class="text-center mb-3">
            <div class="badge bg-danger-subtle text-danger font-monospace fs-5 px-3 py-2 mb-2" id="cancelModalOrderNum"></div>
            <h6 class="fw-bold text-dark mb-1">Direct Contact Required to Cancel</h6>
          </div>
          <p class="text-muted small mb-3">
            Because our store prepares printing materials (cutting photo papers, substrates, mug blanks, or vinyl rolls) shortly after receiving orders, direct online deletion is disabled to prevent accidental damage or wasted physical stock.
          </p>
          <div class="p-3 rounded-3 bg-light border mb-3">
            <div class="fw-bold text-dark small mb-1"><i class="bi bi-shop me-1 text-primary"></i> Nirmana Printing Counter</div>
            <div class="text-muted small">Hotline: <strong>077 568 5543 / 034 226 2355</strong></div>
            <div class="text-muted small">Hours: Monday – Saturday (8:00 AM – 7:00 PM)</div>
          </div>
          <p class="text-muted small mb-0">
            Please tap below to call our counter staff or send a WhatsApp message with your Order # so our team can immediately halt the job.
          </p>
        </div>
        <div class="modal-footer bg-light p-3 d-flex justify-content-between">
          <button type="button" class="btn btn-serene-secondary" data-bs-dismiss="modal">Close</button>
          <div class="d-flex gap-2">
            <a href="tel:0775685543" class="btn btn-outline-primary">
              <i class="bi bi-telephone-fill me-1"></i> Call Store
            </a>
            <a href="#" id="cancelModalWaBtn" target="_blank" class="btn btn-success">
              <i class="bi bi-whatsapp me-1"></i> WhatsApp
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- 3. Modal: Upload Online Bank Payment Slip -->
  <div class="modal fade" id="uploadSlipModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content shadow-lg border-0 rounded-4">
        <div class="modal-header bg-serene-primary text-white">
          <h5 class="modal-title fw-bold">
            <i class="bi bi-cloud-arrow-up-fill me-2"></i> Upload Bank Payment Slip
          </h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <form id="uploadSlipForm" onsubmit="submitPaymentSlip(event)">
          <div class="modal-body p-4">
            <input type="hidden" id="slipModalOrderId">

            <!-- Summary of the order and due amount -->
            <div class="p-3 rounded-3 bg-light border mb-3">
              <div class="d-flex justify-content-between small text-muted mb-1">
                <span>Order Reference:</span>
                <strong class="font-monospace text-dark" id="slipModalOrderNum"></strong>
              </div>
              <div class="d-flex justify-content-between small text-muted mb-1">
                <span>Outstanding Balance Due:</span>
                <strong class="text-danger fs-6 tabular-nums" id="slipModalBalance"></strong>
              </div>
            </div>

            <!-- Bank account details snippet -->
            <div class="p-2 px-3 rounded-2 border mb-3 small" style="background: #f0fdf4; border-color: #bbf7d0;">
              <span class="text-success fw-bold d-block mb-1"><i class="bi bi-bank me-1"></i> Bank Transfer Account:</span>
              <div class="text-dark">Commercial Bank · <strong>8000 1234 5678</strong> (Horana)</div>
              <div class="text-muted" style="font-size: 0.72rem;">Account Name: Nirmana Printing (Pvt) Ltd</div>
            </div>

            <!-- File Upload Input -->
            <div class="mb-3">
              <label class="form-label fw-semibold small text-muted" for="slipFileInput">
                Select Payment Slip / Receipt Screenshot <span class="text-danger">*</span>
              </label>
              <input type="file" class="form-control" id="slipFileInput" name="slipFile" accept="image/*,application/pdf" required>
              <div class="form-text small" style="font-size: 0.73rem;">Accepted: JPG, PNG, WEBP, PDF (Max 15MB)</div>
            </div>

            <!-- Amount Transferred -->
            <div class="mb-3">
              <label class="form-label fw-semibold small text-muted" for="slipAmountInput">
                Transferred Amount (<%= currencySymbol %>) <span class="text-danger">*</span>
              </label>
              <input type="number" step="0.01" min="1" class="form-control tabular-nums fw-bold" id="slipAmountInput" required>
            </div>

            <!-- Bank Ref / Transaction ID -->
            <div class="mb-3">
              <label class="form-label fw-semibold small text-muted" for="slipRefInput">
                Bank Transaction Reference / Approval # (Optional)
              </label>
              <input type="text" class="form-control font-monospace" id="slipRefInput" placeholder="e.g. BOC-TXN-129482 or COM-FLASH-098">
            </div>

            <!-- Notes -->
            <div class="mb-2">
              <label class="form-label fw-semibold small text-muted" for="slipNotesInput">
                Additional Notes (Optional)
              </label>
              <input type="text" class="form-control" id="slipNotesInput" placeholder="e.g. Paid via Flash app from account ending in 4432">
            </div>
          </div>
          <div class="modal-footer bg-light p-3">
            <button type="button" class="btn btn-serene-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-serene-primary" id="btnSubmitSlip">
              <i class="bi bi-cloud-arrow-up me-1"></i> Upload & Submit Slip
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</main>

<script>
  // View Toggle: Separate Cards vs Compact Table
  function toggleOrderView(mode) {
    const cardsEl = document.getElementById('ordersCardsContainer');
    const tableEl = document.getElementById('ordersTableContainer');
    const btnCards = document.getElementById('btnViewCards');
    const btnTable = document.getElementById('btnViewTable');

    if (mode === 'cards') {
      if (cardsEl) cardsEl.style.display = 'block';
      if (tableEl) tableEl.style.display = 'none';
      if (btnCards) btnCards.classList.add('active');
      if (btnTable) btnTable.classList.remove('active');
    } else {
      if (cardsEl) cardsEl.style.display = 'none';
      if (tableEl) tableEl.style.display = 'block';
      if (btnCards) btnCards.classList.remove('active');
      if (btnTable) btnTable.classList.add('active');
    }
  }

  // Customer Edit Request Modal
  function openCustomerEditModal(orderId, orderNum, currentQty, specs) {
    document.getElementById('editModalOrderId').value = orderId;
    document.getElementById('editModalOrderNum').value = orderNum;
    document.getElementById('editModalQuantity').value = currentQty || 1;
    document.getElementById('editModalSpecs').value = specs || '';
    const modal = new bootstrap.Modal(document.getElementById('customerEditModal'));
    modal.show();
  }

  async function submitCustomerEdit(e) {
    e.preventDefault();
    const orderId = document.getElementById('editModalOrderId').value;
    const quantity = document.getElementById('editModalQuantity').value;
    const specifications = document.getElementById('editModalSpecs').value;
    const btn = document.getElementById('btnSaveCustomerEdit');

    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Saving...';

    try {
      const res = await fetch(`/api/orders/${orderId}/customer-edit`, {
        method: 'PUT',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify({ quantity, specifications })
      });
      const data = await res.json();
      if (!res.ok || !data.success) {
        throw new Error(data.message || 'Failed to update order');
      }
      alert('Order updated successfully!');
      window.location.reload();
    } catch (err) {
      alert('Error updating order: ' + err.message);
    } finally {
      btn.disabled = false;
      btn.innerHTML = '<i class="bi bi-check-lg me-1"></i> Save Changes';
    }
  }

  // Customer Cancel Modal
  function openCustomerCancelModal(orderNum) {
    document.getElementById('cancelModalOrderNum').textContent = orderNum;
    const waText = encodeURIComponent(`Hello Nirmana Printing, I need to request cancellation or modification for my order #${orderNum}. Please let me know the status.`);
    const waBtn = document.getElementById('cancelModalWaBtn');
    if (waBtn) {
      waBtn.href = `https://wa.me/94775685543?text=${waText}`;
    }
    const modal = new bootstrap.Modal(document.getElementById('customerCancelModal'));
    modal.show();
  }

  // Upload Bank Payment Slip Modal
  function openUploadSlipModal(orderId, orderNum, balanceDue) {
    document.getElementById('slipModalOrderId').value = orderId;
    document.getElementById('slipModalOrderNum').textContent = orderNum;
    document.getElementById('slipModalBalance').textContent = `Rs. ${parseFloat(balanceDue || 0).toLocaleString('en-LK', { minimumFractionDigits: 2 })}`;
    document.getElementById('slipAmountInput').value = parseFloat(balanceDue || 0).toFixed(2);
    document.getElementById('slipFileInput').value = '';
    document.getElementById('slipRefInput').value = '';
    document.getElementById('slipNotesInput').value = '';

    const modal = new bootstrap.Modal(document.getElementById('uploadSlipModal'));
    modal.show();
  }

  async function submitPaymentSlip(e) {
    e.preventDefault();
    const orderId = document.getElementById('slipModalOrderId').value;
    const fileInput = document.getElementById('slipFileInput');
    const amount = document.getElementById('slipAmountInput').value;
    const refNumber = document.getElementById('slipRefInput').value;
    const notes = document.getElementById('slipNotesInput').value;
    const btn = document.getElementById('btnSubmitSlip');

    if (!fileInput.files || fileInput.files.length === 0) {
      alert('Please select your payment slip image or PDF file.');
      return;
    }

    const formData = new FormData();
    formData.append('slipFile', fileInput.files[0]);
    formData.append('amount', amount);
    formData.append('refNumber', refNumber);
    formData.append('notes', notes);

    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Uploading...';

    try {
      const res = await fetch(`/api/orders/${orderId}/payment-slip`, {
        method: 'POST',
        headers: {
          'Accept': 'application/json'
        },
        body: formData
      });
      const data = await res.json();
      if (!res.ok || !data.success) {
        throw new Error(data.message || 'Failed to upload slip');
      }
      alert('Payment slip uploaded successfully! Our counter staff will verify and confirm your payment.');
      window.location.reload();
    } catch (err) {
      alert('Upload failed: ' + err.message);
    } finally {
      btn.disabled = false;
      btn.innerHTML = '<i class="bi bi-cloud-arrow-up me-1"></i> Upload & Submit Slip';
    }
  }
</script>

<%- include('../partials/footer') %>
