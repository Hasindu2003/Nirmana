<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<main class="main-wrapper">
  <div class="content-body">
    <!-- Header Row 1: Title on Left, Date & Live Status in Far Right Corner -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
      <div>
        <h2 class="fs-4 fw-bold mb-0 text-dark">Print Shop Dashboard</h2>
      </div>

      <!-- Far Right Corner: Date & Live Status -->
      <div class="text-muted small d-flex align-items-center gap-1 bg-white border rounded-pill px-3 py-1 shadow-xs ms-auto" style="font-size: 0.8rem;">
        <i class="bi bi-calendar3 me-1 text-muted"></i>
        <span>Today, <%= formatDateTime(new Date(), { weekday: 'long', year: 'numeric', month: 'short', day: 'numeric' }) %></span>
        <span class="mx-1 text-muted">&bull;</span>
        <span class="badge rounded-pill bg-success-subtle text-success border border-success-subtle px-2 py-0 d-inline-flex align-items-center" style="font-size: 0.72rem; font-weight: 600;">
          <span class="spinner-grow spinner-grow-sm text-success me-1" style="width: 6px; height: 6px;" role="status"></span> Live Operations
        </span>
      </div>
    </div>

    <!-- Header Row 2: Full-Width Action & Alert Toolbar -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-4 pb-1">
      <!-- Left: Stock Alert & Movement Monitoring Icons -->
      <div class="d-flex flex-wrap align-items-center gap-2">
        <!-- Stock Attention Alert Icon Button -->
        <button class="btn btn-sm <%= stats.kpis.lowStockCount > 0 ? 'btn-stock-alert-active' : 'btn-serene-secondary' %> d-inline-flex align-items-center gap-2 shadow-xs" 
                data-bs-toggle="modal" 
                data-bs-target="#stockAttentionModal" 
                title="<%= stats.kpis.lowStockCount > 0 ? stats.kpis.lowStockCount + ' materials low in stock!' : 'All stock levels healthy' %>">
          <i class="bi <%= stats.kpis.lowStockCount > 0 ? 'bi-exclamation-triangle-fill text-danger' : 'bi-shield-check text-success' %>"></i>
          <span class="fw-semibold">Stock Attention</span>
          <span class="badge <%= stats.kpis.lowStockCount > 0 ? 'bg-danger text-white' : 'bg-light text-muted border' %> rounded-pill px-2 py-0" style="font-size: 0.72rem;">
            <%= stats.kpis.lowStockCount %>
          </span>
        </button>

        <!-- Recent Stock Movements Icon Button -->
        <button class="btn btn-sm btn-serene-secondary d-inline-flex align-items-center gap-2 shadow-xs" 
                data-bs-toggle="modal" 
                data-bs-target="#recentMovementsModal" 
                title="View recent inventory ins & outs">
          <i class="bi bi-arrow-left-right text-muted"></i>
          <span class="fw-medium">Stock Movements</span>
          <% if (stats.recentTransactions && stats.recentTransactions.length > 0) { %>
            <span class="badge bg-secondary-subtle text-secondary rounded-pill px-2 py-0" style="font-size: 0.72rem;">
              <%= stats.recentTransactions.length %>
            </span>
          <% } %>
        </button>
      </div>

      <!-- Right: Primary Actions & Shortcuts -->
      <div class="d-flex flex-wrap align-items-center gap-2">
        <!-- Direct Quick Transaction (No customer profile required) -->
        <button class="btn btn-sm btn-success text-white fw-semibold shadow-xs" data-bs-toggle="modal" data-bs-target="#quickTransactionModal">
          <i class="bi bi-lightning-charge-fill me-1"></i> Quick Transaction
        </button>

        <!-- Express Quick Print -->
        <a href="/quick-print" class="btn btn-sm btn-serene-secondary">
          <i class="bi bi-qr-code-scan text-serene-primary me-1"></i> Quick Print
        </a>

        <!-- New Order -->
        <a href="/orders/new" class="btn btn-sm btn-serene-primary">
          <i class="bi bi-plus-lg"></i> New Order
        </a>

        <!-- Stock Actions -->
        <button class="btn btn-sm btn-serene-secondary" data-bs-toggle="modal" data-bs-target="#stockInModal">
          <i class="bi bi-box-arrow-in-down text-success"></i> Stock In
        </button>
        <button class="btn btn-sm btn-serene-secondary" data-bs-toggle="modal" data-bs-target="#stockOutModal">
          <i class="bi bi-box-arrow-up text-danger"></i> Stock Out
        </button>
        <button class="btn btn-sm btn-warning text-dark fw-semibold" data-bs-toggle="modal" data-bs-target="#officeUseModal">
          <i class="bi bi-building-down me-1"></i> Office Use
        </button>
      </div>
    </div>

    <!-- Row 3: 4 Redesigned Compact Modern KPI Cards -->
    <div class="row g-2 g-md-3 mb-4">
      <!-- 1. Active Queue -->
      <div class="col-6 col-lg-3">
        <a href="/orders?status=PRINTING" class="text-decoration-none">
          <div class="kpi-card-compact">
            <div class="kpi-compact-content">
              <div class="kpi-compact-label">
                <span>Active Queue</span>
              </div>
              <div class="kpi-compact-num text-serene-primary tabular-nums">
                <%= stats.kpis.activeOrdersCount %>
              </div>
              <div class="kpi-compact-sub">
                <span class="status-dot" style="background:#2d6a68;"></span> Active orders
              </div>
            </div>
            <div class="kpi-icon-chip" style="background: #e6f0ef; color: #2d6a68;">
              <i class="bi bi-hourglass-split"></i>
            </div>
          </div>
        </a>
      </div>

      <!-- 2. Orders Today -->
      <div class="col-6 col-lg-3">
        <a href="/orders" class="text-decoration-none">
          <div class="kpi-card-compact">
            <div class="kpi-compact-content">
              <div class="kpi-compact-label">
                <span>Orders Today</span>
              </div>
              <div class="kpi-compact-num text-dark tabular-nums">
                <%= stats.kpis.todayOrdersCount %>
              </div>
              <div class="kpi-compact-sub">
                <i class="bi bi-calendar-check text-muted"></i> Today's intake
              </div>
            </div>
            <div class="kpi-icon-chip" style="background: #f1f5f9; color: #334155;">
              <i class="bi bi-calendar2-week"></i>
            </div>
          </div>
        </a>
      </div>

      <!-- 3. Completed -->
      <div class="col-6 col-lg-3">
        <a href="/orders?status=COMPLETED" class="text-decoration-none">
          <div class="kpi-card-compact">
            <div class="kpi-compact-content">
              <div class="kpi-compact-label">
                <span>Completed</span>
              </div>
              <div class="kpi-compact-num text-success tabular-nums">
                <%= stats.kpis.completedOrdersCount %>
              </div>
              <div class="kpi-compact-sub">
                <i class="bi bi-check2-circle text-success"></i> Finished jobs
              </div>
            </div>
            <div class="kpi-icon-chip" style="background: #edf7ed; color: #16a34a;">
              <i class="bi bi-check-circle-fill"></i>
            </div>
          </div>
        </a>
      </div>

      <!-- 4. Low Stock (Clickable to open Stock Attention Modal) -->
      <div class="col-6 col-lg-3">
        <div class="kpi-card-compact <%= stats.kpis.lowStockCount > 0 ? 'border-danger-subtle' : '' %>" 
             data-bs-toggle="modal" 
             data-bs-target="#stockAttentionModal" 
             style="cursor: pointer;"
             title="Click to view Stock Attention details">
          <div class="kpi-compact-content">
            <div class="kpi-compact-label">
              <span>Low Stock</span>
            </div>
            <div class="kpi-compact-num <%= stats.kpis.lowStockCount > 0 ? 'text-danger' : 'text-success' %> tabular-nums">
              <%= stats.kpis.lowStockCount %>
            </div>
            <div class="kpi-compact-sub <%= stats.kpis.lowStockCount > 0 ? 'text-danger fw-semibold' : '' %>">
              <% if (stats.kpis.lowStockCount > 0) { %>
                <i class="bi bi-exclamation-triangle"></i> Needs reorder
              <% } else if (stats.kpis.totalStockItems === 0) { %>
                <i class="bi bi-info-circle"></i> No materials
              <% } else { %>
                <i class="bi bi-shield-check text-success"></i> Stock adequate
              <% } %>
            </div>
          </div>
          <div class="kpi-icon-chip <%= stats.kpis.lowStockCount > 0 ? 'bg-danger-subtle text-danger' : 'bg-light text-muted' %>">
            <i class="bi <%= stats.kpis.lowStockCount > 0 ? 'bi-exclamation-triangle-fill' : 'bi-boxes' %>"></i>
          </div>
        </div>
      </div>
    </div>

    <!-- Row 4: End-of-Day Business & Financial Summary (Daily Money Values, Prices, & Ledgers) -->
    <div class="serene-card mb-4" id="dailyBusinessCard" style="border: 1px solid #cbd5e1; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.06);">
      <div class="serene-card-header d-flex flex-wrap align-items-center justify-content-between gap-3" style="background: linear-gradient(180deg, #f8fafc 0%, #f1f5f9 100%); border-bottom: 1px solid var(--serene-border);">
        <div>
          <div class="d-flex align-items-center gap-2">
            <div class="p-2 rounded-3 bg-primary-subtle text-primary d-flex align-items-center justify-content-center">
              <i class="bi bi-wallet2 fs-5"></i>
            </div>
            <div>
              <div class="d-flex align-items-center gap-2">
                <h3 class="serene-card-title mb-0 fs-5 fw-bold text-dark">
                  End-of-Day Business & Financial Ledger
                </h3>
                <% if (stats.dailyBusiness.isToday) { %>
                  <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-0" style="font-size: 0.72rem;">Today's Live</span>
                <% } else { %>
                  <span class="badge bg-secondary-subtle text-secondary border px-2 py-0" style="font-size: 0.72rem;">Historical Archive</span>
                <% } %>
              </div>
              <div class="text-muted small mt-1">
                Audit of daily money values, counter collections, customer orders, office consumables, and inventory restocks for <strong><%= stats.dailyBusiness.formattedDate %></strong>
              </div>
            </div>
          </div>
        </div>

        <!-- Date Picker & Print Slip Controls -->
        <div class="d-flex flex-wrap align-items-center gap-2">
          <div class="input-group input-group-sm" style="max-width: 200px;">
            <span class="input-group-text bg-white"><i class="bi bi-calendar3"></i></span>
            <input type="date" class="form-control" value="<%= stats.dailyBusiness.date %>" onchange="window.location.href='/dashboard?date=' + this.value" title="Select audit date">
          </div>
          <% if (!stats.dailyBusiness.isToday) { %>
            <a href="/dashboard" class="btn btn-sm btn-outline-secondary">
              <i class="bi bi-arrow-counterclockwise"></i> Jump to Today
            </a>
          <% } %>
          <button type="button" class="btn btn-sm btn-serene-secondary d-inline-flex align-items-center gap-1 shadow-xs" onclick="window.printDayEndSlip()">
            <i class="bi bi-printer text-muted"></i> Print Day Slip
          </button>
        </div>
      </div>

      <!-- Financial Metric Cards Ribbon -->
      <div class="p-3 border-bottom" style="background: #ffffff;">
        <div class="row g-2 g-md-3">
          <!-- Metric 1: Total Cash/Money Collected Today -->
          <div class="col-6 col-lg-3">
            <div class="p-3 rounded-3 border h-100" style="background: #f0fdf4; border-color: #bbf7d0 !important;">
              <div class="d-flex justify-content-between align-items-start mb-1">
                <span class="small fw-semibold text-success">Total Money Collected</span>
                <span class="badge bg-success text-white" style="font-size: 0.68rem;">Cash Inflow</span>
              </div>
              <div class="fs-4 fw-bold text-success tabular-nums">
                <%= currencySymbol %> <%= stats.dailyBusiness.totalCollectedToday.toLocaleString('en-LK', { minimumFractionDigits: 2 }) %>
              </div>
              <div class="small text-muted mt-1" style="font-size: 0.75rem;">
                POS Sales: <%= currencySymbol %> <%= stats.dailyBusiness.posTotalRevenue.toFixed(2) %><br>
                Order Advances: <%= currencySymbol %> <%= stats.dailyBusiness.ordersAdvanceCollected.toFixed(2) %>
              </div>
            </div>
          </div>

          <!-- Metric 2: Total Business Booked -->
          <div class="col-6 col-lg-3">
            <div class="p-3 rounded-3 border h-100" style="background: #f8fafc; border-color: #e2e8f0 !important;">
              <div class="d-flex justify-content-between align-items-start mb-1">
                <span class="small fw-semibold text-dark">Total Business Booked</span>
                <span class="badge bg-light text-dark border" style="font-size: 0.68rem;">Gross Value</span>
              </div>
              <div class="fs-4 fw-bold text-dark tabular-nums">
                <%= currencySymbol %> <%= stats.dailyBusiness.totalBusinessBookedToday.toLocaleString('en-LK', { minimumFractionDigits: 2 }) %>
              </div>
              <div class="small text-muted mt-1" style="font-size: 0.75rem;">
                POS: <%= currencySymbol %> <%= stats.dailyBusiness.posTotalRevenue.toFixed(2) %> (<%= stats.dailyBusiness.posSalesCount %>)<br>
                Orders: <%= currencySymbol %> <%= stats.dailyBusiness.ordersTotalValue.toFixed(2) %> (<%= stats.dailyBusiness.ordersCount %>)
              </div>
            </div>
          </div>

          <!-- Metric 3: Office Consumable Overhead Expense -->
          <div class="col-6 col-lg-3">
            <div class="p-3 rounded-3 border h-100" style="background: #fffbeb; border-color: #fde68a !important;">
              <div class="d-flex justify-content-between align-items-start mb-1">
                <span class="small fw-semibold text-warning-emphasis">Office Consumables</span>
                <span class="badge bg-warning text-dark" style="font-size: 0.68rem;">Internal Used</span>
              </div>
              <div class="fs-4 fw-bold text-danger tabular-nums">
                <%= currencySymbol %> <%= stats.dailyBusiness.officeUseTotalCost.toLocaleString('en-LK', { minimumFractionDigits: 2 }) %>
              </div>
              <div class="small text-muted mt-1" style="font-size: 0.75rem;">
                <%= stats.dailyBusiness.officeUseTotalQty %> units deducted<br>
                Across <%= stats.dailyBusiness.officeUseCount %> office usage records
              </div>
            </div>
          </div>

          <!-- Metric 4: Net Operating Cash Balance -->
          <div class="col-6 col-lg-3">
            <div class="p-3 rounded-3 border h-100" style="background: #faf5ff; border-color: #e9d5ff !important;">
              <div class="d-flex justify-content-between align-items-start mb-1">
                <span class="small fw-semibold" style="color: #6b21a8;">Net Operating Balance</span>
                <span class="badge" style="background: #f3e8ff; color: #6b21a8; font-size: 0.68rem;">Cash - Office</span>
              </div>
              <div class="fs-4 fw-bold tabular-nums" style="color: #6b21a8;">
                <%= currencySymbol %> <%= stats.dailyBusiness.netOperatingBalance.toLocaleString('en-LK', { minimumFractionDigits: 2 }) %>
              </div>
              <div class="small text-muted mt-1" style="font-size: 0.75rem;">
                Restocked: <%= currencySymbol %> <%= stats.dailyBusiness.stockInTotalCost.toFixed(2) %> (<%= stats.dailyBusiness.stockInCount %> in)<br>
                Orders Balance Due: <%= currencySymbol %> <%= stats.dailyBusiness.ordersBalanceDue.toFixed(2) %>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Navigation Tabs for Detailed Day-End Lists -->
      <div class="px-3 pt-2 border-bottom bg-light">
        <ul class="nav nav-tabs border-0" id="dailyLedgerTabs" role="tablist">
          <li class="nav-item" role="presentation">
            <button class="nav-link active fw-semibold small" id="daily-pos-tab" data-bs-toggle="tab" data-bs-target="#daily-pos-pane" type="button" role="tab">
              <i class="bi bi-cart-check me-1 text-primary"></i> POS Sales (<%= stats.dailyBusiness.posSalesCount %>)
            </button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link fw-semibold small" id="daily-orders-tab" data-bs-toggle="tab" data-bs-target="#daily-orders-pane" type="button" role="tab">
              <i class="bi bi-printer me-1 text-success"></i> Orders Booked (<%= stats.dailyBusiness.ordersCount %>)
            </button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link fw-semibold small" id="daily-office-tab" data-bs-toggle="tab" data-bs-target="#daily-office-pane" type="button" role="tab">
              <i class="bi bi-building-down me-1 text-warning"></i> Office Use Taken (<%= stats.dailyBusiness.officeUseCount %>)
            </button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link fw-semibold small" id="daily-stock-tab" data-bs-toggle="tab" data-bs-target="#daily-stock-pane" type="button" role="tab">
              <i class="bi bi-box-arrow-in-down me-1 text-info"></i> Stock In Arrivals (<%= stats.dailyBusiness.stockInCount %>)
            </button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link fw-semibold small" id="daily-slip-tab" data-bs-toggle="tab" data-bs-target="#daily-slip-pane" type="button" role="tab">
              <i class="bi bi-file-earmark-spreadsheet me-1 text-secondary"></i> Day-End Balance Sheet Slip
            </button>
          </li>
        </ul>
      </div>

      <!-- Tab Panes Content -->
      <div class="tab-content" id="dailyLedgerTabContent">
        <!-- 1. POS Sales Pane -->
        <div class="tab-pane fade show active p-0" id="daily-pos-pane" role="tabpanel">
          <% if (stats.dailyBusiness.todayPosSales && stats.dailyBusiness.todayPosSales.length > 0) { %>
            <div class="table-responsive">
              <table class="serene-table mb-0">
                <thead>
                  <tr>
                    <th>Receipt #</th>
                    <th>Operator / Staff</th>
                    <th>Goods / Items Sold</th>
                    <th>Customer Profile</th>
                    <th>Payment Method</th>
                    <th>Total Paid</th>
                  </tr>
                </thead>
                <tbody>
                  <% stats.dailyBusiness.todayPosSales.forEach(s => { %>
                    <tr>
                      <td>
                        <span class="font-monospace fw-bold text-dark"><%= s.receiptNumber %></span>
                        <div class="text-muted small"><%= formatTime(s.createdAt) %></div>
                      </td>
                      <td>
                        <% if (s.cashier) { %>
                          <span class="fw-medium text-dark"><%= s.cashier.fullName || s.cashier.name || s.cashier.username %></span>
                          <div>
                            <% if (s.cashier.role === 'ADMIN') { %>
                              <span class="badge bg-primary-subtle text-primary border border-primary-subtle" style="font-size: 0.68rem;">Owner/Admin</span>
                            <% } else { %>
                              <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle" style="font-size: 0.68rem;">Store Worker</span>
                            <% } %>
                          </div>
                        <% } else { %>
                          <span class="text-muted small">Store Staff</span>
                        <% } %>
                      </td>
                      <td>
                        <% if (s.items && s.items.length > 0) { %>
                          <% s.items.forEach(it => { %>
                            <div class="d-flex align-items-center gap-1 mb-1">
                              <span class="fw-semibold text-dark"><%= it.itemName %></span>
                              <span class="badge bg-light text-dark border font-monospace" style="font-size: 0.72rem;">
                                <%= parseFloat(it.quantity) %> &times; <%= currencySymbol %> <%= parseFloat(it.unitPrice).toFixed(2) %>
                              </span>
                            </div>
                          <% }) %>
                        <% } else { %>
                          <span class="text-muted small"><%= s.notes || 'Counter Sale Item' %></span>
                        <% } %>
                      </td>
                      <td>
                        <% if (!s.customerId || (s.customerName && s.customerName.includes('Walk-in'))) { %>
                          <span class="badge bg-light text-secondary border" style="font-size: 0.75rem;">
                            <i class="bi bi-person-slash me-1"></i> Walk-in (No Profile)
                          </span>
                        <% } else { %>
                          <span class="text-dark fw-medium"><%= s.customerName %></span>
                          <% if (s.customerPhone) { %><div class="text-muted small"><%= s.customerPhone %></div><% } %>
                        <% } %>
                      </td>
                      <td>
                        <span class="badge bg-light text-dark border">
                          <i class="bi <%= s.paymentMethod === 'CASH' ? 'bi-cash text-success' : (s.paymentMethod === 'CARD' ? 'bi-credit-card text-primary' : 'bi-bank text-info') %> me-1"></i>
                          <%= s.paymentMethod %>
                        </span>
                      </td>
                      <td class="tabular-nums fw-bold text-success fs-6">
                        <%= currencySymbol %> <%= parseFloat(s.totalAmount).toLocaleString('en-LK', { minimumFractionDigits: 2 }) %>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
                <tfoot class="table-light">
                  <tr>
                    <th colspan="3" class="text-end">Payment Breakdown:</th>
                    <th colspan="2">
                      <span class="badge bg-success-subtle text-success me-2">Cash: <%= currencySymbol %> <%= stats.dailyBusiness.posCashTotal.toFixed(2) %></span>
                      <span class="badge bg-primary-subtle text-primary me-2">Card: <%= currencySymbol %> <%= stats.dailyBusiness.posCardTotal.toFixed(2) %></span>
                      <span class="badge bg-info-subtle text-info">Bank: <%= currencySymbol %> <%= stats.dailyBusiness.posBankTransferTotal.toFixed(2) %></span>
                    </th>
                    <th class="tabular-nums fw-bold text-success fs-6"><%= currencySymbol %> <%= stats.dailyBusiness.posTotalRevenue.toLocaleString('en-LK', { minimumFractionDigits: 2 }) %></th>
                  </tr>
                </tfoot>
              </table>
            </div>
          <% } else { %>
            <div class="text-center py-4 text-muted small">No POS counter sales recorded on <%= stats.dailyBusiness.formattedDate %>.</div>
          <% } %>
        </div>

        <!-- 2. Orders Pane -->
        <div class="tab-pane fade p-0" id="daily-orders-pane" role="tabpanel">
          <% if (stats.dailyBusiness.todayOrders && stats.dailyBusiness.todayOrders.length > 0) { %>
            <div class="table-responsive">
              <table class="serene-table mb-0">
                <thead>
                  <tr>
                    <th>Order #</th>
                    <th>Time</th>
                    <th>Customer</th>
                    <th>Job Title</th>
                    <th>Total Price</th>
                    <th>Advance Collected</th>
                    <th>Balance Due</th>
                    <th>Status</th>
                  </tr>
                </thead>
                <tbody>
                  <% stats.dailyBusiness.todayOrders.forEach(o => { %>
                    <tr>
                      <td class="font-monospace fw-bold">
                        <a href="/orders/<%= o.id %>" class="text-dark text-decoration-none hover-primary"><%= o.orderNumber %></a>
                      </td>
                      <td class="text-muted small"><%= formatTime(o.createdAt) %></td>
                      <td>
                        <span class="text-dark fw-medium"><%= o.customer ? o.customer.name : 'Unknown' %></span>
                      </td>
                      <td>
                        <div class="text-truncate text-dark fw-medium" style="max-width: 240px;"><%= o.jobTitle %> (<%= o.quantity %> qty)</div>
                      </td>
                      <td class="tabular-nums fw-semibold text-dark"><%= currencySymbol %> <%= parseFloat(o.totalAmount).toLocaleString('en-LK', { minimumFractionDigits: 2 }) %></td>
                      <td class="tabular-nums fw-bold text-success"><%= currencySymbol %> <%= parseFloat(o.advancePaid).toLocaleString('en-LK', { minimumFractionDigits: 2 }) %></td>
                      <td class="tabular-nums <%= parseFloat(o.balanceAmount) > 0 ? 'text-danger fw-semibold' : 'text-muted' %>">
                        <%= parseFloat(o.balanceAmount) > 0 ? currencySymbol + ' ' + parseFloat(o.balanceAmount).toLocaleString('en-LK', { minimumFractionDigits: 2 }) : 'Fully Paid' %>
                      </td>
                      <td>
                        <span class="status-badge status-<%= o.status.toLowerCase() %>">
                          <span class="status-dot"></span> <%= o.status.replace('_', ' ') %>
                        </span>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
                <tfoot class="table-light">
                  <tr>
                    <th colspan="4" class="text-end">Orders Booked Totals:</th>
                    <th class="tabular-nums fw-bold text-dark"><%= currencySymbol %> <%= stats.dailyBusiness.ordersTotalValue.toLocaleString('en-LK', { minimumFractionDigits: 2 }) %></th>
                    <th class="tabular-nums fw-bold text-success"><%= currencySymbol %> <%= stats.dailyBusiness.ordersAdvanceCollected.toLocaleString('en-LK', { minimumFractionDigits: 2 }) %></th>
                    <th class="tabular-nums fw-bold text-danger"><%= currencySymbol %> <%= stats.dailyBusiness.ordersBalanceDue.toLocaleString('en-LK', { minimumFractionDigits: 2 }) %></th>
                    <th></th>
                  </tr>
                </tfoot>
              </table>
            </div>
          <% } else { %>
            <div class="text-center py-4 text-muted small">No print orders received or registered on <%= stats.dailyBusiness.formattedDate %>.</div>
          <% } %>
        </div>

        <!-- 3. Office Use Pane -->
        <div class="tab-pane fade p-0" id="daily-office-pane" role="tabpanel">
          <% if (stats.dailyBusiness.todayOfficeUseTransactions && stats.dailyBusiness.todayOfficeUseTransactions.length > 0) { %>
            <div class="table-responsive">
              <table class="serene-table mb-0">
                <thead>
                  <tr>
                    <th>Time</th>
                    <th>Material Consumed</th>
                    <th>Qty Taken</th>
                    <th>Department / Section</th>
                    <th>Unit Buying Cost</th>
                    <th>Total Office Expense</th>
                    <th>Purpose / Notes</th>
                  </tr>
                </thead>
                <tbody>
                  <% stats.dailyBusiness.todayOfficeUseTransactions.forEach(tx => { %>
                    <% const txCost = parseFloat(tx.totalCost) || (parseFloat(tx.quantity) * (parseFloat(tx.unitCost) || 0)); %>
                    <tr>
                      <td class="text-muted small"><%= formatTime(tx.createdAt) %></td>
                      <td>
                        <span class="fw-bold text-dark"><%= tx.stockItem ? tx.stockItem.name : 'Unknown Item' %></span>
                        <% if (tx.stockItem && tx.stockItem.code) { %>
                          <span class="badge bg-light text-muted border font-monospace ms-1"><%= tx.stockItem.code %></span>
                        <% } %>
                      </td>
                      <td>
                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle fw-bold fs-6 tabular-nums">
                          <%= parseFloat(tx.quantity) %> <%= tx.stockItem ? tx.stockItem.unit : '' %>
                        </span>
                      </td>
                      <td>
                        <span class="badge bg-light text-dark border">
                          <i class="bi bi-building me-1"></i><%= tx.reference.replace('Office Use: ', '') %>
                        </span>
                      </td>
                      <td class="tabular-nums small text-muted"><%= currencySymbol %> <%= parseFloat(tx.unitCost || 0).toFixed(2) %></td>
                      <td class="tabular-nums fw-bold text-danger"><%= currencySymbol %> <%= txCost.toLocaleString('en-LK', { minimumFractionDigits: 2 }) %></td>
                      <td class="small text-muted fst-italic"><%= tx.notes || '-' %></td>
                    </tr>
                  <% }) %>
                </tbody>
                <tfoot class="table-light">
                  <tr>
                    <th colspan="2" class="text-end">Total Office Consumable Deductions:</th>
                    <th><span class="badge bg-warning text-dark"><%= stats.dailyBusiness.officeUseTotalQty %> Units</span></th>
                    <th colspan="2"></th>
                    <th class="tabular-nums fw-bold text-danger fs-6"><%= currencySymbol %> <%= stats.dailyBusiness.officeUseTotalCost.toLocaleString('en-LK', { minimumFractionDigits: 2 }) %></th>
                    <th></th>
                  </tr>
                </tfoot>
              </table>
            </div>
          <% } else { %>
            <div class="text-center py-4 text-muted small">No materials were deducted for internal office use on <%= stats.dailyBusiness.formattedDate %>.</div>
          <% } %>
        </div>

        <!-- 4. Stock In Pane -->
        <div class="tab-pane fade p-0" id="daily-stock-pane" role="tabpanel">
          <% if (stats.dailyBusiness.todayStockInTransactions && stats.dailyBusiness.todayStockInTransactions.length > 0) { %>
            <div class="table-responsive">
              <table class="serene-table mb-0">
                <thead>
                  <tr>
                    <th>Time</th>
                    <th>Material Arrived</th>
                    <th>Quantity Added</th>
                    <th>Buying Unit Cost</th>
                    <th>Total Restock Value</th>
                    <th>Supplier / Invoice Ref</th>
                  </tr>
                </thead>
                <tbody>
                  <% stats.dailyBusiness.todayStockInTransactions.forEach(tx => { %>
                    <% const inCost = parseFloat(tx.totalCost) || (parseFloat(tx.quantity) * (parseFloat(tx.unitCost) || 0)); %>
                    <tr>
                      <td class="text-muted small"><%= formatTime(tx.createdAt) %></td>
                      <td>
                        <span class="fw-bold text-dark"><%= tx.stockItem ? tx.stockItem.name : 'Unknown Item' %></span>
                      </td>
                      <td>
                        <span class="badge bg-success-subtle text-success border border-success-subtle fw-bold fs-6 tabular-nums">
                          +<%= parseFloat(tx.quantity) %> <%= tx.stockItem ? tx.stockItem.unit : '' %>
                        </span>
                      </td>
                      <td class="tabular-nums small text-muted"><%= currencySymbol %> <%= parseFloat(tx.unitCost || 0).toFixed(2) %></td>
                      <td class="tabular-nums fw-bold text-dark"><%= currencySymbol %> <%= inCost.toLocaleString('en-LK', { minimumFractionDigits: 2 }) %></td>
                      <td class="small text-muted"><%= tx.reference || '-' %></td>
                    </tr>
                  <% }) %>
                </tbody>
                <tfoot class="table-light">
                  <tr>
                    <th colspan="2" class="text-end">Total Restock Cost:</th>
                    <th><span class="badge bg-success text-white"><%= stats.dailyBusiness.stockInTotalQty %> Units</span></th>
                    <th></th>
                    <th class="tabular-nums fw-bold text-dark fs-6"><%= currencySymbol %> <%= stats.dailyBusiness.stockInTotalCost.toLocaleString('en-LK', { minimumFractionDigits: 2 }) %></th>
                    <th></th>
                  </tr>
                </tfoot>
              </table>
            </div>
          <% } else { %>
            <div class="text-center py-4 text-muted small">No new stock arrivals recorded on <%= stats.dailyBusiness.formattedDate %>.</div>
          <% } %>
        </div>

        <!-- 5. Day-End Balance Sheet Slip Pane -->
        <div class="tab-pane fade p-4" id="daily-slip-pane" role="tabpanel">
          <div class="mx-auto p-4 rounded-3 border bg-white shadow-xs" id="dayEndSlipPrintArea" style="max-width: 650px;">
            <div class="text-center border-bottom pb-3 mb-3">
              <h5 class="fw-bold mb-1 text-dark">NIRMANA PRINTING & ADVERTISING</h5>
              <div class="text-muted small">Daily End-of-Day Business & Financial Reconciliation Slip</div>
              <div class="badge bg-light text-dark border font-monospace mt-1">Audit Date: <%= stats.dailyBusiness.formattedDate %></div>
            </div>

            <div class="row g-3 mb-3">
              <div class="col-6">
                <div class="small text-muted">Generated By:</div>
                <div class="fw-bold text-dark"><%= locals.currentUser ? (locals.currentUser.fullName || locals.currentUser.name || locals.currentUser.username) : 'Administrator' %> (<%= locals.currentUser ? locals.currentUser.role : 'ADMIN' %>)</div>
              </div>
              <div class="col-6 text-end">
                <div class="small text-muted">Slip Timestamp:</div>
                <div class="fw-medium text-dark font-monospace"><%= formatDateTime(new Date()) %></div>
              </div>
            </div>

            <table class="table table-sm table-bordered align-middle mb-3" style="font-size: 0.88rem;">
              <thead class="table-light">
                <tr>
                  <th>Financial Ledger Account</th>
                  <th class="text-center">Count / Qty</th>
                  <th class="text-end">Amount (<%= currencySymbol %>)</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><i class="bi bi-cart me-2 text-primary"></i> POS Counter Sales (Gross)</td>
                  <td class="text-center font-monospace"><%= stats.dailyBusiness.posSalesCount %></td>
                  <td class="text-end fw-semibold tabular-nums"><%= stats.dailyBusiness.posTotalRevenue.toFixed(2) %></td>
                </tr>
                <tr>
                  <td class="ps-4 text-muted small">&bull; Cash Collected</td>
                  <td class="text-center text-muted small">-</td>
                  <td class="text-end tabular-nums small"><%= stats.dailyBusiness.posCashTotal.toFixed(2) %></td>
                </tr>
                <tr>
                  <td class="ps-4 text-muted small">&bull; Card / Digital Payments</td>
                  <td class="text-center text-muted small">-</td>
                  <td class="text-end tabular-nums small"><%= stats.dailyBusiness.posCardTotal.toFixed(2) %></td>
                </tr>
                <tr>
                  <td class="ps-4 text-muted small">&bull; Bank Transfers</td>
                  <td class="text-center text-muted small">-</td>
                  <td class="text-end tabular-nums small"><%= stats.dailyBusiness.posBankTransferTotal.toFixed(2) %></td>
                </tr>
                <tr>
                  <td><i class="bi bi-printer me-2 text-success"></i> Print Order Advance Collections</td>
                  <td class="text-center font-monospace"><%= stats.dailyBusiness.ordersCount %></td>
                  <td class="text-end fw-semibold tabular-nums"><%= stats.dailyBusiness.ordersAdvanceCollected.toFixed(2) %></td>
                </tr>
                <tr class="table-success fw-bold">
                  <td>TOTAL MONEY & REVENUE COLLECTED</td>
                  <td class="text-center font-monospace"><%= stats.dailyBusiness.posSalesCount + stats.dailyBusiness.ordersCount %></td>
                  <td class="text-end tabular-nums fs-6"><%= currencySymbol %> <%= stats.dailyBusiness.totalCollectedToday.toFixed(2) %></td>
                </tr>
                <tr>
                  <td><i class="bi bi-building-down me-2 text-warning"></i> Internal Office Consumables Expense</td>
                  <td class="text-center font-monospace"><%= stats.dailyBusiness.officeUseTotalQty %> units</td>
                  <td class="text-end fw-semibold text-danger tabular-nums">- <%= stats.dailyBusiness.officeUseTotalCost.toFixed(2) %></td>
                </tr>
                <tr class="table-light">
                  <td><i class="bi bi-box-arrow-in-down me-2 text-info"></i> Inventory Stock Restock Purchases</td>
                  <td class="text-center font-monospace"><%= stats.dailyBusiness.stockInTotalQty %> units</td>
                  <td class="text-end fw-semibold text-dark tabular-nums"><%= stats.dailyBusiness.stockInTotalCost.toFixed(2) %></td>
                </tr>
                <tr style="background: #faf5ff; font-weight: 700;">
                  <td style="color: #6b21a8;">NET DAILY OPERATING CASH BALANCE</td>
                  <td class="text-center">-</td>
                  <td class="text-end tabular-nums fs-6" style="color: #6b21a8;"><%= currencySymbol %> <%= stats.dailyBusiness.netOperatingBalance.toFixed(2) %></td>
                </tr>
              </tbody>
            </table>

            <div class="d-flex justify-content-between pt-4 mt-3 border-top text-center text-muted small">
              <div style="width: 160px; border-top: 1px dashed #94a3b8; padding-top: 4px;">Cashier / Staff Signature</div>
              <div style="width: 160px; border-top: 1px dashed #94a3b8; padding-top: 4px;">Owner / Manager Approval</div>
            </div>

            <div class="text-center mt-3 pt-2">
              <button class="btn btn-sm btn-serene-primary" onclick="window.printDayEndSlip()">
                <i class="bi bi-printer me-1"></i> Print This Daily Summary Slip
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Row 5: Full-Width Spacious Recent Orders Table -->
    <div class="row g-4">
      <div class="col-12">
        <div class="serene-card">
          <div class="serene-card-header d-flex flex-wrap align-items-center justify-content-between gap-2">
            <div>
              <h3 class="serene-card-title mb-0">
                <i class="bi bi-clipboard2-check me-2 text-serene-primary"></i> Recent Printing Orders
              </h3>
              <div class="text-muted small mt-1">Live overview of recent customer orders, production status, and balances</div>
            </div>
            <div class="d-flex align-items-center gap-2">
              <a href="/orders/new" class="btn btn-sm btn-serene-primary">
                <i class="bi bi-plus-lg"></i> New Order
              </a>
              <a href="/orders" class="btn btn-sm btn-serene-secondary">
                All Orders &rarr;
              </a>
            </div>
          </div>
          <div class="table-responsive">
            <table class="serene-table">
              <thead>
                <tr>
                  <th>Order #</th>
                  <th>Customer</th>
                  <th>Job Description</th>
                  <th>Order Date</th>
                  <th>Amount & Balance</th>
                  <th>Status</th>
                  <th class="text-end">Action</th>
                </tr>
              </thead>
              <tbody>
                <% if (stats.recentOrders && stats.recentOrders.length > 0) { %>
                  <% stats.recentOrders.forEach(order => { %>
                    <tr>
                      <td>
                        <a href="/orders/<%= order.id %>" class="fw-bold text-decoration-none text-dark font-monospace">
                          <%= order.orderNumber %>
                        </a>
                      </td>
                      <td>
                        <div class="fw-semibold text-dark"><%= order.customer ? order.customer.name : 'Walk-in / Unknown' %></div>
                        <% if (order.customer && order.customer.phone) { %>
                          <div class="text-muted small"><i class="bi bi-telephone text-muted me-1"></i><%= order.customer.phone %></div>
                        <% } %>
                      </td>
                      <td>
                        <div class="text-dark fw-medium text-truncate" style="max-width: 280px;" title="<%= order.jobTitle %>">
                          <%= order.jobTitle %>
                        </div>
                      </td>
                      <td>
                        <div class="text-muted small tabular-nums">
                          <%= order.orderDate ? formatDate(order.orderDate) : formatDate(order.createdAt) %>
                        </div>
                      </td>
                      <td>
                        <div class="tabular-nums fw-bold text-dark">
                          <%= currencySymbol %> <%= parseFloat(order.totalAmount).toLocaleString('en-LK', { minimumFractionDigits: 2 }) %>
                        </div>
                        <% if (parseFloat(order.balanceAmount) <= 0) { %>
                          <span class="badge bg-success-subtle text-success border border-success-subtle mt-1" style="font-size: 0.72rem;">Paid</span>
                        <% } else { %>
                          <div class="text-danger small fw-semibold mt-1">
                            Due: <%= currencySymbol %> <%= parseFloat(order.balanceAmount).toLocaleString('en-LK', { minimumFractionDigits: 2 }) %>
                          </div>
                        <% } %>
                      </td>
                      <td>
                        <span class="status-badge status-<%= order.status.toLowerCase() %>">
                          <span class="status-dot"></span> <%= order.status.replace('_', ' ') %>
                        </span>
                      </td>
                      <td class="text-end">
                        <a href="/orders/<%= order.id %>" class="btn btn-sm btn-serene-secondary py-1 px-3 d-inline-flex align-items-center gap-1 shadow-xs" title="View Details">
                          <i class="bi bi-eye"></i> View
                        </a>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr>
                    <td colspan="7" class="text-center py-5 text-muted">No orders recorded yet.</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>

<!-- ========================================================================= -->
<!-- POP-UP MODAL: STOCK ATTENTION & LOW INVENTORY ALERTS -->
<!-- ========================================================================= -->
<div class="modal fade" id="stockAttentionModal" tabindex="-1" aria-labelledby="stockAttentionModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content shadow-lg border-0" style="border-radius: var(--serene-radius-lg);">
      <div class="modal-header py-3 px-4 border-bottom" style="background: #fafbfc;">
        <div class="d-flex align-items-center gap-2">
          <div class="p-2 rounded-2 <%= stats.kpis.lowStockCount > 0 ? 'bg-danger-subtle text-danger' : 'bg-success-subtle text-success' %> d-flex align-items-center justify-content-center">
            <i class="bi <%= stats.kpis.lowStockCount > 0 ? 'bi-exclamation-triangle-fill fs-5' : 'bi-shield-check fs-5' %>"></i>
          </div>
          <div>
            <h5 class="modal-title fw-bold fs-6 mb-0 text-dark" id="stockAttentionModalLabel">Stock Attention & Low Inventory Alerts</h5>
            <div class="text-muted small">Materials that have dropped to or below minimum reorder thresholds</div>
          </div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <div class="modal-body p-4">
        <% if (stats.lowStockItems && stats.lowStockItems.length > 0) { %>
          <div class="alert alert-danger d-flex align-items-center gap-2 py-2 px-3 mb-3 border-danger-subtle" style="font-size: 0.84rem;">
            <i class="bi bi-exclamation-circle-fill fs-5 flex-shrink-0"></i>
            <div>
              <strong><%= stats.lowStockItems.length %> material<%= stats.lowStockItems.length > 1 ? 's need' : ' needs' %> replenishment immediately</strong> to avoid printing disruptions.
            </div>
          </div>

          <div class="table-responsive border rounded-3 bg-white">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.86rem;">
              <thead class="table-light">
                <tr>
                  <th>Material / Item</th>
                  <th>Current Stock</th>
                  <th>Min Alert</th>
                  <th>Deficit</th>
                  <th class="text-end">Quick Action</th>
                </tr>
              </thead>
              <tbody>
                <% stats.lowStockItems.forEach(item => { %>
                  <tr>
                    <td>
                      <div class="fw-bold text-dark"><%= item.name %></div>
                      <div class="text-muted small font-monospace"><%= item.code || 'NO-CODE' %></div>
                    </td>
                    <td>
                      <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1 fw-bold fs-6 tabular-nums">
                        <%= parseFloat(item.currentStock) %> <%= item.unit %>
                      </span>
                    </td>
                    <td>
                      <span class="text-muted tabular-nums">
                        <%= parseFloat(item.minStockAlert) %> <%= item.unit %>
                      </span>
                    </td>
                    <td>
                      <% const diff = parseFloat(item.currentStock) - parseFloat(item.minStockAlert); %>
                      <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle tabular-nums">
                        <%= diff < 0 ? diff.toFixed(1) : '0' %> <%= item.unit %>
                      </span>
                    </td>
                    <td class="text-end">
                      <% const deficit = diff < 0 ? Math.abs(diff) : 0; %>
                      <button class="btn btn-sm btn-success py-1 px-3 d-inline-flex align-items-center gap-1 shadow-xs" 
                              onclick="triggerQuickStockInFromModal(<%= item.id %>, <%= deficit %>, '<%= escape(item.name) %>')">
                        <i class="bi bi-plus-circle"></i> Add Stock
                      </button>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } else if (stats.allStockItems && stats.allStockItems.length === 0) { %>
          <div class="text-center py-5">
            <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-light text-muted mb-3" style="width: 60px; height: 60px;">
              <i class="bi bi-box-seam fs-2"></i>
            </div>
            <h6 class="fw-bold mb-1">No Materials Registered Yet</h6>
            <p class="text-muted small mb-3">Add your printing papers, inks, and substrates to enable stock monitoring.</p>
            <a href="/stock" class="btn btn-serene-primary btn-sm">Add Material to Stock</a>
          </div>
        <% } else { %>
          <div class="text-center py-5">
            <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-success-subtle text-success mb-3" style="width: 60px; height: 60px;">
              <i class="bi bi-check2-circle fs-2"></i>
            </div>
            <h6 class="fw-bold text-success mb-1">All Stock Levels Healthy</h6>
            <p class="text-muted small mb-0">Every registered material is currently above its minimum alert threshold. No action required!</p>
          </div>
        <% } %>
      </div>

      <div class="modal-footer border-top bg-light py-2 px-4 d-flex justify-content-between">
        <a href="/stock" class="btn btn-serene-ghost btn-sm">
          <i class="bi bi-boxes me-1"></i> Full Inventory Management &rarr;
        </a>
        <button type="button" class="btn btn-serene-secondary btn-sm px-3" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>

<!-- ========================================================================= -->
<!-- POP-UP MODAL: RECENT STOCK MOVEMENTS -->
<!-- ========================================================================= -->
<div class="modal fade" id="recentMovementsModal" tabindex="-1" aria-labelledby="recentMovementsModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content shadow-lg border-0" style="border-radius: var(--serene-radius-lg);">
      <div class="modal-header py-3 px-4 border-bottom" style="background: #fafbfc;">
        <div class="d-flex align-items-center gap-2">
          <div class="p-2 rounded-2 bg-light text-dark d-flex align-items-center justify-content-center">
            <i class="bi bi-arrow-left-right text-serene-primary fs-5"></i>
          </div>
          <div>
            <h5 class="modal-title fw-bold fs-6 mb-0 text-dark" id="recentMovementsModalLabel">Recent Stock Movements</h5>
            <div class="text-muted small">Audit log of inventory arrivals (Stock In) and production usages (Stock Out)</div>
          </div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <div class="modal-body p-4">
        <% if (stats.recentTransactions && stats.recentTransactions.length > 0) { %>
          <div class="table-responsive border rounded-3 bg-white">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.86rem;">
              <thead class="table-light">
                <tr>
                  <th>Type</th>
                  <th>Stock Item</th>
                  <th>Quantity</th>
                  <th>Reference / Source</th>
                  <th>Date & Time</th>
                </tr>
              </thead>
              <tbody>
                <% stats.recentTransactions.forEach(t => { %>
                  <tr>
                    <td>
                      <% if (t.type === 'IN') { %>
                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                          <i class="bi bi-box-arrow-in-down me-1"></i> Stock In
                        </span>
                      <% } else { %>
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">
                          <i class="bi bi-box-arrow-up me-1"></i> Stock Out
                        </span>
                      <% } %>
                    </td>
                    <td>
                      <div class="fw-bold text-dark"><%= t.stockItem ? t.stockItem.name : 'Item' %></div>
                      <% if (t.stockItem && t.stockItem.code) { %>
                        <div class="text-muted small font-monospace"><%= t.stockItem.code %></div>
                      <% } %>
                    </td>
                    <td>
                      <span class="fw-bold tabular-nums <%= t.type === 'IN' ? 'text-success' : 'text-danger' %>">
                        <%= t.type === 'IN' ? '+' : '-' %><%= parseFloat(t.quantity) %> <%= t.stockItem ? t.stockItem.unit : '' %>
                      </span>
                    </td>
                    <td>
                      <div class="text-dark small"><%= t.reference || (t.type === 'IN' ? 'Stock Arrival' : 'Job Usage') %></div>
                      <% if (t.notes) { %>
                        <div class="text-muted small fst-italic text-truncate" style="max-width: 220px;"><%= t.notes %></div>
                      <% } %>
                    </td>
                    <td class="text-muted small">
                      <%= formatDate(t.date || t.createdAt) %><br>
                      <%= formatTime(t.createdAt) %>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="text-center py-5 text-muted">
            <i class="bi bi-arrow-left-right display-6 d-block mb-2 text-muted opacity-50"></i>
            <h6 class="fw-bold mb-1">No Stock Movements Logged Yet</h6>
            <p class="small mb-0">Transactions will automatically record here as stock arrives or is consumed for jobs.</p>
          </div>
        <% } %>
      </div>

      <div class="modal-footer border-top bg-light py-2 px-4 d-flex justify-content-between">
        <a href="/stock" class="btn btn-serene-ghost btn-sm">
          <i class="bi bi-boxes me-1"></i> View Complete Stock Ledger &rarr;
        </a>
        <button type="button" class="btn btn-serene-secondary btn-sm px-3" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>

<script>
  window._preloadedStockItems = <%- JSON.stringify((stats.allStockItems || []).map(i => ({ id: i.id, name: i.name, code: i.code, unit: i.unit, currentStock: i.currentStock, unitCost: i.unitCost, sellingPrice: i.sellingPrice }))) %>;

  function triggerQuickStockInFromModal(itemId, suggestedQty, itemName) {
    const stockAttentionModalEl = document.getElementById('stockAttentionModal');
    const realItemName = itemName ? unescape(itemName) : null;
    if (stockAttentionModalEl) {
      const stockAttentionModal = bootstrap.Modal.getInstance(stockAttentionModalEl) || bootstrap.Modal.getOrCreateInstance(stockAttentionModalEl);
      let triggered = false;
      const doQuickStockIn = () => {
        if (triggered) return;
        triggered = true;
        stockAttentionModalEl.removeEventListener('hidden.bs.modal', doQuickStockIn);
        if (typeof window.quickStockIn === 'function') {
          window.quickStockIn(itemId, suggestedQty, realItemName);
        }
      };
      stockAttentionModalEl.addEventListener('hidden.bs.modal', doQuickStockIn, { once: true });
      stockAttentionModal.hide();
      setTimeout(doQuickStockIn, 250);
    } else {
      if (typeof window.quickStockIn === 'function') {
        window.quickStockIn(itemId, suggestedQty, realItemName);
      }
    }
  }

  window.printDayEndSlip = function() {
    const printArea = document.getElementById('dayEndSlipPrintArea');
    if (!printArea) {
      window.print();
      return;
    }
    const win = window.open('', '_blank', 'width=750,height=900');
    win.document.write(`
      <!DOCTYPE html>
      <html>
      <head>
        <title>Day-End Financial Slip - Nirmana Printing</title>
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
        <style>
          body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; padding: 24px; background: #fff; }
          .tabular-nums { font-variant-numeric: tabular-nums; }
          @media print {
            .btn { display: none !important; }
          }
        </style>
      </head>
      <body>
        ${printArea.outerHTML}
        <script>
          window.onload = function() {
            window.print();
          };
        <\/script>
      </body>
      </html>
    `);
    win.document.close();
  };
</script>

