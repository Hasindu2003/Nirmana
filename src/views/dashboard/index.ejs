<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<main class="main-wrapper">
  <div class="content-body">
    <!-- Header -->
    <div class="d-flex flex-wrap align-items-center justify-content-between mb-4">
      <div>
        <h2 class="fs-4 fw-bold mb-1">Print Shop Dashboard</h2>
        <div class="text-muted small">
          Today, <%= new Date().toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'short', day: 'numeric' }) %> &bull; Live Operations
        </div>
      </div>
      <div class="d-flex flex-wrap align-items-center gap-2 mt-3 mt-sm-0">
        <a href="/quick-print" class="btn btn-serene-secondary">
          <i class="bi bi-qr-code-scan text-primary me-1"></i> Quick Print (QR)
        </a>
        <a href="/orders/new" class="btn btn-serene-primary">
          <i class="bi bi-plus-lg"></i> New Order
        </a>
        <button class="btn btn-serene-secondary" data-bs-toggle="modal" data-bs-target="#stockInModal">
          <i class="bi bi-box-arrow-in-down text-success"></i> Stock In
        </button>
        <button class="btn btn-serene-secondary" data-bs-toggle="modal" data-bs-target="#stockOutModal">
          <i class="bi bi-box-arrow-up text-danger"></i> Stock Out
        </button>
      </div>
    </div>

    <!-- 4 KPI Cards (2x2 on mobile, 4 in row on desktop) -->
    <div class="row g-2 g-md-3 mb-4">
      <div class="col-6 col-md-6 col-xl-3">
        <div class="kpi-card">
          <div class="kpi-title">Active Queue</div>
          <div class="kpi-value text-primary tabular-nums"><%= stats.kpis.activeOrdersCount %></div>
          <div class="kpi-sub text-muted text-truncate">
            <span class="status-dot" style="background:#2d6a68;"></span> Active orders
          </div>
        </div>
      </div>

      <div class="col-6 col-md-6 col-xl-3">
        <div class="kpi-card">
          <div class="kpi-title">Orders Today</div>
          <div class="kpi-value tabular-nums"><%= stats.kpis.todayOrdersCount %></div>
          <div class="kpi-sub text-muted text-truncate">
            <i class="bi bi-calendar-event"></i> Today's intake
          </div>
        </div>
      </div>

      <div class="col-6 col-md-6 col-xl-3">
        <div class="kpi-card">
          <div class="kpi-title">Completed</div>
          <div class="kpi-value text-success tabular-nums"><%= stats.kpis.completedOrdersCount %></div>
          <div class="kpi-sub text-muted text-truncate">
            <i class="bi bi-check2-circle text-success"></i> Finished jobs
          </div>
        </div>
      </div>

      <div class="col-6 col-md-6 col-xl-3">
        <div class="kpi-card">
          <div class="kpi-title">Low Stock</div>
          <div class="kpi-value <%= stats.kpis.lowStockCount > 0 ? 'text-danger' : 'text-success' %> tabular-nums">
            <%= stats.kpis.lowStockCount %>
          </div>
          <div class="kpi-sub text-muted text-truncate">
            <% if (stats.kpis.lowStockCount > 0) { %>
              <span class="text-danger"><i class="bi bi-exclamation-triangle"></i> Materials need reordering</span>
            <% } else if (stats.kpis.totalStockItems === 0) { %>
              <span class="text-muted"><i class="bi bi-info-circle"></i> No materials registered</span>
            <% } else { %>
              <span class="text-success"><i class="bi bi-shield-check"></i> Stock levels adequate</span>
            <% } %>
          </div>
        </div>
      </div>
    </div>

    <!-- Main Content Grid -->
    <div class="row g-4">
      <!-- Left Column: Active Print Orders (7 cols) -->
      <div class="col-lg-7">
        <div class="serene-card">
          <div class="serene-card-header">
            <h3 class="serene-card-title"><i class="bi bi-clipboard2-check me-2 text-muted"></i> Recent Orders</h3>
            <a href="/orders" class="btn btn-serene-ghost py-1 px-2 small">All Orders &rarr;</a>
          </div>
          <div class="table-responsive">
            <table class="serene-table">
              <thead>
                <tr>
                  <th>Order #</th>
                  <th>Customer & Job</th>
                  <th>Amount & Due</th>
                  <th>Status</th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody>
                <% if (stats.recentOrders && stats.recentOrders.length > 0) { %>
                  <% stats.recentOrders.forEach(order => { %>
                    <tr>
                      <td>
                        <a href="/orders/<%= order.id %>" class="fw-semibold text-decoration-none text-dark font-monospace">
                          <%= order.orderNumber %>
                        </a>
                      </td>
                      <td>
                        <div class="fw-semibold text-dark"><%= order.customer ? order.customer.name : 'Unknown' %></div>
                        <div class="text-muted small text-truncate" style="max-width: 220px;" title="<%= order.jobTitle %>">
                          <%= order.jobTitle %>
                        </div>
                      </td>
                      <td>
                        <div class="tabular-nums fw-medium text-dark">
                          <%= currencySymbol %> <%= parseFloat(order.totalAmount).toLocaleString('en-LK', { minimumFractionDigits: 2 }) %>
                        </div>
                        <% if (parseFloat(order.balanceAmount) <= 0) { %>
                          <span class="badge mt-1" style="background:#edf7ed; color:#1e4620;">Paid</span>
                        <% } else { %>
                          <div class="text-danger small fw-semibold mt-1">
                            Due: <%= currencySymbol %> <%= parseFloat(order.balanceAmount).toLocaleString('en-LK', { minimumFractionDigits: 2 }) %>
                          </div>
                        <% } %>
                      </td>
                      <td>
                        <span class="status-badge status-<%= order.status.toLowerCase() %>">
                          <span class="status-dot"></span> <%= order.status.replace('_', ' ') %>
                        </span>
                      </td>
                      <td>
                        <a href="/orders/<%= order.id %>" class="btn btn-sm btn-serene-secondary py-1 px-2" title="View Details">
                          <i class="bi bi-eye"></i> View
                        </a>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr>
                    <td colspan="5" class="text-center py-5 text-muted">No orders recorded yet.</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Right Column: Stock Health & Movements (5 cols) -->
      <div class="col-lg-5">
        <!-- Stock Attention Card -->
        <div class="serene-card mb-4">
          <div class="serene-card-header">
            <h3 class="serene-card-title"><i class="bi bi-boxes me-2 text-muted"></i> Stock Attention</h3>
            <a href="/stock" class="btn btn-serene-ghost py-0 px-2 small">Full Inventory &rarr;</a>
          </div>
          <div class="serene-card-body p-3">
            <% if (stats.lowStockItems && stats.lowStockItems.length > 0) { %>
              <% stats.lowStockItems.forEach(item => { %>
                <div class="p-2 mb-2 rounded-2" style="background: #fafbfc; border: 1px solid var(--serene-border-subtle);">
                  <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="fw-semibold small text-dark"><%= item.name %></span>
                    <span class="badge" style="background:#fdf2f2; color:#8a2c2c; border:1px solid #dc2626;">
                      <%= parseFloat(item.currentStock) %> <%= item.unit %> left
                    </span>
                  </div>
                  <div class="d-flex justify-content-between align-items-center text-muted" style="font-size: 0.75rem;">
                    <span>Alert threshold: <%= parseFloat(item.minStockAlert) %> <%= item.unit %></span>
                    <button class="btn btn-sm btn-serene-ghost py-0 px-2 text-success" onclick="quickStockIn(<%= item.id %>)">
                      + Add Stock
                    </button>
                  </div>
                </div>
              <% }) %>
            <% } else if (stats.allStockItems && stats.allStockItems.length === 0) { %>
              <div class="text-center py-3 text-muted small">
                No materials registered yet. <a href="/stock" class="text-decoration-none">Add materials &rarr;</a>
              </div>
            <% } else { %>
              <div class="text-center py-3 text-muted small">
                <i class="bi bi-check-circle text-success me-1"></i> All stock materials are currently above alert thresholds.
              </div>
            <% } %>
          </div>
        </div>

        <!-- Recent Stock Movements -->
        <div class="serene-card">
          <div class="serene-card-header">
            <h3 class="serene-card-title"><i class="bi bi-arrow-left-right me-2 text-muted"></i> Recent Stock Movements</h3>
          </div>
          <div class="serene-card-body p-3">
            <% if (stats.recentTransactions && stats.recentTransactions.length > 0) { %>
              <% stats.recentTransactions.forEach(t => { %>
                <div class="d-flex justify-content-between align-items-center py-2 border-bottom border-light">
                  <div>
                    <div class="small fw-semibold text-dark"><%= t.stockItem ? t.stockItem.name : 'Item' %></div>
                    <div class="text-muted" style="font-size: 0.72rem;">
                      <%= t.date %> &bull; <%= t.reference || (t.type === 'IN' ? 'Stock Arrival' : 'Job Usage') %>
                    </div>
                  </div>
                  <div class="text-end">
                    <span class="badge <%= t.type === 'IN' ? 'bg-success-subtle text-success' : 'bg-danger-subtle text-danger' %> fw-bold">
                      <%= t.type === 'IN' ? '+' : '-' %><%= parseFloat(t.quantity) %> <%= t.stockItem ? t.stockItem.unit : '' %>
                    </span>
                  </div>
                </div>
              <% }) %>
            <% } else { %>
              <div class="text-center py-3 text-muted small">No stock movements logged yet.</div>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
