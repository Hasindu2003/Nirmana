<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<main class="main-wrapper">
  <div class="content-body">
    <!-- Header -->
    <div class="d-flex flex-wrap align-items-center justify-content-between mb-4">
      <div>
        <h2 class="fs-4 fw-bold mb-1">Products & Printing Services Catalog</h2>
        <div class="text-muted small">Standard rates, specifications templates, and raw print substrates</div>
      </div>
      <div class="mt-2 mt-sm-0">
        <button class="btn btn-serene-primary" data-bs-toggle="modal" data-bs-target="#newProductModal">
          <i class="bi bi-plus-lg"></i> Add Product / Service
        </button>
      </div>
    </div>

    <!-- Filters -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
      <div class="d-flex flex-wrap gap-1">
        <a href="/products" class="btn btn-sm <%= currentType === 'ALL' ? 'btn-serene-primary' : 'btn-serene-secondary' %>">All (<%= products.length %>)</a>
        <a href="/products?type=SERVICE" class="btn btn-sm <%= currentType === 'SERVICE' ? 'btn-serene-primary' : 'btn-serene-secondary' %>">Printing Services</a>
        <a href="/products?type=PHYSICAL" class="btn btn-sm <%= currentType === 'PHYSICAL' ? 'btn-serene-primary' : 'btn-serene-secondary' %>">Raw Substrates & Materials</a>
      </div>

      <form action="/products" method="GET" class="d-flex align-items-center gap-2">
        <input type="text" name="search" value="<%= search %>" class="form-control form-control-sm" placeholder="Search catalog items..." style="width:240px;">
        <button type="submit" class="btn btn-sm btn-serene-secondary">Search</button>
      </form>
    </div>

    <!-- Products Table Card -->
    <div class="serene-card">
      <div class="table-responsive">
        <table class="serene-table">
          <thead>
            <tr>
              <th>SKU / Code</th>
              <th>Name & Description</th>
              <th>Category</th>
              <th>Type</th>
              <th>Unit</th>
              <th>Selling Price</th>
              <th>Est. Turnaround</th>
            </tr>
          </thead>
          <tbody>
            <% if (products && products.length > 0) { %>
              <% products.forEach(p => { %>
                <tr>
                  <td>
                    <span class="badge bg-light text-muted border font-monospace"><%= p.code %></span>
                  </td>
                  <td>
                    <div class="fw-semibold text-dark"><%= p.name %></div>
                    <% if (p.description) { %>
                      <div class="text-muted small text-truncate" style="max-width:320px;"><%= p.description %></div>
                    <% } %>
                  </td>
                  <td>
                    <span class="badge bg-light text-dark border"><%= p.category ? p.category.name : 'General' %></span>
                  </td>
                  <td>
                    <span class="status-badge <%= p.type === 'SERVICE' ? 'status-ready' : 'status-quotation' %>" style="font-size:0.72rem;">
                      <span class="status-dot"></span> <%= p.type %>
                    </span>
                  </td>
                  <td class="text-muted small"><%= p.unit %></td>
                  <td class="tabular-nums fw-bold">
                    <%= currencySymbol %> <%= parseFloat(p.unitPrice).toLocaleString('en-LK', { minimumFractionDigits: 2 }) %>
                  </td>
                  <td class="text-muted small">
                    <% if (p.estimatedProductionTimeMinutes > 0) { %>
                      <%= Math.round(p.estimatedProductionTimeMinutes / 60) %> hrs
                    <% } else { %>
                      Instant (In stock)
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="7" class="text-center py-5 text-muted">No products found in this catalog view.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</main>

<!-- Modal: Add Product / Service -->
<div class="modal fade" id="newProductModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content" style="border-radius: var(--serene-radius-lg); border: 1px solid var(--serene-border);">
      <div class="modal-header border-bottom" style="background:#fafbfc;">
        <h5 class="modal-title fs-6 fw-semibold">Add New Product / Print Service</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form onsubmit="handleCreateProduct(event)">
        <div class="modal-body p-4">
          <div class="mb-3">
            <label class="form-label">Item / Service Name *</label>
            <input type="text" name="name" class="form-control" placeholder="e.g. Custom Gloss Sticker Sheet" required>
          </div>
          <div class="row g-2 mb-3">
            <div class="col-6">
              <label class="form-label">Category *</label>
              <select name="categoryId" class="form-select" required>
                <% categories.forEach(cat => { %>
                  <option value="<%= cat.id %>"><%= cat.name %></option>
                <% }) %>
              </select>
            </div>
            <div class="col-6">
              <label class="form-label">Classification *</label>
              <select name="type" class="form-select">
                <option value="SERVICE" selected>Print Service</option>
                <option value="PHYSICAL">Physical Raw Substrate</option>
              </select>
            </div>
          </div>
          <div class="row g-2 mb-3">
            <div class="col-6">
              <label class="form-label">Pricing Unit</label>
              <select name="unit" class="form-select">
                <option value="PCS">Pieces (PCS)</option>
                <option value="PACKS" selected>Packs</option>
                <option value="SHEETS">Sheets / Reams</option>
                <option value="ROLLS">Rolls</option>
                <option value="SQFT">Square Feet (SQFT)</option>
              </select>
            </div>
            <div class="col-6">
              <label class="form-label">Default Selling Price (<%= currencySymbol %>) *</label>
              <input type="number" name="unitPrice" class="form-control" placeholder="0.00" step="0.5" required>
            </div>
          </div>
          <div class="mb-3">
            <label class="form-label">Est. Turnaround Time (Minutes)</label>
            <input type="number" name="estimatedProductionTimeMinutes" class="form-control" value="1440" step="60">
          </div>
          <div class="mb-2">
            <label class="form-label">Item Description</label>
            <textarea name="description" class="form-control" rows="2" style="resize: none;" placeholder="Standard specifications or material notes"></textarea>
          </div>
        </div>
        <div class="modal-footer border-top bg-light">
          <button type="button" class="btn btn-serene-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-serene-primary">Save to Catalog</button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>

<script>
async function handleCreateProduct(e) {
  e.preventDefault();
  const form = e.target;
  const formData = new FormData(form);
  const data = Object.fromEntries(formData.entries());

  try {
    const res = await fetch('/api/products', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data),
    });
    const result = await res.json();
    if (result.success) {
      setPendingToast('Product saved: ' + result.data.name, 'success');
      window.location.reload();
    } else {
      toast.error('Error: ' + result.message);
    }
  } catch (err) {
    toast.error('Failed to save product: ' + err.message);
  }
}
</script>
