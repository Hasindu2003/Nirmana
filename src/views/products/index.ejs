<%- include('../partials/header') %>
<% if (typeof currentUser !== 'undefined' && currentUser) { %>
  <%- include('../partials/sidebar') %>
<% } %>

<%
  const activeCategory = typeof currentCategory !== 'undefined' ? currentCategory : 'ALL';
  const activeType = typeof currentType !== 'undefined' ? currentType : 'ALL';
  const searchQuery = typeof search !== 'undefined' ? search : '';
  const productList = typeof products !== 'undefined' ? products : [];
  const categoryList = typeof categories !== 'undefined' ? categories : [];
%>

<main class="<%= (typeof currentUser !== 'undefined' && currentUser) ? 'main-wrapper' : 'container py-4' %>">
  <div class="<%= (typeof currentUser !== 'undefined' && currentUser) ? 'content-body' : '' %>">
    
    <!-- Top Guest / Visitor Navigation Banner if not logged in -->
    <% if (!currentUser) { %>
      <div class="card border-0 shadow-sm mb-4 rounded-4 overflow-hidden" style="background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%); color: #fff;">
        <div class="card-body p-4 p-md-5">
          <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div style="max-width: 600px;">
              <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1 rounded-pill mb-2 fw-semibold" style="font-size: 0.75rem;">
                <i class="bi bi-printer me-1"></i> Nirmana Printing Store & Products Catalog
              </span>
              <h1 class="h3 fw-bold mb-2 text-white">Explore Our Products, Materials & Rates</h1>
              <p class="text-light opacity-75 small mb-0">
                Browse our premium photo frames, raw print substrates, art cards, and commercial printing services. All rates are in Sri Lankan Rupees (<%= currencySymbol %>).
              </p>
            </div>
            <div class="d-flex flex-wrap gap-2">
              <a href="/upload" class="btn btn-outline-light d-flex align-items-center gap-1 shadow-sm">
                <i class="bi bi-cloud-arrow-up"></i>
                <span>Upload Print File</span>
              </a>
              <a href="/register" class="btn btn-primary d-flex align-items-center gap-1 shadow-sm fw-semibold">
                <i class="bi bi-person-plus-fill"></i>
                <span>Sign Up (Register)</span>
              </a>
              <a href="/login" class="btn btn-light d-flex align-items-center gap-1 shadow-sm text-dark fw-semibold">
                <i class="bi bi-box-arrow-in-right"></i>
                <span>Sign In</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    <% } %>

    <!-- Page Header -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
      <div>
        <h2 class="fs-4 fw-bold mb-1 text-dark d-flex align-items-center gap-2">
          <i class="bi bi-tags text-primary"></i>
          <span>Products & Print Services Catalog</span>
        </h2>
        <div class="text-muted small">Standard rates, substrate dimensions, and in-stock items</div>
      </div>
      
      <div class="d-flex align-items-center gap-2">
        <% if (currentUser && (currentUser.role === 'ADMIN' || currentUser.role === 'WORKER')) { %>
          <a href="/pos" class="btn btn-sm btn-serene-secondary">
            <i class="bi bi-calculator me-1"></i> Open POS Terminal
          </a>
          <a href="/stock" class="btn btn-sm btn-serene-primary">
            <i class="bi bi-box-seam me-1"></i> Manage Stock
          </a>
        <% } %>
      </div>
    </div>

    <!-- Search & Category Filters -->
    <div class="card border-0 shadow-xs rounded-3 mb-4 p-3 bg-white border">
      <div class="row g-2 align-items-center justify-content-between">
        <!-- Categories Filter Pills -->
        <div class="col-12 col-lg-8">
          <div class="d-flex flex-wrap gap-1">
            <a href="/products<%= searchQuery ? '?search=' + encodeURIComponent(searchQuery) : '' %>" 
               class="btn btn-xs btn-sm <%= activeCategory === 'ALL' ? 'btn-serene-primary' : 'btn-serene-secondary' %> rounded-pill px-3">
              All Items (<%= productList.length %>)
            </a>
            <% if (categoryList && categoryList.length > 0) { %>
              <% categoryList.forEach(cat => { %>
                <a href="/products?category=<%= encodeURIComponent(cat) %><%= searchQuery ? '&search=' + encodeURIComponent(searchQuery) : '' %>" 
                   class="btn btn-xs btn-sm <%= activeCategory === cat ? 'btn-serene-primary' : 'btn-serene-secondary' %> rounded-pill px-3">
                  <%= cat %>
                </a>
              <% }) %>
            <% } %>
          </div>
        </div>

        <!-- Search input -->
        <div class="col-12 col-lg-4">
          <form action="/products" method="GET" class="d-flex align-items-center gap-1">
            <% if (activeCategory && activeCategory !== 'ALL') { %>
              <input type="hidden" name="category" value="<%= activeCategory %>">
            <% } %>
            <div class="input-group input-group-sm">
              <span class="input-group-text bg-light"><i class="bi bi-search text-muted"></i></span>
              <input type="text" name="search" value="<%= searchQuery %>" class="form-control" placeholder="Search goods, frames, substrates..." autocomplete="off">
            </div>
            <button type="submit" class="btn btn-sm btn-serene-secondary">Search</button>
            <% if (searchQuery) { %>
              <a href="/products<%= activeCategory !== 'ALL' ? '?category=' + encodeURIComponent(activeCategory) : '' %>" class="btn btn-sm btn-outline-secondary" title="Clear search">
                <i class="bi bi-x"></i>
              </a>
            <% } %>
          </form>
        </div>
      </div>
    </div>

    <!-- Products Grid Cards -->
    <div class="row g-3">
      <% if (productList && productList.length > 0) { %>
        <% productList.forEach(p => { %>
          <div class="col-12 col-sm-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm rounded-3 product-catalog-card p-3 d-flex flex-column justify-content-between" style="border: 1px solid #e2e8f0; transition: transform 0.15s ease, box-shadow 0.15s ease;">
              <div>
                <!-- Top Badge Row -->
                <div class="d-flex align-items-center justify-content-between mb-2">
                  <span class="badge bg-light text-muted border font-monospace small" style="font-size: 0.72rem;">
                    <%= p.code %>
                  </span>
                  
                  <span class="badge rounded-pill <%= p.inStock ? 'bg-success-subtle text-success border border-success-subtle' : 'bg-secondary-subtle text-secondary' %>" style="font-size: 0.72rem;">
                    <%= p.inStock ? 'In Stock' : 'Print to Order' %>
                  </span>
                </div>

                <!-- Product Name -->
                <h5 class="fw-bold fs-6 text-dark mb-1">
                  <%= p.name %>
                </h5>

                <!-- Category Tag -->
                <div class="mb-2">
                  <span class="badge bg-light text-secondary border" style="font-size: 0.7rem;">
                    <i class="bi bi-folder me-1 text-muted"></i><%= p.category %>
                  </span>
                  <% if (p.dimensions || p.sizeLabel) { %>
                    <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle ms-1" style="font-size: 0.7rem;">
                      <i class="bi bi-aspect-ratio me-1"></i><%= p.sizeLabel || p.dimensions %>
                    </span>
                  <% } %>
                </div>

                <!-- Short Description -->
                <p class="text-muted small mb-3 text-clamp-2" style="font-size: 0.82rem; min-height: 38px;">
                  <%= p.description %>
                </p>
              </div>

              <!-- Price & Details CTA Bar -->
              <div class="pt-2 border-top d-flex align-items-center justify-content-between">
                <div>
                  <div class="text-muted" style="font-size: 0.7rem;">Price per <%= p.unit %></div>
                  <div class="fs-5 fw-bold text-dark tabular-nums">
                    <%= currencySymbol %> <%= parseFloat(p.unitPrice).toLocaleString('en-LK', { minimumFractionDigits: 2 }) %>
                  </div>
                </div>

                <div>
                  <button type="button" 
                          class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1"
                          onclick='openProductModal(<%= JSON.stringify(p) %>)'>
                    <i class="bi bi-eye"></i>
                    <span>View Details</span>
                  </button>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="col-12">
          <div class="card border-0 shadow-xs p-5 text-center text-muted">
            <i class="bi bi-search fs-1 text-secondary opacity-50 mb-2"></i>
            <h5 class="fw-semibold text-dark">No products found</h5>
            <p class="small text-muted mb-3">No goods or printing services matched your filter criteria.</p>
            <div>
              <a href="/products" class="btn btn-sm btn-serene-secondary">Clear All Filters</a>
            </div>
          </div>
        </div>
      <% } %>
    </div>

  </div>
</main>

<!-- Modal: Comprehensive Product Details Popup -->
<div class="modal fade" id="productDetailsModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow-lg" style="border-radius: 16px;">
      <div class="modal-header border-bottom py-3 px-4" style="background:#f8fafc;">
        <div class="d-flex align-items-center gap-2">
          <div class="p-2 rounded-3 bg-primary-subtle text-primary d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
            <i class="bi bi-box-seam fs-6"></i>
          </div>
          <div>
            <h6 class="modal-title fw-bold text-dark mb-0" id="modalProductName">Product Details</h6>
            <span class="text-muted font-monospace small" id="modalProductCode" style="font-size: 0.75rem;"></span>
          </div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <div class="modal-body p-4">
        <!-- Main Price Banner -->
        <div class="p-3 rounded-3 mb-3 d-flex justify-content-between align-items-center" style="background: #f1f5f9;">
          <div>
            <span class="small text-muted d-block fw-semibold">Selling Price:</span>
            <span class="fs-4 fw-bold text-dark tabular-nums" id="modalProductPrice"></span>
            <span class="text-muted small" id="modalProductUnit"></span>
          </div>
          <span class="badge rounded-pill px-3 py-1-5 fw-semibold" id="modalProductStockBadge"></span>
        </div>

        <!-- Specifications Table -->
        <div class="table-responsive mb-3">
          <table class="table table-sm table-borderless mb-0 small">
            <tbody>
              <tr>
                <td class="text-muted" style="width: 140px;">Category:</td>
                <td class="fw-semibold text-dark" id="modalProductCategory"></td>
              </tr>
              <tr id="modalProductDimensionRow">
                <td class="text-muted">Dimensions / Size:</td>
                <td class="fw-semibold text-dark" id="modalProductDimensions"></td>
              </tr>
              <tr>
                <td class="text-muted">Classification:</td>
                <td class="text-dark" id="modalProductType"></td>
              </tr>
              <tr>
                <td class="text-muted">Inventory Unit:</td>
                <td class="text-dark" id="modalProductUnitDetail"></td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Description Box -->
        <div class="mb-3">
          <label class="form-label small fw-bold text-secondary text-uppercase mb-1">Specifications & Material Description</label>
          <div class="p-3 rounded-3 border bg-light small text-dark" id="modalProductDescription" style="line-height: 1.5;"></div>
        </div>

        <!-- Call to Action Banner -->
        <div class="alert alert-light border d-flex align-items-center justify-content-between p-3 mb-0" style="border-radius: 10px;">
          <div>
            <div class="small fw-bold text-dark">Ready to print or purchase?</div>
            <div class="text-muted" style="font-size: 0.72rem;">Available for immediate counter pickup or custom print run.</div>
          </div>
          <div class="d-flex gap-1" id="modalActionButtons">
            <a href="/upload" class="btn btn-sm btn-primary">
              <i class="bi bi-upload me-1"></i> Upload File
            </a>
          </div>
        </div>
      </div>

      <div class="modal-footer border-top py-2 px-4 bg-light">
        <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>

<!-- Modal: Instant Online Order / WhatsApp Intake -->
<div class="modal fade" id="guestOnlineOrderModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow-lg" style="border-radius: 16px;">
      <div class="modal-header border-bottom py-3 px-4" style="background:#f0fdf4;">
        <div class="d-flex align-items-center gap-2">
          <div class="p-2 rounded-3 bg-success text-white d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
            <i class="bi bi-cart-check-fill fs-6"></i>
          </div>
          <div>
            <h6 class="modal-title fw-bold text-dark mb-0">Place Online Order</h6>
            <div class="text-muted small" style="font-size: 0.75rem;">Fast order confirmation via WhatsApp &bull; Nirmana Store</div>
          </div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <form id="guestOnlineOrderForm" onsubmit="handleGuestOrderSubmit(event)">
        <div class="modal-body p-4">
          <!-- Notification for guests -->
          <% if (!currentUser) { %>
            <div class="alert alert-light border border-info-subtle d-flex align-items-start gap-2 py-2 px-3 mb-3" style="font-size: 0.82rem; background: #f0f9ff; border-radius: 8px;">
              <i class="bi bi-info-circle-fill text-info fs-6 flex-shrink-0 mt-0-5"></i>
              <div>
                <strong>Ordering as a guest?</strong> Please provide your active <strong>WhatsApp number</strong> so our print team can contact you to confirm details. Or <a href="/login" class="fw-semibold text-primary">Sign In</a> / <a href="/register" class="fw-semibold text-primary">Sign Up</a> to track live in your customer portal.
              </div>
            </div>
          <% } %>

          <!-- Selected Item Card -->
          <div class="p-3 rounded-3 mb-3 border d-flex justify-content-between align-items-center" style="background: #fafbfc;">
            <div>
              <span class="text-muted small d-block">Selected Item / Service:</span>
              <strong class="text-dark" id="orderModalItemName">-</strong>
              <div class="text-muted small" id="orderModalItemCode">-</div>
            </div>
            <div class="text-end">
              <span class="text-muted small d-block">Unit Rate:</span>
              <span class="fw-bold text-success fs-6 tabular-nums" id="orderModalItemPrice">Rs. 0.00</span>
            </div>
          </div>

          <input type="hidden" name="productName" id="orderModalInputProductName" value="">
          <input type="hidden" name="unitPrice" id="orderModalInputUnitPrice" value="0">

          <!-- Name -->
          <div class="mb-3">
            <label class="form-label small fw-semibold text-dark">Your Full Name *</label>
            <div class="input-group input-group-sm">
              <span class="input-group-text bg-white"><i class="bi bi-person"></i></span>
              <input type="text" name="customerName" id="orderModalCustomerName" class="form-control" placeholder="e.g. Kasun Jayawardena" 
                     value="<%= currentUser ? (currentUser.fullName || currentUser.username) : '' %>" required>
            </div>
          </div>

          <!-- WhatsApp Number -->
          <div class="mb-3">
            <label class="form-label small fw-semibold text-dark">
              WhatsApp / Contact Number *
              <span class="badge bg-success-subtle text-success border border-success-subtle ms-1" style="font-size: 0.68rem;"><i class="bi bi-whatsapp"></i> Required</span>
            </label>
            <div class="input-group input-group-sm">
              <span class="input-group-text bg-white text-success"><i class="bi bi-whatsapp"></i></span>
              <input type="tel" name="whatsappNumber" id="orderModalWhatsApp" class="form-control" placeholder="e.g. 0771234567" 
                     value="<%= currentUser && currentUser.phone ? currentUser.phone : '' %>" required maxlength="15">
            </div>
            <div class="form-text small text-muted">Must be 10 digits starting with 0 (e.g. 0771234567).</div>
          </div>

          <!-- Quantity -->
          <div class="row g-2 mb-3">
            <div class="col-6">
              <label class="form-label small fw-semibold text-dark">Order Quantity *</label>
              <input type="number" name="quantity" id="orderModalQuantity" class="form-control form-control-sm text-center fw-bold" value="1" min="1" oninput="calculateOrderModalTotal()" required>
            </div>
            <div class="col-6">
              <label class="form-label small fw-semibold text-dark">Total Estimated Price</label>
              <div class="form-control form-control-sm bg-light text-end fw-bold text-success tabular-nums" id="orderModalTotalDisplay">
                Rs. 0.00
              </div>
            </div>
          </div>

          <!-- Specifications / Custom Notes -->
          <div class="mb-2">
            <label class="form-label small fw-semibold text-dark">Special Instructions / Customization (Optional)</label>
            <textarea name="specifications" id="orderModalSpecifications" class="form-control form-control-sm" rows="2" placeholder="e.g. Custom text on frame, color preferences, urgent delivery, etc."></textarea>
          </div>
        </div>

        <div class="modal-footer border-top py-2 px-4 bg-light d-flex justify-content-between">
          <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-sm btn-success fw-bold px-3" id="orderModalSubmitBtn">
            <i class="bi bi-send-fill me-1"></i> Send Online Order
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>

<script>
let currentModalProduct = null;

function openProductModal(p) {
  currentModalProduct = p;
  document.getElementById('modalProductName').textContent = p.name || 'Product Details';
  document.getElementById('modalProductCode').textContent = p.code || '';
  document.getElementById('modalProductPrice').textContent = '<%= currencySymbol %> ' + (parseFloat(p.unitPrice) || 0).toLocaleString('en-LK', { minimumFractionDigits: 2 });
  document.getElementById('modalProductUnit').textContent = ' / ' + (p.unit || 'unit');
  document.getElementById('modalProductCategory').textContent = p.category || 'General';
  document.getElementById('modalProductType').textContent = p.type || 'Physical Substrate';
  document.getElementById('modalProductUnitDetail').textContent = p.unit || 'Pcs';
  document.getElementById('modalProductDescription').textContent = p.description || 'No additional specifications provided.';

  const stockBadge = document.getElementById('modalProductStockBadge');
  if (p.inStock) {
    stockBadge.className = 'badge rounded-pill bg-success-subtle text-success border border-success-subtle px-3 py-1-5';
    stockBadge.textContent = 'In Stock (' + (p.currentStock ? p.currentStock + ' ' + p.unit : 'Available') + ')';
  } else {
    stockBadge.className = 'badge rounded-pill bg-secondary-subtle text-secondary px-3 py-1-5';
    stockBadge.textContent = 'Print to Order';
  }

  const dimRow = document.getElementById('modalProductDimensionRow');
  const dimVal = document.getElementById('modalProductDimensions');
  if (p.dimensions || p.sizeLabel) {
    dimRow.style.display = '';
    dimVal.textContent = p.sizeLabel ? (p.sizeLabel + (p.dimensions ? ' (' + p.dimensions + ')' : '')) : p.dimensions;
  } else {
    dimRow.style.display = 'none';
  }

  const actionContainer = document.getElementById('modalActionButtons');
  const waMsg = encodeURIComponent(`Hi Nirmana Printing! I would like to order:\nProduct: ${p.name}\nPrice: Rs. ${parseFloat(p.unitPrice || 0).toFixed(2)}\nQuantity: 1`);

  <% if (!currentUser) { %>
    actionContainer.innerHTML = `
      <a href="https://wa.me/94771234567?text=${waMsg}" target="_blank" class="btn btn-sm btn-success fw-semibold" title="Instant Order via WhatsApp">
        <i class="bi bi-whatsapp me-1"></i> WhatsApp
      </a>
      <button type="button" class="btn btn-sm btn-primary fw-semibold" onclick="openGuestOnlineOrderModal()">
        <i class="bi bi-cart-plus me-1"></i> Order Online
      </button>
      <a href="/register" class="btn btn-sm btn-outline-secondary">Sign Up</a>
    `;
  <% } else if (currentUser.role === 'ADMIN' || currentUser.role === 'WORKER') { %>
    actionContainer.innerHTML = `
      <button type="button" class="btn btn-sm btn-success fw-semibold" onclick="triggerQuickTxFromProductModal()">
        <i class="bi bi-lightning-charge-fill me-1"></i> Quick Bill
      </button>
      <a href="/orders/new" class="btn btn-sm btn-serene-secondary">New Order</a>
    `;
  <% } else { %>
    actionContainer.innerHTML = `
      <button type="button" class="btn btn-sm btn-primary fw-semibold" onclick="openGuestOnlineOrderModal()">
        <i class="bi bi-cart-plus me-1"></i> Order Now
      </button>
      <a href="https://wa.me/94771234567?text=${waMsg}" target="_blank" class="btn btn-sm btn-outline-success fw-semibold">
        <i class="bi bi-whatsapp me-1"></i> WhatsApp
      </a>
    `;
  <% } %>

  const modal = new bootstrap.Modal(document.getElementById('productDetailsModal'));
  modal.show();
}

function openGuestOnlineOrderModal() {
  if (!currentModalProduct) return;
  const pModalEl = document.getElementById('productDetailsModal');
  const pModal = bootstrap.Modal.getInstance(pModalEl);
  if (pModal) pModal.hide();

  document.getElementById('orderModalItemName').textContent = currentModalProduct.name;
  document.getElementById('orderModalItemCode').textContent = currentModalProduct.code || '';
  document.getElementById('orderModalItemPrice').textContent = '<%= currencySymbol %> ' + (parseFloat(currentModalProduct.unitPrice) || 0).toFixed(2);
  document.getElementById('orderModalInputProductName').value = currentModalProduct.name;
  document.getElementById('orderModalInputUnitPrice').value = currentModalProduct.unitPrice || 0;
  document.getElementById('orderModalQuantity').value = 1;
  calculateOrderModalTotal();

  const oModal = bootstrap.Modal.getOrCreateInstance(document.getElementById('guestOnlineOrderModal'));
  oModal.show();
}

function calculateOrderModalTotal() {
  const price = parseFloat(document.getElementById('orderModalInputUnitPrice').value) || 0;
  const qty = parseInt(document.getElementById('orderModalQuantity').value, 10) || 1;
  const total = price * qty;
  document.getElementById('orderModalTotalDisplay').textContent = '<%= currencySymbol %> ' + total.toLocaleString('en-LK', { minimumFractionDigits: 2 });
}

async function handleGuestOrderSubmit(e) {
  e.preventDefault();
  const form = e.target;
  const formData = new FormData(form);
  const payload = Object.fromEntries(formData.entries());

  const btn = document.getElementById('orderModalSubmitBtn');
  btn.disabled = true;
  btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Submitting...';

  try {
    const res = await fetch('/api/orders/online-guest', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });
    const result = await res.json();
    if (result.success) {
      const oModalEl = document.getElementById('guestOnlineOrderModal');
      const oModal = bootstrap.Modal.getInstance(oModalEl);
      if (oModal) oModal.hide();

      setPendingToast(result.message, 'success');
      <% if (currentUser && currentUser.role === 'CUSTOMER') { %>
        window.location.href = '/portal';
      <% } else { %>
        window.location.reload();
      <% } %>
    } else {
      toast.error(result.message || 'Could not place order');
    }
  } catch (err) {
    toast.error('Network error: ' + err.message);
  } finally {
    btn.disabled = false;
    btn.innerHTML = '<i class="bi bi-send-fill me-1"></i> Send Online Order';
  }
}

function triggerQuickTxFromProductModal() {
  const pModalEl = document.getElementById('productDetailsModal');
  const pModal = bootstrap.Modal.getInstance(pModalEl);
  if (pModal) pModal.hide();
  if (currentModalProduct && typeof window.openQuickTransaction === 'function') {
    window.openQuickTransaction(
      currentModalProduct.stockItemId || null,
      currentModalProduct.name,
      currentModalProduct.unitPrice
    );
  }
}
</script>
