{
  "info": {
    "name": "Nirmana Printing Management System - Phase 1 API",
    "_postman_id": "nirmana-phase1-collection-2024",
    "description": "Postman API Collection for Nirmana Printing Management System (Phase 1 Foundation: Auth, Users, Dashboard, Customers, Products/Services Catalog, Orders & Print Specs, Split Payments, and Receivables).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "string" },
    { "key": "authToken", "value": "", "type": "string" },
    { "key": "orderId", "value": "1", "type": "string" },
    { "key": "customerId", "value": "1", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login (Admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Current Authenticated User",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/auth/logout", "host": ["{{baseUrl}}"], "path": ["api", "auth", "logout"] }
          }
        }
      ]
    },
    {
      "name": "2. Dashboard",
      "item": [
        {
          "name": "Get Dashboard Statistics & KPIs",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/dashboard/stats", "host": ["{{baseUrl}}"], "path": ["api", "dashboard", "stats"] }
          }
        }
      ]
    },
    {
      "name": "3. Customers & Receivables",
      "item": [
        {
          "name": "List All Customers",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/customers", "host": ["{{baseUrl}}"], "path": ["api", "customers"] }
          }
        },
        {
          "name": "Create New Customer",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Naveen Kulatunga\",\n  \"companyName\": \"Blue Horizon Creative (Pvt) Ltd\",\n  \"customerType\": \"BUSINESS\",\n  \"phone\": \"+94 77 555 1234\",\n  \"email\": \"naveen@bluehorizon.lk\",\n  \"address\": \"45 Dharmapala Mawatha, Colombo 07\",\n  \"creditLimit\": 75000,\n  \"paymentTerms\": \"NET_30\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/customers", "host": ["{{baseUrl}}"], "path": ["api", "customers"] }
          }
        },
        {
          "name": "Get Customer By ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/customers/{{customerId}}", "host": ["{{baseUrl}}"], "path": ["api", "customers", "{{customerId}}"] }
          }
        },
        {
          "name": "Get Customer Receivables & Debt Schedule",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/customers/{{customerId}}/receivables", "host": ["{{baseUrl}}"], "path": ["api", "customers", "{{customerId}}", "receivables"] }
          }
        }
      ]
    },
    {
      "name": "4. Products & Catalog",
      "item": [
        {
          "name": "List Product Categories",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/products/categories", "host": ["{{baseUrl}}"], "path": ["api", "products", "categories"] }
          }
        },
        {
          "name": "List Products & Print Services",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/products", "host": ["{{baseUrl}}"], "path": ["api", "products"] }
          }
        },
        {
          "name": "Create Product / Print Service",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"A3 Folded Brochures (Pack of 250)\",\n  \"categoryId\": 1,\n  \"type\": \"SERVICE\",\n  \"unit\": \"PACKS\",\n  \"unitPrice\": 8500,\n  \"costPrice\": 3900,\n  \"estimatedProductionTimeMinutes\": 1440,\n  \"description\": \"A3 bi-fold high-gloss product catalogues\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/products", "host": ["{{baseUrl}}"], "path": ["api", "products"] }
          }
        }
      ]
    },
    {
      "name": "5. Orders & Print Specifications",
      "item": [
        {
          "name": "List Orders",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/orders", "host": ["{{baseUrl}}"], "path": ["api", "orders"] }
          }
        },
        {
          "name": "Create New Print Order with Specs & Split Payment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": 1,\n  \"status\": \"CONFIRMED\",\n  \"priority\": \"HIGH\",\n  \"deliveryDueDate\": \"2024-11-10\",\n  \"discount\": 500,\n  \"initialPayment\": 5000,\n  \"paymentMethod\": \"BANK_TRANSFER\",\n  \"scheduledAmount\": 13000,\n  \"scheduledDueDate\": \"2024-11-25\",\n  \"items\": [\n    {\n      \"itemDescription\": \"1,000x Luxury Gold-Foil Business Cards\",\n      \"quantity\": 10,\n      \"unitPrice\": 1850,\n      \"specifications\": {\n        \"paperMaterial\": \"350gsm Dutch Ivory Art Card\",\n        \"size\": \"3.5 x 2.0 in\",\n        \"gsm\": \"350gsm\",\n        \"colorMode\": \"CMYK Full Color\",\n        \"sides\": \"Double-sided\",\n        \"pages\": 1,\n        \"finishingOptions\": [\"Matte Velvet Soft-Touch\", \"Gold Foil Stamping\"]\n      }\n    }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/orders", "host": ["{{baseUrl}}"], "path": ["api", "orders"] }
          }
        },
        {
          "name": "Get Order By ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/orders/{{orderId}}", "host": ["{{baseUrl}}"], "path": ["api", "orders", "{{orderId}}"] }
          }
        },
        {
          "name": "Update Order Status Workflow",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"DESIGNING\",\n  \"notes\": \"Client approved preliminary proofs. Ready for layout imposition.\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/orders/{{orderId}}/status", "host": ["{{baseUrl}}"], "path": ["api", "orders", "{{orderId}}", "status"] }
          }
        },
        {
          "name": "Record Payment Against Order",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 3500,\n  \"paymentMethod\": \"CASH\",\n  \"referenceNumber\": \"COUNTER-REC-901\",\n  \"notes\": \"Customer collected portion of print run\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/orders/{{orderId}}/payments", "host": ["{{baseUrl}}"], "path": ["api", "orders", "{{orderId}}", "payments"] }
          }
        },
        {
          "name": "Add Payment Schedule Commitment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 5000,\n  \"dueDate\": \"2024-12-01\",\n  \"notes\": \"Final balance installment\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/orders/{{orderId}}/payment-schedules", "host": ["{{baseUrl}}"], "path": ["api", "orders", "{{orderId}}", "payment-schedules"] }
          }
        }
      ]
    },
    {
      "name": "6. Administration & Users",
      "item": [
        {
          "name": "List Users",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/users", "host": ["{{baseUrl}}"], "path": ["api", "users"] }
          }
        }
      ]
    }
  ]
}
