# Application Configuration
PORT=3000
NODE_ENV=development
APP_NAME="Nirmana Printing Management System"
CURRENCY_SYMBOL="Rs."
CURRENCY_CODE="LKR"

# Database Configuration
# Dialect: 'sqlite' (local development) or 'mysql' (production)
DB_DIALECT=sqlite
DB_STORAGE=./data/nirmana.sqlite

# MySQL Settings (used when DB_DIALECT=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=nirmana_printing
DB_USER=root
DB_PASS=

# Authentication Secrets
SESSION_SECRET=nirmana_super_secure_session_secret_key_2024
JWT_SECRET=nirmana_jwt_signing_token_secret_key_2024

# Google Drive Cloud Storage (Customer File Uploads)
# 1. Create a Google Cloud Project and enable Google Drive API
# 2. Create a Service Account, generate a JSON Key, and share your Drive folder with the service account email
# 3. Enter the details below:
GOOGLE_SERVICE_ACCOUNT_EMAIL=nirmana-storage@your-gcp-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id

