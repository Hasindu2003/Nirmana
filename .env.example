# ==============================================================================
# NIRMANA PRINTING MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. Application Settings
PORT=3000
NODE_ENV=development
APP_NAME="Nirmana Printing Management System"
CURRENCY_SYMBOL="Rs."
CURRENCY_CODE="LKR"

# 2. Database Settings
# ------------------------------------------------------------------------------
# OPTION A: Single Connection URL (Recommended for Vercel / Cloud Deployment)
# Supports PostgreSQL (Supabase, Neon, Railway, Vercel Postgres) & MySQL (PlanetScale, Aiven)
#
# Examples:
# PostgreSQL (Supabase / Neon):
# DATABASE_URL=postgres://postgres:your_password@db.xxxx.supabase.co:5432/postgres
# MySQL (PlanetScale / Aiven):
# DATABASE_URL=mysql://user:password@aws.connect.psdb.cloud/nirmana_db
# ------------------------------------------------------------------------------
# DATABASE_URL=

# OPTION B: SQLite (Default for Local Development on your PC)
DB_DIALECT=sqlite
DB_STORAGE=./data/nirmana.sqlite

# OPTION C: Explicit MySQL / PostgreSQL Connection (Local or Self-Hosted)
# DB_DIALECT=mysql        # or 'postgres'
# DB_HOST=localhost
# DB_PORT=3306            # 3306 for MySQL, 5432 for PostgreSQL
# DB_NAME=nirmana_printing
# DB_USER=root
# DB_PASS=
# DB_SSL=false            # Set to 'true' if using a remote cloud DB

# 3. Security & Authentication Secrets
# (Generate random 32+ character strings for production)
SESSION_SECRET=nirmana_super_secure_session_secret_key_2024
JWT_SECRET=nirmana_jwt_signing_token_secret_key_2024

# 4. Google Drive Cloud Storage (Customer File Uploads for Quick Print)
# ------------------------------------------------------------------------------
# OPTION A: OAuth 2.0 (Recommended - works with any regular @gmail.com 15GB account)
# 1. Create a project in Google Cloud Console (https://console.cloud.google.com)
# 2. Enable "Google Drive API"
# 3. Create OAuth 2.0 Credentials (Web Application)
# 4. Add Authorized redirect URIs:
#    - For local:  http://localhost:3000/oauth2callback
#    - For Vercel: https://your-app.vercel.app/oauth2callback
# 5. After setting CLIENT_ID and CLIENT_SECRET, visit /auth/google in your browser
#    to link your Google Drive with 1 click.
# ------------------------------------------------------------------------------
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id
GOOGLE_CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_oauth_client_secret
GOOGLE_REFRESH_TOKEN=your_oauth_refresh_token

# OPTION B: Service Account (Google Workspace / Shared Organization Drives only)
# GOOGLE_SERVICE_ACCOUNT_EMAIL=nirmana-storage@your-gcp-project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"



